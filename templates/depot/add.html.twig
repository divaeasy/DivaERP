{% extends "template_oukatech.html.twig" %}

{% block PageTitle %}Depot{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('depot.list') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
        <h1 class="h3 mb-0 text-gray-800">{{ id > 0 ? 'Modifier le depot' : 'Nouveau depot' }}</h1>
    </div>
</div>

<div class="form-card">
    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

    <div class="card-header-custom">
        <h5><i class="fas fa-warehouse mr-2"></i>Informations du depot</h5>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.libelle, 'Libelle', {'label_attr': {'class': 'required'}}) }}
                {{ form_widget(form.libelle, {'attr': {'class': 'form-control', 'placeholder': 'Nom du depot'}}) }}
                {{ form_errors(form.libelle) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.tiersInterne, 'Tiers interne') }}
                {{ form_widget(form.tiersInterne, {'attr': {'class': 'form-control js-example-basic-single'}}) }}
                {{ form_errors(form.tiersInterne) }}
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.adr1, 'Adresse ligne 1') }}
                {{ form_widget(form.adr1, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.adr1) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.adr2, 'Adresse ligne 2') }}
                {{ form_widget(form.adr2, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.adr2) }}
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                {{ form_label(form.rue, 'Rue') }}
                {{ form_widget(form.rue, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.rue) }}
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                {{ form_label(form.codepostal, 'Code postal') }}
                {{ form_widget(form.codepostal, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.codepostal) }}
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                {{ form_label(form.ville, 'Ville') }}
                {{ form_widget(form.ville, {'attr': {'class': 'form-control js-example-basic-single'}}) }}
                {{ form_errors(form.ville) }}
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                {{ form_label(form.pays, 'Pays') }}
                {{ form_widget(form.pays, {'attr': {'class': 'form-control js-example-basic-single'}}) }}
                {{ form_errors(form.pays) }}
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save mr-2"></i>{{ id > 0 ? 'Mettre a jour' : 'Enregistrer' }}
        </button>
        <a href="{{ path('depot.list') }}" class="btn btn-secondary">
            <i class="fas fa-times mr-2"></i>Annuler
        </a>
    </div>

    {{ form_rest(form) }}
    {{ form_end(form) }}
</div>
{% endblock %}

{% block javascripts %}
<script>
    $(document).ready(function() {
        $('.js-example-basic-single').select2({
            theme: 'bootstrap-5',
            allowClear: true
        });
    });
</script>
{% endblock %}
