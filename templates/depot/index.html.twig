{% extends 'template_oukatech.html.twig' %}

{% block PageTitle %}Gestion des Depots{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Depots</h1>
    </div>
</div>

<div class="action-bar">
    <div class="action-buttons">
        <button type="button" class="btn-add no-loading" data-toggle="modal" data-target="#depotQuickCreateModal">
            <i class="fas fa-plus"></i> Nouveau depot
        </button>
        <a class="btn btn-sm btn-outline-success ml-2 no-loading" href="{{ path('export.depots') }}" title="Exporter CSV">
            <i class="fas fa-file-csv mr-1"></i> Exporter
        </a>
        <button type="button" class="btn btn-sm btn-outline-primary ml-2 no-loading" data-toggle="modal" data-target="#depotImportModal">
            <i class="fas fa-file-import fa-md"></i> Importer
        </button>
    </div>
    <div class="table-bulk-actions" id="depotsBulkActions" data-bulk-bar-for="depots">
        <div class="table-bulk-actions__content">
            <div class="table-bulk-actions__left">
                <span class="table-bulk-actions__badge">
                    <i class="fas fa-check-circle"></i>
                    <strong data-selection-count>0</strong>
                </span>
                <span class="table-bulk-actions__label" data-selection-label>Aucun depot selectionne</span>
            </div>
            <div class="table-bulk-actions__buttons">
                <button type="button" class="btn btn-sm table-bulk-actions__delete-btn no-loading" data-bulk-action="delete">
                    <i class="fas fa-trash-alt mr-1"></i> Supprimer
                </button>
                <button type="button" class="btn btn-sm table-bulk-actions__clear-btn no-loading" data-bulk-clear>
                    Annuler
                </button>
            </div>
        </div>
    </div>
    <div class="action-tools">
        <div class="search-box">
            {% include "components/search_data.html.twig" with {search: search} only %}
        </div>
    </div>
</div>

<div class="table-container">
    <div class="crud-column-settings-floating">
        <button type="button" class="no-loading crud-column-settings__trigger" aria-expanded="false">
            <i class="fas fa-cog"></i>
        </button>
        <div class="crud-column-settings__menu"></div>
    </div>
    {% if depots|length > 0 %}
    <table class="table js-crud-list-table commercial-table"
           id="depotsTable"
           data-table-id="depots"
           data-crud-resource="depot"
           data-bulk-delete-token="{{ csrf_token('crud_bulk_delete_depot') }}"
           data-update-token="{{ csrf_token('crud_update_depot') }}"
           data-create-token="{{ csrf_token('crud_create_depot') }}"
           data-import-token="{{ csrf_token('crud_import_depot') }}"
           data-enable-quick-create="1"
           data-enable-import="1"
           data-placeholder="____">
        <thead>
            <tr>
                <th class="row-selector-head" data-column-key="selector">
                    <div class="form-check d-flex justify-content-center mb-0">
                        <input class="form-check-input position-static" type="checkbox" data-select-all-checkbox aria-label="Selectionner toutes les lignes">
                    </div>
                </th>
                <th data-sort-key="id" data-sort-type="number" data-column-key="id">ID</th>
                <th data-sort-key="libelle" data-column-key="libelle" data-field="libelle" data-required="1">Libelle</th>
                <th data-sort-key="tiers_interne" data-column-key="tiers_interne">Tiers interne</th>
                <th data-sort-key="adresse" data-column-key="adresse" data-field="adr1">Adresse</th>
                <th data-sort-key="ville" data-column-key="ville">Ville</th>
                <th data-sort-key="pays" data-column-key="pays">Pays</th>
                <th class="text-center" style="width: 150px;" data-column-key="actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for depot in depots %}
            <tr data-row-id="{{ depot.id }}" data-item-id="{{ depot.id }}">
                <td class="row-selector-cell" data-column-key="selector">
                    <div class="form-check d-flex justify-content-center mb-0">
                        <input class="form-check-input position-static" type="checkbox" value="{{ depot.id }}" data-row-checkbox aria-label="Selectionner depot {{ depot.libelle|default(depot.id) }}">
                    </div>
                </td>
                <td data-column-key="id"><strong>#{{ depot.id }}</strong></td>
                <td data-column-key="libelle" data-field="libelle">{{ depot.libelle ?: '____' }}</td>

                <td data-column-key="tiers_interne">{{ depot.tiersInterne ?: '____' }}</td>
                <td data-column-key="adresse" data-field="adr1">{{ depot.adr1 ?: '____' }}</td>

                <td data-column-key="ville">{{ depot.ville ?: '____' }}</td>
                <td data-column-key="pays">{{ depot.pays ?: '____' }}</td>
                <td class="text-center" data-role="actions" data-column-key="actions">
                    <a href="{{ path('app_depot_show', {id: depot.id}) }}" class="btn btn-action btn-view" title="Voir">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a href="{{ path('app_depot_edit', {id: depot.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn"
                            data-delete-url="{{ path('app_depot_delete', {id: depot.id}) }}"
                            data-item-name="{{ depot.libelle }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% include "components/_pagination.html.twig" with {currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, route: 'app_depot_index', routeParams: {}} %}
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-warehouse"></i>
        </div>
        <h5>Aucun depot trouve</h5>
        <p>Ajoutez vos depots pour organiser les stocks et les emplacements logistiques.</p>
        <a href="{{ path('app_depot_new') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouveau depot
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
