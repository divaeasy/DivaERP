{% extends 'template_oukatech.html.twig' %}


{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Pays</h1>
    </div>
</div>

<div class="action-bar">
    <div class="action-buttons">
        <a class="btn-add" href="{{ path('pays.edit') }}">
            <i class="fas fa-plus"></i> Nouveau Pays
        </a>
        <a class="btn btn-sm btn-outline-success ml-2 no-loading" href="{{ path('export.pays') }}" title="Exporter CSV">
            <i class="fas fa-file-csv mr-1"></i> Exporter
        </a>
    </div>
    <div class="search-box">
        {% include "components/search_data.html.twig" with {search: search} only %}
    </div>
</div>

<div class="table-container">
    {% if pays|length > 0 %}
    <table class="table">
        <thead>
            <tr>
                <th data-sort-key="id" data-sort-type="number">ID</th>
                <th data-sort-key="libelle">Libellé</th>
                <th class="text-center" style="width: 120px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for p in pays %}
            <tr>
                <td><strong>#{{ p.id }}</strong></td>
                <td>{{ p.libelle|default('____') }}</td>
                <td class="text-center">
                    <a href="{{ path('pays.edit', {id: p.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn"
                            data-delete-url="{{ path('pays.delete', {id: p.id}) }}"
                            data-item-name="{{ p.libelle }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% include "components/_pagination.html.twig" with {currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, route: 'pays.list', routeParams: {}} %}
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-globe"></i>
            
        </div>
        <h5>Aucun pays trouvé</h5>
        <p>Ajoutez les pays nécessaires à votre gestion commerciale.</p>
        <a href="{{ path('pays.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouveau pays
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
