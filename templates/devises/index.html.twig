{% extends 'template_oukatech.html.twig' %}

{% block PageTitle%}
    Gestion des Devises
{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Devises</h1>
    </div>
</div>

<div class="action-bar">
    <div class="action-buttons">
        <a class="btn-add" href="{{ path('devise.edit') }}">
            <i class="fas fa-plus"></i> Nouvelle Devise
        </a>
        <a class="btn btn-sm btn-outline-success ml-2 no-loading" href="{{ path('export.devises') }}" title="Exporter CSV">
            <i class="fas fa-file-csv mr-1"></i> Exporter
        </a>
    </div>
    <div class="search-box">
        {% include "components/search_data.html.twig" with {search: search} only %}
    </div>
</div>

<div class="table-container">
    <div class="crud-column-settings-floating">
        <button type="button" class="no-loading crud-column-settings__trigger" aria-expanded="false">
            <i class="fas fa-cog"></i>
        </button>
        <div class="crud-column-settings__menu"></div>
    </div>

    {% if devises|length > 0 %}
    <table class="table js-crud-list-table"
           data-table-id="devise"
           data-crud-resource="devise"
           data-bulk-delete-token="{{ csrf_token('crud_bulk_delete_devise') }}"
           data-update-token="{{ csrf_token('crud_update_devise') }}"
           data-create-token="{{ csrf_token('crud_create_devise') }}"
           data-import-token="{{ csrf_token('crud_import_devise') }}"
           data-enable-quick-create="1"
           data-enable-import="1"
           data-placeholder="____">
        <thead>
            <tr>
                <th data-sort-key="id" data-sort-type="number" data-column-key="id">ID</th>
                <th data-sort-key="code" data-field="code" data-required="1" data-column-key="code">Code</th>
                <th data-sort-key="libelle" data-field="libelle" data-required="1" data-column-key="libelle">Libelle</th>
                <th class="text-center" style="width: 120px;" data-column-key="actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for devise in devises %}
            <tr data-row-id="{{ devise.id }}">
                <td data-column-key="id"><strong>#{{ devise.id }}</strong></td>
                <td data-column-key="code" data-field="code" data-field-value="{{ devise.code|default('') }}"><span class="badge badge-info badge-lg">{{ devise.code|default('____') }}</span></td>
                <td data-column-key="libelle" data-field="libelle" data-field-value="{{ devise.libelle|default('') }}">{{ devise.libelle|default('____') }}</td>
                <td class="text-center" data-column-key="actions" data-role="actions">
                    <a href="{{ path('devise.edit', {id: devise.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn"
                            data-delete-url="{{ path('devise.delete', {id: devise.id}) }}"
                            data-item-name="{{ devise.code }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% include "components/_pagination.html.twig" with {currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, route: 'devise.list', routeParams: {}} %}
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-euro-sign"></i>
        </div>
        <h5>Aucune devise trouvée</h5>
        <p>Configurez vos devises pour gérer les transactions multi-devises.</p>
        <a href="{{ path('devise.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouvelle devise
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}


