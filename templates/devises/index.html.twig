{% extends 'template_oukatech.html.twig' %}


{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Devises</h1>
    </div>
</div>

<div class="action-bar">
    <a class="btn-add" href="{{ path('devise.edit') }}">
        <i class="fas fa-plus"></i> Nouvelle Devise
    </a>
</div>

<div class="table-container">
    {% if devises|length > 0 %}
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Code</th>
                <th>Libellé</th>
                <th class="text-center" style="width: 120px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for devise in devises %}
            <tr>
                <td><strong>#{{ devise.id }}</strong></td>
                <td><span class="badge badge-info">{{ devise.code }}</span></td>
                <td>{{ devise.libelle }}</td>
                <td class="text-center">
                    <a href="{{ path('devise.edit', {id: devise.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn"
                            data-delete-url="{{ path('devise.delete', {id: devise.id}) }}"
                            data-item-name="{{ devise.code }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-euro-sign"></i>
        </div>
        <h5>Aucune devise trouvée</h5>
        <p>Configurez vos devises pour gérer les transactions multi-devises.</p>
        <a href="{{ path('devise.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouvelle devise
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
