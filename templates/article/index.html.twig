            $row.attr('data-nature-production-id', article.natureProductionId || '');
            $row.attr('data-nature-production-label', article.natureProductionLabel || '');
            $row.attr('data-sorti-stock', article.sortiStockLabel || '');
            $row.attr('data-fournisseur-habituel-id', article.fournisseurHabituelId || '');
            $row.attr('data-fournisseur-habituel-label', article.fournisseurHabituelLabel || '');

            restoreRowDisplay($row);
            $row.removeClass('is-new-unsaved').addClass('is-saved');
            window.setTimeout(function() {
