        function uploadArticleDetailImageIfNeeded($row) {
            var deferred = $.Deferred();
            if (!articleDetailState.imageFile) {
                deferred.resolve();
                return deferred.promise();
            }

            if (!$row || !$row.length || !$row.attr('data-upload-image-url')) {
                deferred.reject('Image: URL de mise a jour introuvable.');
                return deferred.promise();
            }

            var validationMessage = validateArticleImageFile(articleDetailState.imageFile);
            if (validationMessage) {
                deferred.reject(validationMessage);
                return deferred.promise();
            }

            var formData = new FormData();
            formData.append('_token', uploadImageToken);
            formData.append('image', articleDetailState.imageFile);

            $.ajax({
                url: String($row.attr('data-upload-image-url') || ''),
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            }).done(function(response) {
                if (!response || response.success !== true) {
                    deferred.reject((response && response.message) ? response.message : 'La mise a jour de l image a echoue.');
                    return;
                }

                if (response.article) {
                    $row.attr('data-upload-image-url', response.article.uploadImageUrl || $row.attr('data-upload-image-url'));
                    $row.attr('data-image-url', response.article.imageUrl || '');
                } else {
                    $row.attr('data-image-url', response.imageUrl || '');
                }
                renderRowImageCell($row);
                deferred.resolve();
            }).fail(function(xhr) {
                var message = 'La mise a jour de l image a echoue.';
                if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
                    message = xhr.responseJSON.message;
                }
                deferred.reject(message);
            });

            return deferred.promise();
        }

        function saveArticleDetailModal() {
            var $row = articleDetailState.$row;
            if (!$row || !$row.length) {
                return;
            }

            var payload = {
                _token: inlineUpdateToken,
                libelle: $.trim(String($articleDetailLibelle.val() || '')),
                uniteId: String($articleDetailUnite.val() || ''),
                tarifId: String($articleDetailTarif.val() || ''),
                modeGestion: String($articleDetailModeGestion.val() || ''),
                modeSuivi: String($articleDetailModeSuivi.val() || ''),
                natureProductionId: String($articleDetailNatureProduction.val() || ''),
                sortiStock: String($articleDetailSortiStock.val() || ''),
                fournisseurHabituelId: String($articleDetailFournisseurHabituel.val() || '')
            };

            if (payload.libelle === '') {
                showToast('error', 'La designation est obligatoire.');
                $articleDetailLibelle.trigger('focus');
                return;
            }

            setArticleDetailSubmitting(true);

            $.ajax({
                url: $row.data('inlineUpdateUrl'),
                method: 'POST',
                dataType: 'json',
                data: payload,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            }).done(function(response) {
                if (!response || response.success !== true || !response.article) {
                    setArticleDetailSubmitting(false);
                    showToast('error', (response && response.message) ? response.message : 'La mise a jour a echoue.');
                    return;
                }

                applySavedState($row, response.article);
                uploadArticleDetailImageIfNeeded($row)
                    .done(function() {
                        setArticleDetailSubmitting(false);
                        if ($articleDetailModal.length) {
                            $articleDetailModal.modal('hide');
                        }
                        showToast('success', response.message || 'Article mis a jour avec succes.');
                    })
                    .fail(function(message) {
                        setArticleDetailSubmitting(false);
                        showToast('error', message || 'La mise a jour de l image a echoue.');
                    });
            }).fail(function(xhr) {
                var message = 'La mise a jour a echoue.';
                if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
                    message = xhr.responseJSON.message;
                }

                setArticleDetailSubmitting(false);
                showToast('error', message);
            });
        }

