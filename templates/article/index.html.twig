<div class="modal fade" id="articleImportModal" tabindex="-1" role="dialog" aria-labelledby="articleImportModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" action="{{ path('article.import') }}" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('article_import') }}">
                <div class="modal-header">
                    <h5 class="modal-title" id="articleImportModalLabel">Importer des articles</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="article-import-file">Fichier Excel (.xlsx, .xls ou .xlsm)</label>
                        <input id="article-import-file" type="file" name="import_file" class="form-control-file" accept=".xlsx,.xls,.xlsm" required>
                    </div>
                    <small class="text-muted d-block">
                        Utilisez le fichier exporte, modifiez la feuille <strong>Export</strong> puis importez-le ici (format recommande: <strong>.xls</strong>).
                    </small>
                    <small class="text-muted d-block">
                        Sans ID = création. Avec ID existant = mise à jour. La colonne ID est protégée.
                    </small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade article-quick-modal" id="articleQuickCreateModal" tabindex="-1" role="dialog" aria-labelledby="articleQuickCreateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <button type="button" class="close article-quick-modal-close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            <form id="articleQuickCreateForm" class="no-loading" data-no-loading novalidate enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('article_create_minimal') }}">
                <div class="article-quick-modal-body">
                    <div class="article-quick-modal-badge">
                        <i class="fas fa-box-open"></i>
                    </div>
                    <h3 class="article-quick-modal-title" id="articleQuickCreateModalLabel">Creation rapide d'article</h3>
                    {#
                        Désignation + Unité suffisent pour créer l'article.
                    </div>

                    #}
                    <div class="form-group">
                        <label for="quickCreateLibelle">Designation <span class="text-danger">*</span></label>
                        <input type="text" class="form-control article-quick-input" id="quickCreateLibelle" name="libelle" maxlength="255" required>
                    </div>
                    <div class="form-group mb-0">
                        <label for="quickCreateUniteId">Unite <span class="text-danger">*</span></label>
                        <select class="form-control article-quick-input" id="quickCreateUniteId" name="uniteId" required>
                            <option value="">Selectionner une unite</option>
                            {% for unite in inlineUnites %}
                                <option value="{{ unite.id }}">{{ unite.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="quickCreateTarifId">Tarif</label>
                        <select class="form-control article-quick-input" id="quickCreateTarifId" name="tarifId">
                            <option value="">Selectionner un tarif</option>
                            {% for tarif in inlineTarifs %}
                                <option value="{{ tarif.id }}">{{ tarif.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="quickCreateModeGestion">Mode de gestion</label>
                        <select class="form-control article-quick-input" id="quickCreateModeGestion" name="modeGestion">
                            {% for modeGestion in inlineModeGestions %}
                                <option value="{{ modeGestion.value }}">{{ modeGestion.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="quickCreateModeSuivi">Mode de suivi</label>
                        <select class="form-control article-quick-input" id="quickCreateModeSuivi" name="modeSuivi">
                            {% for modeSuivi in inlineModeSuivis %}
                                <option value="{{ modeSuivi.value }}">{{ modeSuivi.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="quickCreateNatureProductionId">Nature de production</label>
                        <select class="form-control article-quick-input" id="quickCreateNatureProductionId" name="natureProductionId">
                            <option value="">Selectionner une nature de production</option>
                            {% for natureProduction in inlineNatureProductions %}
                                <option value="{{ natureProduction.id }}">{{ natureProduction.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="quickCreateFournisseurHabituelId">Fournisseur habituel</label>
                        <select class="form-control article-quick-input" id="quickCreateFournisseurHabituelId" name="fournisseurHabituelId">
                            <option value="">Selectionner un fournisseur</option>
                            {% for fournisseur in inlineFournisseurs %}
                                <option value="{{ fournisseur.id }}">{{ fournisseur.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="d-block mb-2">Sortie de stock</label>
                        <div class="article-quick-radio-group">
                            {% for sortiStock in inlineSortiStocks %}
                                <div class="article-quick-radio-item">
                                    <label for="quickCreateSortiStock_{{ loop.index }}">
                                        <input
                                            type="radio"
                                            id="quickCreateSortiStock_{{ loop.index }}"
                                            name="sortiStock"
                                            value="{{ sortiStock.value }}"
                                            {% if loop.first %}checked{% endif %}
                                        >
                                        <span>{{ sortiStock.label }}</span>
                                    </label>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="form-group mb-0">
                        <div class="article-quick-image-head">
                            <label for="quickCreateImageFile" class="article-quick-image-title mb-0">Image de l'article</label>
                            <span class="article-quick-image-meta">Optionnel</span>
                        </div>
                        <div class="article-quick-image-grid">
                            <div class="article-quick-image-preview" id="quickCreateImagePreview">
                                <div class="article-quick-image-placeholder">
                                    <i class="fas fa-image"></i>
                                    <span>Apercu</span>
                                </div>
                            </div>
                            <div class="article-quick-image-controls">
                                <div class="article-quick-image-trigger-wrap">
                                    <button type="button" class="article-quick-image-trigger" id="quickCreateImageButton">
                                        <i class="fas fa-upload mr-2"></i>Ajouter une image
                                    </button>
                                    <input type="file" id="quickCreateImageFile" name="imageFile" class="article-quick-image-input" accept="image/*">
                                </div>
                                <div class="article-quick-image-filename" id="quickCreateImageFileName">Aucun fichier selectionne</div>
                                <div class="article-quick-image-help">PNG, JPG, WebP. Max 2 Mo.</div>
                            </div>
                        </div>
                    </div>

