        function syncArticleDetailImagePreview(file) {
            if (!file) {
                var currentImageUrl = getArticleImageUrl(articleDetailState.$row);
                renderArticleDetailImagePreview(currentImageUrl);
                renderArticleDetailViewImagePreview(currentImageUrl);
                return true;
            }

            var validationMessage = validateArticleImageFile(file);
            if (validationMessage) {
                showToast('error', validationMessage);
                return false;
            }

            var reader = new FileReader();
            reader.onload = function(event) {
                var imageData = event && event.target && event.target.result ? String(event.target.result) : '';
                renderArticleDetailImagePreview(imageData);
                renderArticleDetailViewImagePreview(imageData);
            };
            reader.onerror = function() {
                showToast('error', 'La previsualisation de l image a echoue.');
                var fallbackImageUrl = getArticleImageUrl(articleDetailState.$row);
                renderArticleDetailImagePreview(fallbackImageUrl);
                renderArticleDetailViewImagePreview(fallbackImageUrl);
            };
            reader.readAsDataURL(file);
            return true;
        }

