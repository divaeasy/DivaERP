        function buildSelectOptions($select, options, selectedValue, emptyLabel) {
            if (!$select || !$select.length) {
                return;
            }

            var normalizedSelected = String(selectedValue || '');
            var html = '<option value="">' + escapeHtml(emptyLabel || 'Aucun') + '</option>';

            options.forEach(function(option) {
                var optionValue = String(option.id || option.value || '');
                var optionLabel = String(option.label || optionValue || '').trim();
                if (optionValue === '' && optionLabel === '') {
                    return;
                }

                html += '<option value="' + escapeHtml(optionValue) + '"' +
                    (optionValue === normalizedSelected ? ' selected' : '') +
                    '>' + escapeHtml(optionLabel) + '</option>';
            });

            $select.html(html).val(normalizedSelected);
        }

