{% extends 'template_oukatech.html.twig' %}


{% block body %}
<style>
.sortable-header {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    white-space: nowrap;
    user-select: none;
}

.sortable-header:hover {
    color: #c2c2c2;
}

.sort-icon {
    margin-left: 8px;
    font-size: 0.85em;
}

.sort-icon.inactive {
    opacity: 0.3;
}
</style>

<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Articles</h1>
    </div>
</div>

<div class="action-bar">
    <a class="btn-add" href="{{ path('article.edit') }}">
        <i class="fas fa-plus"></i> Nouvel Article
    </a>
    <div class="search-box">
        {% include "components/search_data.html.twig" with {search: search} only %}
    </div>
</div>

<div class="table-container">
    {% if articles|length > 0 %}
    <table class="table">
        <thead>
            <tr>
                <th>
                    <a href="{{ path('article.list', {sort: 'id', direction: sort == 'id' and direction == 'ASC' ? 'DESC' : 'ASC'}) }}" class="sortable-header">
                        ID
                        <i class="fas fa-arrow-up sort-icon {% if not (sort == 'id' and direction == 'ASC') %}inactive{% endif %}"></i>
                    </a>
                </th>
                <th>
                    <a href="{{ path('article.list', {sort: 'libelle', direction: sort == 'libelle' and direction == 'ASC' ? 'DESC' : 'ASC'}) }}" class="sortable-header">
                        Désignation
                        <i class="fas fa-arrow-up sort-icon {% if not (sort == 'libelle' and direction == 'ASC') %}inactive{% endif %}"></i>
                    </a>
                </th>
                <th>Unité</th>
                <th>Tarif</th>
                <th class="text-center" style="width: 150px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for article in articles %}
            <tr>
                <td><strong>#{{ article.id }}</strong></td>
                <td>{{ article.libelle }}</td>
                <td>{{ article.unite }}</td>
                <td>{{ article.tarif }}</td>
                <td class="text-center">
                    <a href="{{ path('article.detail', {id: article.id}) }}" class="btn btn-action btn-view" title="Voir">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a href="{{ path('article.edit', {id: article.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn" 
                            data-delete-url="{{ path('article.delete', {id: article.id}) }}"
                            data-item-name="{{ article.libelle }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-boxes"></i>
        </div>
        <h5>Aucun article trouvé</h5>
        <p>Commencez par ajouter votre premier article au catalogue.</p>
        <a href="{{ path('article.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouvel article
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
