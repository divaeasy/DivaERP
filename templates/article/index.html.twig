        function validateArticleImageFile(file) {
            if (!file) {
                return 'Aucun fichier selectionne';
            }

            var allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];
            if (allowedTypes.indexOf(String(file.type || '')) === -1) {
                return 'Seuls les fichiers PNG, JPG et WebP sont acceptés';
            }

            if ((Number(file.size) || 0) > 2 * 1024 * 1024) {
                return 'Le fichier dépasse 2 Mo';
            }

            return '';
        }

        function getDefaultColumnPreferences() {
            var preferences = {};
            var maxOptionalVisible = Math.max(0, MAX_VISIBLE_ARTICLE_COLUMNS - (mandatoryColumnKeys.length + 1));

            optionalColumnKeys.forEach(function(columnKey, index) {
                preferences[columnKey] = index < maxOptionalVisible;
            });

            return preferences;
        }

        function getVisibleOptionalColumnCount(preferences) {
            var source = preferences || articleColumnPreferences;
            return optionalColumnKeys.reduce(function(total, columnKey) {
                return total + (source[columnKey] !== false ? 1 : 0);
            }, 0);
        }

        function getVisibleColumnCount(preferences) {
            return mandatoryColumnKeys.length + 1 + getVisibleOptionalColumnCount(preferences);
        }

        function enforceColumnVisibilityLimit(preferences) {
            var normalized = $.extend({}, preferences);
            var maxVisible = Math.max(0, MAX_VISIBLE_ARTICLE_COLUMNS - (mandatoryColumnKeys.length + 1));
            var visibleCount = 0;

            optionalColumnKeys.forEach(function(columnKey) {
                var shouldShow = normalized[columnKey] !== false;
                if (!shouldShow) {
                    normalized[columnKey] = false;
                    return;
                }

                if (visibleCount >= maxVisible) {
                    normalized[columnKey] = false;
                    return;
                }

                visibleCount += 1;
                normalized[columnKey] = true;
            });

            return normalized;
        }

        function normalizeColumnPreferences(rawPreferences) {
            var defaults = getDefaultColumnPreferences();
            var normalized = $.extend({}, defaults);

            if (!rawPreferences || typeof rawPreferences !== 'object') {
                return normalized;
            }

            optionalColumnKeys.forEach(function(columnKey) {
                if (Object.prototype.hasOwnProperty.call(rawPreferences, columnKey)) {
                    normalized[columnKey] = rawPreferences[columnKey] !== false;
                }
            });

            return enforceColumnVisibilityLimit(normalized);
        }

        function loadColumnPreferences() {
            try {
                var storedValue = window.localStorage ? window.localStorage.getItem(articleColumnStorageKey) : null;
                if (!storedValue) {
                    return getDefaultColumnPreferences();
                }

                return normalizeColumnPreferences(JSON.parse(storedValue));
            } catch (error) {
                return getDefaultColumnPreferences();
            }
        }

        function saveColumnPreferences() {
            try {
                if (window.localStorage) {
                    window.localStorage.setItem(articleColumnStorageKey, JSON.stringify(articleColumnPreferences));
                }
            } catch (error) {
            }
        }

        function updateColumnSettingsInputs() {
            var visibleCount = getVisibleColumnCount();
            var isAtLimit = visibleCount >= MAX_VISIBLE_ARTICLE_COLUMNS;

            optionalColumnKeys.forEach(function(columnKey) {
                var isChecked = articleColumnPreferences[columnKey] !== false;
                var shouldDisable = isAtLimit && !isChecked;
                var $input = $('[data-column-toggle="' + columnKey + '"]');

                $input.prop('checked', isChecked);
                $input.prop('disabled', shouldDisable);
                $input.closest('.article-column-settings__item').toggleClass('is-disabled', shouldDisable);
            });

            if ($articleColumnSettingsHint.length) {
                $articleColumnSettingsHint
                    .toggleClass('is-warning', isAtLimit)
                    .text('Colonnes visibles: ' + visibleCount + '/' + MAX_VISIBLE_ARTICLE_COLUMNS + (isAtLimit ? ' (masquez une colonne optionnelle pour en afficher une autre)' : ''));
            }
        }

        function setColumnVisibility(columnKey, isVisible) {
            $articlesTable.find('[data-column-key="' + columnKey + '"]').toggle(!!isVisible);
        }

        function applyColumnPreferences() {
            optionalColumnKeys.forEach(function(columnKey) {
                setColumnVisibility(columnKey, articleColumnPreferences[columnKey] !== false);
            });
            updateColumnSettingsInputs();
        }

        function toggleColumnPreference(columnKey, isVisible) {
            if (mandatoryColumnKeys.indexOf(columnKey) !== -1) {
                return;
            }

            if (isVisible && articleColumnPreferences[columnKey] !== true) {
                var projectedVisibleCount = getVisibleColumnCount() + 1;
                if (projectedVisibleCount > MAX_VISIBLE_ARTICLE_COLUMNS) {
                    articleColumnPreferences[columnKey] = false;
                    updateColumnSettingsInputs();
                    showToast('warning', 'Maximum ' + MAX_VISIBLE_ARTICLE_COLUMNS + ' colonnes visibles. Masquez une colonne optionnelle avant d en afficher une nouvelle.');
                    return;
                }
            }

            articleColumnPreferences[columnKey] = !!isVisible;
            applyColumnPreferences();
            saveColumnPreferences();
        }

        function closeColumnSettingsMenu() {
            if (!$articleColumnSettings.length) {
                return;
            }

            $articleColumnSettings.removeClass('is-open');
            if ($articleColumnSettingsToggle.length) {
                $articleColumnSettingsToggle.attr('aria-expanded', 'false');
            }
        }

        function openColumnSettingsMenu() {
            if (!$articleColumnSettings.length) {
                return;
            }

            $articleColumnSettings.addClass('is-open');
            if ($articleColumnSettingsToggle.length) {
                $articleColumnSettingsToggle.attr('aria-expanded', 'true');
            }
        }

        function renderQuickCreateImagePreview(imageUrl) {
            if (!$quickCreateImagePreview.length) {
                return;
            }

            if (String(imageUrl || '').trim() === '') {
                $quickCreateImagePreview.html(
                    '<div class="article-quick-image-placeholder">' +
                        '<i class="fas fa-image"></i>' +
                        '<span>Apercu</span>' +
                    '</div>'
                );
                return;
            }

            $quickCreateImagePreview.html(
                $('<img>', {
                    src: imageUrl,
                    alt: 'Apercu de l image'
                })
            );
        }

        function resetQuickCreateImageState() {
            if ($quickCreateImageFile.length) {
                $quickCreateImageFile.val('');
            }
            if ($quickCreateImageFileName.length) {
                $quickCreateImageFileName.text('Aucun fichier selectionne');
            }
            renderQuickCreateImagePreview('');
        }

        function syncQuickCreateImagePreview(file) {
            if (!file) {
                resetQuickCreateImageState();
                return true;
            }

            var validationMessage = validateArticleImageFile(file);
            if (validationMessage) {
                resetQuickCreateImageState();
                showToast('error', validationMessage);
                return false;
            }

            if ($quickCreateImageFileName.length) {
                $quickCreateImageFileName.text(file.name);
            }

            var reader = new FileReader();
            reader.onload = function(event) {
                renderQuickCreateImagePreview(event.target.result);
            };
            reader.readAsDataURL(file);
            return true;
        }

        function uploadArticleImageForRow($row, file) {
            if (!$row || !$row.length || !$row.attr('data-upload-image-url')) {
                return;
            }

            var validationMessage = validateArticleImageFile(file);
            if (validationMessage) {
                showToast('error', validationMessage);
                return;
            }

            var formData = new FormData();
            formData.append('_token', uploadImageToken);
            formData.append('image', file);

            $row.find('.article-image-cell').addClass('is-updating');

            $.ajax({
                url: String($row.attr('data-upload-image-url') || ''),
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            }).done(function(response) {
                if (!response || response.success !== true) {
                    showToast('error', 'La mise a jour de l image a echoue.');
                    return;
                }

                if (response.article) {
                    $row.attr('data-upload-image-url', response.article.uploadImageUrl || $row.attr('data-upload-image-url'));
                    $row.attr('data-image-url', response.article.imageUrl || '');
                    renderRowImageCell($row);
                } else {
                    updateRowImageDisplay($row, response.imageUrl || '');
                }

                showToast('success', response.message || 'Image enregistrée avec succès');
            }).fail(function(xhr) {
                var message = 'Erreur de connexion';
                if (xhr.status !== 0) {
                    message = xhr.responseJSON && xhr.responseJSON.message
                        ? xhr.responseJSON.message
                        : 'La mise a jour de l image a echoue.';
                }
                showToast('error', message);
            }).always(function() {
                $row.find('.article-image-cell').removeClass('is-updating');
            });
        }

        function removeArticleImageForRow($row) {
            if (!$row || !$row.length || !$row.attr('data-upload-image-url')) {
                return;
            }

            $row.find('.article-image-cell').addClass('is-updating');

            $.ajax({
                url: String($row.attr('data-upload-image-url') || ''),
                method: 'POST',
                dataType: 'json',
                data: {
                    _token: uploadImageToken,
                    removeImage: 1
                },
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            }).done(function(response) {
                if (!response || response.success !== true) {
                    showToast('error', 'La suppression de l image a echoue.');
                    return;
                }

                $row.attr('data-image-url', '');
                renderRowImageCell($row);
                showToast('success', response.message || 'Image supprimée avec succès');
            }).fail(function(xhr) {
                var message = xhr.responseJSON && xhr.responseJSON.message
                    ? xhr.responseJSON.message
                    : 'La suppression de l image a echoue.';
                showToast('error', message);
            }).always(function() {
                $row.find('.article-image-cell').removeClass('is-updating');
            });
        }

        function refreshTableVisibility() {
            var hasRows = $articlesTableBody.find('.article-row').length > 0;
            $articlesTable.toggle(hasRows);
            $emptyState.toggle(!hasRows);
        }

        function updateBulkSelectionLabel(selectedCount) {
            var count = Number(selectedCount) || 0;
            var label = count > 1
                ? count + ' articles sélectionnés'
                : (count === 1 ? '1 article sélectionné' : 'Aucun article sélectionné');
            $('#articlesBulkActions').find('[data-selection-label]').text(label);
        }

        function removeArticleRowsByIds(ids) {
            if (!Array.isArray(ids) || !ids.length) {
                return;
            }

            ids.forEach(function(idValue) {
                var rowId = String(idValue || '').trim();
                if (rowId === '') {
                    return;
                }

                var $row = $articlesTableBody.find('.article-row[data-item-id="' + rowId + '"]');
                if ($row.length && activeEditRow && activeEditRow.length && activeEditRow.is($row)) {
                    activeEditRow = null;
                }
                $row.remove();
            });
        }

        function setBulkDeleteConfirmButtonLoading(isLoading) {
            if (!$confirmDeleteBtn.length) {
                return;
            }

            var initialHtml = String($confirmDeleteBtn.data('bulk-initial-html') || '');
            if (!initialHtml) {
                initialHtml = String($confirmDeleteBtn.html() || '');
                $confirmDeleteBtn.data('bulk-initial-html', initialHtml);
            }

            if (isLoading) {
                $confirmDeleteBtn
                    .addClass('bulk-delete-loading')
                    .html('<i class="fas fa-spinner fa-spin"></i>Suppression...');
                return;
            }

            $confirmDeleteBtn
                .removeClass('bulk-delete-loading')
                .html(initialHtml);
        }

        function resetBulkDeleteConfirmState() {
            if ($confirmDeleteBtn.length) {
                $confirmDeleteBtn.removeAttr('data-bulk-delete');
            }
            setBulkDeleteConfirmButtonLoading(false);
        }

        function openBulkDeleteConfirmation(selectedIds, manager) {
            if (!$deleteConfirmModal.length || !$confirmDeleteBtn.length || !$deleteModalItemName.length) {
                showToast('error', 'La confirmation de suppression est indisponible.');
                return;
            }

            var normalizedIds = Array.isArray(selectedIds)
                ? selectedIds.map(function(idValue) { return String(idValue || '').trim(); }).filter(function(idValue) { return idValue !== ''; })
                : [];

            if (!normalizedIds.length) {
                showToast('error', 'Selection vide.');
                return;
            }

            bulkDeletePending = {
                ids: normalizedIds,
                manager: manager || articleSelectionManager
            };

            var count = normalizedIds.length;
            var itemLabel = count > 1 ? ('ces ' + count + ' articles') : 'cet article';
            $deleteModalItemName.text(itemLabel);
            $confirmDeleteBtn.attr('href', '#').attr('data-bulk-delete', '1');
            setBulkDeleteConfirmButtonLoading(false);
            $deleteConfirmModal.modal('show');
        }

        function submitBulkDeleteSelection() {
            if (isBulkDeleteSubmitting || !bulkDeletePending || !Array.isArray(bulkDeletePending.ids) || !bulkDeletePending.ids.length) {
                return;
            }

            isBulkDeleteSubmitting = true;
            setBulkDeleteConfirmButtonLoading(true);

            var pendingSnapshot = bulkDeletePending;

            $.ajax({
                url: bulkDeleteUrl,
                method: 'POST',
                contentType: 'application/json; charset=UTF-8',
                dataType: 'json',
                data: JSON.stringify({
                    _token: bulkDeleteToken,
                    ids: pendingSnapshot.ids
                }),
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            }).done(function(response) {
                if (!response || response.success !== true) {
                    showToast('error', (response && response.message) ? response.message : 'La suppression multiple a échoué.');
                    return;
                }

                var deletedIds = Array.isArray(response.deletedIds) && response.deletedIds.length
                    ? response.deletedIds
                    : pendingSnapshot.ids;
                removeArticleRowsByIds(deletedIds);
                refreshTableVisibility();

                if (pendingSnapshot.manager && typeof pendingSnapshot.manager.syncFromDom === 'function') {
                    pendingSnapshot.manager.syncFromDom();
                } else {
                    updateSelectionUi();
                }

                $deleteConfirmModal.modal('hide');
                showToast('success', response.message || 'Suppression multiple effectuee.');
            }).fail(function(xhr) {
                var message = 'La suppression multiple a échoué.';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    message = xhr.responseJSON.message;
                }
                showToast('error', message);
            }).always(function() {
                isBulkDeleteSubmitting = false;
                setBulkDeleteConfirmButtonLoading(false);
                if (!$deleteConfirmModal.hasClass('show')) {
                    bulkDeletePending = null;
                    resetBulkDeleteConfirmState();
                }
            });
        }

        function getFieldNameFromTarget(target) {
            var $cell = $(target).closest('td[data-field]');
            return $cell.length ? String($cell.data('field') || '') : '';
        }

        function initTableSelectionManagers() {
            $('[data-table-id]').each(function() {
                var $table = $(this);
                var tableId = String($table.attr('data-table-id') || '').trim();

                if (tableId === '') {
                    return;
                }

                var managerOptions = {};

                if (tableId === 'articles') {
                    managerOptions = {
                        rowSelector: 'tbody .article-row',
                        rowCheckboxSelector: '.article-row-checkbox',
                        $bulkBar: $('#articlesBulkActions'),
                        enableRowClickSelection: false,
                        rowClickExclusionSelector: 'a, button, input, select, textarea, label, [contenteditable="true"], .inline-dropdown-menu, .inline-dropdown-trigger, .inline-dropdown-option',
                        onSelectionChange: function(state) {
                            updateBulkSelectionLabel(state.selectedCount);
                        },
                        onBulkAction: function(action, selectedIds, manager) {
                            if (action !== 'delete') {
                                return;
                            }

                            openBulkDeleteConfirmation(selectedIds, manager);
                        }
                    };
                }

                tableSelectionManagers[tableId] = new UniversalTableSelectionManager($table, managerOptions);
            });

            articleSelectionManager = tableSelectionManagers.articles || null;
        }

        function updateSelectionUi() {
            if (articleSelectionManager) {
                articleSelectionManager.syncFromDom();
            }
        }

        function closeDropdowns(exceptShell) {
            $articlesTable.find('.inline-dropdown-shell.is-open').each(function() {
                var $shell = $(this);
                if (exceptShell && $shell.is(exceptShell)) {
                    return;
                }
                $shell.removeClass('is-open');
            });
        }

        function openDropdownShell($shell) {
            if (!$shell || !$shell.length) {
                return;
            }

            closeDropdowns($shell);
            $shell.addClass('is-open');
        }

        function createDropdownOption(value, label, isActive) {
            return $('<button type="button" class="inline-dropdown-option"></button>')
                .attr('data-value', value)
                .toggleClass('is-active', !!isActive)
                .text(label);
        }

        function setDropdownValue($shell, value, label) {
            $shell.attr('data-value', value);
            $shell.find('.inline-dropdown-label').text(fallbackDisplay(label));
            $shell.find('.inline-dropdown-option').removeClass('is-active');
            $shell.find('.inline-dropdown-option').filter(function() {
                return String($(this).attr('data-value') || '') === String(value || '');
            }).first().addClass('is-active');
        }

        function buildInlineDropdown(options, selectedValue, selectedLabel, emptyLabel) {
            var $shell = $('<div class="inline-dropdown-shell"></div>').attr('data-value', String(selectedValue || ''));
            var $label = $('<span class="inline-dropdown-label"></span>').text(fallbackDisplay(selectedLabel));
            var $trigger = $('<button type="button" class="inline-dropdown-trigger" aria-label="Ouvrir la liste"><i class="fas fa-chevron-down"></i></button>');
            var $menu = $('<div class="inline-dropdown-menu"></div>');
            var normalizedSelectedValue = String(selectedValue || '');

            $menu.append(createDropdownOption('', emptyLabel, normalizedSelectedValue === ''));

            options.forEach(function(option) {
                var optionValue = String(option.id || option.value || '');
                $menu.append(
                    createDropdownOption(optionValue, option.label, optionValue === normalizedSelectedValue)
                        .attr('data-label', option.label)
                );
            });

            $shell.append($label, $trigger, $menu);
            return $shell;
        }

        function getRowSnapshot($row) {
            return {
                libelle: String($row.attr('data-libelle') || ''),
                imageUrl: String($row.attr('data-image-url') || ''),
                uniteId: String($row.attr('data-unite-id') || ''),
                uniteLabel: String($row.attr('data-unite-label') || ''),
                tarifId: String($row.attr('data-tarif-id') || ''),
                tarifLabel: String($row.attr('data-tarif-label') || ''),
                modeGestionLabel: String($row.attr('data-mode-gestion') || ''),
                modeSuiviLabel: String($row.attr('data-mode-suivi') || ''),
                natureProductionId: String($row.attr('data-nature-production-id') || ''),
                natureProductionLabel: String($row.attr('data-nature-production-label') || ''),
                sortiStockLabel: String($row.attr('data-sorti-stock') || ''),
                fournisseurHabituelId: String($row.attr('data-fournisseur-habituel-id') || ''),
                fournisseurHabituelLabel: String($row.attr('data-fournisseur-habituel-label') || '')
            };
        }

        function getEditValues($row) {
            return {
                libelle: $.trim($row.find('.inline-editable-text').text() || ''),
                uniteId: String($row.find('.inline-dropdown-shell[data-name="uniteId"]').attr('data-value') || ''),
                tarifId: String($row.find('.inline-dropdown-shell[data-name="tarifId"]').attr('data-value') || ''),
                modeGestion: String($row.find('.inline-dropdown-shell[data-name="modeGestion"]').attr('data-value') || ''),
                modeSuivi: String($row.find('.inline-dropdown-shell[data-name="modeSuivi"]').attr('data-value') || ''),
                natureProductionId: String($row.find('.inline-dropdown-shell[data-name="natureProductionId"]').attr('data-value') || ''),
                sortiStock: String($row.find('.inline-dropdown-shell[data-name="sortiStock"]').attr('data-value') || ''),
                fournisseurHabituelId: String($row.find('.inline-dropdown-shell[data-name="fournisseurHabituelId"]').attr('data-value') || '')
            };
        }

        function hasUnsavedChanges($row) {
            if (!$row || !$row.length || !$row.hasClass('is-editing')) {
                return false;
            }

            var snapshot = getRowSnapshot($row);
            var currentValues = getEditValues($row);

            return snapshot.libelle !== currentValues.libelle
                || snapshot.uniteId !== currentValues.uniteId
                || snapshot.tarifId !== currentValues.tarifId
                || snapshot.modeGestionLabel !== currentValues.modeGestion
                || snapshot.modeSuiviLabel !== currentValues.modeSuivi
                || snapshot.natureProductionId !== currentValues.natureProductionId
                || snapshot.sortiStockLabel !== currentValues.sortiStock
                || snapshot.fournisseurHabituelId !== currentValues.fournisseurHabituelId;
        }

        function restoreRowDisplay($row) {
            var snapshot = getRowSnapshot($row);
            closeDropdowns();

            $row.removeClass('is-editing is-saving is-edit-focus');
            renderRowImageCell($row);
            $row.find('td[data-field="libelle"]').html(escapeHtml(fallbackDisplay(snapshot.libelle)));
            $row.find('td[data-field="unite"]').html(escapeHtml(fallbackDisplay(snapshot.uniteLabel)));
            $row.find('td[data-field="tarif"]').html(escapeHtml(fallbackDisplay(snapshot.tarifLabel)));
            $row.find('td[data-field="modeGestion"]').html(escapeHtml(fallbackDisplay(snapshot.modeGestionLabel)));
            $row.find('td[data-field="modeSuivi"]').html(escapeHtml(fallbackDisplay(snapshot.modeSuiviLabel)));
            $row.find('td[data-field="natureProduction"]').html(escapeHtml(fallbackDisplay(snapshot.natureProductionLabel)));
            $row.find('td[data-field="sortiStock"]').html(escapeHtml(fallbackDisplay(snapshot.sortiStockLabel)));
            $row.find('td[data-field="fournisseurHabituel"]').html(escapeHtml(fallbackDisplay(snapshot.fournisseurHabituelLabel)));

            var originalActions = $row.data('originalActionsHtml');
            if (originalActions) {
                $row.find('.article-actions-cell').html(originalActions);
            }

            $row.find('.delete-btn').attr('data-item-name', snapshot.libelle || '');
            $row.find('.article-row-checkbox').attr('aria-label', 'Selectionner l\'article ' + (snapshot.libelle || ''));

            if (activeEditRow && activeEditRow.is($row)) {
                activeEditRow = null;
            }
        }

        function focusEditableField($row, fieldName) {
            if (!$row || !$row.length || !$row.hasClass('is-editing')) {
                return;
            }

            if (!fieldName || fieldName === 'libelle') {
                $row.find('.inline-editable-text').trigger('focus');
                return;
            }

            if (fieldName === 'unite' || fieldName === 'tarif' || fieldName === 'modeGestion' || fieldName === 'modeSuivi' 
                || fieldName === 'natureProduction' || fieldName === 'sortiStock' || fieldName === 'fournisseurHabituel') {
                var dropdownName = (fieldName === 'natureProduction' || fieldName === 'fournisseurHabituel' || fieldName === 'modeGestion' || fieldName === 'modeSuivi' || fieldName === 'sortiStock')
                    ? fieldName + (fieldName === 'natureProduction' || fieldName === 'fournisseurHabituel' ? 'Id' : '')
                    : fieldName + 'Id';
                var $shell = $row.find('.inline-dropdown-shell[data-name="' + dropdownName + '"]');
                if ($shell.length === 0) {
                    $shell = $row.find('.inline-dropdown-shell[data-name="' + fieldName + '"]');
                }
                openDropdownShell($shell);
                $shell.find('.inline-dropdown-trigger').trigger('focus');
                return;
            }

            if (fieldName === 'image') {
                $row.find('.article-image-edit-input').trigger('click');
            }
        }

        function focusRelativeField($row, currentField, direction) {
            var fields = ['libelle', 'unite', 'tarif', 'modeGestion', 'modeSuivi', 'natureProduction', 'sortiStock', 'fournisseurHabituel'];
            var index = fields.indexOf(currentField);
            if (index === -1) {
                focusEditableField($row, 'libelle');
                return;
            }

            var nextIndex = index + direction;
            if (nextIndex < 0) {
                nextIndex = fields.length - 1;
            }
            if (nextIndex >= fields.length) {
                nextIndex = 0;
            }
            focusEditableField($row, fields[nextIndex]);
        }

        function beginInlineEdit($row, preferredField) {
            if (!$row || !$row.length) {
                return;
            }

            if (activeEditRow && activeEditRow.length && !activeEditRow.is($row)) {
                if (hasUnsavedChanges(activeEditRow)) {
                    requestUnsavedChangesConfirmation('Des modifications non enregistrées seront perdues. Continuer ?', function() {
                        restoreRowDisplay(activeEditRow);
                        beginInlineEdit($row, preferredField);
                    });
                    return;
                }
                restoreRowDisplay(activeEditRow);
            }

            if ($row.hasClass('is-editing')) {
                focusEditableField($row, preferredField);
                return;
            }

            var snapshot = getRowSnapshot($row);
            var $actionsCell = $row.find('.article-actions-cell');
            $row.data('originalActionsHtml', $actionsCell.html());

            $row.find('td[data-field="libelle"]').html(
                $('<span class="article-inline-text inline-editable-text" contenteditable="true" spellcheck="false"></span>').text(snapshot.libelle)
            );
            $row.find('td[data-field="unite"]').html(
                buildInlineDropdown(inlineUnites, snapshot.uniteId, snapshot.uniteLabel, 'Aucune unite').attr('data-name', 'uniteId')
            );
            $row.find('td[data-field="tarif"]').html(
                buildInlineDropdown(inlineTarifs, snapshot.tarifId, snapshot.tarifLabel, 'Aucun tarif').attr('data-name', 'tarifId')
            );
            $row.find('td[data-field="modeGestion"]').html(
                buildInlineDropdown(inlineModeGestions, snapshot.modeGestionLabel, snapshot.modeGestionLabel, 'Aucun mode').attr('data-name', 'modeGestion')
            );
            $row.find('td[data-field="modeSuivi"]').html(
                buildInlineDropdown(inlineModeSuivis, snapshot.modeSuiviLabel, snapshot.modeSuiviLabel, 'Aucun mode').attr('data-name', 'modeSuivi')
            );
            $row.find('td[data-field="natureProduction"]').html(
                buildInlineDropdown(inlineNatureProductions, snapshot.natureProductionId, snapshot.natureProductionLabel, 'Aucune nature').attr('data-name', 'natureProductionId')
            );
            $row.find('td[data-field="sortiStock"]').html(
                buildInlineDropdown(inlineSortiStocks, snapshot.sortiStockLabel, snapshot.sortiStockLabel, 'Aucune sortie').attr('data-name', 'sortiStock')
            );
            $row.find('td[data-field="fournisseurHabituel"]').html(
                buildInlineDropdown(inlineFournisseurs, snapshot.fournisseurHabituelId, snapshot.fournisseurHabituelLabel, 'Aucun fournisseur').attr('data-name', 'fournisseurHabituelId')
            );

            $actionsCell.html(
                '<div class="inline-actions">' +
                    '<button type="button" class="btn btn-action btn-view article-inline-save-btn" title="Enregistrer">' +
                        '<i class="fas fa-check"></i>' +
                    '</button>' +
                    '<button type="button" class="btn btn-action btn-delete article-inline-cancel-btn" title="Annuler">' +
                        '<i class="fas fa-times"></i>' +
                    '</button>' +
                '</div>'
            );

            $row.addClass('is-editing');
            renderRowImageCell($row);
            activeEditRow = $row;
            if ($row.hasClass('is-new-unsaved')) {
                $row.addClass('is-edit-focus');
                window.setTimeout(function() {
                    $row.removeClass('is-edit-focus');
                }, 850);
            }
            focusEditableField($row, preferredField);
        }

        function applySavedState($row, article) {
            $row.attr('data-libelle', article.libelle || '');
            $row.attr('data-image-url', article.imageUrl || '');
            $row.attr('data-upload-image-url', article.uploadImageUrl || '');
            $row.attr('data-unite-id', article.uniteId || '');
            $row.attr('data-unite-label', article.uniteLabel || '');
            $row.attr('data-tarif-id', article.tarifId || '');
            $row.attr('data-tarif-label', article.tarifLabel || '');
