        function initColumnResizing() {
            $articlesTable.find('thead th').each(function(index) {
                var $th = $(this);
                if ($th.data('column-key') === 'selector' || $th.data('column-key') === 'actions') {
                    return;
                }
                
                var $rightHandle = $('<div class="article-column-resize-handle right"></div>');
                $th.append($rightHandle);
                
                $rightHandle.on('mousedown', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    var startX = e.pageX;
                    var startWidth = $th.width();
                    
                    $rightHandle.addClass('is-dragging');
                    
                    $(document).on('mousemove.colresize', function(e) {
                        var diff = e.pageX - startX;
                        var newWidth = Math.max(60, startWidth + diff);
                        $th.css('width', newWidth + 'px');
                        $articlesTable.find('tbody tr').each(function() {
                            $(this).find('td').eq(index).css('width', newWidth + 'px');
                        });
                    });
                    
                    $(document).on('mouseup.colresize', function() {
                        $(document).off('mousemove.colresize mouseup.colresize');
                        $rightHandle.removeClass('is-dragging');
                    });
                });
            });
        }

