        function renderArticleDetailReport(articleId, snapshot) {
            var completeFields = [
                snapshot.libelle,
                snapshot.uniteLabel,
                snapshot.tarifLabel,
                snapshot.modeGestionLabel,
                snapshot.modeSuiviLabel,
                snapshot.natureProductionLabel,
                snapshot.sortiStockLabel,
                snapshot.fournisseurHabituelLabel
            ];
            var optionalFields = [
                snapshot.uniteLabel,
                snapshot.tarifLabel,
                snapshot.modeGestionLabel,
                snapshot.modeSuiviLabel,
                snapshot.natureProductionLabel,
                snapshot.sortiStockLabel,
                snapshot.fournisseurHabituelLabel
            ];
            var completedCount = completeFields.filter(hasMeaningfulValue).length;
            var completionPct = completeFields.length > 0 ? Math.round((completedCount / completeFields.length) * 100) : 0;
            var optionalCount = optionalFields.filter(hasMeaningfulValue).length;
            var stockProfile = isTruthyLabel(snapshot.sortiStockLabel) ? 'Gere en stock' : 'Hors stock';

            $articleDetailViewMode.find('[data-report-field="id"]').text(fallbackDisplay(articleId ? ('#' + articleId) : ''));
            $articleDetailViewMode.find('[data-report-field="libelle"]').text(fallbackDisplay(snapshot.libelle));
            $articleDetailViewMode.find('[data-report-field="unite"]').text(fallbackDisplay(snapshot.uniteLabel));
            $articleDetailViewMode.find('[data-report-field="tarif"]').text(fallbackDisplay(snapshot.tarifLabel));
            $articleDetailViewMode.find('[data-report-field="natureProduction"]').text(fallbackDisplay(snapshot.natureProductionLabel));
            $articleDetailViewMode.find('[data-report-field="fournisseurHabituel"]').text(fallbackDisplay(snapshot.fournisseurHabituelLabel));
            $articleDetailViewMode.find('[data-report-field="modeGestion"]').text(fallbackDisplay(snapshot.modeGestionLabel));
            $articleDetailViewMode.find('[data-report-field="modeSuivi"]').text(fallbackDisplay(snapshot.modeSuiviLabel));
            $articleDetailViewMode.find('[data-report-field="sortiStock"]').text(fallbackDisplay(snapshot.sortiStockLabel));

            if ($articleDetailViewTitle.length) {
                $articleDetailViewTitle.text(hasMeaningfulValue(snapshot.libelle) ? snapshot.libelle : 'Article');
            }
            if ($articleDetailCompletionValue.length) {
                $articleDetailCompletionValue.text(completionPct + '%');
            }
            if ($articleDetailOptionalValue.length) {
                $articleDetailOptionalValue.text(optionalCount + '/7');
            }
            if ($articleDetailTrackingValue.length) {
                $articleDetailTrackingValue.text(stockProfile);
            }

            renderArticleDetailViewImagePreview(snapshot.imageUrl);
            renderArticleDetailCharts({
                completedCount: completedCount,
                totalCount: completeFields.length,
                profileValues: optionalFields.map(function(fieldValue) { return hasMeaningfulValue(fieldValue) ? 100 : 0; })
            });
