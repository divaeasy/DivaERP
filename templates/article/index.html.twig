            if (activeEditRow && activeEditRow.length && activeEditRow.hasClass('is-editing')) {
                if (!activeEditRow.is($row) && hasUnsavedChanges(activeEditRow)) {
                    requestUnsavedChangesConfirmation('Des modifications non enregistrees seront perdues. Continuer ?', function() {
                        restoreRowDisplay(activeEditRow);
                        openArticleDetailModalForRow($row);
                    });
                    return;
                }

                if (activeEditRow.is($row) && hasUnsavedChanges(activeEditRow)) {
                    requestUnsavedChangesConfirmation('Des modifications non enregistrees seront perdues. Continuer ?', function() {
                        restoreRowDisplay(activeEditRow);
                        openArticleDetailModalForRow($row);
                    });
