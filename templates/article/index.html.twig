{% extends 'template_oukatech.html.twig' %}

{% block PageTitle%}
    Gestion des Articles
{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Articles</h1>
    </div>
</div>

<div class="action-bar">
    <div class="action-buttons">
        <a class="btn-add" href="{{ path('article.edit') }}">
            <i class="fas fa-plus"></i> Nouvel Article
        </a>
        <a class="btn btn-sm btn-outline-success ml-2 no-loading" href="{{ path('export.articles') }}" title="Exporter CSV">
            <i class="fas fa-file-csv mr-1"></i> Exporter
        </a>
    </div>
    <div class="search-box">
        {% include "components/search_data.html.twig" with {search: search} only %}
    </div>
</div>

<div class="table-container">
    {% if articles|length > 0 %}
    <table class="table">
        <thead>
            <tr>
                <th data-sort-key="id" data-sort-type="number">ID</th>
                <th data-sort-key="libelle">Désignation</th>
                <th data-sort-key="unite">Unité</th>
                <th data-sort-key="tarif">Tarif</th>
                <th class="text-center" style="width: 150px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for article in articles %}
            <tr>
                <td><strong>#{{ article.id }}</strong></td>
                <td>{{ article.libelle|default('____') }}</td>
                <td>{{ article.unite|default('____') }}</td>
                <td>{{ article.tarif|default('____') }}</td>
                <td class="text-center">
                    <a href="{{ path('article.detail', {id: article.id}) }}" class="btn btn-action btn-view" title="Voir">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a href="{{ path('article.edit', {id: article.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn" 
                            data-delete-url="{{ path('article.delete', {id: article.id}) }}"
                            data-item-name="{{ article.libelle }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% include "components/_pagination.html.twig" with {currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, route: 'article.list', routeParams: {}} %}
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-boxes"></i>
        </div>
        <h5>Aucun article trouvé</h5>
        <p>Commencez par ajouter votre premier article au catalogue.</p>
        <a href="{{ path('article.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouvel article
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
