                var natureProductionId = String($quickCreateNatureProductionId.val() || '');
                var fournisseurHabituelId = String($quickCreateFournisseurHabituelId.val() || '');
                var sortiStock = String($quickCreateForm.find('input[name="sortiStock"]:checked').val() || '');

                if (libelle === '') {
                    showToast('error', 'La designation est obligatoire.');
                    $quickCreateLibelle.trigger('focus');
                    return;
                }

                if (uniteId === '') {
                    showToast('error', 'L unite est obligatoire.');
                    $quickCreateUniteId.trigger('focus');
                    return;
                }

                var imageFile = $quickCreateImageFile.length && $quickCreateImageFile[0].files && $quickCreateImageFile[0].files[0]
                    ? $quickCreateImageFile[0].files[0]
                    : null;

                if (imageFile && !syncQuickCreateImagePreview(imageFile)) {
                    return;
                }

                $quickCreateSubmit.prop('disabled', true);
                var formData = new FormData();
                formData.append('_token', token);
                formData.append('libelle', libelle);
                formData.append('uniteId', uniteId);
                formData.append('tarifId', tarifId);
                formData.append('modeGestion', modeGestion);
                formData.append('modeSuivi', modeSuivi);
                formData.append('natureProductionId', natureProductionId);
                formData.append('fournisseurHabituelId', fournisseurHabituelId);
                formData.append('sortiStock', sortiStock);
                if (imageFile) {
                    formData.append('imageFile', imageFile);
                }

                $.ajax({
                    url: createMinimalUrl,
                    method: 'POST',
                    dataType: 'json',
                    data: formData,
                    processData: false,
                    contentType: false,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                }).done(function(response) {
                    if (!response || response.success !== true || !response.article) {
                        $quickCreateSubmit.prop('disabled', false);
                        if (window.hideLoading) {
                            window.hideLoading();
                        }
                        showToast('error', 'La création rapide a échoué.');
                        return;
                    }

                    var $newRow = appendCreatedRow(response.article);
                    $quickCreateModal.one('hidden.bs.modal', function() {
                        scrollRowIntoView($newRow);
                        beginInlineEdit($newRow, 'tarif');
                    });
                    $quickCreateModal.modal('hide');
                    showToast('success', response.message || 'Article créé avec succès.');
                }).fail(function(xhr) {
                    var message = 'La création rapide a échoué.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        message = xhr.responseJSON.message;
                    }

                    $quickCreateSubmit.prop('disabled', false);
                    if (window.hideLoading) {
                        window.hideLoading();
                    }
                    showToast('error', message);
                });
            });
        }

        if ($articleExportLink.length) {
            $articleExportLink.on('click', function(event) {
                event.preventDefault();

                if (window.hideLoading) {
                    window.hideLoading(true);
                }
                if (window.suppressLoadingOverlay) {
                    window.suppressLoadingOverlay(15000);
                }

                var frameId = 'articleExportDownloadFrame';
                var iframe = document.getElementById(frameId);
                if (!iframe) {
                    iframe = document.createElement('iframe');
                    iframe.id = frameId;
                    iframe.style.display = 'none';
                    document.body.appendChild(iframe);
                }

                var separator = this.href.indexOf('?') === -1 ? '?' : '&';
                iframe.src = this.href + separator + '_download=' + Date.now();

                window.setTimeout(function() {
                    if (window.hideLoading) {
                        window.hideLoading(true);
                    }
                }, 200);

                window.setTimeout(function() {
                    if (window.hideLoading) {
                        window.hideLoading(true);
                    }
                }, 1500);
            });
        }

        refreshTableVisibility();
        updateSelectionUi();
    });
</script>
{% endblock %}
