        function saveInlineEdit($row) {
            if (!$row || !$row.length || !$row.hasClass('is-editing') || $row.hasClass('is-saving')) {
                return;
            }

            var values = getEditValues($row);
            if (values.libelle === '') {
                showToast('error', 'La designation est obligatoire.');
                $row.find('.inline-editable-text').trigger('focus');
                return;
            }

            $row.addClass('is-saving');

            $.ajax({
                url: $row.data('inlineUpdateUrl'),
                method: 'POST',
                dataType: 'json',
                data: {
                    _token: inlineUpdateToken,
                    libelle: values.libelle,
                    uniteId: values.uniteId,
                    tarifId: values.tarifId,
                    modeGestion: values.modeGestion,
                    modeSuivi: values.modeSuivi,
                    natureProductionId: values.natureProductionId,
                    sortiStock: values.sortiStock,
                    fournisseurHabituelId: values.fournisseurHabituelId
                },
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            }).done(function(response) {
                if (!response || response.success !== true || !response.article) {
                    $row.removeClass('is-saving');
                    showToast('error', 'La mise à jour a échoué.');
                    return;
                }

                applySavedState($row, response.article);
                showToast('success', response.message || 'Article mis a jour avec succes.');
            }).fail(function(xhr) {
                var message = 'La mise à jour a échoué.';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    message = xhr.responseJSON.message;
                }

                $row.removeClass('is-saving');
                showToast('error', message);
            });
        }

        function cancelInlineEdit($row) {
            if (!$row || !$row.length || !$row.hasClass('is-editing')) {
                return;
            }

            if (hasUnsavedChanges($row)) {
                requestUnsavedChangesConfirmation('Annuler les modifications de cette ligne ?', function() {
                    restoreRowDisplay($row);
                });
                return;
            }

            restoreRowDisplay($row);
        }

