{% extends 'template_oukatech.html.twig' %}

{% block title %}Articles{% endblock %}

{% block body %}
{% include "components/search_data.html.twig" with {search: search} only %}
<br/>
<div class="input-group"  >

<a class="btn btn-primary" href="{{path('article.edit')}}" role="button">Ajouter</a>
<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p>

  

</div>

<br/>
<div class="row">

  <table class="table table-striped">
    <thead class="thead-light">
      <tr>
        <th scope="col">Id</th>
        <th scope="col">Deseignation</th>
        <th scope="col">Unité</th>
        <th scope="col">Tarif</th>          
        
  
      </tr>
    </thead>
    <tbody>
      {% for article in articles %}
      <tr>
        <th scope="row"><a href="{{ path('article.edit',{id: article.id}) }}" >{{article.id}}</a></th>
        <th scope="row">{{article.libelle}}</th>
        <td>{{article.unite}}</td>
        <td>{{article.tarif}}</td>    
        
        {%if is_granted('ROLE_ADMIN')%}
        <td><a href="{{ path('article.edit',{id: article.id}) }}" ><i class="fa-solid fa-user-pen"></i></a></td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>

</div>
{% endblock %}
