{% extends 'template_oukatech.html.twig' %}


{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('article.list') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Détails de l'Article</h1>
    </div>
    <div class="page-actions">
        <a href="{{ path('article.edit', {id: article.id}) }}" class="btn btn-primary">
            <i class="fas fa-edit mr-2"></i>Modifier
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="form-card">
            <div class="card-header-custom">
                <h5><i class="fas fa-box mr-2"></i>Informations Générales</h5>
            </div>
            
            <div class="detail-grid">
                <div class="detail-row">
                    <div class="detail-label">ID</div>
                    <div class="detail-value"><strong>#{{ article.id }}</strong></div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Désignation</div>
                    <div class="detail-value">{{ article.libelle }}</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Dossier</div>
                    <div class="detail-value">
                        {% if article.dossier %}
                            <span class="badge badge-primary">{{ article.dossier }}</span>
                        {% else %}
                            <span class="text-muted">Non défini</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="form-card">
            <div class="card-header-custom">
                <h5><i class="fas fa-tags mr-2"></i>Informations Commerciales</h5>
            </div>
            
            <div class="detail-grid">
                <div class="detail-row">
                    <div class="detail-label">Unité</div>
                    <div class="detail-value">
                        {% if article.unite %}
                            {{ article.unite }}
                        {% else %}
                            <span class="text-muted">Non définie</span>
                        {% endif %}
                    </div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Tarif</div>
                    <div class="detail-value">
                        {% if article.tarif %}
                            <span class="badge badge-primary">{{ article.tarif }}</span>
                        {% else %}
                            <span class="text-muted">Non défini</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {% if article.createdAt or article.createdBy %}
        <div class="form-card">
            <div class="card-header-custom">
                <h5><i class="fas fa-history mr-2"></i>Historique</h5>
            </div>
            
            <div class="detail-grid">
                {% if article.createdAt %}
                <div class="detail-row">
                    <div class="detail-label">Créé le</div>
                    <div class="detail-value">{{ article.createdAt|date('d/m/Y H:i') }}</div>
                </div>
                {% endif %}
                {% if article.createdBy %}
                <div class="detail-row">
                    <div class="detail-label">Créé par</div>
                    <div class="detail-value">{{ article.createdBy }}</div>
                </div>
                {% endif %}
                {% if article.updatedAt %}
                <div class="detail-row">
                    <div class="detail-label">Modifié le</div>
                    <div class="detail-value">{{ article.updatedAt|date('d/m/Y H:i') }}</div>
                </div>
                {% endif %}
            </div>
        </div>
        {% endif %}
    </div>
</div>

<style>
.detail-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
}
.detail-row {
    display: flex;
    padding: 8px 0;
    border-bottom: 1px solid #f0f0f0;
}
.detail-row:last-child {
    border-bottom: none;
}
.detail-label {
    flex: 0 0 140px;
    font-weight: 600;
    color: #6c757d;
    font-size: 13px;
}
.detail-value {
    flex: 1;
    color: #333;
}
.page-actions {
    display: flex;
    gap: 10px;
}
</style>
{% endblock %}
