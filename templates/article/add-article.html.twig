{% extends "template_oukatech.html.twig" %}
{% block PageTitle %}Article{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('article.list') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
        <h1 class="h3 mb-0 text-gray-800">{{ id > 0 ? 'Modifier l\'article' : 'Nouvel article' }}</h1>
    </div>
</div>

<div class="form-card">
    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

    <div class="card-header-custom">
        <h5><i class="fas fa-box mr-2"></i>Informations de l'article</h5>
    </div>

    {% include 'article/_form_fields.html.twig' with {form: form} only %}

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save mr-2"></i>{{ id > 0 ? 'Mettre a jour' : 'Enregistrer' }}
        </button>
        <a href="{{ path('article.list') }}" class="btn btn-secondary">
            <i class="fas fa-times mr-2"></i>Annuler
        </a>
    </div>

    {{ form_rest(form) }}
    {{ form_end(form) }}
</div>

<p class="text-muted small mt-3">
    <i class="fas fa-info-circle mr-1"></i>
    Les champs marques d'un <span class="text-danger">*</span> sont obligatoires.
</p>
{% endblock %}

{% block javascripts %}
<script>
    $(document).ready(function() {
        $('.js-example-basic-single').select2({
            theme: 'bootstrap-5',
            allowClear: true
        });
    });
</script>
{% endblock %}
