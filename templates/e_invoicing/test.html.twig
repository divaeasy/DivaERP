{% extends 'template_oukatech.html.twig' %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('entetepiece.list') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div>
            <h1 class="h3 mb-0 text-gray-800">Facturation Électronique</h1>
            <small class="text-muted">{{ invoice.pieceref }} — {{ invoice.client.nom ?? 'Client non défini' }}</small>
        </div>
    </div>
</div>

<style>
    /* ===== E-INVOICING PAGE ===== */
    .einv-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }
    .einv-stat {
        background: #fff;
        border-radius: 10px;
        padding: 18px 20px;
        box-shadow: 0 1px 8px rgba(58,59,69,0.08);
        border-left: 4px solid #e3e6f0;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .einv-stat:hover { transform: translateY(-2px); box-shadow: 0 4px 16px rgba(58,59,69,0.12); }
    .einv-stat.stat-ref { border-left-color: #4e73df; }
    .einv-stat.stat-amount { border-left-color: #1cc88a; }
    .einv-stat.stat-date { border-left-color: #f6c23e; }
    .einv-stat.stat-status { border-left-color: #36b9cc; }
    .einv-stat-label {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #858796;
        margin-bottom: 4px;
    }
    .einv-stat-value {
        font-size: 17px;
        font-weight: 700;
        color: #3a3b45;
    }

    /* Workflow Steps */
    .einv-workflow {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(58,59,69,0.08);
        overflow: hidden;
        margin-bottom: 24px;
    }
    .einv-workflow-header {
        padding: 18px 24px;
        border-bottom: 1px solid #e3e6f0;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .einv-workflow-header i { color: #4e73df; font-size: 18px; }
    .einv-workflow-header h6 { margin: 0; font-weight: 700; color: #3a3b45; font-size: 15px; }
    .einv-workflow-body { padding: 24px; }

    .einv-steps {
        display: flex;
        flex-direction: column;
        gap: 0;
    }
    .einv-step {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 20px 0;
        border-bottom: 1px solid #f0f0f5;
        position: relative;
    }
    .einv-step:last-child { border-bottom: none; }

    .einv-step-indicator {
        flex-shrink: 0;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 700;
        transition: all 0.2s ease;
    }
    .einv-step.step-pending .einv-step-indicator {
        background: #f8f9fc;
        border: 2px solid #d1d3e2;
        color: #858796;
    }
    .einv-step.step-active .einv-step-indicator {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        border: 2px solid #4e73df;
        color: #fff;
        box-shadow: 0 3px 10px rgba(78,115,223,0.35);
    }
    .einv-step.step-done .einv-step-indicator {
        background: linear-gradient(135deg, #1cc88a 0%, #17a673 100%);
        border: 2px solid #1cc88a;
        color: #fff;
    }
    .einv-step.step-error .einv-step-indicator {
        background: linear-gradient(135deg, #e74a3b 0%, #c0392b 100%);
        border: 2px solid #e74a3b;
        color: #fff;
    }

    .einv-step-content { flex: 1; min-width: 0; }
    .einv-step-title {
        font-weight: 700;
        font-size: 14px;
        color: #3a3b45;
        margin-bottom: 4px;
    }
    .einv-step.step-pending .einv-step-title { color: #a0a3b1; }
    .einv-step-desc {
        font-size: 13px;
        color: #858796;
        margin-bottom: 10px;
        line-height: 1.5;
    }
    .einv-step-action { display: inline-flex; align-items: center; }

    .btn-einv {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 20px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .btn-einv:hover { text-decoration: none; transform: translateY(-1px); }
    .btn-einv-primary {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        color: #fff;
        box-shadow: 0 3px 10px rgba(78,115,223,0.3);
    }
    .btn-einv-primary:hover { color: #fff; box-shadow: 0 5px 16px rgba(78,115,223,0.4); }
    .btn-einv-success {
        background: linear-gradient(135deg, #1cc88a 0%, #17a673 100%);
        color: #fff;
        box-shadow: 0 3px 10px rgba(28,200,138,0.3);
    }
    .btn-einv-success:hover { color: #fff; box-shadow: 0 5px 16px rgba(28,200,138,0.4); }
    .btn-einv-outline {
        background: #fff;
        color: #4e73df;
        border: 1.5px solid #d1d3e2;
    }
    .btn-einv-outline:hover { color: #4e73df; border-color: #4e73df; background: #f8f9fc; }
    .btn-einv-sm { padding: 6px 14px; font-size: 12px; }
    .btn-einv:disabled, .btn-einv.disabled {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
    }

    /* Download area */
    .einv-downloads {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 10px;
    }
    .einv-download-card {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f8f9fc;
        border: 1px solid #e3e6f0;
        border-radius: 8px;
        padding: 10px 16px;
        text-decoration: none;
        color: #3a3b45;
        transition: all 0.15s ease;
        flex: 1;
        min-width: 160px;
    }
    .einv-download-card:hover {
        text-decoration: none;
        color: #3a3b45;
        border-color: #4e73df;
        background: #eef1fb;
        transform: translateY(-1px);
    }
    .einv-download-card.disabled {
        opacity: 0.55;
        cursor: not-allowed;
        pointer-events: none;
        background: #f6f7fb;
    }
    .einv-download-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }
    .einv-download-icon.icon-pdf { background: #fce4ec; color: #e74a3b; }
    .einv-download-icon.icon-xml { background: #e3f2fd; color: #2196f3; }
    .einv-download-label { font-size: 13px; font-weight: 600; }
    .einv-download-meta { font-size: 11px; color: #858796; }

    /* Status badge */
    .einv-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }
    .einv-badge-success { background: #e8f8f0; color: #1cc88a; }
    .einv-badge-warning { background: #fff8e1; color: #d4a100; }
    .einv-badge-error { background: #fce4ec; color: #e74a3b; }
    .einv-badge-info { background: #e3f2fd; color: #36b9cc; }
    .einv-badge-muted { background: #f0f0f5; color: #858796; }

    /* Side panel */
    .einv-panel {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(58,59,69,0.08);
        overflow: hidden;
        margin-bottom: 20px;
    }
    .einv-panel-header {
        padding: 16px 20px;
        border-bottom: 1px solid #e3e6f0;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .einv-panel-header i { font-size: 16px; }
    .einv-panel-header h6 { margin: 0; font-weight: 700; font-size: 14px; color: #3a3b45; }
    .einv-panel-body { padding: 20px; }

    .einv-info-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding: 8px 0;
        border-bottom: 1px dashed #f0f0f5;
        font-size: 13px;
    }
    .einv-info-row:last-child { border-bottom: none; }
    .einv-info-label { color: #858796; font-weight: 500; }
    .einv-info-value { color: #3a3b45; font-weight: 600; text-align: right; max-width: 60%; word-break: break-all; }

    /* History timeline */
    .einv-timeline { list-style: none; padding: 0; margin: 0; }
    .einv-timeline-item {
        display: flex;
        gap: 14px;
        padding: 12px 0;
        position: relative;
    }
    .einv-timeline-item:not(:last-child)::after {
        content: '';
        position: absolute;
        left: 15px;
        top: 40px;
        bottom: 0;
        width: 2px;
        background: #e3e6f0;
    }
    .einv-timeline-dot {
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        background: #f0f0f5;
        color: #858796;
        border: 2px solid #e3e6f0;
        z-index: 1;
    }
    .einv-timeline-dot.dot-success { background: #e8f8f0; color: #1cc88a; border-color: #c3ecd9; }
    .einv-timeline-dot.dot-error { background: #fce4ec; color: #e74a3b; border-color: #f5c6cb; }
    .einv-timeline-dot.dot-info { background: #e3f2fd; color: #36b9cc; border-color: #bee5eb; }
    .einv-timeline-content { flex: 1; }
    .einv-timeline-title { font-size: 13px; font-weight: 600; color: #3a3b45; }
    .einv-timeline-time { font-size: 11px; color: #a0a3b1; margin-top: 2px; }

    /* Responsive */
    @media (max-width: 768px) {
        .einv-summary { grid-template-columns: repeat(2, 1fr); }
        .einv-downloads { flex-direction: column; }
    }
    @media (max-width: 480px) {
        .einv-summary { grid-template-columns: 1fr; }
    }

    /* Sticky Workflow */
    .einv-workflow--sticky {
        position: sticky;
        top: 90px;
        align-self: flex-start;
    }

    /* Responsive - Sticky adjustments */
    @media (max-width: 991.98px) {
        .einv-workflow--sticky {
            position: static;
            top: auto;
            align-self: auto;
        }
    }
</style>

{% set computed_total = 0 %}
{% set computed_remise_weighted = 0 %}
{% set computed_remise_base = 0 %}
{% for line in invoice.lignepieces %}
    {% set line_qte = line.qte ?? 0 %}
    {% set line_pub = line.pub ?? 0 %}
    {% set line_remise = line.remise ?? 0 %}
    {% set line_total = line_qte * line_pub %}
    {% set computed_total = computed_total + (line_total * (1 - line_remise / 100)) %}
    {% set computed_remise_weighted = computed_remise_weighted + (line_total * line_remise) %}
    {% set computed_remise_base = computed_remise_base + line_total %}
{% endfor %}
{% set has_lines = invoice.lignepieces|length > 0 %}
{% set invoice_total = has_lines ? computed_total : ((invoice.montant is not null and invoice.montant > 0) ? invoice.montant : computed_total) %}
{% set invoice_remise = computed_remise_base > 0 ? (computed_remise_weighted / computed_remise_base) : (invoice.remise ?? 0) %}
{% set invoice_tax_rate = invoice.taxRate is not null ? invoice.taxRate : (invoice.remise ?? 0) %}
{% set invoice_taxable = invoice.taxableAmount is not null ? invoice.taxableAmount : invoice_total %}
{% set invoice_tax_amount = invoice.taxAmount is not null ? invoice.taxAmount : (invoice_taxable * (invoice_tax_rate / 100)) %}

<!-- Summary Cards -->
<div class="einv-summary mt-3">
    <div class="einv-stat stat-ref">
        <div class="einv-stat-label">Référence</div>
        <div class="einv-stat-value">{{ invoice.pieceref }}</div>
    </div>
    <div class="einv-stat stat-amount">
        <div class="einv-stat-label">Montant</div>
        <div class="einv-stat-value">{{ invoice_total|number_format(2, ',', ' ') }} {{ invoice.devise.code ?? 'EUR' }}</div>
    </div>
    <div class="einv-stat stat-date">
        <div class="einv-stat-label">Date</div>
        <div class="einv-stat-value">{{ invoice.datep ? invoice.datep|date('d/m/Y') : '—' }}</div>
    </div>
    <div class="einv-stat stat-status">
        <div class="einv-stat-label">Statut e-Facture</div>
        <div class="einv-stat-value">
            {% if invoice.isSubmittedToTiime %}
                <span class="einv-badge einv-badge-success"><i class="fas fa-check-circle"></i> Transmise</span>
            {% elseif invoice.isFactureX %}
                <span class="einv-badge einv-badge-info"><i class="fas fa-file-alt"></i> Générée</span>
            {% else %}
                <span class="einv-badge einv-badge-warning"><i class="fas fa-clock"></i> En attente</span>
            {% endif %}
        </div>
    </div>
</div>

<div class="row">
    <!-- Main Content -->
    <div class="col-lg-8">

        <!-- Workflow Steps -->
        <div class="einv-workflow einv-workflow--sticky">
            <div class="einv-workflow-header">
                <i class="fas fa-route"></i>
                <h6>Processus de Facturation Électronique</h6>
            </div>
            <div class="einv-workflow-body">
                <div class="einv-steps">

                    {# === STEP 1: Generate Facture-X === #}
                    {% set step1_done = classic_generated or modern_generated %}
                    <div class="einv-step {{ step1_done ? 'step-done' : 'step-active' }}">
                        <div class="einv-step-indicator">
                            {% if step1_done %}
                                <i class="fas fa-check"></i>
                            {% else %}
                                1
                            {% endif %}
                        </div>
                        <div class="einv-step-content">
                            <div class="einv-step-title">Generer la Facture-X</div>
                            <div class="einv-step-desc">
                                {% if classic_generated and modern_generated %}
                                    Les 2 modeles sont generes. Vous pouvez telecharger chacun separement.
                                {% elseif classic_generated %}
                                    Le modele 1 est genere. Le modele 2 ne sera genere que si vous cliquez sur "Generer modele 2".
                                {% elseif modern_generated %}
                                    Le modele 2 est genere. Le modele 1 ne sera genere que si vous cliquez sur "Generer modele 1".
                                {% else %}
                                    Generez le PDF Facture-X (avec XML integre) puis choisissez le modele visuel a telecharger.
                                {% endif %}
                            </div>

                            {% if step1_done %}
                                <div class="einv-downloads">
                                    {% if classic_generated %}
                                        <a href="{{ path('invoice_einvoicing_download_pdf', {id: invoice.id, model: 'classic'}) }}" class="einv-download-card">
                                            <div class="einv-download-icon icon-pdf"><i class="fas fa-file-pdf"></i></div>
                                            <div>
                                                <div class="einv-download-label">Modele 1 PDF</div>
                                                <div class="einv-download-meta">Style classique, donnees dynamiques</div>
                                            </div>
                                        </a>
                                    {% else %}
                                        <div class="einv-download-card disabled">
                                            <div class="einv-download-icon icon-pdf"><i class="fas fa-lock"></i></div>
                                            <div>
                                                <div class="einv-download-label">Modele 1 PDF</div>
                                                <div class="einv-download-meta">Generez d abord le modele 1</div>
                                            </div>
                                        </div>
                                    {% endif %}

                                    {% if modern_generated %}
                                        <a href="{{ path('invoice_einvoicing_download_pdf', {id: invoice.id, model: 'modern'}) }}" class="einv-download-card">
                                            <div class="einv-download-icon icon-pdf"><i class="fas fa-file-pdf"></i></div>
                                            <div>
                                                <div class="einv-download-label">Modele 2 PDF</div>
                                                <div class="einv-download-meta">Style moderne, donnees dynamiques</div>
                                            </div>
                                        </a>
                                    {% else %}
                                        <div class="einv-download-card disabled">
                                            <div class="einv-download-icon icon-pdf"><i class="fas fa-lock"></i></div>
                                            <div>
                                                <div class="einv-download-label">Modele 2 PDF</div>
                                                <div class="einv-download-meta">Generez d abord le modele 2</div>
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="mt-3">
                                    <a href="{{ path('invoice_einvoicing_generate_facturex', {id: invoice.id, model: 'classic'}) }}" class="btn-einv btn-einv-outline btn-einv-sm">
                                        <i class="fas fa-redo-alt"></i> {{ classic_generated ? 'Regenerer modele 1' : 'Generer modele 1' }}
                                    </a>
                                    <a href="{{ path('invoice_einvoicing_generate_facturex', {id: invoice.id, model: 'modern'}) }}" class="btn-einv btn-einv-outline btn-einv-sm ml-2">
                                        <i class="fas fa-redo-alt"></i> {{ modern_generated ? 'Regenerer modele 2' : 'Generer modele 2' }}
                                    </a>
                                </div>
                            {% else %}
                                <div class="einv-step-action">
                                    <a href="{{ path('invoice_einvoicing_generate_facturex', {id: invoice.id, model: 'classic'}) }}" class="btn-einv btn-einv-primary">
                                        <i class="fas fa-cogs"></i> Generer modele 1
                                    </a>
                                    <a href="{{ path('invoice_einvoicing_generate_facturex', {id: invoice.id, model: 'modern'}) }}" class="btn-einv btn-einv-outline ml-2">
                                        <i class="fas fa-cogs"></i> Generer modele 2
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    {# === STEP 2: Submit to Tiime PDP === #}
                    {% set step2_done = invoice.isSubmittedToTiime %}
                    {% set step2_active = step1_done and not step2_done %}
                    <div class="einv-step {{ step2_done ? 'step-done' : (step2_active ? 'step-active' : 'step-pending') }}">
                        <div class="einv-step-indicator">
                            {% if step2_done %}
                                <i class="fas fa-check"></i>
                            {% else %}
                                2
                            {% endif %}
                        </div>
                        <div class="einv-step-content">
                            <div class="einv-step-title">Transmettre via Tiime PDP</div>
                            <div class="einv-step-desc">
                                {% if step2_done %}
                                    La facture a été transmise avec succès à la plateforme Tiime.
                                    {% if invoice.tiimeInvoiceId %}
                                        <br><small class="text-muted">ID Tiime : {{ invoice.tiimeInvoiceId }}</small>
                                    {% endif %}
                                {% elseif step2_active %}
                                    Envoyer la facture au PDP Tiime pour transmission à la plateforme publique de facturation (PPF).
                                {% else %}
                                    Vous devez d'abord générer la Facture-X avant de pouvoir la transmettre.
                                {% endif %}
                            </div>
                            <div class="einv-step-action">
                                {% if step2_done %}
                                    <a href="{{ path('invoice_einvoicing_submit_tiime', {id: invoice.id}) }}" class="btn-einv btn-einv-outline btn-einv-sm">
                                        <i class="fas fa-redo-alt"></i> Retransmettre
                                    </a>
                                {% elseif step2_active %}
                                    <a href="{{ path('invoice_einvoicing_submit_tiime', {id: invoice.id}) }}" class="btn-einv btn-einv-success">
                                        <i class="fas fa-paper-plane"></i> Transmettre à Tiime
                                    </a>
                                {% else %}
                                    <span class="btn-einv btn-einv-outline disabled">
                                        <i class="fas fa-lock"></i> Transmettre à Tiime
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    {# === STEP 3: Verify Status === #}
                    {% set step3_active = step2_done %}
                    <div class="einv-step {{ step3_active ? 'step-active' : 'step-pending' }}">
                        <div class="einv-step-indicator">3</div>
                        <div class="einv-step-content">
                            <div class="einv-step-title">Vérifier le statut</div>
                            <div class="einv-step-desc">
                                {% if step3_active %}
                                    Consultez le statut de la facture sur la plateforme Tiime et l'historique des événements.
                                {% else %}
                                    Le suivi du statut sera disponible après la transmission de la facture.
                                {% endif %}
                            </div>
                            <div class="einv-step-action" style="gap: 8px; display: flex; flex-wrap: wrap;">
                                {% if step3_active %}
                                    <button type="button" class="btn-einv btn-einv-primary btn-einv-sm" id="btnCheckStatus">
                                        <i class="fas fa-sync-alt"></i> Vérifier le statut
                                    </button>
                                    <button type="button" class="btn-einv btn-einv-outline btn-einv-sm" id="btnViewHistory">
                                        <i class="fas fa-history"></i> Historique
                                    </button>
                                {% else %}
                                    <span class="btn-einv btn-einv-outline btn-einv-sm disabled">
                                        <i class="fas fa-lock"></i> Vérifier le statut
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- History Panel (hidden by default, shown via AJAX) -->
        <div class="einv-workflow" id="historyPanel" style="display: none;">
            <div class="einv-workflow-header">
                <i class="fas fa-history"></i>
                <h6>Historique des Événements</h6>
            </div>
            <div class="einv-workflow-body" id="historyContent">
                <div class="text-center text-muted py-4">
                    <i class="fas fa-spinner fa-spin mr-2"></i> Chargement...
                </div>
            </div>
        </div>

        <!-- Status Result Panel (hidden by default) -->
        <div class="einv-workflow" id="statusPanel" style="display: none;">
            <div class="einv-workflow-header">
                <i class="fas fa-satellite-dish"></i>
                <h6>Statut Tiime</h6>
            </div>
            <div class="einv-workflow-body" id="statusContent">
                <div class="text-center text-muted py-4">
                    <i class="fas fa-spinner fa-spin mr-2"></i> Vérification en cours...
                </div>
            </div>
        </div>

    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">

        <!-- Invoice Info Panel -->
        <div class="einv-panel">
            <div class="einv-panel-header">
                <i class="fas fa-file-invoice" style="color: #4e73df;"></i>
                <h6>Détails de la Facture</h6>
            </div>
            <div class="einv-panel-body">
                <div class="einv-info-row">
                    <span class="einv-info-label">N° Pièce</span>
                    <span class="einv-info-value">{{ invoice.pieceno }}</span>
                </div>
                <div class="einv-info-row">
                    <span class="einv-info-label">Type</span>
                    <span class="einv-info-value">{{ invoice.type }}</span>
                </div>
                <div class="einv-info-row">
                    <span class="einv-info-label">Client</span>
                    <span class="einv-info-value">{{ invoice.client.nom ?? '—' }}</span>
                </div>
                <div class="einv-info-row">
                    <span class="einv-info-label">Montant</span>
                    <span class="einv-info-value">{{ invoice_total|number_format(2, ',', ' ') }} {{ invoice.devise.code ?? 'EUR' }}</span>
                </div>
                <div class="einv-info-row">
                    <span class="einv-info-label">Remise</span>
                    <span class="einv-info-value">{{ invoice_remise|number_format(2, ',', ' ') }}%</span>
                </div>
                <div class="einv-info-row">
                    <span class="einv-info-label">Statut Pièce</span>
                    <span class="einv-info-value">
                        {% if invoice.statut == 'validé' %}
                            <span class="einv-badge einv-badge-success">{{ invoice.statut }}</span>
                        {% elseif invoice.statut == 'brouillon' %}
                            <span class="einv-badge einv-badge-muted">{{ invoice.statut }}</span>
                        {% else %}
                            <span class="einv-badge einv-badge-warning">{{ invoice.statut }}</span>
                        {% endif %}
                    </span>
                </div>
                <div class="einv-info-row">
                    <span class="einv-info-label">Règlement</span>
                    <span class="einv-info-value">{{ invoice.reglement ?? '—' }}</span>
                </div>
            </div>
        </div>

        <!-- Seller/Buyer Panel -->
        <div class="einv-panel">
            <div class="einv-panel-header">
                <i class="fas fa-building" style="color: #1cc88a;"></i>
                <h6>Identification Fiscale</h6>
            </div>
            <div class="einv-panel-body">
                <p class="einv-stat-label mb-2" style="font-size: 10px;">ÉMETTEUR (VENDEUR)</p>
                <div class="einv-info-row">
                    <span class="einv-info-label">SIREN</span>
                    <span class="einv-info-value">{{ invoice.sellerSiren ?? '—' }}</span>
                </div>
                <div class="einv-info-row">
                    <span class="einv-info-label">SIRET</span>
                    <span class="einv-info-value">{{ invoice.sellerSiret ?? '—' }}</span>
                </div>
                <div class="einv-info-row">
                    <span class="einv-info-label">N° TVA</span>
                    <span class="einv-info-value">{{ invoice.sellerVatNumber ?? '—' }}</span>
                </div>

                <hr class="my-3" style="border-color: #f0f0f5;">

                <p class="einv-stat-label mb-2" style="font-size: 10px;">DESTINATAIRE (ACHETEUR)</p>
                <div class="einv-info-row">
                    <span class="einv-info-label">SIREN</span>
                    <span class="einv-info-value">{{ invoice.buyerSiren ?? '—' }}</span>
                </div>
                <div class="einv-info-row">
                    <span class="einv-info-label">SIRET</span>
                    <span class="einv-info-value">{{ invoice.buyerSiret ?? '—' }}</span>
                </div>
                <div class="einv-info-row">
                    <span class="einv-info-label">N° TVA</span>
                    <span class="einv-info-value">{{ invoice.buyerVatNumber ?? '—' }}</span>
                </div>
            </div>
        </div>

        <!-- Tax Info Panel -->
        <div class="einv-panel">
            <div class="einv-panel-header">
                <i class="fas fa-calculator" style="color: #f6c23e;"></i>
                <h6>Informations Fiscales</h6>
            </div>
            <div class="einv-panel-body">
                <div class="einv-info-row">
                    <span class="einv-info-label">Type facture</span>
                    <span class="einv-info-value">{{ invoice.invoiceType ?? '—' }}</span>
                </div>
                <div class="einv-info-row">
                    <span class="einv-info-label">Taux TVA</span>
                    <span class="einv-info-value">{{ invoice_tax_rate|number_format(2, ',', ' ') }}%</span>
                </div>
                <div class="einv-info-row">
                    <span class="einv-info-label">Base HT</span>
                    <span class="einv-info-value">{{ invoice_taxable|number_format(2, ',', ' ') }} €</span>
                </div>
                <div class="einv-info-row">
                    <span class="einv-info-label">Montant TVA</span>
                    <span class="einv-info-value">{{ invoice_tax_amount|number_format(2, ',', ' ') }} €</span>
                </div>
            </div>
        </div>

        <!-- Quick Guide -->
        <div class="einv-panel">
            <div class="einv-panel-header">
                <i class="fas fa-lightbulb" style="color: #f6c23e;"></i>
                <h6>Guide Rapide</h6>
            </div>
            <div class="einv-panel-body">
                <div class="d-flex align-items-start mb-3" style="gap: 10px;">
                    <span class="einv-badge einv-badge-info" style="min-width: 24px; justify-content: center;">1</span>
                    <small class="text-muted"><strong>Générer</strong> — Crée le PDF et XML conformes à Facture-X</small>
                </div>
                <div class="d-flex align-items-start mb-3" style="gap: 10px;">
                    <span class="einv-badge einv-badge-info" style="min-width: 24px; justify-content: center;">2</span>
                    <small class="text-muted"><strong>Transmettre</strong> — Envoie la facture au PDP Tiime</small>
                </div>
                <div class="d-flex align-items-start" style="gap: 10px;">
                    <span class="einv-badge einv-badge-info" style="min-width: 24px; justify-content: center;">3</span>
                    <small class="text-muted"><strong>Vérifier</strong> — Suivez le statut PPF en temps réel</small>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
$(document).ready(function() {
    // Check Tiime Status
    $('#btnCheckStatus').on('click', function() {
        var btn = $(this);
        var panel = $('#statusPanel');
        var content = $('#statusContent');

        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Vérification...');
        panel.slideDown(300);
        content.html('<div class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin mr-2"></i> Vérification en cours...</div>');

        $.ajax({
            url: '{{ path("invoice_einvoicing_check_tiime_status", {id: invoice.id}) }}',
            method: 'GET',
            dataType: 'json',
            success: function(data) {
                var statusHtml = '<div class="einv-info-row"><span class="einv-info-label">ID Facture</span><span class="einv-info-value">' + data.invoice_id + '</span></div>';
                if (data.tiime_status && typeof data.tiime_status === 'object') {
                    for (var key in data.tiime_status) {
                        statusHtml += '<div class="einv-info-row"><span class="einv-info-label">' + key + '</span><span class="einv-info-value">' + (data.tiime_status[key] || '—') + '</span></div>';
                    }
                } else {
                    statusHtml += '<div class="einv-info-row"><span class="einv-info-label">Statut</span><span class="einv-info-value">' + (data.tiime_status || 'Aucune information') + '</span></div>';
                }
                content.html(statusHtml);
            },
            error: function() {
                content.html('<div class="text-center py-4"><span class="einv-badge einv-badge-error"><i class="fas fa-exclamation-triangle mr-1"></i> Erreur de connexion au serveur Tiime</span><p class="text-muted small mt-2">Vérifiez vos paramètres API dans le fichier .env</p></div>');
            },
            complete: function() {
                btn.prop('disabled', false).html('<i class="fas fa-sync-alt"></i> Vérifier le statut');
            }
        });
    });

    // View History
    $('#btnViewHistory').on('click', function() {
        var btn = $(this);
        var panel = $('#historyPanel');
        var content = $('#historyContent');

        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Chargement...');
        panel.slideDown(300);
        content.html('<div class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin mr-2"></i> Chargement...</div>');

        $.ajax({
            url: '{{ path("invoice_einvoicing_history", {id: invoice.id}) }}',
            method: 'GET',
            dataType: 'json',
            success: function(data) {
                if (data.lifecycle && data.lifecycle.length > 0) {
                    var html = '<ul class="einv-timeline">';
                    data.lifecycle.forEach(function(item) {
                        var dotClass = 'dot-info';
                        var icon = 'fa-info-circle';
                        var status = item.status || '';
                        if (status.indexOf('SUCCESS') > -1 || status.indexOf('GENERATED') > -1 || status.indexOf('COMPLETED') > -1) {
                            dotClass = 'dot-success'; icon = 'fa-check';
                        } else if (status.indexOf('ERROR') > -1 || status.indexOf('FAIL') > -1) {
                            dotClass = 'dot-error'; icon = 'fa-times';
                        }
                        html += '<li class="einv-timeline-item">';
                        html += '<div class="einv-timeline-dot ' + dotClass + '"><i class="fas ' + icon + '"></i></div>';
                        html += '<div class="einv-timeline-content">';
                        html += '<div class="einv-timeline-title">' + status + '</div>';
                        html += '<div class="einv-timeline-time">' + (item.created_at || '') + '</div>';
                        html += '</div></li>';
                    });
                    html += '</ul>';
                    content.html(html);
                } else {
                    content.html('<div class="text-center py-4"><i class="fas fa-inbox fa-2x text-muted mb-2 d-block"></i><p class="text-muted small">Aucun événement enregistré pour cette facture.</p></div>');
                }
            },
            error: function() {
                content.html('<div class="text-center py-4"><span class="einv-badge einv-badge-error"><i class="fas fa-exclamation-triangle mr-1"></i> Erreur de chargement</span></div>');
            },
            complete: function() {
                btn.prop('disabled', false).html('<i class="fas fa-history"></i> Historique');
            }
        });
    });
});
</script>
{% endblock %}
