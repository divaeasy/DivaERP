{% extends 'template_oukatech.html.twig' %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Unités</h1>
    </div>
</div>

<div class="action-bar">
    <a class="btn-add" href="{{ path('unite.edit') }}">
        <i class="fas fa-plus"></i> Nouvelle Unité
    </a>
    <div class="search-box">
        {% include "components/search_data.html.twig" with {search: search} only %}
    </div>
</div>

<div class="table-container">
    {% if unites|length > 0 %}
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Code</th>
                <th>Libellé</th>
                <th class="text-center" style="width: 120px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for unite in unites %}
            <tr>
                <td><strong>#{{ unite.id }}</strong></td>
                <td><span class="badge badge-secondary">{{ unite.code }}</span></td>
                <td>{{ unite.libelle }}</td>
                <td class="text-center">
                    <a href="{{ path('unite.edit', {id: unite.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn"
                            data-delete-url="{{ path('unite.delete', {id: unite.id}) }}"
                            data-item-name="{{ unite.libelle }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-balance-scale"></i>
        </div>
        <h5>Aucune unité trouvée</h5>
        <p>Ajoutez vos unités de mesure pour vos articles et produits.</p>
        <a href="{{ path('unite.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouvelle unité
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
