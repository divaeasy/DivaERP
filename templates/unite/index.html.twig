{% extends 'template_oukatech.html.twig' %}

{% block PageTitle%}
    Gestion des Unités
{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Unités</h1>
    </div>
</div>

<div class="action-bar">
    <div class="action-buttons">
        <a class="btn-add" href="{{ path('unite.edit') }}">
            <i class="fas fa-plus"></i> Nouvelle Unité
        </a>
        <a class="btn btn-sm btn-outline-success ml-2 no-loading" href="{{ path('export.unites') }}" title="Exporter CSV">
            <i class="fas fa-file-csv mr-1"></i> Exporter
        </a>
    </div>
    <div class="search-box">
        {% include "components/search_data.html.twig" with {search: search} only %}
    </div>
</div>

<div class="table-container">
    {% if unites|length > 0 %}
    <table class="table js-crud-list-table"
           data-crud-resource="unite"
           data-bulk-delete-token="{{ csrf_token('crud_bulk_delete_unite') }}"
           data-update-token="{{ csrf_token('crud_update_unite') }}"
           data-create-token="{{ csrf_token('crud_create_unite') }}"
           data-import-token="{{ csrf_token('crud_import_unite') }}"
           data-enable-quick-create="1"
           data-enable-import="1"
           data-placeholder="____">
        <thead>
            <tr>
                <th data-sort-key="id" data-sort-type="number">ID</th>
                <th data-sort-key="code" data-field="code">Code</th>
                <th data-sort-key="libelle" data-field="libelle" data-required="1">Libelle</th>
                <th class="text-center" style="width: 120px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for unite in unites %}
            <tr data-row-id="{{ unite.id }}">
                <td><strong>#{{ unite.id }}</strong></td>
                <td data-field="code" data-field-value="{{ unite.code|default('') }}"><span class="badge badge-secondary badge-lg">{{ unite.code|default('____') }}</span></td>
                <td data-field="libelle" data-field-value="{{ unite.libelle|default('') }}">{{ unite.libelle|default('____') }}</td>
                <td class="text-center" data-role="actions">
                    <a href="{{ path('unite.edit', {id: unite.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn"
                            data-delete-url="{{ path('unite.delete', {id: unite.id}) }}"
                            data-item-name="{{ unite.libelle }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% include "components/_pagination.html.twig" with {currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, route: 'unite.list', routeParams: {}} %}
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-balance-scale"></i>
        </div>
        <h5>Aucune unité trouvée</h5>
        <p>Ajoutez vos unités de mesure pour vos articles et produits.</p>
        <a href="{{ path('unite.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouvelle unité
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}


