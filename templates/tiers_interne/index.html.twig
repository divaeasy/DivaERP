{% extends 'template_oukatech.html.twig' %}

{% block PageTitle %}Gestion des Tiers Internes{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Tiers Internes</h1>
    </div>
</div>

<div class="action-bar">
    <div class="action-buttons">
        <button type="button" class="btn-add no-loading" data-toggle="modal" data-target="#tiersInterneQuickCreateModal">
            <i class="fas fa-plus"></i> Nouveau tiers interne
        </button>
        <a class="btn btn-sm btn-outline-success ml-2 no-loading" href="{{ path('export.tiers_internes') }}" title="Exporter CSV">
            <i class="fas fa-file-csv mr-1"></i> Exporter
        </a>
        <button type="button" class="btn btn-sm btn-outline-primary ml-2 no-loading" data-toggle="modal" data-target="#tiersInterneImportModal">
            <i class="fas fa-file-import fa-md"></i> Importer
        </button>
    </div>
    <div class="table-bulk-actions" id="tiersInternesBulkActions" data-bulk-bar-for="tiers-internes">
        <div class="table-bulk-actions__content">
            <div class="table-bulk-actions__left">
                <span class="table-bulk-actions__badge">
                    <i class="fas fa-check-circle"></i>
                    <strong data-selection-count>0</strong>
                </span>
                <span class="table-bulk-actions__label" data-selection-label>Aucun tiers interne selectionne</span>
            </div>
            <div class="table-bulk-actions__buttons">
                <button type="button" class="btn btn-sm table-bulk-actions__delete-btn no-loading" data-bulk-action="delete">
                    <i class="fas fa-trash-alt mr-1"></i> Supprimer
                </button>
                <button type="button" class="btn btn-sm table-bulk-actions__clear-btn no-loading" data-bulk-clear>
                    Annuler
                </button>
            </div>
        </div>
    </div>
    <div class="action-tools">
        <div class="search-box">
            {% include "components/search_data.html.twig" with {search: search} only %}
        </div>
    </div>
</div>

<div class="table-container">
    <div class="crud-column-settings-floating">
        <button type="button" class="no-loading crud-column-settings__trigger" aria-expanded="false">
            <i class="fas fa-cog"></i>
        </button>
        <div class="crud-column-settings__menu"></div>
    </div>
    {% if tiersInternes|length > 0 %}
    <table class="table js-crud-list-table commercial-table"
           id="tiersInternesTable"
           data-table-id="tiers-internes"
           data-crud-resource="tiers_interne"
           data-bulk-delete-token="{{ csrf_token('crud_bulk_delete_tiers_interne') }}"
           data-update-token="{{ csrf_token('crud_update_tiers_interne') }}"
           data-create-token="{{ csrf_token('crud_create_tiers_interne') }}"
           data-import-token="{{ csrf_token('crud_import_tiers_interne') }}"
           data-enable-quick-create="1"
           data-enable-import="1"
           data-placeholder="____">
        <thead>
            <tr>
                <th class="row-selector-head" data-column-key="selector">
                    <div class="form-check d-flex justify-content-center mb-0">
                        <input class="form-check-input position-static" type="checkbox" data-select-all-checkbox aria-label="Selectionner toutes les lignes">
                    </div>
                </th>
                <th data-sort-key="id" data-sort-type="number" data-column-key="id">ID</th>
                <th data-sort-key="nom" data-column-key="nom" data-field="nom" data-required="1">Nom</th>
                <th data-sort-key="adresse" data-column-key="adresse" data-field="adr1" data-required="1">Adresse</th>
                <th data-sort-key="ville" data-column-key="ville" data-field="ville" data-type="entity">Ville</th>
                <th data-sort-key="pays" data-column-key="pays" data-field="pays" data-type="entity">Pays</th>
                <th data-sort-key="telephone" data-column-key="telephone" data-field="tel" data-type="digits">Telephone</th>
                <th data-sort-key="email" data-column-key="email" data-field="email">Email</th>
                <th data-sort-key="tarif" data-column-key="tarif" data-field="tarif" data-type="entity">Tarif</th>
                <th class="text-center" style="width: 170px;" data-column-key="actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for tiersInterne in tiersInternes %}
            <tr data-row-id="{{ tiersInterne.id }}" data-item-id="{{ tiersInterne.id }}">
                <td class="row-selector-cell" data-column-key="selector">
                    <div class="form-check d-flex justify-content-center mb-0">
                        <input class="form-check-input position-static" type="checkbox" value="{{ tiersInterne.id }}" data-row-checkbox aria-label="Selectionner tiers interne {{ tiersInterne.nom|default(tiersInterne.id) }}">
                    </div>
                </td>
                <td data-column-key="id"><strong>#{{ tiersInterne.id }}</strong></td>
                <td data-column-key="nom" data-field="nom">{{ tiersInterne.nom|default('____') }}</td>
                <td data-column-key="adresse" data-field="adr1">{{ tiersInterne.adr1|default('____') }}</td>
                <td data-column-key="ville" data-field="ville">{{ tiersInterne.ville|default('____') }}</td>
                <td data-column-key="pays" data-field="pays">{{ tiersInterne.pays|default('____') }}</td>
                <td data-column-key="telephone" data-field="tel">{{ tiersInterne.tel|default('____') }}</td>
                <td data-column-key="email" data-field="email">{{ tiersInterne.email|default('____') }}</td>
                <td data-column-key="tarif" data-field="tarif">{{ tiersInterne.tarif|default('____') }}</td>
                <td class="text-center" data-role="actions" data-column-key="actions">
                    <a href="{{ path('app_tiers_interne_show', {id: tiersInterne.id}) }}" class="btn btn-action btn-view" title="Voir">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a href="{{ path('app_tiers_interne_edit', {id: tiersInterne.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn"
                            data-delete-url="{{ path('app_tiers_interne_delete', {id: tiersInterne.id}) }}"
                            data-item-name="{{ tiersInterne.nom }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% include "components/_pagination.html.twig" with {currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, route: 'app_tiers_interne_index', routeParams: {}} %}
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-people-arrows"></i>
        </div>
        <h5>Aucun tiers interne trouve</h5>
        <p>Ajoutez vos tiers internes pour rattacher vos depots et flux logistiques.</p>
        <a href="{{ path('app_tiers_interne_new') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouveau tiers interne
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
