{% extends "template_oukatech.html.twig" %}

{% block PageTitle %}Tiers interne{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('tiers_interne.list') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
        <h1 class="h3 mb-0 text-gray-800">{{ id > 0 ? 'Modifier le tiers interne' : 'Nouveau tiers interne' }}</h1>
    </div>
</div>

<div class="form-card">
    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

    <div class="card-header-custom">
        <h5><i class="fas fa-building mr-2"></i>Informations generales</h5>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                {{ form_label(form.nom, 'Nom', {'label_attr': {'class': 'required'}}) }}
                {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Entrez le nom'}}) }}
                {{ form_errors(form.nom) }}
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                {{ form_label(form.email, 'Email') }}
                {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'contact@interne.com'}}) }}
                {{ form_errors(form.email) }}
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                {{ form_label(form.tel, 'Telephone') }}
                {{ form_widget(form.tel, {'attr': {'class': 'form-control', 'placeholder': '+212 600 000 000'}}) }}
                {{ form_errors(form.tel) }}
            </div>
        </div>
    </div>

    <div class="card-header-custom mt-4">
        <h5><i class="fas fa-map-marker-alt mr-2"></i>Adresse</h5>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.adr1, 'Adresse ligne 1', {'label_attr': {'class': 'required'}}) }}
                {{ form_widget(form.adr1, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.adr1) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.adr2, 'Adresse ligne 2') }}
                {{ form_widget(form.adr2, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.adr2) }}
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                {{ form_label(form.rue, 'Rue', {'label_attr': {'class': 'required'}}) }}
                {{ form_widget(form.rue, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.rue) }}
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                {{ form_label(form.codepostal, 'Code postal') }}
                {{ form_widget(form.codepostal, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.codepostal) }}
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                {{ form_label(form.ville, 'Ville', {'label_attr': {'class': 'required'}}) }}
                {{ form_widget(form.ville, {'attr': {'class': 'form-control js-example-basic-single'}}) }}
                {{ form_errors(form.ville) }}
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                {{ form_label(form.pays, 'Pays', {'label_attr': {'class': 'required'}}) }}
                {{ form_widget(form.pays, {'attr': {'class': 'form-control js-example-basic-single'}}) }}
                {{ form_errors(form.pays) }}
            </div>
        </div>
    </div>

    <div class="card-header-custom mt-4">
        <h5><i class="fas fa-globe mr-2"></i>Presence en ligne</h5>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.web, 'Site web') }}
                {{ form_widget(form.web, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.web) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.linkedin, 'LinkedIn') }}
                {{ form_widget(form.linkedin, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.linkedin) }}
            </div>
        </div>
    </div>

    <div class="card-header-custom mt-4">
        <h5><i class="fas fa-cog mr-2"></i>Parametres commerciaux</h5>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.tarif, 'Grille tarifaire') }}
                {{ form_widget(form.tarif, {'attr': {'class': 'form-control js-example-basic-single'}}) }}
                {{ form_errors(form.tarif) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.reglement, 'Mode de reglement') }}
                {{ form_widget(form.reglement, {'attr': {'class': 'form-control js-example-basic-single'}}) }}
                {{ form_errors(form.reglement) }}
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save mr-2"></i>{{ id > 0 ? 'Mettre a jour' : 'Enregistrer' }}
        </button>
        <a href="{{ path('tiers_interne.list') }}" class="btn btn-secondary">
            <i class="fas fa-times mr-2"></i>Annuler
        </a>
    </div>

    {{ form_rest(form) }}
    {{ form_end(form) }}
</div>
{% endblock %}

{% block javascripts %}
<script>
    $(document).ready(function() {
        $('.js-example-basic-single').select2({
            theme: 'bootstrap-5',
            allowClear: true
        });
    });
</script>
{% endblock %}
