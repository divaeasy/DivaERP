{% extends 'template_oukatech.html.twig' %}

{% block title %}Réglements{% endblock %}

{% block body %}

<br/>
<div class="input-group"  >

<a class="btn btn-primary" href="{{path('reglement.edit')}}" role="button">Ajouter</a>


</div>

<br/>
<div class="row">

  <table class="table table-striped">
    <thead class="thead-light">
      <tr>
        <th scope="col">Id</th>
        <th scope="col">Libellé</th>
        <th scope="col">Echéance</th>
        
        <th scope="col"></th>
  
      </tr>
    </thead>
    <tbody>
      {% for reglement in reglements %}
      <tr>
        <th scope="row"><a href="{{ path('reglement.edit',{id: reglement.id}) }}" >{{reglement.id}}</a></th>
        <th scope="row">{{reglement.libelle}}</th>
        <td>{{reglement.echeance}}</td>
        

        
        {%if is_granted('ROLE_ADMIN')%}
        <td><a href="{{ path('reglement.edit',{id: reglement.id}) }}" ><i class="fa-solid fa-user-pen"></i></a></td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>

</div>
{% endblock %}
