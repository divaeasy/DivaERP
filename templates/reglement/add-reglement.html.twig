{% extends "template_oukatech.html.twig" %}
{% block PageTitle %}Règlement{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('reglement.list') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
        <h1 class="h3 mb-0 text-gray-800">{{ id > 0 ? 'Modifier le règlement' : 'Nouveau règlement' }}</h1>
    </div>
</div>

<div class="form-card">
    {{ form_start(reglement, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
    
    <div class="card-header-custom">
        <h5><i class="fas fa-credit-card mr-2"></i>Informations du règlement</h5>
    </div>
    
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(reglement.libelle, 'Libellé', {'label_attr': {'class': 'required'}}) }}
                {{ form_widget(reglement.libelle, {'attr': {'class': 'form-control', 'placeholder': 'Nom du règlement'}}) }}
                <div class="invalid-feedback">Le libellé est obligatoire</div>
                {{ form_errors(reglement.libelle) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(reglement.echeance, 'Échéance (jours)', {'label_attr': {'class': 'required'}}) }}
                {{ form_widget(reglement.echeance, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 30'}}) }}
                <div class="invalid-feedback">L'échéance est obligatoire</div>
                {{ form_errors(reglement.echeance) }}
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save mr-2"></i>{{ id > 0 ? 'Mettre à jour' : 'Enregistrer' }}
        </button>
        <a href="{{ path('reglement.list') }}" class="btn btn-secondary">
            <i class="fas fa-times mr-2"></i>Annuler
        </a>
    </div>

    {{ form_rest(reglement) }}
    {{ form_end(reglement) }}
</div>

<p class="text-muted small mt-3">
    <i class="fas fa-info-circle mr-1"></i>
    Les champs marqués d'un <span class="text-danger">*</span> sont obligatoires.
</p>
{% endblock %}

{% block javascripts %}
<script>
    $(document).ready(function() {
        $('.js-example-basic-single').select2({
            theme: 'bootstrap-5',
            allowClear: true
        });
    });
</script>
{% endblock %}