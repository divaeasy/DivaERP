{% extends 'template_oukatech.html.twig' %}


{% block PageTitle %}Gestion des Natures de Production{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Natures de Production</h1>
    </div>
</div>

<div class="action-bar">
    <div class="action-buttons">
        <button type="button" class="btn-add no-loading" data-toggle="modal" data-target="#natureProductionQuickCreateModal">
            <i class="fas fa-plus"></i> Nouvelle nature
        </button>
        <a class="btn btn-sm btn-outline-success ml-2 no-loading" href="{{ path('export.nature_production') }}" title="Exporter CSV">
            <i class="fas fa-file-csv mr-1"></i> Exporter
        </a>
        <button type="button" class="btn btn-sm btn-outline-primary ml-2 no-loading" data-toggle="modal" data-target="#natureProductionImportModal">
            <i class="fas fa-file-import fa-md"></i> Importer
        </button>
    </div>
    <div class="table-bulk-actions" id="naturesProductionBulkActions" data-bulk-bar-for="natures-production">
        <div class="table-bulk-actions__content">
            <div class="table-bulk-actions__left">
                <span class="table-bulk-actions__badge">
                    <i class="fas fa-check-circle"></i>
                    <strong data-selection-count>0</strong>
                </span>
                <span class="table-bulk-actions__label" data-selection-label>Aucune nature selectionnee</span>
            </div>
            <div class="table-bulk-actions__buttons">
                <button type="button" class="btn btn-sm table-bulk-actions__delete-btn no-loading" data-bulk-action="delete">
                    <i class="fas fa-trash-alt mr-1"></i> Supprimer
                </button>
                <button type="button" class="btn btn-sm table-bulk-actions__clear-btn no-loading" data-bulk-clear>
                    Annuler
                </button>
            </div>
        </div>
    </div>
    <div class="action-tools">
        <div class="search-box">
            {% include "components/search_data.html.twig" with {search: search} only %}
        </div>
    </div>
</div>

<div class="table-container">
    <div class="crud-column-settings-floating">
        <button type="button" class="no-loading crud-column-settings__trigger" aria-expanded="false">
            <i class="fas fa-cog"></i>
        </button>
        <div class="crud-column-settings__menu"></div>
    </div>
    {% if naturesProduction|length > 0 %}
        <table class="table js-crud-list-table commercial-table"
               id="naturesProductionTable"
               data-table-id="natures-production"
               data-crud-resource="nature_production"
               data-bulk-delete-token="{{ csrf_token('crud_bulk_delete_nature_production') }}"
               data-update-token="{{ csrf_token('crud_update_nature_production') }}"
               data-create-token="{{ csrf_token('crud_create_nature_production') }}"
               data-import-token="{{ csrf_token('crud_import_nature_production') }}"
               data-enable-quick-create="1"
               data-enable-import="1"
               data-placeholder="____">
            <thead>
                <tr>
                    <th class="row-selector-head" data-column-key="selector">
                        <div class="form-check d-flex justify-content-center mb-0">
                            <input class="form-check-input position-static" type="checkbox" data-select-all-checkbox aria-label="Selectionner toutes les lignes">
                        </div>
                    </th>
                    <th data-sort-key="id" data-sort-type="number" data-column-key="id">ID</th>
                    <th data-sort-key="libelle" data-column-key="libelle" data-field="libelle" data-required="1">Libelle</th>
                    <th data-sort-key="type" data-column-key="type">Type</th>
                    <th class="text-center" style="width: 150px;" data-column-key="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for natureProduction in naturesProduction %}
                    <tr data-row-id="{{ natureProduction.id }}" data-item-id="{{ natureProduction.id }}">
                        <td class="row-selector-cell" data-column-key="selector">
                            <div class="form-check d-flex justify-content-center mb-0">
                                <input class="form-check-input position-static" type="checkbox" value="{{ natureProduction.id }}" data-row-checkbox aria-label="Selectionner nature {{ natureProduction.libelle|default(natureProduction.id) }}">
                            </div>
                        </td>
                        <td data-column-key="id"><strong>#{{ natureProduction.id }}</strong></td>
<td data-column-key="libelle" data-field="libelle">{{ natureProduction.libelle }}</td>

                        <td data-column-key="type"><span class="badge badge-primary">{{ natureProduction.type.value|capitalize }}</span></td>
                        <td class="text-center" data-role="actions" data-column-key="actions">
                            <a href="{{ path('app_nature_production_show', {id: natureProduction.id}) }}" class="btn btn-action btn-view" title="Voir">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('app_nature_production_edit', {id: natureProduction.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button type="button" class="btn btn-action btn-delete delete-btn"
                                    data-delete-url="{{ path('app_nature_production_delete', {id: natureProduction.id}) }}"
                                    data-item-name="{{ natureProduction.libelle }}"
                                    title="Supprimer">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {% include "components/_pagination.html.twig" with {currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, route: 'app_nature_production_index', routeParams: {}} %}
    {% else %}
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="fas fa-industry"></i>
            </div>
            <h5>Aucune nature de production trouvee</h5>
            <p>Ajoutez vos familles de production pour parametrer les articles et les dossiers.</p>
            <a href="{{ path('app_nature_production_new') }}" class="btn btn-primary">
                <i class="fas fa-plus mr-2"></i>Nouvelle nature
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
