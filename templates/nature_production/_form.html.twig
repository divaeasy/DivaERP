<div class="form-card">
    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

    <div class="card-header-custom">
        <h5><i class="fas fa-industry mr-2"></i>Informations de la nature</h5>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="form-group">
                {{ form_label(form.libelle, 'Libelle', {'label_attr': {'class': 'required'}}) }}
                {{ form_widget(form.libelle, {'attr': {'class': 'form-control', 'placeholder': 'Entrez le libelle'}}) }}
                {{ form_errors(form.libelle) }}
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                {{ form_label(form.type, 'Type', {'label_attr': {'class': 'required'}}) }}
                {{ form_widget(form.type, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.type) }}
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save mr-2"></i>{{ submit_label }}
        </button>
        <a href="{{ path('app_nature_production_index') }}" class="btn btn-secondary">
            <i class="fas fa-times mr-2"></i>Annuler
        </a>
    </div>

    {{ form_rest(form) }}
    {{ form_end(form) }}
</div>
