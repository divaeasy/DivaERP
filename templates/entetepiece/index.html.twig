{% extends 'template_oukatech.html.twig' %}


{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Pièces</h1>
    </div>
</div>

<div class="action-bar">
    <a class="btn-add" href="{{ path('entetepiece.edit') }}">
        <i class="fas fa-plus"></i> Nouvelle Pièce
    </a>
</div>

<div class="table-container">
    {% if entetepieces|length > 0 %}
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Type</th>
                <th>Client</th>
                <th>N° Pièce</th>
                <th>Référence</th>
                <th class="text-right">Remise</th>
                <th>Statut</th>
                <th>Devise</th>
                <th class="text-center" style="width: 120px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for entetepiece in entetepieces %}
            <tr>
                <td><strong>#{{ entetepiece.id }}</strong></td>
                <td><span class="badge badge-primary">{{ entetepiece.type }}</span></td>
                <td>{{ entetepiece.client }}</td>
                <td><strong>{{ entetepiece.pieceno }}</strong></td>
                <td>{{ entetepiece.pieceref }}</td>
                <td class="text-right">{{ entetepiece.remise }}%</td>
                <td>
                    {% if entetepiece.statut == 'validé' %}
                        <span class="badge badge-success">{{ entetepiece.statut }}</span>
                    {% elseif entetepiece.statut == 'brouillon' %}
                        <span class="badge badge-secondary">{{ entetepiece.statut }}</span>
                    {% else %}
                        <span class="badge badge-warning">{{ entetepiece.statut }}</span>
                    {% endif %}
                </td>
                <td>{{ entetepiece.devise }}</td>
                <td class="text-center">
                    <a href="{{ path('entetepiece.edit', {id: entetepiece.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a href="{{ path('invoice_einvoicing_test', {id: entetepiece.id}) }}" class="btn btn-action btn-info" title="E-Invoicing">
                        <i class="fas fa-file-pdf" style="color: white;"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn"
                            data-delete-url="{{ path('entetepiece.delete', {id: entetepiece.id}) }}"
                            data-item-name="Pièce #{{ entetepiece.pieceno }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-file-invoice"></i>
        </div>
        <h5>Aucune pièce trouvée</h5>
        <p>Créez votre première pièce comptable pour commencer la facturation.</p>
        <a href="{{ path('entetepiece.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouvelle pièce
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
