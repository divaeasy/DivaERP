{% extends 'template_oukatech.html.twig' %}

{% block PageTitle%}
    Gestion des Pieces
{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Pieces</h1>
    </div>
</div>

<div class="action-bar">
    <div class="action-buttons">
        <a class="btn-add" href="{{ path('entetepiece.edit') }}">
            <i class="fas fa-plus"></i> Nouvelle Piece
        </a>
        <a class="btn btn-sm btn-outline-success ml-2 no-loading" href="{{ path('export.factures') }}" title="Exporter CSV">
            <i class="fas fa-file-csv mr-1"></i> Exporter
        </a>
    </div>
    <div class="search-box">
        {% include "components/search_data.html.twig" with {search: search} only %}
    </div>
</div>

<div class="table-container">
    {% if entetepieces|length > 0 %}
    <table class="table">
        <thead>
            <tr>
                <th data-sort-key="id" data-sort-type="number">ID</th>
                <th data-sort-key="type">Type</th>
                <th data-sort-key="client">Client</th>
                <th data-sort-key="pieceno" data-sort-type="number">No Piece</th>
                <th data-sort-key="pieceref">Reference</th>
                <th data-sort-key="remise" data-sort-type="number" class="text-right">Remise</th>
                <th data-sort-key="montant" data-sort-type="number" class="text-right">Montant</th>
                <th data-sort-key="lignes" data-sort-type="number" class="text-center">Lignes</th>
                <th data-sort-key="statut">Statut</th>
                <th data-sort-key="devise">Devise</th>
                <th data-sort-key="annee" data-sort-type="number">Annee</th>
                <th class="text-center" style="width: 220px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for entetepiece in entetepieces %}
            {% set wf = workflowByInvoice[entetepiece.id]|default({}) %}
            {% set display_remise = remiseByInvoice[entetepiece.id]|default(entetepiece.remise ?? 0) %}
            {% set display_amount = amountByInvoice[entetepiece.id]|default(entetepiece.montant ?? 0) %}
            {% set line_count = lineCountByInvoice[entetepiece.id]|default(0) %}
            {% set isPerimee = wf.isPerimee|default(false) %}
            {% set isInvoiceType = wf.isInvoiceType|default(false) %}
            {% set statusKey = wf.statusKey|default('') %}
            {% set canView = wf.showView|default(false) %}
            {% set canEdit = wf.showEdit|default(false) %}
            {% set canLaunchEinvoicing = wf.showEinvoicing|default(false) and line_count > 0 %}

            {% set transitionDisabledReason = wf.transitionDisabledReason|default('') %}
            {% if transitionDisabledReason == '' %}
                {% if isInvoiceType %}
                    {% set transitionDisabledReason = 'Cette piece est deja au stade final Facture' %}
                {% elseif isPerimee %}
                    {% set transitionDisabledReason = 'Cette piece est perimee et ne peut plus etre modifiee' %}
                {% elseif statusKey not in ['validee', 'valide'] %}
                    {% set transitionDisabledReason = 'Validez la piece pour pouvoir la convertir' %}
                {% elseif line_count <= 0 %}
                    {% set transitionDisabledReason = 'Ajoutez au moins une ligne avant la conversion' %}
                {% else %}
                    {% set transitionDisabledReason = 'Transition indisponible' %}
                {% endif %}
            {% endif %}

            {% if isPerimee %}
                {% set einvoiceDisabledReason = 'Cette facture est perimee et en lecture seule' %}
            {% elseif not canLaunchEinvoicing %}
                {% set einvoiceDisabledReason = 'Ajoutez au moins une ligne pour generer la facture' %}
            {% else %}
                {% set einvoiceDisabledReason = '' %}
            {% endif %}

            <tr>
                <td><strong>#{{ entetepiece.id }}</strong></td>
                <td><span class="badge badge-primary badge-lg">{{ entetepiece.type|default('____') }}</span></td>
                <td>{{ entetepiece.client|default('____') }}</td>
                <td><strong>{{ entetepiece.pieceno|default('____') }}</strong></td>
                <td>{{ entetepiece.pieceref|default('____') }}</td>
                <td class="text-right">{{ display_remise|number_format(2, ',', ' ') }}%</td>
                <td class="text-right"><strong>{{ display_amount|number_format(2, ',', ' ') }}</strong></td>
                <td class="text-center">
                    <span class="badge {{ line_count > 0 ? 'badge-success' : 'badge-warning' }}">{{ line_count }}</span>
                </td>
                <td>
                    {% if statusKey in ['validee', 'valide'] %}
                        <span class="badge badge-success badge-lg">{{ wf.statusLabel|default(entetepiece.statut) }}</span>
                    {% elseif statusKey == 'brouillon' %}
                        <span class="badge badge-secondary badge-lg">{{ wf.statusLabel|default(entetepiece.statut) }}</span>
                    {% elseif statusKey == 'active' %}
                        <span class="badge badge-info badge-lg">{{ wf.statusLabel|default(entetepiece.statut) }}</span>
                    {% elseif statusKey in ['perimee', 'perime', 'archivee', 'archive'] %}
                        <span class="badge badge-danger badge-lg">{{ wf.statusLabel|default(entetepiece.statut) }}</span>
                    {% else %}
                        <span class="badge badge-warning badge-lg">{{ wf.statusLabel|default(entetepiece.statut|default('-')) }}</span>
                    {% endif %}
                </td>
                <td>{{ entetepiece.devise }}</td>
                <td>{{ entetepiece.datep ? entetepiece.datep|date('Y') : '-' }}</td>
                <td class="text-center">
                    <div class="piece-actions">
                        <span class="piece-action-slot">
                            {% if canView %}
                                <a href="{{ path('entetepiece.edit', {id: entetepiece.id}) }}"
                                   class="btn btn-action btn-view"
                                   title="Voir les details (lecture seule)">
                                    <i class="fas fa-eye"></i>
                                </a>
                            {% elseif canEdit %}
                                <a href="{{ path('entetepiece.edit', {id: entetepiece.id}) }}"
                                   class="btn btn-action btn-edit"
                                   title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                            {% else %}
                                <button type="button"
                                        class="btn btn-action btn-edit is-disabled-ui js-disabled-action"
                                        title="{{ isInvoiceType ? 'Edition directe indisponible pour les pieces Facture' : 'Action indisponible' }}">
                                    <i class="fas fa-edit"></i>
                                </button>
                            {% endif %}
                        </span>

                        <span class="piece-action-slot">
                            {% if isInvoiceType %}
                                {% if wf.showEinvoicing|default(false) %}
                                    <a href="{{ canLaunchEinvoicing ? path('invoice_einvoicing_test', {id: entetepiece.id}) : 'javascript:void(0)' }}"
                                       class="btn btn-action btn-einvoicing {% if not entetepiece.isSubmittedToTiime and not entetepiece.isFactureX %}btn-einvoicing--no-facture{% endif %} {% if not canLaunchEinvoicing %}disabled no-loading js-disabled-action{% endif %}"
                                       title="{% if not canLaunchEinvoicing %}Ajoutez au moins une ligne pour generer la facture{% elseif entetepiece.isSubmittedToTiime %}E-Facture transmise{% elseif entetepiece.isFactureX %}Facture-X generee{% else %}E-Facturation{% endif %}">
                                        <i class="fas {% if not canLaunchEinvoicing %}fa-ban{% elseif entetepiece.isSubmittedToTiime %}fa-check-circle{% elseif entetepiece.isFactureX %}fa-file-pdf{% else %}fa-file-invoice{% endif %}"></i>
                                    </a>
                                {% else %}
                                    <button type="button"
                                            class="btn btn-action btn-einvoicing is-disabled-ui js-disabled-action"
                                            title="{{ einvoiceDisabledReason }}">
                                        <i class="fas fa-file-invoice"></i>
                                    </button>
                                {% endif %}
                            {% else %}
                                {% if wf.showTransition|default(false) and wf.transitionEnabled|default(false) %}
                                    <div class="dropdown d-inline-block">
                                        <button class="btn btn-action btn-convert dropdown-toggle no-loading"
                                                type="button"
                                                data-toggle="dropdown"
                                                aria-haspopup="true"
                                                aria-expanded="false"
                                                title="Convertir cette piece">
                                            <i class="fas fa-random"></i>
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-right shadow-sm">
                                            {% for targetType in wf.transitionTargets|default([]) %}
                                                <form method="post"
                                                      action="{{ path('entetepiece.transition', {id: entetepiece.id}) }}"
                                                      class="js-piece-transition-form px-2 py-1"
                                                      data-target-type="{{ targetType }}">
                                                    <input type="hidden" name="targetType" value="{{ targetType }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('transition_piece_' ~ entetepiece.id) }}">
                                                    <button type="submit" class="dropdown-item">
                                                        Vers {{ targetType }}
                                                    </button>
                                                </form>
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% else %}
                                    <button type="button"
                                            class="btn btn-action btn-convert is-disabled-ui js-disabled-action"
                                            title="{{ transitionDisabledReason }}">
                                        <i class="fas fa-random"></i>
                                    </button>
                                {% endif %}
                            {% endif %}
                        </span>

                        <span class="piece-action-slot">
                            <button type="button"
                                    class="btn btn-action btn-delete delete-btn"
                                    data-delete-url="{{ path('entetepiece.delete', {id: entetepiece.id}) }}"
                                    data-item-name="Piece #{{ entetepiece.pieceno }}"
                                    title="Supprimer">
                                <i class="fas fa-trash"></i>
                            </button>
                        </span>
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% include "components/_pagination.html.twig" with {currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, route: 'entetepiece.list', routeParams: {}} %}
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-file-invoice"></i>
        </div>
        <h5>Aucune piece trouvee</h5>
        <p>Creez votre premiere piece comptable pour commencer la facturation.</p>
        <a href="{{ path('entetepiece.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouvelle piece
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
<script>
    (function() {
        function initPieceTransitions() {
            if (!window.jQuery) {
                return;
            }

            $('.js-piece-transition-form').off('submit.pieceTransition').on('submit.pieceTransition', function(e) {
                var targetType = String($(this).data('target-type') || '').trim();
                var confirmationMessage = 'Confirmer la conversion vers ' + targetType + ' ? ' +
                    'La piece source passera automatiquement en statut Perimee.';
                if (!window.confirm(confirmationMessage)) {
                    e.preventDefault();
                }
            });

            $('.js-disabled-transition, .js-disabled-action').off('click.pieceTransition').on('click.pieceTransition', function(e) {
                e.preventDefault();
                e.stopPropagation();
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPieceTransitions);
        } else {
            initPieceTransitions();
        }

        document.addEventListener('turbo:load', initPieceTransitions);
        document.addEventListener('turbo:render', initPieceTransitions);
    })();
</script>
<style>
    .piece-actions {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 2px;
    }
    .piece-action-slot {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 38px;
    }
    .piece-action-slot .dropdown {
        display: inline-flex;
    }
    .btn-action.is-disabled-ui {
        opacity: 0.42;
        color: rgba(107, 114, 128, 0.78) !important;
        background: transparent !important;
        border: none !important;
        pointer-events: auto;
        cursor: not-allowed;
        transform: none !important;
    }
    .btn-action.is-disabled-ui:hover {
        color: rgba(107, 114, 128, 0.78) !important;
        background: transparent !important;
        transform: none !important;
    }
    .piece-actions .btn-einvoicing.btn-einvoicing--no-facture.disabled {
        pointer-events: auto;
        cursor: not-allowed;
    }
    .piece-actions .btn-einvoicing.btn-einvoicing--no-facture:hover {
        background: rgba(8, 145, 178, 0.12) !important;
        color: #0e7490 !important;
        transform: translateY(-1px) !important;
    }
</style>
{% endblock %}
