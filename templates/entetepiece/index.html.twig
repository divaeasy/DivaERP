{% extends 'template_oukatech.html.twig' %}

{% block PageTitle%}
    Gestion des Pièces
{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Pièces</h1>
    </div>
</div>

<div class="action-bar">
    <a class="btn-add" href="{{ path('entetepiece.edit') }}">
        <i class="fas fa-plus"></i> Nouvelle Pièce
    </a>
    <a class="btn btn-sm btn-outline-success ml-2 no-loading" href="{{ path('export.factures') }}" title="Exporter CSV">
        <i class="fas fa-file-csv mr-1"></i> Exporter
    </a>
    <div class="search-box">
        {% include "components/search_data.html.twig" with {search: search} only %}
    </div>
</div>

<div class="table-container">
    {% if entetepieces|length > 0 %}
    <table class="table">
        <thead>
            <tr>
                <th data-sort-key="id" data-sort-type="number">ID</th>
                <th data-sort-key="type">Type</th>
                <th data-sort-key="client">Client</th>
                <th data-sort-key="pieceno" data-sort-type="number">N° Pièce</th>
                <th data-sort-key="pieceref">Référence</th>
                <th data-sort-key="remise" data-sort-type="number" class="text-right">Remise</th>
                <th data-sort-key="montant" data-sort-type="number" class="text-right">Montant</th>
                <th data-sort-key="lignes" data-sort-type="number" class="text-center">Lignes</th>
                <th data-sort-key="statut">Statut</th>
                <th data-sort-key="devise">Devise</th>
                <th data-sort-key="annee" data-sort-type="number">Année</th>
                <th class="text-center" style="width: 120px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for entetepiece in entetepieces %}
            <tr>
                <td><strong>#{{ entetepiece.id }}</strong></td>
                <td><span class="badge badge-primary">{{ entetepiece.type }}</span></td>
                <td>{{ entetepiece.client }}</td>
                <td><strong>{{ entetepiece.pieceno }}</strong></td>
                <td>{{ entetepiece.pieceref }}</td>
                {% set display_remise = remiseByInvoice[entetepiece.id]|default(entetepiece.remise ?? 0) %}
                <td class="text-right">{{ display_remise|number_format(2, ',', ' ') }}%</td>
                {% set display_amount = amountByInvoice[entetepiece.id]|default(entetepiece.montant ?? 0) %}
                {% set line_count = lineCountByInvoice[entetepiece.id]|default(0) %}
                {% set isInvoiceType = entetepiece.type|default('')|trim|lower == 'facture' %}
                {% set canLaunchEinvoicing = isInvoiceType and line_count > 0 %}
                <td class="text-right"><strong>{{ display_amount|number_format(2, ',', ' ') }}</strong></td>
                <td class="text-center">
                    <span class="badge {{ line_count > 0 ? 'badge-success' : 'badge-warning' }}">{{ line_count }}</span>
                </td>
                <td>
                    {% if entetepiece.statut == 'validé' %}
                        <span class="badge badge-success">{{ entetepiece.statut }}</span>
                    {% elseif entetepiece.statut == 'brouillon' %}
                        <span class="badge badge-secondary">{{ entetepiece.statut }}</span>
                    {% else %}
                        <span class="badge badge-warning">{{ entetepiece.statut }}</span>
                    {% endif %}
                </td>
                <td>{{ entetepiece.devise }}</td>
                <td>{{ entetepiece.datep ? entetepiece.datep|date('Y') : '-' }}</td>
                <td class="text-center">
                    <a href="{{ path('entetepiece.edit', {id: entetepiece.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    {% if isInvoiceType %}
                        <a href="{{ canLaunchEinvoicing ? path('invoice_einvoicing_test', {id: entetepiece.id}) : 'javascript:void(0)' }}"
                           class="btn btn-action btn-einvoicing {% if not entetepiece.isSubmittedToTiime and not entetepiece.isFactureX %}btn-einvoicing--no-facture{% endif %} {% if not canLaunchEinvoicing %}disabled no-loading{% endif %}"
                           title="{% if not canLaunchEinvoicing %}Ajoutez au moins une ligne pour générer la facture{% elseif entetepiece.isSubmittedToTiime %}E-Facture transmise{% elseif entetepiece.isFactureX %}Facture-X générée{% else %}E-Facturation{% endif %}">
                            <i class="fas {% if not canLaunchEinvoicing %}fa-ban{% elseif entetepiece.isSubmittedToTiime %}fa-check-circle{% elseif entetepiece.isFactureX %}fa-file-pdf{% else %}fa-file-invoice{% endif %}"></i>
                        </a>
                    {% endif %}
                    <button type="button" class="btn btn-action btn-delete delete-btn"
                            data-delete-url="{{ path('entetepiece.delete', {id: entetepiece.id}) }}"
                            data-item-name="Pièce #{{ entetepiece.pieceno }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% include "components/_pagination.html.twig" with {currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, route: 'entetepiece.list', routeParams: {}} %}
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-file-invoice"></i>
        </div>
        <h5>Aucune pièce trouvée</h5>
        <p>Créez votre première pièce comptable pour commencer la facturation.</p>
        <a href="{{ path('entetepiece.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouvelle pièce
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
