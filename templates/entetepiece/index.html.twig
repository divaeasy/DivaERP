{% extends 'template_oukatech.html.twig' %}

{% block PageTitle%}
    Gestion des Pieces
{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Pieces</h1>
    </div>
</div>

<div class="action-bar">
    <div class="action-buttons">
        <a class="btn-add" href="{{ path('entetepiece.edit') }}">
            <i class="fas fa-plus"></i> Nouvelle Piece
        </a>
        <a class="btn btn-sm btn-outline-success ml-2 no-loading" href="{{ path('export.factures') }}" title="Exporter CSV">
            <i class="fas fa-file-csv mr-1"></i> Exporter
        </a>
    </div>
    <div class="search-box">
        {% include "components/search_data.html.twig" with {search: search} only %}
    </div>
</div>

<div class="table-container">
    {% if entetepieces|length > 0 %}
    <table class="table">
        <thead>
            <tr>
                <th data-sort-key="id" data-sort-type="number">ID</th>
                <th data-sort-key="type">Type</th>
                <th data-sort-key="client">Client</th>
                <th data-sort-key="pieceno" data-sort-type="number">No Piece</th>
                <th data-sort-key="pieceref">Reference</th>
                <th data-sort-key="remise" data-sort-type="number" class="text-right">Remise</th>
                <th data-sort-key="montant" data-sort-type="number" class="text-right">Montant</th>
                <th data-sort-key="lignes" data-sort-type="number" class="text-center">Lignes</th>
                <th data-sort-key="statut">Statut</th>
                <th data-sort-key="devise">Devise</th>
                <th data-sort-key="annee" data-sort-type="number">Annee</th>
                <th class="text-center" style="width: 280px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for entetepiece in entetepieces %}
            {% set wf = workflowByInvoice[entetepiece.id]|default({}) %}
            {% set display_remise = remiseByInvoice[entetepiece.id]|default(entetepiece.remise ?? 0) %}
            {% set display_amount = amountByInvoice[entetepiece.id]|default(entetepiece.montant ?? 0) %}
            {% set line_count = lineCountByInvoice[entetepiece.id]|default(0) %}
            {% set isPerimee = wf.isPerimee|default(false) %}
            {% set isInvoiceType = wf.isInvoiceType|default(false) %}
            {% set statusKey = wf.statusKey|default('') %}
            {% set canView = wf.showView|default(false) %}
            {% set canEdit = wf.showEdit|default(false) %}
            {% set canOpenEinvoicing = wf.showEinvoicing|default(false) %}

            {% set transitionDisabledReason = wf.transitionDisabledReason|default('') %}
            {% if transitionDisabledReason == '' %}
                {% if isInvoiceType %}
                    {% set transitionDisabledReason = 'Cette piece est deja au stade final Facture' %}
                {% elseif isPerimee %}
                    {% set transitionDisabledReason = 'Cette piece est perimee et ne peut plus etre modifiee' %}
                {% elseif statusKey not in ['validee', 'valide'] %}
                    {% set transitionDisabledReason = 'Validez la piece pour pouvoir la convertir' %}
                {% elseif line_count <= 0 %}
                    {% set transitionDisabledReason = 'Ajoutez au moins une ligne avant la conversion' %}
                {% else %}
                    {% set transitionDisabledReason = 'Transition indisponible' %}
                {% endif %}
            {% endif %}

            {% if isPerimee %}
                {% set einvoiceDisabledReason = 'Cette piece est perimee et en lecture seule' %}
            {% elseif statusKey not in ['validee', 'valide'] %}
                {% set einvoiceDisabledReason = 'Validez la piece pour activer la e-facturation' %}
            {% else %}
                {% set einvoiceDisabledReason = '' %}
            {% endif %}

            <tr>
                <td><strong>#{{ entetepiece.id }}</strong></td>
                <td><span class="badge badge-primary badge-lg">{{ entetepiece.type|default('____') }}</span></td>
                <td>{{ entetepiece.client|default('____') }}</td>
                <td><strong>{{ entetepiece.pieceno|default('____') }}</strong></td>
                <td>{{ entetepiece.pieceref|default('____') }}</td>
                <td class="text-right">{{ display_remise|number_format(2, ',', ' ') }}%</td>
                <td class="text-right"><strong>{{ display_amount|number_format(2, ',', ' ') }}</strong></td>
                <td class="text-center">
                    <span class="badge {{ line_count > 0 ? 'badge-success' : 'badge-warning' }}">{{ line_count }}</span>
                </td>
                <td>
                    {% if statusKey in ['validee', 'valide'] %}
                        <span class="badge badge-success badge-lg">{{ wf.statusLabel|default(entetepiece.statut) }}</span>
                    {% elseif statusKey == 'brouillon' %}
                        <span class="badge badge-secondary badge-lg">{{ wf.statusLabel|default(entetepiece.statut) }}</span>
                    {% elseif statusKey == 'active' %}
                        <span class="badge badge-info badge-lg">{{ wf.statusLabel|default(entetepiece.statut) }}</span>
                    {% elseif statusKey in ['perimee', 'perime', 'archivee', 'archive'] %}
                        <span class="badge badge-danger badge-lg">{{ wf.statusLabel|default(entetepiece.statut) }}</span>
                    {% else %}
                        <span class="badge badge-warning badge-lg">{{ wf.statusLabel|default(entetepiece.statut|default('-')) }}</span>
                    {% endif %}
                </td>
                <td>{{ entetepiece.devise }}</td>
                <td>{{ entetepiece.datep ? entetepiece.datep|date('Y') : '-' }}</td>
                <td class="text-center">
                    <div class="piece-actions">
                        <span class="piece-action-slot">
                            {% if canView %}
                                <a href="{{ path('entetepiece.edit', {id: entetepiece.id}) }}"
                                   class="btn btn-action btn-view"
                                   title="Voir les details (lecture seule)">
                                    <i class="fas fa-eye"></i>
                                </a>
                            {% elseif canEdit %}
                                <a href="{{ path('entetepiece.edit', {id: entetepiece.id}) }}"
                                   class="btn btn-action btn-edit"
                                   title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                            {% else %}
                                <button type="button"
                                        class="btn btn-action btn-edit is-disabled-ui js-disabled-action"
                                        title="{{ isInvoiceType ? 'Edition autorisee pour les pieces Facture en statut Active uniquement' : 'Action indisponible' }}">
                                    <i class="fas fa-edit"></i>
                                </button>
                            {% endif %}
                        </span>

                        <span class="piece-action-slot">
                            {% if wf.showTransition|default(false) and wf.transitionEnabled|default(false) %}
                                <div class="dropdown d-inline-block">
                                    <button class="btn btn-action btn-convert dropdown-toggle no-loading"
                                            type="button"
                                            data-toggle="dropdown"
                                            aria-haspopup="true"
                                            aria-expanded="false"
                                            title="Convertir cette piece">
                                        <i class="fas fa-random"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-right shadow-sm">
                                        {% for targetType in wf.transitionTargets|default([]) %}
                                            <form method="post"
                                                  action="{{ path('entetepiece.transition', {id: entetepiece.id}) }}"
                                                  class="js-piece-transition-form no-loading px-2 py-1"
                                                  data-target-type="{{ targetType }}"
                                                  data-piece-label="Piece #{{ entetepiece.pieceno|default(entetepiece.id) }}">
                                                <input type="hidden" name="targetType" value="{{ targetType }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('transition_piece_' ~ entetepiece.id) }}">
                                                <button type="submit" class="dropdown-item">
                                                    Vers {{ targetType }}
                                                </button>
                                            </form>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% else %}
                                <button type="button"
                                        class="btn btn-action btn-convert is-disabled-ui js-disabled-action"
                                        title="{{ transitionDisabledReason }}">
                                    <i class="fas fa-random"></i>
                                </button>
                            {% endif %}
                        </span>

                        <span class="piece-action-slot">
                            {% if canOpenEinvoicing %}
                                <a href="{{ path('invoice_einvoicing_test', {id: entetepiece.id}) }}"
                                   class="btn btn-action btn-einvoicing no-loading {% if not entetepiece.isSubmittedToTiime and not entetepiece.isFactureX %}btn-einvoicing--no-facture{% endif %}"
                                   title="{% if entetepiece.isSubmittedToTiime %}E-Facture transmise{% elseif entetepiece.isFactureX %}Facture-X generee{% else %}Ouvrir la page e-facturation{% endif %}">
                                    <i class="fas {% if entetepiece.isSubmittedToTiime %}fa-check-circle{% else %}fa-file-pdf{% endif %}"></i>
                                </a>
                            {% else %}
                                <button type="button"
                                        class="btn btn-action btn-einvoicing is-disabled-ui js-disabled-action"
                                        title="{{ einvoiceDisabledReason }}">
                                    <i class="fas fa-file-invoice"></i>
                                </button>
                            {% endif %}
                        </span>

                        <span class="piece-action-slot">
                            <button type="button"
                                    class="btn btn-action btn-delete delete-btn"
                                    data-delete-url="{{ path('entetepiece.delete', {id: entetepiece.id}) }}"
                                    data-item-name="Piece #{{ entetepiece.pieceno }}"
                                    title="Supprimer">
                                <i class="fas fa-trash"></i>
                            </button>
                        </span>
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% include "components/_pagination.html.twig" with {currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, route: 'entetepiece.list', routeParams: {}} %}
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-file-invoice"></i>
        </div>
        <h5>Aucune piece trouvee</h5>
        <p>Creez votre premiere piece comptable pour commencer la facturation.</p>
        <a href="{{ path('entetepiece.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouvelle piece
        </a>
    </div>
    {% endif %}
</div>

<div class="modal fade" id="transitionConfirmModal" tabindex="-1" role="dialog" aria-labelledby="transitionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden; position: relative;">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"
                    style="position: absolute; right: 20px; top: 20px; background: none; border: none; font-size: 28px; color: #86efac; opacity: 0.7; z-index: 10; transition: all 0.2s ease;"
                    onmouseover="this.style.opacity='1'; this.style.color='#15803d';"
                    onmouseout="this.style.opacity='0.7'; this.style.color='#86efac';">
                <span aria-hidden="true" style="font-weight: 300;">&times;</span>
            </button>

            <div style="padding: 48px 32px 32px; text-align: center;">
                <div style="
                    width: 80px;
                    height: 80px;
                    background: linear-gradient(135deg, #22c55e 0%, #15803d 100%);
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    margin: 0 auto 28px;
                    box-shadow: 0 8px 24px rgba(21, 128, 61, 0.25);
                ">
                    <i class="fas fa-random" style="font-size: 34px; color: white;"></i>
                </div>

                <h3 id="transitionModalLabel" style="margin: 0 0 12px; font-size: 24px; font-weight: 700; color: #0f172a;">
                    Confirmation de conversion
                </h3>

                <p style="margin: 0 0 20px; font-size: 15px; color: #64748b; line-height: 1.6;">
                    Voulez-vous convertir
                    <strong id="transitionModalPieceName" style="color:#0f172a;">cette piece</strong>
                    vers
                    <strong id="transitionModalTargetType" style="color:#0f172a;">le type cible</strong> ?
                </p>

                <div style="
                    background: rgba(21, 128, 61, 0.08);
                    border-left: 3px solid #15803d;
                    border-radius: 6px;
                    padding: 14px 16px;
                    margin-bottom: 28px;
                    text-align: left;
                ">
                    <p style="margin: 0; font-size: 13px; color: #14532d; line-height: 1.5;">
                        <i class="fas fa-exclamation-triangle mr-2" style="color: #15803d;"></i>
                        La piece source sera automatiquement archivee (statut Perimee) apres conversion.
                    </p>
                </div>

                <div style="display: flex; gap: 12px; justify-content: center;">
                    <button type="button" class="btn" data-dismiss="modal"
                            style="
                                background-color: #e9ecef;
                                border: none;
                                color: #5a5c69;
                                font-weight: 600;
                                padding: 12px 28px;
                                border-radius: 8px;
                                font-size: 14px;
                                transition: all 0.3s ease;
                                cursor: pointer;
                                flex: 1;
                                max-width: 140px;
                            "
                            onmouseover="this.style.backgroundColor='#dfe3e9'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.08)';"
                            onmouseout="this.style.backgroundColor='#e9ecef'; this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                        <i class="fas fa-times mr-2"></i>Annuler
                    </button>

                    <a id="confirmTransitionBtn" href="#"
                       class="btn"
                       style="
                            background: linear-gradient(135deg, #22c55e 0%, #15803d 100%);
                            color: white;
                            border: none;
                            font-weight: 600;
                            padding: 12px 28px;
                            border-radius: 8px;
                            font-size: 14px;
                            transition: all 0.3s ease;
                            text-decoration: none;
                            display: inline-flex;
                            align-items: center;
                            gap: 8px;
                            justify-content: center;
                            flex: 1;
                            max-width: 160px;
                            box-shadow: 0 4px 16px rgba(21, 128, 61, 0.25);
                        "
                       onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 8px 24px rgba(21, 128, 61, 0.35)';"
                       onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 16px rgba(21, 128, 61, 0.25)';">
                        <i class="fas fa-random"></i>Convertir
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    (function() {
        function initPieceTransitions() {
            if (!window.jQuery) {
                return;
            }

            var pendingTransitionForm = null;
            var $transitionModal = $('#transitionConfirmModal');
            var $pieceName = $('#transitionModalPieceName');
            var $targetType = $('#transitionModalTargetType');

            $('.js-piece-transition-form').off('submit.pieceTransition').on('submit.pieceTransition', function(e) {
                e.preventDefault();
                pendingTransitionForm = this;
                if (window.hideLoading) {
                    window.hideLoading();
                }

                var targetType = String($(this).data('target-type') || '').trim();
                var pieceLabel = String($(this).data('piece-label') || 'cette piece').trim();
                $targetType.text(targetType !== '' ? targetType : 'le type cible');
                $pieceName.text(pieceLabel);
                $transitionModal.modal('show');
            });

            $('#confirmTransitionBtn').off('click.pieceTransition').on('click.pieceTransition', function(e) {
                e.preventDefault();
                if (!pendingTransitionForm) {
                    return;
                }

                var formToSubmit = pendingTransitionForm;
                pendingTransitionForm = null;
                $transitionModal.modal('hide');

                if (window.showLoading) {
                    window.showLoading();
                }
                formToSubmit.submit();
            });

            $transitionModal.off('hidden.bs.modal.pieceTransition').on('hidden.bs.modal.pieceTransition', function() {
                pendingTransitionForm = null;
                if (window.hideLoading) {
                    window.hideLoading();
                }
            });

            $('.js-disabled-transition, .js-disabled-action').off('click.pieceTransition').on('click.pieceTransition', function(e) {
                e.preventDefault();
                e.stopPropagation();
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPieceTransitions);
        } else {
            initPieceTransitions();
        }

        document.addEventListener('turbo:load', initPieceTransitions);
        document.addEventListener('turbo:render', initPieceTransitions);
    })();
</script>
<style>
    .piece-actions {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 2px;
    }
    .piece-action-slot {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 38px;
    }
    .piece-action-slot .dropdown {
        display: inline-flex;
    }
    .btn-action.is-disabled-ui {
        opacity: 0.30;
        color: rgba(107, 114, 128, 0.78) !important;
        background: transparent !important;
        border: none !important;
        pointer-events: auto;
        cursor: not-allowed;
        transform: none !important;
    }
    .btn-action.is-disabled-ui:hover {
        color: rgba(107, 114, 128, 0.78) !important;
        background: transparent !important;
        transform: none !important;
    }
    .piece-actions .btn-einvoicing.btn-einvoicing--no-facture:hover {
        background: rgba(8, 145, 178, 0.12) !important;
        color: #0e7490 !important;
        transform: translateY(-1px) !important;
    }
</style>
{% endblock %}
