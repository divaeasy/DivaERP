{% extends 'template_oukatech.html.twig' %}

{% block PageTitle%}
    Gestion des Pieces
{% endblock %}

{% block body %}
{% set pieceOrigin = origin|default(listRoute is defined and listRoute == 'entetepiece.fournisseur_list' ? 'fournisseur' : 'client') %}
{% set pieceOriginParams = pieceOrigin ? {origin: pieceOrigin} : {} %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">
            Gestion des Pieces{% if forcedTierLabel is defined and forcedTierLabel %} - {{ forcedTierLabel }}{% endif %}
        </h1>
    </div>
</div>

<div class="action-bar">
    <div class="action-buttons">
        <button type="button" class="btn-add no-loading" data-toggle="modal" data-target="#pieceQuickCreateModal">
            <i class="fas fa-plus"></i> Creation rapide
        </button>
        <a class="btn btn-sm btn-outline-success ml-2 no-loading" href="{{ path('export.factures') }}" title="Exporter Excel">
            <i class="fas fa-file-excel fa-md"></i> Exporter
        </a>
        <a class="btn btn-sm btn-outline-info ml-2 no-loading" href="{{ path('export.accounting_entries') }}" title="Exporter ecritures comptables">
            <i class="fas fa-file-csv fa-md"></i> Ecritures
        </a>
        <button type="button" class="btn btn-sm btn-outline-primary ml-2 no-loading" data-toggle="modal" data-target="#pieceImportModal">
            <i class="fas fa-file-import fa-md"></i> Importer
        </button>
    </div>
    <div class="table-bulk-actions" id="piecesBulkActions" data-bulk-bar-for="pieces">
        <div class="table-bulk-actions__content">
            <div class="table-bulk-actions__left">
                <span class="table-bulk-actions__badge">
                    <i class="fas fa-check-circle"></i>
                    <strong data-selection-count>0</strong>
                </span>
                <span class="table-bulk-actions__label" data-selection-label>
                    Aucune piece selectionnee
                </span>
            </div>
            <div class="table-bulk-actions__buttons">
                <button type="button" class="btn btn-sm table-bulk-actions__delete-btn no-loading" data-bulk-action="delete">
                    <i class="fas fa-trash-alt mr-1"></i> Supprimer
                </button>
                <button type="button" class="btn btn-sm table-bulk-actions__clear-btn no-loading" data-bulk-clear>
                    Annuler
                </button>
            </div>
        </div>
    </div>
    <div class="action-tools">
        <div class="search-box">
            {% include "components/search_data.html.twig" with {search: search} only %}
        </div>
    </div>
</div>

<div class="table-container table-container--pieces">
    {% if entetepieces|length > 0 %}
    <div class="piece-column-settings-floating">
        <button type="button" class="no-loading piece-column-settings__trigger" id="pieceColumnSettingsToggle" aria-expanded="false" aria-controls="pieceColumnSettingsMenu">
            <i class="fas fa-cog"></i>
        </button>
        <div class="piece-column-settings__menu" id="pieceColumnSettingsMenu">
            <div class="piece-column-settings__title">Colonnes</div>
            <div class="piece-column-settings__group">
                <div class="piece-column-settings__item is-static">
                    <span>ID</span>
                    <small>Obligatoire</small>
                </div>
                <div class="piece-column-settings__item is-static">
                    <span>Type</span>
                    <small>Obligatoire</small>
                </div>
                <div class="piece-column-settings__item is-static">
                    <span>Tiers</span>
                    <small>Obligatoire</small>
                </div>
                <div class="piece-column-settings__item is-static">
                    <span>Actions</span>
                    <small>Obligatoire</small>
                </div>
            </div>
            <div class="piece-column-settings__divider"></div>
            <div class="piece-column-settings__group">
                <label class="piece-column-settings__item" for="pieceColumnToggle_pieceno">
                    <span>No Piece</span>
                    <input type="checkbox" id="pieceColumnToggle_pieceno" data-column-toggle="pieceno" checked>
                </label>
                <label class="piece-column-settings__item" for="pieceColumnToggle_pieceref">
                    <span>Reference</span>
                    <input type="checkbox" id="pieceColumnToggle_pieceref" data-column-toggle="pieceref" checked>
                </label>
                <label class="piece-column-settings__item" for="pieceColumnToggle_remise">
                    <span>Remise</span>
                    <input type="checkbox" id="pieceColumnToggle_remise" data-column-toggle="remise" checked>
                </label>
                <label class="piece-column-settings__item" for="pieceColumnToggle_montant">
                    <span>Montant</span>
                    <input type="checkbox" id="pieceColumnToggle_montant" data-column-toggle="montant" checked>
                </label>
                <label class="piece-column-settings__item" for="pieceColumnToggle_lignes">
                    <span>Lignes</span>
                    <input type="checkbox" id="pieceColumnToggle_lignes" data-column-toggle="lignes" checked>
                </label>
                <label class="piece-column-settings__item" for="pieceColumnToggle_statut">
                    <span>Statut</span>
                    <input type="checkbox" id="pieceColumnToggle_statut" data-column-toggle="statut" checked>
                </label>
                <label class="piece-column-settings__item" for="pieceColumnToggle_codeoperation">
                    <span>Code operation</span>
                    <input type="checkbox" id="pieceColumnToggle_codeoperation" data-column-toggle="codeoperation">
                </label>
                <label class="piece-column-settings__item" for="pieceColumnToggle_devise">
                    <span>Devise</span>
                    <input type="checkbox" id="pieceColumnToggle_devise" data-column-toggle="devise" checked>
                </label>
                <label class="piece-column-settings__item" for="pieceColumnToggle_annee">
                    <span>Annee</span>
                    <input type="checkbox" id="pieceColumnToggle_annee" data-column-toggle="annee" checked>
                </label>
            </div>
        </div>
    </div>
    <table class="table pieces-table"
           id="piecesTable"
           data-table-id="pieces"
           data-bulk-delete-token="{{ csrf_token('crud_bulk_delete_entetepiece') }}"
           data-inline-update-token="{{ csrf_token('entetepiece_inline_update') }}">
        <thead>
            <tr>
                <th class="row-selector-head" data-column-key="selector">
                    <div class="form-check d-flex justify-content-center mb-0">
                        <input class="form-check-input position-static" type="checkbox" id="selectAllPiecesRows" data-select-all-checkbox aria-label="Selectionner toutes les lignes">
                    </div>
                </th>
                <th data-column-key="id" data-sort-key="id" data-sort-type="number">ID</th>
                <th data-column-key="type" data-sort-key="type">Type</th>
                <th data-column-key="tier" data-sort-key="tier">Tiers</th>
                <th data-column-key="pieceno" data-sort-key="pieceno" data-sort-type="number">No Piece</th>
                <th data-column-key="pieceref" data-sort-key="pieceref">Reference</th>
                <th data-column-key="remise" data-sort-key="remise" data-sort-type="number" class="text-right">Remise</th>
                <th data-column-key="montant" data-sort-key="montant" data-sort-type="number" class="text-right">Montant</th>
                <th data-column-key="lignes" data-sort-key="lignes" data-sort-type="number" class="text-center">Lignes</th>
                <th data-column-key="statut" data-sort-key="statut">Statut</th>
                <th data-column-key="codeoperation" data-sort-key="codeoperation">Code operation</th>
                <th data-column-key="devise" data-sort-key="devise">Devise</th>
                <th data-column-key="annee" data-sort-key="annee" data-sort-type="number">Annee</th>
                <th class="text-center" style="width: 220px;" data-column-key="actions">Actions</th>
            </tr>
        </thead>
        <tbody id="piecesTableBody">
            {% for entetepiece in entetepieces %}
            {% set wf = workflowByInvoice[entetepiece.id]|default({}) %}
            {% set display_remise = remiseByInvoice[entetepiece.id]|default(entetepiece.remise ?? 0) %}
            {% set display_amount = amountByInvoice[entetepiece.id]|default(entetepiece.montant ?? 0) %}
            {% set line_count = lineCountByInvoice[entetepiece.id]|default(0) %}
            {% set isPerimee = wf.isPerimee|default(false) %}
            {% set isInvoiceType = wf.isInvoiceType|default(false) %}
            {% set statusKey = wf.statusKey|default('') %}
            {% set canView = wf.showView|default(false) %}
            {% set canEdit = wf.showEdit|default(false) %}
            {% set canOpenEinvoicing = wf.showEinvoicing|default(false) %}

            {% set transitionDisabledReason = wf.transitionDisabledReason|default('') %}
            {% if transitionDisabledReason == '' %}
                {% if isInvoiceType %}
                    {% set transitionDisabledReason = 'Cette piece est deja au stade final Facture' %}
                {% elseif isPerimee %}
                    {% set transitionDisabledReason = 'Cette piece est perimee et ne peut plus etre modifiee' %}
                {% elseif statusKey not in ['validee', 'valide'] %}
                    {% set transitionDisabledReason = 'Validez la piece pour pouvoir la convertir' %}
                {% elseif line_count <= 0 %}
                    {% set transitionDisabledReason = 'Ajoutez au moins une ligne avant la conversion' %}
                {% else %}
                    {% set transitionDisabledReason = 'Transition indisponible' %}
                {% endif %}
            {% endif %}

            {% if isPerimee %}
                {% set einvoiceDisabledReason = 'Cette piece est perimee et en lecture seule' %}
            {% elseif statusKey not in ['validee', 'valide'] %}
                {% set einvoiceDisabledReason = 'Validez la piece pour activer la e-facturation' %}
            {% else %}
                {% set einvoiceDisabledReason = '' %}
            {% endif %}

            <tr class="piece-row"
                data-row-id="{{ entetepiece.id }}"
                data-item-id="{{ entetepiece.id }}"
                data-inline-editable="{% if canEdit %}1{% else %}0{% endif %}"
                data-inline-update-url="{{ path('entetepiece.inline_update', {id: entetepiece.id}|merge(pieceOriginParams)) }}"
                data-type-value="{{ entetepiece.type|default('') }}"
                data-tier-type="{{ entetepiece.typet|default('') }}"
                data-tier-id="{{ entetepiece.tierId is not null ? entetepiece.tierId : '' }}"
                data-tier-label="{{ entetepiece.tierName|default('____') }}"
                data-code-operation-id="{{ entetepiece.codeOperation ? entetepiece.codeOperation.id : '' }}"
                data-code-operation-label="{{ entetepiece.codeOperation ? entetepiece.codeOperation.libelle : '' }}"
                data-code-operation-sens="{{ entetepiece.codeOperation ? entetepiece.codeOperation.sens.label : '' }}"
                data-statut-value="{{ entetepiece.statut|default('') }}"
                data-statut-label="{{ wf.statusLabel|default(entetepiece.statut|default('-')) }}"
                data-devise-id="{{ entetepiece.devise ? entetepiece.devise.id : '' }}"
                data-devise-label="{{ entetepiece.devise ? entetepiece.devise.code : '' }}"
                data-annee-value="{{ entetepiece.datep ? entetepiece.datep|date('Y') : '' }}"
                data-piece-ref-value="{{ entetepiece.pieceref|default('') }}"
                data-remise-value="{{ display_remise|number_format(2, '.', '') }}"
                tabindex="0">
                <td class="row-selector-cell" data-column-key="selector">
                    <div class="form-check d-flex justify-content-center mb-0">
                        <input class="form-check-input position-static piece-row-checkbox" type="checkbox" value="{{ entetepiece.id }}" data-row-checkbox aria-label="Selectionner la piece {{ entetepiece.pieceno|default(entetepiece.id) }}">
                    </div>
                </td>
                <td data-column-key="id"><strong>#{{ entetepiece.id }}</strong></td>
                <td data-field="type" data-column-key="type"><span class="badge badge-primary badge-lg">{{ entetepiece.type|default('____') }}</span></td>
                <td data-field="tier" data-column-key="tier">{{ entetepiece.tierName|default('____') }}</td>
                <td data-column-key="pieceno"><strong>{{ entetepiece.pieceno|default('____') }}</strong></td>
                <td data-field="pieceref" data-column-key="pieceref">{{ entetepiece.pieceref|default('____') }}</td>
                <td class="text-right" data-field="remise" data-column-key="remise">{{ display_remise|number_format(2, ',', ' ') }}%</td>
                <td class="text-right" data-column-key="montant"><strong>{{ display_amount|number_format(2, ',', ' ') }}</strong></td>
                <td class="text-center" data-column-key="lignes">
                    <span class="badge {{ line_count > 0 ? 'badge-success' : 'badge-warning' }}">{{ line_count }}</span>
                </td>
                <td data-field="statut" data-column-key="statut">
                    {% if statusKey in ['validee', 'valide'] %}
                        <span class="badge badge-success badge-lg">{{ wf.statusLabel|default(entetepiece.statut) }}</span>
                    {% elseif statusKey == 'brouillon' %}
                        <span class="badge badge-secondary badge-lg">{{ wf.statusLabel|default(entetepiece.statut) }}</span>
                    {% elseif statusKey == 'active' %}
                        <span class="badge badge-info badge-lg">{{ wf.statusLabel|default(entetepiece.statut) }}</span>
                    {% elseif statusKey in ['perimee', 'perime', 'archivee', 'archive'] %}
                        <span class="badge badge-danger badge-lg">{{ wf.statusLabel|default(entetepiece.statut) }}</span>
                    {% else %}
                        <span class="badge badge-warning badge-lg">{{ wf.statusLabel|default(entetepiece.statut|default('-')) }}</span>
                    {% endif %}
                </td>
                <td data-column-key="codeoperation">
                    {% set opLabel = entetepiece.codeOperation ? entetepiece.codeOperation.libelle : '____' %}
                    {% set opSens = entetepiece.codeOperation ? entetepiece.codeOperation.sens.label : '' %}
                    {% if opSens == 'Entree' %}
                        <span class="piece-sens-badge piece-sens-badge--debit"><i class="fas fa-arrow-down"></i>{{ opLabel }}</span>
                    {% elseif opSens == 'Sortie' %}
                        <span class="piece-sens-badge piece-sens-badge--credit"><i class="fas fa-arrow-up"></i>{{ opLabel }}</span>
                    {% else %}
                        <span class="piece-sens-badge">{{ opLabel }}</span>
                    {% endif %}
                </td>
                <td data-field="devise" data-column-key="devise">{{ entetepiece.devise }}</td>
                <td data-field="annee" data-column-key="annee">{{ entetepiece.datep ? entetepiece.datep|date('Y') : '-' }}</td>
                <td class="text-center piece-actions-cell" data-column-key="actions" data-role="actions">
                    <div class="piece-actions">
                        <span class="piece-action-slot">
                            {% if canView %}
                                <a href="{{ path('entetepiece.edit', {id: entetepiece.id}|merge(pieceOriginParams)) }}"
                                   class="btn btn-action btn-view"
                                   title="Voir les details (lecture seule)">
                                    <i class="fas fa-eye"></i>
                                </a>
                            {% elseif canEdit %}
                                <button type="button"
                                   class="btn btn-action btn-edit js-piece-inline-edit"
                                   title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </button>
                            {% else %}
                                <button type="button"
                                        class="btn btn-action btn-edit is-disabled-ui js-disabled-action"
                                        title="{{ isInvoiceType ? 'Edition autorisee pour les pieces Facture en statut Active uniquement' : 'Action indisponible' }}">
                                    <i class="fas fa-edit"></i>
                                </button>
                            {% endif %}
                        </span>
                        
                        <span class="piece-action-slot">
                            {% if wf.showTransition|default(false) and wf.transitionEnabled|default(false) %}
                                <div class="dropdown d-inline-block piece-transition-dropdown">
                                    <button class="btn btn-action btn-convert dropdown-toggle no-loading"
                                            type="button"
                                            aria-haspopup="true"
                                            aria-expanded="false"
                                            title="Convertir cette piece">
                                        <i class="fas fa-random"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-right shadow-sm piece-transition-menu">
                                        {% for targetType in wf.transitionTargets|default([]) %}
                                            <form method="post"
                                                  action="{{ path('entetepiece.transition', {id: entetepiece.id}|merge(pieceOriginParams)) }}"
                                                  class="js-piece-transition-form no-loading px-2 py-1"
                                                  data-target-type="{{ targetType }}"
                                                  data-piece-label="Piece #{{ entetepiece.pieceno|default(entetepiece.id) }}">
                                                <input type="hidden" name="targetType" value="{{ targetType }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('transition_piece_' ~ entetepiece.id) }}">
                                                <button type="submit" class="dropdown-item">
                                                    Vers {{ targetType }}
                                                </button>
                                            </form>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% else %}
                                <button type="button"
                                        class="btn btn-action btn-convert is-disabled-ui js-disabled-action"
                                        title="{{ transitionDisabledReason }}">
                                    <i class="fas fa-random"></i>
                                </button>
                            {% endif %}
                        </span>

                        <span class="piece-action-slot">
                            {% if canOpenEinvoicing %}
                                <a href="{{ path('invoice_einvoicing_test', {id: entetepiece.id}) }}"
                                   class="btn btn-action btn-einvoicing no-loading {% if not entetepiece.isSubmittedToTiime and not entetepiece.isFactureX %}btn-einvoicing--no-facture{% endif %}"
                                   title="{% if entetepiece.isSubmittedToTiime %}E-Facture transmise{% elseif entetepiece.isFactureX %}Facture-X generee{% else %}Ouvrir la page e-facturation{% endif %}">
                                    <i class="fas {% if entetepiece.isSubmittedToTiime %}fa-check-circle{% else %}fa-file-pdf{% endif %}"></i>
                                </a>
                            {% else %}
                                <button type="button"
                                        class="btn btn-action btn-einvoicing is-disabled-ui js-disabled-action"
                                        title="{{ einvoiceDisabledReason }}">
                                    <i class="fas fa-file-invoice"></i>
                                </button>
                            {% endif %}
                        </span>

                        <span class="piece-action-slot">
                            <button type="button"
                                    class="btn btn-action btn-delete delete-btn"
                                    data-delete-url="{{ path('entetepiece.delete', {id: entetepiece.id}|merge(pieceOriginParams)) }}"
                                    data-item-name="Piece #{{ entetepiece.pieceno }}"
                                    title="Supprimer">
                                <i class="fas fa-trash"></i>
                            </button>
                        </span>
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% include "components/_pagination.html.twig" with {currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, route: listRoute|default('entetepiece.list'), routeParams: routeParams|default({})} %}
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-file-invoice"></i>
        </div>
        <h5>Aucune piece trouvee</h5>
        <p>Creez votre premiere piece comptable pour commencer la facturation.</p>
        <a href="{{ path('entetepiece.edit', pieceOriginParams) }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouvelle piece
        </a>
    </div>
    {% endif %}
</div>

<div class="modal fade" id="pieceImportModal" tabindex="-1" role="dialog" aria-labelledby="pieceImportModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="pieceImportForm" class="no-loading" enctype="multipart/form-data" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="pieceImportModalLabel">Importer des pieces</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="_token" value="{{ csrf_token('entetepiece_import') }}">
                    <input type="hidden" name="origin" value="{{ pieceOrigin|default('client') }}">
                    <div class="alert alert-info py-2 mb-3">
                        Format similaire a l'import article. Colonnes attendues:
                        <strong>type, typet, tierId, pieceref, remise, statut, datep</strong> (CSV/XLS/XLSX).
                    </div>
                    <div class="form-group mb-0">
                        <label for="pieceImportFile">Fichier</label>
                        <input id="pieceImportFile" type="file" name="file" class="form-control-file" accept=".csv,.txt,.xls,.xlsx" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary" id="pieceImportSubmit">Importer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade piece-quick-modal" id="pieceQuickCreateModal" tabindex="-1" role="dialog" aria-labelledby="pieceQuickCreateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <button type="button" class="close piece-quick-modal-close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
            <form id="pieceQuickCreateForm" class="no-loading" data-no-loading novalidate>
                <div class="piece-quick-modal-body">
                    <input type="hidden" name="_token" value="{{ csrf_token('entetepiece_create_minimal') }}">
                    <input type="hidden" name="origin" value="{{ pieceOrigin|default('client') }}">
                    <div class="piece-quick-modal-badge">
                        <i class="fas fa-file-invoice"></i>
                    </div>
                    <h3 class="piece-quick-modal-title" id="pieceQuickCreateModalLabel">Creation rapide de piece</h3>
                    <p class="piece-quick-modal-subtitle">Renseignez uniquement les champs requis. Les autres informations se completent ensuite en edition inline.</p>
                    <div class="piece-quick-modal-note">
                        Astuce: apres creation, la nouvelle ligne passe directement en mode edition inline.
                    </div>

                    <div class="form-group">
                        <label for="pieceQuickType">Type de piece <span class="text-danger">*</span></label>
                        <select id="pieceQuickType" name="type" class="form-control piece-quick-input" required>
                            {% for item in inlinePieceTypes|default([]) %}
                                <option value="{{ item.value }}" {% if item.value == 'Facture' %}selected{% endif %}>{{ item.label }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="pieceQuickTierType">Type de tiers <span class="text-danger">*</span></label>
                        <select id="pieceQuickTierType" name="typet" class="form-control piece-quick-input" required {% if (inlineTierTypes|default([]))|length <= 1 %}disabled{% endif %}>
                            {% for item in inlineTierTypes|default([]) %}
                                <option value="{{ item.value }}">{{ item.label }}</option>
                            {% endfor %}
                        </select>
                        {% if (inlineTierTypes|default([]))|length <= 1 %}
                            <input type="hidden" name="typet" value="{{ (inlineTierTypes|default([]))[0].value|default('Client') }}">
                        {% endif %}
                    </div>

                    <div class="form-group">
                        <label for="pieceQuickTierId">Tiers <span class="text-danger">*</span></label>
                        <select id="pieceQuickTierId" name="tierId" class="form-control piece-quick-input" required>
                            <option value="">Selectionner un tiers</option>
                        </select>
                    </div>

                    <div class="form-group" id="pieceQuickTierDestinationGroup" style="display:none;">
                        <label for="pieceQuickTierDestination">Tiers destination <span class="text-danger">*</span></label>
                        <select id="pieceQuickTierDestination" name="tierDestinationId" class="form-control piece-quick-input">
                            <option value="">Selectionner une destination interne</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="pieceQuickCodeOperation">Code operation</label>
                        <select id="pieceQuickCodeOperation" name="codeOperationId" class="form-control piece-quick-input">
                            <option value="">Auto</option>
                            {% for item in inlineCodeOperations|default([]) %}
                                <option value="{{ item.id }}">{{ item.label }} ({{ item.sens }})</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="pieceQuickReference">Reference</label>
                        <input id="pieceQuickReference" name="pieceref" type="text" class="form-control piece-quick-input" maxlength="255" placeholder="Reference optionnelle">
                    </div>

                    <input type="hidden" name="remise" value="0">
                    <input type="hidden" name="statut" value="Brouillon">

                    <div class="piece-quick-modal-actions">
