<script>
    (function() {
        function initPieceTransitions() {
            if (!window.jQuery) {
                return;
            }

            var pendingTransitionForm = null;
            var $transitionModal = $('#transitionConfirmModal');
            var $pieceName = $('#transitionModalPieceName');
            var $targetType = $('#transitionModalTargetType');
            var transitionDropdownNamespace = '.pieceTransitionDropdown';

            function prepareTransitionMenu($dropdown) {
                var $menu = $dropdown.data('pieceTransitionMenu');
                if ($menu && $menu.length && $menu.closest('body').length) {
                    return $menu;
                }

                $menu = $dropdown.find('.piece-transition-menu').first();
                if (!$menu.length) {
                    return $();
                }

                $dropdown.data('pieceTransitionMenu', $menu);
                return $menu;
            }

            function positionTransitionDropdown($dropdown, allowHiddenMeasure) {
                var $toggle = $dropdown.find('.btn-convert.dropdown-toggle').first();
                var $menu = prepareTransitionMenu($dropdown);
                if (!$toggle.length || !$menu.length || !$toggle[0]) {
                    return;
                }

                if (allowHiddenMeasure && !$menu.hasClass('show')) {
                    $menu.css({
                        display: 'block',
                        visibility: 'hidden'
                    });
                }

                var toggleRect = $toggle[0].getBoundingClientRect();
                var viewportWidth = Math.max(document.documentElement.clientWidth || 0, window.innerWidth || 0);
                var viewportHeight = Math.max(document.documentElement.clientHeight || 0, window.innerHeight || 0);
                var menuWidth = $menu.outerWidth();
                var menuHeight = $menu.outerHeight();
                var gap = 8;
                var gutter = 8;
                var left = toggleRect.left + (toggleRect.width / 2) - (menuWidth / 2);
                var top = toggleRect.bottom + gap;

                if (top + menuHeight > viewportHeight - gutter && toggleRect.top - menuHeight - gap > gutter) {
                    top = toggleRect.top - menuHeight - gap;
                }

                left = Math.max(gutter, Math.min(left, viewportWidth - menuWidth - gutter));
                top = Math.max(gutter, top);

                $menu.css({
                    position: 'fixed',
                    top: top + 'px',
                    left: left + 'px',
                    right: 'auto',
                    bottom: 'auto',
                    transform: 'none',
                    zIndex: 30000
                });

                if (allowHiddenMeasure && !$menu.hasClass('show')) {
                    $menu.css({
                        display: '',
                        visibility: ''
                    });
                    void $menu[0].offsetHeight;
                }
            }

            function positionOpenTransitionDropdowns() {
                $('.piece-transition-dropdown.show').each(function() {
                    positionTransitionDropdown($(this), false);
                });
            }

            function closeTransitionDropdown($dropdown) {
                var $menu = prepareTransitionMenu($dropdown);
                var $home = $menu.data('pieceTransitionHome');
                $dropdown.removeClass('show');
                $dropdown.find('.btn-convert.dropdown-toggle').attr('aria-expanded', 'false');
                $menu.removeClass('show').removeAttr('style');
                if ($home && $home.length) {
                    $menu.insertAfter($home);
                    $home.remove();
                }
            }

            function closeAllTransitionDropdowns($except) {
                $('.piece-transition-dropdown.show').each(function() {
                    var $dropdown = $(this);
                    if (!$except || !$except.length || $dropdown[0] !== $except[0]) {
                        closeTransitionDropdown($dropdown);
                    }
                });
            }

            function openTransitionDropdown($dropdown) {
                var $menu = prepareTransitionMenu($dropdown);
                if (!$menu.length) {
                    return;
                }
                closeAllTransitionDropdowns($dropdown);
                if (!$menu.data('pieceTransitionHome') || !$menu.data('pieceTransitionHome').length) {
                    $menu.data('pieceTransitionHome', $('<span class="piece-transition-menu-home"></span>').insertBefore($menu));
                }
                $menu.appendTo(document.body);
                $dropdown.addClass('show');
                $dropdown.find('.btn-convert.dropdown-toggle').attr('aria-expanded', 'true');
                $menu.addClass('show');
                positionTransitionDropdown($dropdown, false);
            }

            function initTransitionDropdown($dropdown) {
                if (!$dropdown || !$dropdown.length) {
                    return;
                }
                var $toggle = $dropdown.find('.btn-convert.dropdown-toggle').first();
                if (!$toggle.length) {
                    return;
                }
                if (typeof $toggle.dropdown === 'function') {
                    try {
                        $toggle.dropdown('dispose');
                    } catch (error) {
                        // Ignore stale Bootstrap instances.
                    }
                }
                $toggle.removeData('bs.dropdown');
                $dropdown.removeData('pieceTransitionMenu');
                $toggle.off('click' + transitionDropdownNamespace).on('click' + transitionDropdownNamespace, function(event) {
                    event.preventDefault();
                    event.stopPropagation();
                    event.stopImmediatePropagation();
                    if ($dropdown.hasClass('show')) {
                        closeTransitionDropdown($dropdown);
                    } else {
                        openTransitionDropdown($dropdown);
                    }
                });
            }

            function initTransitionDropdowns() {
                var $dropdowns = $('.piece-transition-dropdown');
                $dropdowns.off(transitionDropdownNamespace);
                $dropdowns.removeData('pieceTransitionMenu');
                $dropdowns.each(function() {
                    initTransitionDropdown($(this));
                });

                $(document)
                    .off('click' + transitionDropdownNamespace)
                    .on('click' + transitionDropdownNamespace, function(event) {
                        var $target = $(event.target);
                        if ($target.closest('.piece-transition-dropdown, .piece-transition-menu').length === 0) {
                            closeAllTransitionDropdowns();
                        }
                    });

                $(window)
                    .off('scroll' + transitionDropdownNamespace + ' resize' + transitionDropdownNamespace)
                    .on('scroll' + transitionDropdownNamespace + ' resize' + transitionDropdownNamespace, positionOpenTransitionDropdowns);
            }

            function refreshTransitionDropdowns() {
                window.requestAnimationFrame(function() {
                    initTransitionDropdowns();
                    window.setTimeout(initTransitionDropdowns, 0);
                });
            }

            window.initPieceTransitionDropdown = function(dropdown) {
                initTransitionDropdown($(dropdown));
            };
            window.refreshPieceTransitionDropdowns = refreshTransitionDropdowns;

            initTransitionDropdowns();

            $(document).off('submit.pieceTransition', '.js-piece-transition-form').on('submit.pieceTransition', '.js-piece-transition-form', function(e) {
                e.preventDefault();
                pendingTransitionForm = this;
                if (window.hideLoading) {
                    window.hideLoading();
                }

                var targetType = String($(this).data('target-type') || '').trim();
                var pieceLabel = String($(this).data('piece-label') || 'cette piece').trim();
                $targetType.text(targetType !== '' ? targetType : 'le type cible');
                $pieceName.text(pieceLabel);
                $transitionModal.modal('show');
            });

            $('#confirmTransitionBtn').off('click.pieceTransition').on('click.pieceTransition', function(e) {
                e.preventDefault();
                if (!pendingTransitionForm) {
                    return;
                }

                var formToSubmit = pendingTransitionForm;
                pendingTransitionForm = null;
                $transitionModal.modal('hide');

                if (window.showLoading) {
                    window.showLoading();
                }
                formToSubmit.submit();
            });

            $transitionModal.off('hidden.bs.modal.pieceTransition').on('hidden.bs.modal.pieceTransition', function() {
                pendingTransitionForm = null;
                if (window.hideLoading) {
                    window.hideLoading();
                }
            });

            $(document).off('click.pieceTransition', '.js-disabled-transition, .js-disabled-action').on('click.pieceTransition', '.js-disabled-transition, .js-disabled-action', function(e) {
                e.preventDefault();
                e.stopPropagation();
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPieceTransitions);
        } else {
            initPieceTransitions();
        }

        document.addEventListener('turbo:load', initPieceTransitions);
        document.addEventListener('turbo:render', initPieceTransitions);
    })();
</script>
<script>
    (function() {
        function initPieceListUx() {
            if (!window.jQuery) {
                return;
            }

            var $quickCreateModal = $('#pieceQuickCreateModal');
            var $quickCreateForm = $('#pieceQuickCreateForm');
            var $quickCreateSubmit = $('#pieceQuickCreateSubmit');
            var $pieceImportModal = $('#pieceImportModal');
            var $pieceImportForm = $('#pieceImportForm');
            var $pieceImportSubmit = $('#pieceImportSubmit');
            var quickCreateUrl = '{{ path('entetepiece.create_minimal') }}';
            var autoInlineEditId = '{{ app.request.query.get('inlineEditId')|default('')|e('js') }}';
            var importUrl = '{{ path('entetepiece.import') }}';
            var $table = $('#piecesTable');
            var $tbody = $('#piecesTableBody');
            var hasTable = $table.length > 0 && $tbody.length > 0;
            var inlineUpdateToken = hasTable ? String($table.data('inlineUpdateToken') || '').trim() : '';
            var bulkDeleteToken = hasTable ? String($table.data('bulkDeleteToken') || '').trim() : '';
            var bulkDeleteUrl = '{{ path('api.crud.bulk_delete', {resource: 'entetepiece'}) }}';
            var $bulkBar = $('#piecesBulkActions');
            var $deleteConfirmModal = $('#deleteConfirmModal');
            var $deleteModalItemName = $('#deleteModalItemName');
            var $confirmDeleteBtn = $('#confirmDeleteBtn');
            var $selectAll = $table.find('[data-select-all-checkbox]').first();
            var $columnSettings = $('.piece-column-settings-floating');
            var $columnSettingsToggle = $('#pieceColumnSettingsToggle');
            var pieceColumnStorageKey = 'piece-table-columns:{{ app.user ? app.user.id : "guest" }}:{{ app.user and app.user.currentDossier ? app.user.currentDossier.id : "0" }}';
            var mandatoryColumnKeys = ['selector', 'id', 'type', 'tier', 'actions'];
            var optionalColumnKeys = ['pieceno', 'pieceref', 'remise', 'montant', 'lignes', 'statut', 'codeoperation', 'devise', 'annee'];
            var columnPrefs = Object.create(null);
            var activeInlineRow = null;
            var rowClickTimer = null;
            var tierEndpointTemplate = '{{ path('entetepiece.tier_autocomplete', {tierType: '__TYPE__'}) }}';
            var tierOptionsCache = Object.create(null);
            var inlinePieceTypes = {{ inlinePieceTypes|default([])|json_encode|raw }};
            var inlinePieceStatuses = {{ inlinePieceStatuses|default([])|json_encode|raw }};
            var inlineDevises = {{ inlineDevises|default([])|json_encode|raw }};
            var inlineTierTypes = {{ inlineTierTypes|default([])|json_encode|raw }};
            var sensDisplayMap = {
                Entree: { className: 'piece-sens-badge piece-sens-badge--debit', icon: 'fa-arrow-down' },
                Sortie: { className: 'piece-sens-badge piece-sens-badge--credit', icon: 'fa-arrow-up' }
            };
            var bulkDeletePending = null;
            var isBulkDeleteSubmitting = false;

            function showPieceToast(message, type) {
                if (typeof window.showAppToast === 'function') {
                    window.showAppToast({ message: message, type: type || 'info' });
                    return;
                }
                window.alert(message);
            }

            function setBulkDeleteConfirmButtonLoading(isLoading) {
                if (!$confirmDeleteBtn.length) {
                    return;
                }

                var initialHtml = String($confirmDeleteBtn.data('bulk-initial-html') || '');
                if (!initialHtml) {
                    initialHtml = String($confirmDeleteBtn.html() || '');
                    $confirmDeleteBtn.data('bulk-initial-html', initialHtml);
                }

                if (isLoading) {
                    $confirmDeleteBtn
                        .addClass('bulk-delete-loading')
                        .html('<i class="fas fa-spinner fa-spin"></i>Suppression...');
                    return;
                }

                $confirmDeleteBtn
                    .removeClass('bulk-delete-loading')
                    .html(initialHtml);
            }

            function resetBulkDeleteConfirmState() {
                if ($confirmDeleteBtn.length) {
                    $confirmDeleteBtn.removeAttr('data-bulk-delete');
                }
                setBulkDeleteConfirmButtonLoading(false);
            }

            function openBulkDeleteConfirmation(selectedIds) {
                if (!$deleteConfirmModal.length || !$confirmDeleteBtn.length || !$deleteModalItemName.length) {
                    showPieceToast('La confirmation de suppression est indisponible.', 'error');
                    return;
                }

                var normalizedIds = Array.isArray(selectedIds)
                    ? selectedIds.map(function(idValue) { return String(idValue || '').trim(); }).filter(function(idValue) { return idValue !== ''; })
                    : [];

                if (!normalizedIds.length) {
                    showPieceToast('Selection vide.', 'error');
                    return;
                }

                bulkDeletePending = { ids: normalizedIds };
                var count = normalizedIds.length;
                var itemLabel = count > 1 ? ('ces ' + count + ' pieces') : 'cette piece';
                $deleteModalItemName.text(itemLabel);
                $confirmDeleteBtn.attr('href', '#').attr('data-bulk-delete', '1');
                setBulkDeleteConfirmButtonLoading(false);
                $deleteConfirmModal.modal('show');
            }

            function submitBulkDeleteSelection() {
                if (isBulkDeleteSubmitting || !bulkDeletePending || !Array.isArray(bulkDeletePending.ids) || !bulkDeletePending.ids.length) {
                    return;
                }
                if (bulkDeleteToken === '') {
                    showPieceToast('Jeton de suppression indisponible.', 'error');
                    return;
                }

                isBulkDeleteSubmitting = true;
                setBulkDeleteConfirmButtonLoading(true);
                var pendingSnapshot = bulkDeletePending;

                $.ajax({
                    url: bulkDeleteUrl,
                    method: 'POST',
                    contentType: 'application/json; charset=UTF-8',
                    dataType: 'json',
                    data: JSON.stringify({
                        _token: bulkDeleteToken,
                        ids: pendingSnapshot.ids
                    }),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                }).done(function(response) {
                    if (!response || response.success !== true) {
                        showPieceToast((response && response.message) ? response.message : 'Suppression impossible.', 'error');
                        return;
                    }

                    showPieceToast(response.message || 'Pieces supprimees.', 'success');
                    window.location.reload();
                }).fail(function(xhr) {
                    var message = 'Suppression impossible.';
                    if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
                        message = xhr.responseJSON.message;
                    }
                    showPieceToast(message, 'error');
                }).always(function() {
                    isBulkDeleteSubmitting = false;
                    setBulkDeleteConfirmButtonLoading(false);
                    if (!$deleteConfirmModal.hasClass('show')) {
                        bulkDeletePending = null;
                        resetBulkDeleteConfirmState();
                    }
                });
            }

            function parseNumber(value) {
                var normalized = String(value || '')
                    .replace(/[%\s\u00a0\u202f]/g, '')
                    .replace(',', '.')
                    .trim();
                if (normalized === '') {
                    return 0;
                }
                var parsed = parseFloat(normalized);
                return Number.isFinite(parsed) ? parsed : 0;
            }

            function formatNumber(value) {
                return parseNumber(value).toLocaleString('fr-FR', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }

            function formatRemise(value) {
                return formatNumber(value) + '%';
            }

            function escapeHtml(value) {
                return String(value || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function fallbackDisplay(value) {
                var normalized = $.trim(String(value || ''));
                return normalized === '' ? '____' : normalized;
            }

            function normalizeToken(value) {
                var normalized = String(value || '').toLowerCase();
                if (typeof normalized.normalize === 'function') {
                    normalized = normalized.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
                }
                return normalized.replace(/[^a-z0-9]/g, '');
            }

            function resolveStatusBadgeClass(statusValue) {
                var statusKey = normalizeToken(statusValue);
                if (statusKey === 'validee' || statusKey === 'valide') {
                    return 'badge badge-success badge-lg';
                }
                if (statusKey === 'brouillon') {
                    return 'badge badge-secondary badge-lg';
                }
                if (statusKey === 'active') {
                    return 'badge badge-info badge-lg';
                }
                if (statusKey === 'perimee' || statusKey === 'perime' || statusKey === 'archivee' || statusKey === 'archive') {
                    return 'badge badge-danger badge-lg';
                }
                return 'badge badge-warning badge-lg';
            }

            function buildCodeOperationBadgeHtml(label, sens) {
                var displayLabel = fallbackDisplay(label);
                var safeLabel = escapeHtml(displayLabel);
                var sensLabel = String(sens || '').trim();
                var config = sensDisplayMap[sensLabel] || null;
                if (!config) {
                    return '<span class="piece-sens-badge">' + safeLabel + '</span>';
                }
                return '<span class="' + escapeHtml(config.className) + '"><i class="fas ' + escapeHtml(config.icon) + '"></i>' + safeLabel + '</span>';
            }

            function getTierTypeOptions() {
                return Array.isArray(inlineTierTypes) ? inlineTierTypes : [];
            }

            function getDefaultTierTypeValue() {
                var options = getTierTypeOptions();
                return options.length > 0 ? String(options[0].value || '') : 'Client';
            }

            function mapTierItems(items) {
                var mapped = [];
                (items || []).forEach(function(item) {
                    var id = String(item.id || '').trim();
                    var label = String(item.name || item.label || '').trim();
                    if (id === '' || label === '') {
                        return;
                    }
                    mapped.push({
                        value: id,
                        label: label
                    });
                });
                return mapped;
            }

            function fetchTierOptions(tierType, forceReload) {
                var deferred = $.Deferred();
                var normalizedType = normalizeToken(tierType);
                if (normalizedType === '') {
                    deferred.resolve([]);
                    return deferred.promise();
                }

                if (!forceReload && Array.isArray(tierOptionsCache[normalizedType])) {
                    deferred.resolve(tierOptionsCache[normalizedType]);
                    return deferred.promise();
                }

                var endpoint = tierEndpointTemplate.replace('__TYPE__', encodeURIComponent(String(tierType || '').trim()));
                $.ajax({
                    url: endpoint,
                    method: 'GET',
                    dataType: 'json',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                }).done(function(response) {
                    var mapped = mapTierItems(response);
                    tierOptionsCache[normalizedType] = mapped;
                    deferred.resolve(mapped);
                }).fail(function() {
                    deferred.resolve([]);
                });

                return deferred.promise();
            }

            function getRows() {
                return $tbody.find('.piece-row');
            }

            function getRowCheckbox($row) {
                return $row.find('[data-row-checkbox]').first();
            }

            function getSelectedIds() {
                var selectedIds = [];
                getRows().each(function() {
                    var $row = $(this);
                    var $checkbox = getRowCheckbox($row);
                    if ($checkbox.is(':checked')) {
                        var rawId = String($row.attr('data-item-id') || '').trim();
                        if (!/^\d+$/.test(rawId)) {
                            return;
                        }
                        selectedIds.push(rawId);
                    }
                });
                return selectedIds;
            }

            function updateSelectionUi() {
                var $rows = getRows();
                var totalRows = $rows.length;
                var selectedIds = getSelectedIds();
                var selectedCount = selectedIds.length;
                var allSelected = totalRows > 0 && selectedCount === totalRows;

                $rows.each(function() {
                    var $row = $(this);
                    $row.toggleClass('is-selected', getRowCheckbox($row).is(':checked'));
                });

                if ($selectAll.length) {
                    $selectAll.prop('checked', allSelected);
                    $selectAll.prop('indeterminate', selectedCount > 0 && !allSelected);
                }

                if ($bulkBar.length) {
                    $bulkBar.toggleClass('is-visible', selectedCount > 0);
                    $bulkBar.find('[data-selection-count]').text(selectedCount);
                    $bulkBar.find('[data-selection-label]').text(
                        selectedCount > 1
                            ? selectedCount + ' pieces selectionnees'
                            : (selectedCount === 1 ? '1 piece selectionnee' : 'Aucune piece selectionnee')
                    );
                }
            }

            function isEditableRow($row) {
                return String($row.attr('data-inline-editable') || '') === '1';
            }

            function readSnapshot($row) {
                var typeValue = String($row.attr('data-type-value') || '').trim();
                var tierType = String($row.attr('data-tier-type') || '').trim();
                var tierId = String($row.attr('data-tier-id') || '').trim();
                var tierLabel = String($row.attr('data-tier-label') || '').trim();
                var piecerefValue = String($row.attr('data-piece-ref-value') || '').trim();
                var remiseValue = parseNumber(String($row.attr('data-remise-value') || '0'));
                var statutValue = String($row.attr('data-statut-value') || '').trim();
                var statutLabel = String($row.attr('data-statut-label') || '').trim();
                var deviseId = String($row.attr('data-devise-id') || '').trim();
                var deviseLabel = String($row.attr('data-devise-label') || '').trim();
                var anneeValue = String($row.attr('data-annee-value') || '').trim();

                return {
                    typeValue: typeValue,
                    tierType: tierType || getDefaultTierTypeValue(),
                    tierId: tierId,
                    tierLabel: tierLabel,
                    piecerefValue: piecerefValue,
                    piecerefDisplay: piecerefValue !== '' ? piecerefValue : '____',
                    remiseValue: remiseValue,
                    remiseDisplay: formatRemise(remiseValue),
                    statutValue: statutValue,
                    statutLabel: statutLabel,
                    deviseId: deviseId,
                    deviseLabel: deviseLabel,
                    anneeValue: anneeValue
                };
            }

            function restoreRowSnapshot($row, snapshot) {
                $row.find('td[data-field="type"]').html('<span class="badge badge-primary badge-lg">' + escapeHtml(fallbackDisplay(snapshot.typeValue)) + '</span>');
                $row.find('td[data-field="tier"]').text(fallbackDisplay(snapshot.tierLabel));
                $row.find('td[data-field="pieceref"]').text(snapshot.piecerefDisplay);
                $row.find('td[data-field="remise"]').text(snapshot.remiseDisplay);
                $row.find('td[data-field="statut"]').html('<span class="' + resolveStatusBadgeClass(snapshot.statutValue) + '">' + escapeHtml(fallbackDisplay(snapshot.statutLabel)) + '</span>');
                $row.find('td[data-field="devise"]').text(fallbackDisplay(snapshot.deviseLabel));
                $row.find('td[data-field="annee"]').text(snapshot.anneeValue !== '' ? snapshot.anneeValue : '-');
            }

            function closeDropdowns(exceptShell) {
                $table.find('.inline-dropdown-shell.is-open').each(function() {
                    var $shell = $(this);
                    if (exceptShell && $shell.is(exceptShell)) {
                        return;
                    }
                    $shell.removeClass('is-open');
                });
            }

            function positionDropdownMenu($shell) {
                if (!$shell || !$shell.length) {
                    return;
                }
                var $menu = $shell.find('.inline-dropdown-menu').first();
                if (!$menu.length) {
                    return;
                }
                var triggerRect = $shell[0].getBoundingClientRect();
                var menuWidth = $menu.outerWidth() || 220;
                var menuHeight = $menu.outerHeight() || 300;
                var viewportHeight = window.innerHeight;
                var viewportWidth = window.innerWidth;
                var scrollLeft = window.pageXOffset || document.documentElement.scrollLeft;
                var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                
                // Try to position below the trigger first
                var top = triggerRect.bottom + scrollTop + 8;
                var left = triggerRect.left + scrollLeft;
                
                // Check if menu goes below viewport, if so position above
                if (triggerRect.bottom + menuHeight + 16 > viewportHeight) {
                    top = triggerRect.top + scrollTop - menuHeight - 8;
                }
                
                // Check if menu goes right of viewport, if so align to right side of viewport
                if (left + menuWidth > viewportWidth - 10) {
                    left = Math.max(10, viewportWidth - menuWidth - 10) + scrollLeft;
                }
                
                // Ensure menu doesn't go off left side
                if (left < 10) {
                    left = 10 + scrollLeft;
                }
                
                // Ensure menu is at least 10px from top
                if (top < 10) {
                    top = 10 + scrollTop;
                }
                
                $menu.css({
                    top: top + 'px',
                    left: left + 'px'
                });
            }
            
            function openDropdownShell($shell) {
                if (!$shell || !$shell.length) {
                    return;
                }
                closeDropdowns($shell);
                $shell.addClass('is-open');
                positionDropdownMenu($shell);
            }

            function createDropdownOption(value, label, isActive) {
                return $('<button type="button" class="inline-dropdown-option"></button>')
                    .attr('data-value', value)
                    .attr('data-label', label)
                    .toggleClass('is-active', !!isActive)
                    .text(label);
            }

            function setDropdownValue($shell, value, label) {
                $shell.attr('data-value', String(value || ''));
                $shell.find('.inline-dropdown-label').text(fallbackDisplay(label));
                $shell.find('.inline-dropdown-option').removeClass('is-active');
                $shell.find('.inline-dropdown-option').filter(function() {
                    return String($(this).attr('data-value') || '') === String(value || '');
                }).first().addClass('is-active');
            }

            function buildInlineDropdown(options, selectedValue, selectedLabel, emptyLabel) {
                var normalizedSelectedValue = String(selectedValue || '');
                var $shell = $('<div class="inline-dropdown-shell"></div>').attr('data-value', normalizedSelectedValue);
                var $label = $('<span class="inline-dropdown-label"></span>').text(fallbackDisplay(selectedLabel));
                var $trigger = $('<button type="button" class="inline-dropdown-trigger" aria-label="Ouvrir la liste"><i class="fas fa-chevron-down"></i></button>');
                var $menu = $('<div class="inline-dropdown-menu"></div>');

                $menu.append(createDropdownOption('', emptyLabel, normalizedSelectedValue === ''));
                (options || []).forEach(function(option) {
                    var optionValue = String(option.value || option.id || '');
                    var optionLabel = String(option.label || option.name || optionValue);
                    $menu.append(createDropdownOption(optionValue, optionLabel, optionValue === normalizedSelectedValue));
                });

                $shell.append($label, $trigger, $menu);
                return $shell;
            }

            function focusEditableField($row, fieldName) {
                if (!$row || !$row.length || !$row.hasClass('is-editing')) {
                    return;
                }

                if (!fieldName || fieldName === 'pieceref') {
                    $row.find('.piece-inline-text[data-field="pieceref"]').trigger('focus');
                    return;
                }

                if (fieldName === 'remise' || fieldName === 'annee') {
                    $row.find('.piece-inline-text[data-field="' + fieldName + '"]').trigger('focus');
                    return;
                }

                if (fieldName === 'tier') {
                    openDropdownShell($row.find('.inline-dropdown-shell[data-name="tierId"]').first());
                    $row.find('.inline-dropdown-shell[data-name="tierId"] .inline-dropdown-trigger').trigger('focus');
                    return;
                }

                var dropdownName = fieldName;
                if (fieldName === 'devise') {
                    dropdownName = 'deviseId';
                } else if (fieldName === 'statut') {
                    dropdownName = 'statut';
                } else if (fieldName === 'type') {
                    dropdownName = 'type';
                }
                openDropdownShell($row.find('.inline-dropdown-shell[data-name="' + dropdownName + '"]').first());
                $row.find('.inline-dropdown-shell[data-name="' + dropdownName + '"] .inline-dropdown-trigger').trigger('focus');
            }

            function getEditValues($row) {
                var tierTypeValue = String($row.attr('data-tier-type') || '').trim();
                var tierIdValue = String($row.find('.inline-dropdown-shell[data-name="tierId"]').attr('data-value') || '').trim();

                if (tierTypeValue === '') {
                    tierTypeValue = String($row.attr('data-tier-type') || '').trim();
                }
                if (tierIdValue === '') {
                    tierIdValue = String($row.attr('data-tier-id') || '').trim();
                }

                return {
                    type: String($row.find('.inline-dropdown-shell[data-name="type"]').attr('data-value') || ''),
                    typet: tierTypeValue,
                    tierId: tierIdValue,
                    pieceref: $.trim($row.find('.piece-inline-text[data-field="pieceref"]').text() || ''),
                    remise: $.trim($row.find('.piece-inline-text[data-field="remise"]').text() || ''),
                    statut: String($row.find('.inline-dropdown-shell[data-name="statut"]').attr('data-value') || ''),
                    deviseId: String($row.find('.inline-dropdown-shell[data-name="deviseId"]').attr('data-value') || ''),
                    annee: $.trim($row.find('.piece-inline-text[data-field="annee"]').text() || '')
                };
            }

            function applySavedState($row, item) {
                var pieceRefValue = String(item.pieceref || '');
                var pieceRefDisplay = String(item.piecerefDisplay || (pieceRefValue !== '' ? pieceRefValue : '____'));
                var remiseValue = parseNumber(item.remise);
                var remiseDisplay = String(item.remiseDisplay || formatRemise(remiseValue));
                var tierLabel = String(item.tier || '');
                var statutLabel = String(item.statutLabel || item.statut || '');
                var deviseLabel = String(item.devise || '');
                var anneeValue = String(item.annee || '');
                var codeOperationLabel = String(item.codeOperationLabel || '');
                var codeOperationSens = String(item.sens || '');

                $row.attr('data-inline-editable', item.canEdit ? '1' : '0');
                $row.attr('data-inline-update-url', String(item.inlineUpdateUrl || $row.attr('data-inline-update-url') || ''));
                $row.attr('data-type-value', String(item.type || ''));
                $row.attr('data-tier-type', String(item.typet || ''));
                $row.attr('data-tier-id', String(item.tierId || ''));
                $row.attr('data-tier-label', tierLabel);
                $row.attr('data-code-operation-id', String(item.codeOperationId || ''));
                $row.attr('data-code-operation-label', codeOperationLabel);
                $row.attr('data-code-operation-sens', codeOperationSens);
                $row.attr('data-piece-ref-value', pieceRefValue);
                $row.attr('data-remise-value', remiseValue.toFixed(2));
                $row.attr('data-statut-value', String(item.statut || ''));
                $row.attr('data-statut-label', statutLabel);
                $row.attr('data-devise-id', String(item.deviseId || ''));
                $row.attr('data-devise-label', deviseLabel);
                $row.attr('data-annee-value', anneeValue);

                if (item.pieceno) {
                    $row.find('td[data-column-key="pieceno"]').html('<strong>' + escapeHtml(String(item.pieceno)) + '</strong>');
                }
                if (typeof item.montantDisplay !== 'undefined') {
                    $row.find('td[data-column-key="montant"]').html('<strong>' + escapeHtml(String(item.montantDisplay)) + '</strong>');
                }
                if (typeof item.lignes !== 'undefined') {
                    var lineCount = parseInt(item.lignes, 10);
                    if (!Number.isFinite(lineCount)) {
                        lineCount = 0;
                    }
                    var lineBadgeClass = lineCount > 0 ? 'badge badge-success' : 'badge badge-warning';
                    $row.find('td[data-column-key="lignes"]').html('<span class="' + lineBadgeClass + '">' + lineCount + '</span>');
                }
                $row.find('td[data-column-key="codeoperation"]').html(buildCodeOperationBadgeHtml(codeOperationLabel, codeOperationSens));
                if (item.deleteUrl) {
                    $row.find('.delete-btn').attr('data-delete-url', item.deleteUrl);
                }
                $row.find('.delete-btn').attr('data-item-name', 'Piece #' + String(item.pieceno || item.id || ''));
                if (item.editUrl) {
                    $row.find('.js-piece-view-link').attr('href', item.editUrl);
                }

                restoreRowSnapshot($row, readSnapshot($row));
            }

            function closeInlineEdit($row, restoreSnapshot) {
                if (!$row || !$row.length) {
                    return;
                }

                var snapshot = $row.data('inlineSnapshot') || null;
                if (restoreSnapshot && snapshot) {
                    restoreRowSnapshot($row, snapshot);
                }

                $row.find('.piece-inline-actions').remove();
                $row.find('.piece-actions').removeClass('d-none');
                $row.removeClass('is-editing is-saving').removeData('inlineSnapshot');
                closeDropdowns();

                if (activeInlineRow && activeInlineRow[0] === $row[0]) {
                    activeInlineRow = null;
                }
            }

            function renderTierSelectorForRow($row, tierTypeValue, selectedTierId, selectedTierLabel) {
                fetchTierOptions(tierTypeValue, false).done(function(tierOptions) {
                    if (!$row || !$row.length || !$row.hasClass('is-editing')) {
                        return;
                    }

                    var $tierSelectorHost = $row.find('.piece-inline-tier-selector').first();
                    if (!$tierSelectorHost.length) {
                        return;
                    }

                    var tierShell = buildInlineDropdown(tierOptions, selectedTierId, selectedTierLabel, 'Selectionner un tiers').attr('data-name', 'tierId');
                    $tierSelectorHost.empty().append(tierShell);
                    
                    // Ensure the value is set on the shell
                    if (selectedTierId && selectedTierId !== '') {
                        $tierSelectorHost.find('.inline-dropdown-shell').attr('data-value', selectedTierId);
                    }
                });
            }

            function beginInlineEdit($row, focusField, forceTierType) {
                if (!$row.length || !isEditableRow($row)) {
                    return;
                }

                if (activeInlineRow && activeInlineRow.length && activeInlineRow[0] !== $row[0]) {
                    closeInlineEdit(activeInlineRow, true);
                }

                if ($row.hasClass('is-editing')) {
                    focusEditableField($row, focusField);
                    return;
                }

                var snapshot = readSnapshot($row);
                $row.data('inlineSnapshot', snapshot);
                var selectedTierType = String(forceTierType || snapshot.tierType || getDefaultTierTypeValue());

                $row.find('td[data-field="type"]').html(
                    buildInlineDropdown(inlinePieceTypes, snapshot.typeValue, snapshot.typeValue, 'Selectionner').attr('data-name', 'type')
                );
                $row.find('td[data-field="tier"]').html(
                    '<div class="piece-inline-tier-edit">' +
                        '<div class="piece-inline-tier-selector"></div>' +
                    '</div>'
                );
                renderTierSelectorForRow($row, selectedTierType, snapshot.tierId, snapshot.tierLabel);

                $row.find('td[data-field="pieceref"]').html(
                    $('<span class="piece-inline-text inline-editable-text" contenteditable="true" spellcheck="false" data-field="pieceref"></span>').text(snapshot.piecerefValue)
                );
                $row.find('td[data-field="remise"]').html(
                    $('<span class="piece-inline-text inline-editable-text text-right" contenteditable="true" spellcheck="false" data-field="remise"></span>').text(formatNumber(snapshot.remiseValue))
                );
                $row.find('td[data-field="statut"]').html(
                    buildInlineDropdown(inlinePieceStatuses, snapshot.statutValue, snapshot.statutLabel, 'Statut').attr('data-name', 'statut')
                );
                var deviseOptions = (inlineDevises || []).map(function(item) {
                    var code = String(item.code || '');
                    var label = String(item.label || '');
                    return {
                        value: String(item.id || ''),
                        label: code !== '' ? (code + (label !== '' ? ' - ' + label : '')) : label
                    };
                });
                $row.find('td[data-field="devise"]').html(
                    buildInlineDropdown(deviseOptions, snapshot.deviseId, snapshot.deviseLabel, 'Devise').attr('data-name', 'deviseId')
                );
                $row.find('td[data-field="annee"]').html(
                    $('<span class="piece-inline-text inline-editable-text" contenteditable="true" spellcheck="false" data-field="annee"></span>').text(snapshot.anneeValue || '')
                );

                var $actions = $row.find('.piece-actions').first();
                $actions.addClass('d-none');
                $actions.after(
                    '<div class="piece-inline-actions">' +
                        '<button type="button" class="btn btn-action btn-view js-piece-inline-lignes" title="Gérer les lignes"><i class="fas fa-list"></i></button>' +
                        '<button type="button" class="btn btn-action btn-view js-piece-inline-save" title="Enregistrer"><i class="fas fa-check"></i></button>' +
                        '<button type="button" class="btn btn-action btn-delete js-piece-inline-cancel" title="Annuler"><i class="fas fa-times"></i></button>' +
                    '</div>'
                );

                $row.addClass('is-editing');
                activeInlineRow = $row;
                focusEditableField($row, focusField || 'tier');
            }

            function saveInlineEdit($row) {
                if (!$row.length || !$row.hasClass('is-editing')) {
                    return;
                }

                var updateUrl = String($row.attr('data-inline-update-url') || '').trim();
                if (updateUrl === '' || inlineUpdateToken === '') {
                    showPieceToast('Edition inline indisponible.', 'error');
                    return;
                }

                var values = getEditValues($row);
                var remise = parseNumber(values.remise);
                var annee = $.trim(String(values.annee || ''));

                if (remise < 0) {
                    showPieceToast('La remise ne peut pas etre negative.', 'error');
                    return;
                }

                if (values.tierId === '') {
                    showPieceToast('Le tiers est obligatoire.', 'error');
                    focusEditableField($row, 'tier');
                    return;
                }

                if ($.trim(String(values.type || '')) === '') {
                    showPieceToast('Le type de piece est obligatoire.', 'error');
                    focusEditableField($row, 'type');
                    return;
                }

                if ($.trim(String(values.typet || '')) === '') {
                    showPieceToast('Le type de tiers est obligatoire.', 'error');
                    focusEditableField($row, 'tier');
                    return;
                }

                if (annee !== '' && !/^\d{4}$/.test(annee)) {
                    showPieceToast('L annee doit contenir 4 chiffres.', 'error');
                    focusEditableField($row, 'annee');
                    return;
                }

                $row.addClass('is-saving');
                $row.find('.js-piece-inline-save, .js-piece-inline-cancel, .inline-dropdown-trigger, .inline-dropdown-option').prop('disabled', true);

                var currentCodeOperationId = String($row.attr('data-code-operation-id') || '').trim();
                $.ajax({
                    url: updateUrl,
                    method: 'POST',
                    dataType: 'json',
                    data: {
                        _token: inlineUpdateToken,
                        type: values.type,
                        typet: values.typet,
                        tierId: values.tierId,
                        pieceref: values.pieceref,
                        remise: remise.toFixed(2),
                        statut: values.statut,
                        deviseId: values.deviseId,
                        annee: annee,
                        codeOperationId: currentCodeOperationId
                    },
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                }).done(function(response) {
                    if (!response || response.success !== true || !response.item) {
                        showPieceToast((response && response.message) ? response.message : 'La mise a jour a echoue.', 'error');
                        $row.removeClass('is-saving');
                        $row.find('.js-piece-inline-save, .js-piece-inline-cancel, .inline-dropdown-trigger, .inline-dropdown-option').prop('disabled', false);
                        return;
                    }

                    applySavedState($row, response.item);
                    closeInlineEdit($row, false);
                    var $actionCell = $row.find('.piece-actions-cell');
                    $actionCell.html(buildPieceActionsCell(response.item));
                    $actionCell.find('.piece-transition-dropdown').each(function() {
                        if (typeof window.initPieceTransitionDropdown === 'function') {
                            window.initPieceTransitionDropdown(this);
                        }
                    });
                    
                    $row.addClass('is-saved');
                    window.setTimeout(function() {
                        $row.removeClass('is-saved');
                    }, 900);

                    showPieceToast(response.message || 'Piece mise a jour avec succes.', 'success');
                }).fail(function(xhr) {
                    var message = 'La mise a jour a echoue.';
                    if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
                        message = xhr.responseJSON.message;
                    }
                    showPieceToast(message, 'error');
                    $row.removeClass('is-saving');
                    $row.find('.js-piece-inline-save, .js-piece-inline-cancel, .inline-dropdown-trigger, .inline-dropdown-option').prop('disabled', false);
                });
            }

            function buildPieceActionsCell(item) {
                var canEdit = !!item.canEdit;
                var canView = !!item.canView;
                var canOpenEinvoicing = !!item.canOpenEinvoicing;
                var transitionTargets = Array.isArray(item.transitionTargets) ? item.transitionTargets : [];
                var transitionEnabled = !!item.transitionEnabled && transitionTargets.length > 0;
                var editUrl = String(item.editUrl || '#');
                var deleteUrl = String(item.deleteUrl || '#');
                var transitionUrl = String(item.transitionUrl || '#');
                var transitionToken = String(item.transitionToken || '');
                var eInvoicingUrl = String(item.eInvoicingUrl || '#');
                var transitionToggleId = 'pieceTransitionToggle_' + String(item.id || item.pieceno || '').replace(/[^A-Za-z0-9_-]/g, '');
                var inlineDisabledClass = canEdit ? '' : ' is-disabled-ui js-disabled-action';
                var inlineDisabledTitle = canEdit ? 'Modifier' : 'Action indisponible';
                var transitionDisabledTitle = String(item.transitionDisabledReason || 'Validez la piece pour pouvoir la convertir');
                var einvoicingDisabledTitle = String(item.einvoicingDisabledReason || 'Validez la piece pour activer la e-facturation');

                var html = '<div class="piece-actions">';
                html += '<span class="piece-action-slot">';
                if (canView) {
                    html += '<a href="' + escapeHtml(editUrl) + '" class="btn btn-action btn-view js-piece-view-link" title="Voir les details (lecture seule)"><i class="fas fa-eye"></i></a>';
                } else {
                    html += '<button type="button" class="btn btn-action btn-edit js-piece-inline-edit' + inlineDisabledClass + '" title="' + escapeHtml(inlineDisabledTitle) + '"><i class="fas fa-edit"></i></button>';
                }
                html += '</span>';
                html += '<span class="piece-action-slot">';
                if (transitionEnabled) {
                    html += '<div class="dropdown d-inline-block piece-transition-dropdown">';
                    html += '<button id="' + escapeHtml(transitionToggleId) + '" class="btn btn-action btn-convert dropdown-toggle no-loading" type="button" aria-haspopup="true" aria-expanded="false" title="Convertir cette piece"><i class="fas fa-random"></i></button>';
                    html += '<div class="dropdown-menu dropdown-menu-right shadow-sm piece-transition-menu" aria-labelledby="' + escapeHtml(transitionToggleId) + '">';
                    transitionTargets.forEach(function(targetType) {
                        html += '<form method="post" action="' + escapeHtml(transitionUrl) + '" class="js-piece-transition-form no-loading px-2 py-1" data-target-type="' + escapeHtml(String(targetType)) + '" data-piece-label="Piece #' + escapeHtml(String(item.pieceno || item.id || '')) + '">';
                        html += '<input type="hidden" name="targetType" value="' + escapeHtml(String(targetType)) + '">';
                        html += '<input type="hidden" name="_token" value="' + escapeHtml(transitionToken) + '">';
                        html += '<button type="submit" class="dropdown-item">Vers ' + escapeHtml(String(targetType)) + '</button>';
                        html += '</form>';
                    });
                    html += '</div></div>';
                } else {
                    html += '<button type="button" class="btn btn-action btn-convert is-disabled-ui js-disabled-action" title="' + escapeHtml(transitionDisabledTitle) + '"><i class="fas fa-random"></i></button>';
                }
                html += '</span>';
                if (canOpenEinvoicing) {
                    html += '<span class="piece-action-slot"><a href="' + escapeHtml(eInvoicingUrl) + '" class="btn btn-action btn-einvoicing no-loading" title="Ouvrir la page e-facturation"><i class="fas fa-file-pdf"></i></a></span>';
                } else {
                    html += '<span class="piece-action-slot"><button type="button" class="btn btn-action btn-einvoicing is-disabled-ui js-disabled-action" title="' + escapeHtml(einvoicingDisabledTitle) + '"><i class="fas fa-file-invoice"></i></button></span>';
                }
                html += '<span class="piece-action-slot"><button type="button" class="btn btn-action btn-delete delete-btn" data-delete-url="' + escapeHtml(deleteUrl) + '" data-item-name="Piece #' + escapeHtml(String(item.pieceno || item.id || '')) + '" title="Supprimer"><i class="fas fa-trash"></i></button></span>';
                html += '</div>';
                return html;
            }

            function buildPieceRow(item) {
                var id = String(item.id || '');
                var row = [
                    '<tr class="piece-row is-new-unsaved" data-row-id="' + escapeHtml(id) + '" data-item-id="' + escapeHtml(id) + '"' +
                        ' data-inline-editable="' + (item.canEdit ? '1' : '0') + '"' +
                        ' data-inline-update-url="' + escapeHtml(String(item.inlineUpdateUrl || '')) + '"' +
                        ' data-type-value="' + escapeHtml(String(item.type || '')) + '"' +
                        ' data-tier-type="' + escapeHtml(String(item.typet || '')) + '"' +
                        ' data-tier-id="' + escapeHtml(String(item.tierId || '')) + '"' +
                        ' data-tier-label="' + escapeHtml(String(item.tier || '')) + '"' +
                        ' data-code-operation-id="' + escapeHtml(String(item.codeOperationId || '')) + '"' +
                        ' data-code-operation-label="' + escapeHtml(String(item.codeOperationLabel || '')) + '"' +
                        ' data-code-operation-sens="' + escapeHtml(String(item.sens || '')) + '"' +
                        ' data-piece-ref-value="' + escapeHtml(String(item.pieceref || '')) + '"' +
                        ' data-remise-value="' + escapeHtml(String(parseNumber(item.remise).toFixed(2))) + '"' +
                        ' data-statut-value="' + escapeHtml(String(item.statut || '')) + '"' +
                        ' data-statut-label="' + escapeHtml(String(item.statutLabel || item.statut || '')) + '"' +
                        ' data-devise-id="' + escapeHtml(String(item.deviseId || '')) + '"' +
                        ' data-devise-label="' + escapeHtml(String(item.devise || '')) + '"' +
                        ' data-annee-value="' + escapeHtml(String(item.annee || '')) + '"' +
                        ' tabindex="0">',
                        '<td class="row-selector-cell" data-column-key="selector"><div class="form-check d-flex justify-content-center mb-0"><input class="form-check-input position-static piece-row-checkbox" type="checkbox" value="' + escapeHtml(id) + '" data-row-checkbox aria-label="Selectionner la piece ' + escapeHtml(String(item.pieceno || item.id || '')) + '"></div></td>',
                        '<td data-column-key="id"><strong>#' + escapeHtml(id) + '</strong></td>',
                        '<td data-field="type" data-column-key="type"><span class="badge badge-primary badge-lg">' + escapeHtml(fallbackDisplay(item.type)) + '</span></td>',
                        '<td data-field="tier" data-column-key="tier">' + escapeHtml(fallbackDisplay(item.tier)) + '</td>',
                        '<td data-column-key="pieceno"><strong>' + escapeHtml(String(item.pieceno || '')) + '</strong></td>',
                        '<td data-field="pieceref" data-column-key="pieceref">' + escapeHtml(fallbackDisplay(item.piecerefDisplay || item.pieceref || '')) + '</td>',
                        '<td class="text-right" data-field="remise" data-column-key="remise">' + escapeHtml(String(item.remiseDisplay || formatRemise(item.remise || 0))) + '</td>',
                        '<td class="text-right" data-column-key="montant"><strong>' + escapeHtml(String(item.montantDisplay || formatNumber(item.montant || 0))) + '</strong></td>',
                        '<td class="text-center" data-column-key="lignes"><span class="' + ((parseInt(item.lignes, 10) || 0) > 0 ? 'badge badge-success' : 'badge badge-warning') + '">' + escapeHtml(String(item.lignes || 0)) + '</span></td>',
                        '<td data-field="statut" data-column-key="statut"><span class="' + resolveStatusBadgeClass(item.statut) + '">' + escapeHtml(fallbackDisplay(item.statutLabel || item.statut || '-')) + '</span></td>',
                        '<td data-column-key="codeoperation">' + buildCodeOperationBadgeHtml(item.codeOperationLabel || '', item.sens || '') + '</td>',
                        '<td data-field="devise" data-column-key="devise">' + escapeHtml(fallbackDisplay(item.devise || '')) + '</td>',
                        '<td data-field="annee" data-column-key="annee">' + escapeHtml(String(item.annee || '-')) + '</td>',
                        '<td class="text-center piece-actions-cell" data-column-key="actions" data-role="actions">' + buildPieceActionsCell(item) + '</td>',
                    '</tr>'
                ].join('');
                return $(row);
            }

            function appendCreatedRow(item) {
                if (!hasTable) {
                    window.location.reload();
                    return null;
                }
                var $row = buildPieceRow(item);
                $tbody.prepend($row);
                applyColumnPrefs();
                updateSelectionUi();
                $row[0].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                window.setTimeout(function() {
                    $row.removeClass('is-new-unsaved');
                }, 1200);
                return $row;
            }

            function loadQuickCreateTiers(selectedTierId) {
                var $tierType = $('#pieceQuickTierType');
                var $tierSelect = $('#pieceQuickTierId');
                if (!$tierSelect.length) {
                    return;
                }

                var tierType = String($tierType.val() || getDefaultTierTypeValue());
                fetchTierOptions(tierType, true).done(function(options) {
                    $tierSelect.empty().append('<option value="">Selectionner un tiers</option>');
                    options.forEach(function(option) {
                        var $option = $('<option></option>').attr('value', option.value).text(option.label);
                        $tierSelect.append($option);
                    });
                    if (selectedTierId) {
                        $tierSelect.val(String(selectedTierId));
                    }
                });
            }

            function readColumnPrefs() {
                try {
                    var parsed = JSON.parse(window.localStorage.getItem(pieceColumnStorageKey) || '{}');
                    if (parsed && typeof parsed === 'object') {
                        columnPrefs = parsed;
                    }
                } catch (error) {
                    columnPrefs = Object.create(null);
                }
                if (!Object.prototype.hasOwnProperty.call(columnPrefs, 'codeoperation')) {
                    columnPrefs.codeoperation = false;
                }
            }

            function writeColumnPrefs() {
                try {
                    window.localStorage.setItem(pieceColumnStorageKey, JSON.stringify(columnPrefs));
                } catch (error) {
                    // Ignore storage failures.
                }
            }

            function isColumnVisible(columnKey) {
                if (mandatoryColumnKeys.indexOf(columnKey) !== -1) {
                    return true;
                }
                return columnPrefs[columnKey] !== false;
            }

            function applyColumnPrefs() {
                optionalColumnKeys.forEach(function(columnKey) {
                    var visible = isColumnVisible(columnKey);
                    $table.find('[data-column-key="' + columnKey + '"]').toggle(visible);
                    $('#pieceColumnToggle_' + columnKey).prop('checked', visible);
                });
            }

            function openColumnSettingsMenu() {
                $columnSettings.addClass('is-open');
                $columnSettingsToggle.attr('aria-expanded', 'true');
            }

            function closeColumnSettingsMenu() {
                $columnSettings.removeClass('is-open');
                $columnSettingsToggle.attr('aria-expanded', 'false');
            }

            function initColumnResizing() {
                $table.find('.piece-column-resize-handle').remove();
                $(document).off('.pieceResize');
                $(window).off('.pieceResize');

                var activeResize = null;

                function stopResize() {
                    if (!activeResize) {
                        return;
                    }

                    $(document).off('mousemove.pieceResize mouseup.pieceResize');
                    $(window).off('blur.pieceResize mouseleave.pieceResize');
                    $('body').removeClass('piece-resize-active');
                    activeResize.$handle.removeClass('is-dragging');
                    activeResize = null;
                }

                function applyWidth(index, $th, newWidth) {
                    var safeWidth = Math.max(72, newWidth);
                    $th.css({
                        width: safeWidth + 'px',
                        minWidth: safeWidth + 'px',
                        maxWidth: safeWidth + 'px'
                    });

                    $tbody.find('tr').each(function() {
                        $(this).find('td').eq(index).css({
                            width: safeWidth + 'px',
                            minWidth: safeWidth + 'px',
                            maxWidth: safeWidth + 'px'
                        });
                    });
                }

                $table.find('thead th').each(function(index) {
                    var $th = $(this);
                    var columnKey = String($th.attr('data-column-key') || '').trim();
                    if (columnKey === 'selector' || columnKey === 'actions') {
                        return;
                    }

                    var $handle = $('<div class="piece-column-resize-handle right" />');
                    $th.append($handle);

                    $handle.on('mousedown.pieceResize', function(event) {
                        event.preventDefault();
                        event.stopPropagation();
                        stopResize();
                        activeResize = {
                            index: index,
                            $th: $th,
                            $handle: $handle,
                            startX: event.pageX,
                            startWidth: $th.outerWidth()
                        };
                        $('body').addClass('piece-resize-active');
                        $handle.addClass('is-dragging');

                        $(document).on('mousemove.pieceResize', function(moveEvent) {
                            if (!activeResize) {
                                return;
                            }
                            if (typeof moveEvent.buttons === 'number' && moveEvent.buttons === 0) {
                                stopResize();
                                return;
                            }
                            var diff = moveEvent.pageX - activeResize.startX;
                            applyWidth(activeResize.index, activeResize.$th, activeResize.startWidth + diff);
                        });

                        $(document).on('mouseup.pieceResize', stopResize);
                        $(window).on('blur.pieceResize mouseleave.pieceResize', stopResize);
                    });
                });
            }

            $table.off('.pieceList');
            $bulkBar.off('.pieceList');
            $(document).off('.pieceListColumns');
            $(document).off('.pieceInlineDropdown');
            if (hasTable) {
                $table.on('change.pieceList', '[data-row-checkbox]', function() {
                    updateSelectionUi();
                });

                $table.on('change.pieceList', '[data-select-all-checkbox]', function() {
                    var isChecked = $(this).is(':checked');
                    getRows().each(function() {
                        getRowCheckbox($(this)).prop('checked', isChecked);
                    });
                    updateSelectionUi();
                });

                $table.on('dblclick.pieceList', '.piece-row', function(event) {
                    if ($(event.target).closest('a, button, input, select, textarea, label, .dropdown-menu, .dropdown-toggle').length > 0) {
                        return;
                    }
                    if (rowClickTimer) {
                        window.clearTimeout(rowClickTimer);
                        rowClickTimer = null;
                    }
                    beginInlineEdit($(this), 'tier');
                });

                $table.on('click.pieceList', '.js-piece-inline-edit', function(event) {
                    event.preventDefault();
                    event.stopPropagation();
                    beginInlineEdit($(this).closest('.piece-row'), 'tier');
                });

                $table.on('click.pieceList', '.js-piece-inline-lignes', function(event) {
                    event.preventDefault();
                    event.stopPropagation();
                    var $row = $(this).closest('.piece-row');
                    var pieceId = $row.data('row-id') || $row.data('item-id');
                    var tierType = String($row.attr('data-tier-type') || 'Client');
                    
                    if (typeof InlineLigneEditor !== 'undefined') {
                        var editor = InlineLigneEditor.getInstance(pieceId, tierType);
                        editor.show($row);
                    }
                });

                $table.on('click.pieceList', '.js-piece-inline-save', function(event) {
                    event.preventDefault();
                    event.stopPropagation();
                    saveInlineEdit($(this).closest('.piece-row'));
                });

                $table.on('click.pieceList', '.js-piece-inline-cancel', function(event) {
                    event.preventDefault();
                    event.stopPropagation();
                    closeInlineEdit($(this).closest('.piece-row'), true);
                });

                $table.on('click.pieceList', '.inline-dropdown-trigger, .inline-dropdown-label', function(event) {
                    event.preventDefault();
                    event.stopPropagation();
                    var $shell = $(this).closest('.inline-dropdown-shell');
                    if ($shell.hasClass('is-open')) {
                        $shell.removeClass('is-open');
                        return;
                    }
                    openDropdownShell($shell);
                });

                $table.on('click.pieceList', '.inline-dropdown-option', function(event) {
                    event.preventDefault();
                    event.stopPropagation();
                    var $option = $(this);
                    var $shell = $option.closest('.inline-dropdown-shell');
                    var value = String($option.attr('data-value') || '');
                    var label = value === '' ? '' : String($option.attr('data-label') || $option.text() || '');
                    setDropdownValue($shell, value, label);
                    
                    // Ensure value is properly set before closing
                    $shell.attr('data-value', value);
                    
                    setTimeout(function() {
                        $shell.removeClass('is-open');
                    }, 50);

                });

                $table.on('keydown.pieceList', '.piece-inline-text, .inline-dropdown-trigger, .inline-dropdown-option', function(event) {
                    if (event.key === 'Escape') {
                        event.preventDefault();
                        closeInlineEdit($(this).closest('.piece-row'), true);
                    }
                });

                $table.on('keydown.pieceList', '.piece-inline-text', function(event) {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        saveInlineEdit($(this).closest('.piece-row'));
                    }
                });

                if (autoInlineEditId) {
                    var $autoInlineRow = $('tr.piece-row[data-row-id="' + autoInlineEditId + '"], tr.piece-row[data-item-id="' + autoInlineEditId + '"]').first();
                    var shouldOpenLigneModal = sessionStorage.getItem('showLigneModalAfterCreate') === 'true';
                    if (shouldOpenLigneModal) {
                        sessionStorage.removeItem('showLigneModalAfterCreate');
                    }
                    if ($autoInlineRow.length) {
                        setTimeout(function() {
                            $autoInlineRow[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
                            if (shouldOpenLigneModal && typeof LigneCreationModal !== 'undefined') {
                                var tierType = String($autoInlineRow.attr('data-tier-type') || 'Client');
                                LigneCreationModal.showAfterPieceCreation({
                                    id: parseInt(autoInlineEditId, 10) || 0
                                }, { tierType: tierType });
                            } else {
                                beginInlineEdit($autoInlineRow, 'tier');
                            }
                            if (window.history && window.URL) {
                                var cleanUrl = new URL(window.location.href);
                                cleanUrl.searchParams.delete('inlineEditId');
                                window.history.replaceState({}, document.title, cleanUrl.toString());
                            }
                        }, 120);
                    } else if (shouldOpenLigneModal && typeof LigneCreationModal !== 'undefined') {
                        LigneCreationModal.showAfterPieceCreation({
                            id: parseInt(autoInlineEditId, 10) || 0
                        });
                    }
                    autoInlineEditId = '';
                }

                $bulkBar.on('click.pieceList', '[data-bulk-clear]', function(event) {
                    event.preventDefault();
                    getRows().each(function() {
                        getRowCheckbox($(this)).prop('checked', false);
                    });
                    updateSelectionUi();
                });

                $bulkBar.on('click.pieceList', '[data-bulk-action="delete"]', function(event) {
                    event.preventDefault();

                    var ids = getSelectedIds();
                    if (!ids.length) {
                        return;
                    }
                    openBulkDeleteConfirmation(ids);
                });

                readColumnPrefs();
                applyColumnPrefs();
                initColumnResizing();
                updateSelectionUi();
            }

            if ($quickCreateForm.length) {
                var $quickTierType = $('#pieceQuickTierType');
                var $quickTierId = $('#pieceQuickTierId');
                var $quickTierDestination = $('#pieceQuickTierDestination');
                var $quickTierDestinationGroup = $('#pieceQuickTierDestinationGroup');
                var $quickRef = $('#pieceQuickReference');

                function refreshQuickTierDestinationOptions() {
                    if (!$quickTierType.length || !$quickTierDestination.length || !$quickTierDestinationGroup.length) {
                        return;
                    }

                    var normalizedType = normalizeToken(String($quickTierType.val() || ''));
                    var isInternalType = normalizedType === 'interne' || normalizedType === 'tiersinterne' || normalizedType === 'tierinterne';
                    if (!isInternalType) {
                        $quickTierDestinationGroup.hide();
                        $quickTierDestination.empty().append('<option value="">Selectionner une destination interne</option>');
                        return;
                    }

                    $quickTierDestinationGroup.show();
                    fetchTierOptions(String($quickTierType.val() || 'Interne'), true).done(function(options) {
                        $quickTierDestination.empty().append('<option value="">Selectionner une destination interne</option>');
                        options.forEach(function(option) {
                            $quickTierDestination.append($('<option></option>').attr('value', option.value).text(option.label));
                        });
                    });
                }

                if ($quickTierType.length) {
                    $quickTierType.off('change.pieceQuickCreate').on('change.pieceQuickCreate', function() {
                        loadQuickCreateTiers('');
                        refreshQuickTierDestinationOptions();
                    });
                }

                $quickCreateModal.off('shown.bs.modal.pieceQuickCreate').on('shown.bs.modal.pieceQuickCreate', function() {
                    loadQuickCreateTiers('');
                    refreshQuickTierDestinationOptions();
                    if ($quickRef.length) {
                        $quickRef.trigger('focus');
                    }
                });

                $quickCreateForm.off('submit.pieceQuickCreate').on('submit.pieceQuickCreate', function(event) {
                    event.preventDefault();

                    var tierId = String($quickTierId.val() || '').trim();
                    if (tierId === '') {
                        showPieceToast('Le tiers est obligatoire.', 'error');
                        $quickTierId.trigger('focus');
                        return;
                    }
                    var normalizedType = normalizeToken(String($quickTierType.val() || ''));
                    var isInternalType = normalizedType === 'interne' || normalizedType === 'tiersinterne' || normalizedType === 'tierinterne';
                    if (isInternalType) {
                        var tierDestinationId = String($quickTierDestination.val() || '').trim();
                        if (tierDestinationId === '') {
                            showPieceToast('Le tiers destination est obligatoire pour une piece interne.', 'error');
                            $quickTierDestination.trigger('focus');
                            return;
                        }
                    }

                    $quickCreateSubmit.prop('disabled', true);
                    var formData = $(this).serialize();

                    $.ajax({
                        url: quickCreateUrl,
                        method: 'POST',
                        dataType: 'json',
                        data: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    }).done(function(response) {
                        if (!response || response.success !== true || !response.item) {
                            showPieceToast((response && response.message) ? response.message : 'La creation rapide a echoue.', 'error');
                            $quickCreateSubmit.prop('disabled', false);
                            return;
                        }

                        var $row = appendCreatedRow(response.item);
                        if ($row && $row.length) {
                            showPieceToast(response.message || 'Piece creee avec succes.', 'success');
                            $quickCreateModal.one('hidden.bs.modal.pieceQuickInline', function() {
                                beginInlineEdit($row, 'tier', String(response.item.typet || getDefaultTierTypeValue()));
                            });
                            $quickCreateModal.modal('hide');
                        } else {
                            showPieceToast(response.message || 'Piece creee avec succes.', 'success');
                            $quickCreateModal.modal('hide');
                        }
                    }).fail(function(xhr) {
                        var message = 'La creation rapide a echoue.';
                        if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
                            message = xhr.responseJSON.message;
                        }
                        showPieceToast(message, 'error');
                    }).always(function() {
                        $quickCreateSubmit.prop('disabled', false);
                    });
                });

                $quickCreateModal.off('hidden.bs.modal.pieceQuickCreate').on('hidden.bs.modal.pieceQuickCreate', function() {
                    $quickCreateSubmit.prop('disabled', false);
                    if ($quickCreateForm[0]) {
                        $quickCreateForm[0].reset();
                    }
                    if ($quickTierDestinationGroup.length) {
                        $quickTierDestinationGroup.hide();
                    }
                    if ($quickTierType.length && getTierTypeOptions().length <= 1) {
                        $quickTierType.val(getDefaultTierTypeValue());
                    }
                    // Clean up orphaned backdrop
                    if (typeof window.syncSingleModalBackdrop === 'function') {
                        window.syncSingleModalBackdrop(true);
                    }
                });
            }

            window.updatePieceLigneSummary = function(summary) {
                if (!summary || !summary.id) {
                    return;
                }

                var $row = $('tr.piece-row[data-row-id="' + summary.id + '"], tr.piece-row[data-item-id="' + summary.id + '"]').first();
                if (!$row.length) {
                    return;
                }

                var lineCount = parseInt(summary.lignes, 10);
                if (!Number.isFinite(lineCount)) {
                    lineCount = 0;
                }

                $row.find('td[data-column-key="lignes"]').html(
                    '<span class="' + (lineCount > 0 ? 'badge badge-success' : 'badge badge-warning') + '">' + escapeHtml(String(lineCount)) + '</span>'
                );

                if (typeof summary.montantDisplay !== 'undefined') {
                    $row.find('td[data-column-key="montant"]').html('<strong>' + escapeHtml(String(summary.montantDisplay)) + '</strong>');
                }
            };

            if ($pieceImportForm.length) {
                $pieceImportForm.off('submit.pieceImport').on('submit.pieceImport', function(event) {
                    event.preventDefault();

                    var formEl = $pieceImportForm[0];
                    var fileInput = formEl ? formEl.querySelector('input[name="file"]') : null;
                    if (!fileInput || !fileInput.files || !fileInput.files[0]) {
                        showPieceToast('Selectionnez un fichier a importer.', 'error');
                        return;
                    }

                    var formData = new FormData(formEl);
                    $pieceImportSubmit.prop('disabled', true);

                    $.ajax({
                        url: importUrl,
                        method: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        dataType: 'json',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    }).done(function(response) {
                        if (!response || response.success !== true) {
                            showPieceToast((response && response.message) ? response.message : 'Import impossible.', 'error');
                            return;
                        }
                        showPieceToast(response.message || 'Import termine.', 'success');
                        $pieceImportModal.modal('hide');
                        window.location.reload();
                    }).fail(function(xhr) {
                        var message = 'Import impossible.';
                        if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
                            message = xhr.responseJSON.message;
                        }
                        showPieceToast(message, 'error');
                    }).always(function() {
                        $pieceImportSubmit.prop('disabled', false);
                    });
                });
            }

            if ($columnSettingsToggle.length) {
                $columnSettingsToggle.off('click.pieceList').on('click.pieceList', function(event) {
                    event.preventDefault();
                    event.stopPropagation();
                    if ($columnSettings.hasClass('is-open')) {
                        closeColumnSettingsMenu();
                    } else {
                        openColumnSettingsMenu();
                    }
                });
            }

            $(document).on('change.pieceListColumns', '[data-column-toggle]', function(event) {
                event.stopPropagation();
                var columnKey = String($(this).attr('data-column-toggle') || '').trim();
                if (columnKey === '' || mandatoryColumnKeys.indexOf(columnKey) !== -1) {
                    return;
                }
                columnPrefs[columnKey] = $(this).is(':checked');
                writeColumnPrefs();
                if (hasTable) {
                    applyColumnPrefs();
                }
            });

            $(document).on('click.pieceListColumns', function(event) {
                var $target = $(event.target);
                if (!$columnSettings.hasClass('is-open')) {
                    return;
                }
                if ($target.closest('.piece-column-settings__menu').length || $target.closest('#pieceColumnSettingsToggle').length) {
                    return;
                }
                closeColumnSettingsMenu();
                if (hasTable && $target.closest('.inline-dropdown-shell').length === 0) {
                    closeDropdowns();
                }
            });

            $(document).on('click.pieceInlineDropdown', function(event) {
                if (!hasTable) {
                    return;
                }
                // Don't close dropdowns if clicking on table elements
                if ($(event.target).closest('#piecesTable').length) {
                    if ($(event.target).closest('.inline-dropdown-shell').length === 0 && 
                        $(event.target).closest('.inline-dropdown-menu').length === 0) {
                        closeDropdowns();
                    }
                    return;
                }
                if ($(event.target).closest('.inline-dropdown-shell').length === 0) {
                    closeDropdowns();
                }
            });

            // Reposition dropdowns on scroll and window resize
            var repositionDropdownsThrottled = (function() {
                var timeout = null;
                return function() {
                    if (timeout) {
                        clearTimeout(timeout);
                    }
                    timeout = setTimeout(function() {
                        if (hasTable) {
                            $table.find('.inline-dropdown-shell.is-open').each(function() {
                                positionDropdownMenu($(this));
                            });
                        }
                    }, 10);
                };
            })();

            $(window).on('scroll.pieceInlineDropdown resize.pieceInlineDropdown', repositionDropdownsThrottled);
            
            // Prevent dropdown from closing when clicking inside it
            $table.on('click.pieceDropdown', '.inline-dropdown-menu, .inline-dropdown-option, .inline-dropdown-trigger', function(e) {
                e.stopPropagation();
                return true;
            });

            $(document).off('click.pieceBulkDeleteConfirm', '#confirmDeleteBtn').on('click.pieceBulkDeleteConfirm', '#confirmDeleteBtn', function(event) {
                if ($(this).attr('data-bulk-delete') !== '1') {
                    return;
                }
                event.preventDefault();
                submitBulkDeleteSelection();
            });

            if ($deleteConfirmModal.length) {
                $deleteConfirmModal.off('hidden.bs.modal.pieceBulkDelete').on('hidden.bs.modal.pieceBulkDelete', function() {
                    bulkDeletePending = null;
                    isBulkDeleteSubmitting = false;
                    resetBulkDeleteConfirmState();
                });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPieceListUx);
        } else {
            initPieceListUx();
        }

        document.addEventListener('turbo:load', initPieceListUx);
        document.addEventListener('turbo:render', initPieceListUx);
    })();
</script>
<style>
    .piece-quick-modal .modal-dialog {
        max-width: 580px;
    }
    .piece-quick-modal .modal-content {
        border-radius: 14px;
        overflow: hidden;
        position: relative;
        background: #fff;
        border: none;
        box-shadow: 0 24px 50px rgba(15, 23, 42, 0.18);
    }
    .piece-quick-modal-close {
        position: absolute;
        right: 18px;
        top: 16px;
        background: none;
        border: none;
        font-size: 28px;
        color: #94a3b8;
        opacity: 0.78;
        z-index: 3;
        transition: color 0.2s ease, opacity 0.2s ease, transform 0.2s ease;
        width: 28px;
        height: 28px;
        line-height: 1;
        padding: 0;
    }
    .piece-quick-modal-close:hover {
        opacity: 1;
        color: #334155;
        transform: scale(1.06);
    }
    .piece-quick-modal-body {
        padding: 42px 30px 26px;
    }
    .piece-quick-modal-badge {
        width: 72px;
        height: 72px;
        margin: 0 auto 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-secondary) 100%);
        box-shadow: 0 10px 28px rgba(30, 64, 175, 0.27);
    }
    .piece-quick-modal-badge i {
        color: #fff;
        font-size: 28px;
    }
    .piece-quick-modal-title {
        margin: 0 0 8px;
        text-align: center;
        font-size: 1.45rem;
