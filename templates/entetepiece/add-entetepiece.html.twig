{% extends "template_oukatech.html.twig" %}
{% block PageTitle %}Entete de piece{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('entetepiece.list') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
        <h1 class="h3 mb-0 text-gray-800">{{ id > 0 ? 'Modifier la piece' : 'Nouvelle piece' }}</h1>
    </div>
</div>

{% if isPerimee|default(false) %}
    <div class="alert alert-warning d-flex align-items-start" role="alert" style="border-left: 4px solid #dd6b20; background-color: #fff7e6; color: #7a4a00;">
        <i class="fas fa-archive mr-2 mt-1"></i>
        <div>
            <strong>Cette piÃ¨ce est pÃ©rimÃ©e (archivÃ©e).</strong><br>
            Mode lecture seule: aucune modification n'est autorisÃ©e.
        </div>
    </div>
{% endif %}

<div class="form-card">
    {{ form_start(entetepiece, {
        'attr': {
            'id': 'piece-edit-form',
            'class': 'needs-validation' ~ ((isReadOnly|default(false)) ? ' piece-readonly-mode' : ''),
            'novalidate': 'novalidate',
            'data-read-only': (isReadOnly|default(false)) ? '1' : '0'
        }
    }) }}

    {% if isReadOnly|default(false) %}
        <input type="hidden" name="_readonly_mode" value="1">
    {% endif %}
    
    <div class="card-header-custom">
        <h5><i class="fas fa-file-invoice mr-2"></i>Type de document</h5>
    </div>
    
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(entetepiece.type, 'Type de piece', {'label_attr': {'class': 'required'}}) }}
                {{ form_widget(entetepiece.type, {'attr': {'class': 'form-control js-example-basic-single'}}) }}
                {% if id > 0 %}
                    <small class="form-text text-muted">Type verrouille apres creation.</small>
                {% endif %}
                {% if not isReadOnly|default(false) %}
                    <div class="invalid-feedback">Le type de piece est obligatoire</div>
                    {{ form_errors(entetepiece.type) }}
                {% endif %}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(entetepiece.typet, 'Type de tiers', {'label_attr': {'class': 'required'}}) }}
                {{ form_widget(entetepiece.typet, {'attr': {'class': 'form-control js-example-basic-single'}}) }}
                {% if not isReadOnly|default(false) %}
                    <div class="invalid-feedback">Le type de tiers est obligatoire</div>
                    {{ form_errors(entetepiece.typet) }}
                {% endif %}
            </div>
        </div>
    </div>

    <div class="card-header-custom mt-4">
        <h5><i class="fas fa-user mr-2"></i>Informations client</h5>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(entetepiece.client, 'Client', {'label_attr': {'class': 'required'}}) }}
                {{ form_widget(entetepiece.client, {'attr': {'class': 'form-control js-example-basic-single'}}) }}
                {% if not isReadOnly|default(false) %}
                    <div class="invalid-feedback">Le client est obligatoire</div>
                    {{ form_errors(entetepiece.client) }}
                {% endif %}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(entetepiece.statut, 'Statut', {'label_attr': {'class': 'required'}}) }}
                {{ form_widget(entetepiece.statut, {'attr': {'class': 'form-control js-example-basic-single'}}) }}
                {% if not isReadOnly|default(false) %}
                    <div id="statusEligibilityHint" class="status-eligibility-panel mt-2">
                        <div class="status-eligibility-header d-flex justify-content-between align-items-center">
                            <span class="status-eligibility-title">Controle d'eligibilite du statut</span>
                            <span id="statusEligibilityBadge" class="badge badge-secondary">Brouillon</span>
                        </div>
                        <ul id="statusEligibilityChecklist" class="status-eligibility-list mb-0"></ul>
                        <small id="statusEligibilitySummary" class="form-text text-muted mt-1"></small>
                    </div>
                {% endif %}
                {% if not isReadOnly|default(false) %}
                    <div class="invalid-feedback">Le statut est obligatoire</div>
                    {{ form_errors(entetepiece.statut) }}
                {% endif %}
            </div>
        </div>
    </div>

    <div class="card-header-custom mt-4">
        <h5><i class="fas fa-info-circle mr-2"></i>Details de la piece</h5>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(entetepiece.pieceref, 'Reference') }}
                {{ form_widget(entetepiece.pieceref, {'attr': {'class': 'form-control', 'placeholder': 'Reference de la piece'}}) }}
                {% if not isReadOnly|default(false) %}
                    {{ form_errors(entetepiece.pieceref) }}
                {% endif %}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(entetepiece.remise, 'Remise (%)') }}
                {{ form_widget(entetepiece.remise, {'attr': {'class': 'form-control', 'placeholder': '0'}}) }}
                {% if not isReadOnly|default(false) %}
                    {{ form_errors(entetepiece.remise) }}
                {% endif %}
            </div>
        </div>
    </div>

    <div class="card-header-custom mt-4">
        <h5><i class="fas fa-money-check-alt mr-2"></i>Conditions de paiement</h5>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(entetepiece.devise, 'Devise') }}
                {{ form_widget(entetepiece.devise, {'attr': {'class': 'form-control js-example-basic-single'}}) }}
                {% if not isReadOnly|default(false) %}
                    {{ form_errors(entetepiece.devise) }}
                {% endif %}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(entetepiece.reglement, 'Mode de reglement') }}
                {{ form_widget(entetepiece.reglement, {'attr': {'class': 'form-control js-example-basic-single'}}) }}
                {% if not isReadOnly|default(false) %}
                    {{ form_errors(entetepiece.reglement) }}
                {% endif %}
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(entetepiece.datep, 'Date piece') }}
                {{ form_widget(entetepiece.datep, {'attr': {'class': 'form-control'}}) }}
                {% if not isReadOnly|default(false) %}
                    {{ form_errors(entetepiece.datep) }}
                {% endif %}
            </div>
        </div>
    </div>

    <div class="form-actions">
        {% if not isReadOnly|default(false) %}
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save mr-2"></i>{{ id > 0 ? 'Mettre a jour' : 'Enregistrer' }}
            </button>
        {% else %}
            <span class="badge badge-warning p-2 mr-2">Lecture seule</span>
        {% endif %}
        <a href="{{ path('entetepiece.list') }}" class="btn btn-secondary">
            <i class="fas fa-times mr-2"></i>{{ isReadOnly|default(false) ? 'Fermer' : 'Annuler' }}
        </a>
    </div>

    {{ form_rest(entetepiece) }}
    {{ form_end(entetepiece) }}
</div>

<p class="text-muted small mt-3">
    <i class="fas fa-info-circle mr-1"></i>
    Les champs marques d'un <span class="text-danger">*</span> sont obligatoires.
</p>

{% if id > 0 %}
<div class="form-card mt-4" id="piece-lines">
    <div class="card-header-custom d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-list mr-2"></i>Lignes de la piece</h5>
        {% if not isReadOnly|default(false) %}
            <a class="btn btn-success btn-sm" href="{{ path('lignepiece.add', {pceId: id}) }}">
                <i class="fas fa-plus mr-2"></i>Ajouter une ligne
            </a>
        {% else %}
            <span class="badge badge-warning">Lecture seule</span>
        {% endif %}
    </div>

    {% if lignepieces|length == 0 %}
        <div class="alert alert-warning mt-3 mb-0">
            <i class="fas fa-exclamation-triangle mr-2"></i>
            Cette piece ne contient aucune ligne.
        </div>
    {% endif %}
    
    <div class="table-responsive mt-3">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Article</th>
                    <th class="text-right">Quantite</th>
                    <th class="text-right">Prix unitaire</th>
                    <th class="text-right">Remise</th>
                    <th class="text-right">Montant</th>
                    <th>Cree par</th>
                    <th>Cree le</th>
                    <th class="text-center" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for lignepiece in lignepieces %}
                <tr
                    data-piece-line="1"
                    data-has-article="{{ lignepiece.article ? '1' : '0' }}"
                    data-qty="{{ lignepiece.qte|default(0) }}"
                    data-pub="{{ lignepiece.pub|default(0) }}">
                    <td>{{ lignepiece.article }}</td>
                    <td class="text-right">{{ lignepiece.qte }}</td>
                    <td class="text-right">{{ lignepiece.pub|number_format(2, ',', ' ') }}</td>
                    <td class="text-right">{{ lignepiece.remise }}%</td>
                    <td class="text-right"><strong>{{ lignepiece.montant|number_format(2, ',', ' ') }}</strong></td>
                    <td>{{ lignepiece.createdBy }}</td>
                    <td>{{ lignepiece.createdAt|date('d/m/Y') }}</td>
                    <td>
                        {% if not isReadOnly|default(false) %}
                            <div class="action-buttons">
                                <a href="{{ path('lignepiece.edit', {id: lignepiece.id, pceId: id}) }}" class="btn-action btn-edit" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button"
                                        class="btn-action btn-delete delete-btn"
                                        data-delete-url="{{ path('lignepiece.delete', {id: lignepiece.id, pceId: id}) }}"
                                        data-item-name="cette ligne"
                                        title="Supprimer">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                        {% else %}
                            <span class="text-muted small">Lecture seule</span>
                        {% endif %}
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                        Aucune ligne ajoutee
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

<style>
    .status-eligibility-panel {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #f8fafc;
        padding: 10px 12px;
    }

    .status-eligibility-title {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #64748b;
    }

    .status-eligibility-list {
        list-style: none;
        padding-left: 0;
        margin-top: 8px;
    }

    .status-eligibility-list li {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        font-size: 13px;
        line-height: 1.5;
        margin-bottom: 4px;
        color: #334155;
    }

    .status-eligibility-list li:last-child {
        margin-bottom: 0;
    }

    .status-eligibility-list li .status-icon {
        width: 16px;
        text-align: center;
    }

    .status-rule-main {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .status-rule-tag {
        font-size: 11px;
        font-weight: 600;
        border-radius: 999px;
        padding: 2px 8px;
        letter-spacing: 0.01em;
        white-space: nowrap;
    }

    .status-rule-tag.is-required {
        color: #7c2d12;
        background: #ffedd5;
    }

    .status-rule-tag.is-recommended {
        color: #1e3a8a;
        background: #dbeafe;
    }

    .status-eligibility-list li.is-ok {
        color: #166534;
    }

    .status-eligibility-list li.is-missing {
        color: #9a3412;
    }

    .status-eligibility-list li.is-recommended-missing {
        color: #334155;
    }

    .piece-readonly-mode .form-control[disabled],
    .piece-readonly-mode .form-control:disabled,
    .piece-readonly-mode .select2-container--bootstrap-5 .select2-selection {
        background-color: #f5f5f5 !important;
    }

    .piece-readonly-mode .invalid-feedback,
    .piece-readonly-mode .is-invalid,
    .piece-readonly-mode .is-valid {
        display: none !important;
        border-color: inherit !important;
        box-shadow: none !important;
    }

    .form-actions .btn-primary:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        filter: grayscale(0.2);
        transform: none !important;
        box-shadow: none !important;
    }
</style>

{% endblock %}

{% block javascripts %}
<script>
    (function() {
        function shouldScrollToLines() {
            var hash = String(window.location.hash || '').trim();
            if (hash === '#piece-lines') {
                return true;
            }

            try {
                var params = new URLSearchParams(window.location.search || '');
                return String(params.get('scroll') || '').trim() === 'piece-lines';
            } catch (e) {
                return false;
            }
        }

        function clearScrollQueryFlag() {
            try {
                var params = new URLSearchParams(window.location.search || '');
                if (String(params.get('scroll') || '').trim() !== 'piece-lines') {
                    return;
                }

                params.delete('scroll');
                var nextUrl = window.location.pathname;
                var nextQuery = params.toString();
                if (nextQuery !== '') {
                    nextUrl += '?' + nextQuery;
                }
                if (window.location.hash) {
                    nextUrl += window.location.hash;
                }

                window.history.replaceState({}, document.title, nextUrl);
            } catch (e) {
                // Ignore environments where URLSearchParams is unavailable.
            }
        }

        function initPieceForm() {
            var form = document.getElementById('piece-edit-form');
            var isReadOnly = form && String(form.getAttribute('data-read-only') || '') === '1';
            var initialLineStats = {
                lineCount: Number({{ statusProgression.lineCount|default(0) }}),
                invalidLineCount: Number({{ statusProgression.invalidLineCount|default(0) }})
            };
            var originalStatusRaw = '{{ statusProgression.originalStatus|default("Brouillon")|e("js") }}';

            $('.js-example-basic-single').each(function() {
                if (!$(this).hasClass('select2-hidden-accessible')) {
                    $(this).select2({
                        theme: 'bootstrap-5',
                        allowClear: true
                    });
                }
            });

            if (isReadOnly) {
                if (form) {
                    $(form).find('input, select, textarea').not('[type="hidden"]').prop('disabled', true);
                    $(form).off('submit.readonly').on('submit.readonly', function(e) {
                        e.preventDefault();
                        return false;
                    });
                }
            }

            if (shouldScrollToLines()) {
                var linesSection = document.getElementById('piece-lines');
                if (linesSection) {
                    setTimeout(function() {
                        linesSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 80);
                    clearScrollQueryFlag();
                }
            }

            if (isReadOnly) {
                return;
            }

            var $status = $('#{{ entetepiece.statut.vars.id }}');
            var $client = $('#{{ entetepiece.client.vars.id }}');
            var $devise = $('#{{ entetepiece.devise.vars.id }}');
            var $reglement = $('#{{ entetepiece.reglement.vars.id }}');
            var $statusChecklist = $('#statusEligibilityChecklist');
            var $statusSummary = $('#statusEligibilitySummary');
            var $statusBadge = $('#statusEligibilityBadge');
            var $submitButtons = $(form).find('button[type="submit"]');

            function normalizeStatus(rawValue) {
                var normalized = String(rawValue || '').toLowerCase();
                if (typeof normalized.normalize === 'function') {
                    normalized = normalized.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
                }
                return normalized.replace(/[^a-z0-9]/g, '');
            }

            function getStatusLabel(normalizedStatus) {
                if (normalizedStatus === 'active') {
                    return 'Active';
                }
                if (normalizedStatus === 'validee' || normalizedStatus === 'valide') {
                    return 'Validee';
                }
                return 'Brouillon';
            }

            function parseNumeric(value) {
                var rawValue = (value === null || value === undefined) ? '' : value;
                var raw = String(rawValue).trim();
                if (raw === '') {
                    return 0;
                }
                raw = raw.replace(/\s/g, '').replace(',', '.').replace(/[^0-9.\-]/g, '');
                var parsed = Number(raw);
                return Number.isFinite(parsed) ? parsed : 0;
            }

            function getLiveLineStats() {
                var stats = {
                    lineCount: 0,
                    invalidLineCount: 0
                };

                var $rows = $('#piece-lines tbody tr[data-piece-line="1"]');
                if (!$rows.length) {
                    return stats;
                }

                $rows.each(function() {
                    var $row = $(this);
                    stats.lineCount += 1;

                    var hasArticle = String($row.data('has-article') || '') === '1';
                    var quantity = parseNumeric($row.data('qty'));
                    var unitPrice = parseNumeric($row.data('pub'));

                    if (!hasArticle || quantity <= 0 || unitPrice <= 0) {
                        stats.invalidLineCount += 1;
                    }
                });

                return stats;
            }

            function getCurrentLineStats() {
                var hasLineSection = $('#piece-lines').length > 0;
                if (!hasLineSection) {
                    return {
                        lineCount: initialLineStats.lineCount,
                        invalidLineCount: initialLineStats.invalidLineCount
                    };
                }

                return getLiveLineStats();
            }

            function isStatusAllowed(fromStatus, toStatus, lineStats) {
                var from = normalizeStatus(fromStatus);
                var to = normalizeStatus(toStatus);

                if (to === from) {
                    return true;
                }
                if (to === 'brouillon') {
                    return true;
                }
                if (to === 'active') {
                    return lineStats.lineCount > 0;
                }
                if (to === 'validee' || to === 'valide') {
                    return lineStats.lineCount > 0 && lineStats.invalidLineCount === 0;
                }

                return false;
            }

            function hasFieldValue($field) {
                if (!$field.length) {
                    return false;
                }
                return String($field.val() || '').trim() !== '';
            }

            function updateSubmitAvailability(selectedStatus, checks) {
                if (!$submitButtons.length) {
                    return;
                }

                var normalizedStatus = normalizeStatus(selectedStatus);
                if (normalizedStatus === '') {
                    $submitButtons.prop('disabled', true).attr('title', 'Selectionnez un statut pour enregistrer.');
                    return;
                }

                var blockingChecks = checks.filter(function(check) {
                    return check.required && !check.ok;
                });
                var canSubmit = blockingChecks.length === 0;

                if (canSubmit) {
                    $submitButtons.prop('disabled', false).removeAttr('title');
                    return;
                }

                var firstBlockingLabel = String(blockingChecks[0].label || 'Completez les regles obligatoires');
                $submitButtons
                    .prop('disabled', true)
                    .attr('title', 'Enregistrement bloque: ' + firstBlockingLabel + '.');
            }

            function updateStatusOptionsAvailability() {
                if (!$status.length) {
                    return;
                }

                var lineStats = getCurrentLineStats();
                var fromStatus = normalizeStatus(String($status.val() || originalStatusRaw));
                $status.find('option').each(function() {
                    var optionValue = String($(this).attr('value') || '').trim();
                    if (optionValue === '') {
                        return;
                    }
                    var normalizedOption = normalizeStatus(optionValue);
                    var isCurrent = normalizedOption === fromStatus;
                    var isAllowed = isCurrent || isStatusAllowed(fromStatus, optionValue, lineStats);
                    $(this).prop('disabled', !isAllowed);
                });

                if ($status.hasClass('select2-hidden-accessible')) {
                    $status.trigger('change.select2');
                }
            }

            function renderStatusEligibility() {
                if (!$status.length || !$statusChecklist.length || !$statusSummary.length) {
                    return;
                }

                var selectedStatus = normalizeStatus(String($status.val() || originalStatusRaw));
                var lineStats = getCurrentLineStats();
                var lineCount = lineStats.lineCount;
                var invalidLineCount = lineStats.invalidLineCount;
                var hasAtLeastOneLine = lineCount > 0;
                var hasCompleteLines = hasAtLeastOneLine && invalidLineCount === 0;
                var hasClient = hasFieldValue($client);
                var hasDevise = hasFieldValue($devise);
                var hasReglement = hasFieldValue($reglement);

                var requiresLineCount = selectedStatus === 'active' || selectedStatus === 'validee' || selectedStatus === 'valide';
                var requiresLineCompleteness = selectedStatus === 'validee' || selectedStatus === 'valide';
                var lineCompletenessLabel = 'Toutes les lignes completees (article, quantite, prix)';
                if (!hasAtLeastOneLine) {
                    lineCompletenessLabel = 'Aucune ligne a verifier pour le moment';
                } else if (invalidLineCount > 0) {
                    lineCompletenessLabel = invalidLineCount + ' ligne(s) incomplete(s) detectee(s)';
                }

                var checks = [
                    { ok: hasAtLeastOneLine, label: 'Au moins une ligne ajoutee (' + lineCount + ')', required: requiresLineCount },
                    { ok: hasCompleteLines, label: lineCompletenessLabel, required: requiresLineCompleteness },
                    { ok: hasClient, label: 'Client renseigne', required: false },
                    { ok: hasDevise, label: 'Devise renseignee', required: false },
                    { ok: hasReglement, label: 'Reglement renseigne', required: false }
                ];

                updateSubmitAvailability(selectedStatus, checks);

                var checklistHtml = checks.map(function(check) {
                    var rowClass = 'is-ok';
                    var iconClass = 'fa-check-circle';
                    if (!check.ok && check.required) {
                        rowClass = 'is-missing';
                        iconClass = 'fa-exclamation-triangle';
                    } else if (!check.ok) {
                        rowClass = 'is-recommended-missing';
                        iconClass = 'fa-info-circle';
                    }

                    return '<li class=\"' + rowClass + '\">' +
                        '<span class=\"status-rule-main\">' +
                            '<span class=\"status-icon\"><i class=\"fas ' + iconClass + '\"></i></span>' +
                            '<span>' + check.label + '</span>' +
                        '</span>' +
                        '<span class=\"status-rule-tag ' + (check.required ? 'is-required' : 'is-recommended') + '\">' +
                            (check.required ? 'Obligatoire' : 'Conseil') +
                        '</span>' +
                        '</li>';
                }).join('');

                $statusChecklist.html(checklistHtml);

                if ($statusBadge.length) {
                    $statusBadge
                        .removeClass('badge-secondary badge-success badge-warning badge-info')
                        .text(getStatusLabel(selectedStatus));

                    if ((selectedStatus === 'validee' || selectedStatus === 'valide') && hasCompleteLines) {
                        $statusBadge.addClass('badge-success');
                    } else if (selectedStatus === 'active' && hasAtLeastOneLine) {
                        $statusBadge.addClass('badge-info');
                    } else if (selectedStatus === 'brouillon') {
                        $statusBadge.addClass('badge-secondary');
                    } else {
                        $statusBadge.addClass('badge-warning');
                    }
                }

                $statusSummary.removeClass('text-success text-warning text-info text-muted');

                if (selectedStatus === 'active') {
                    if (!hasAtLeastOneLine) {
                        $statusSummary
                            .addClass('text-warning')
                            .text('Active bloque: ajoutez au moins une ligne avant de selectionner ce statut.');
                    } else {
                        var activeMessage = 'Le statut Active est disponible.';
                        if (invalidLineCount > 0) {
                            activeMessage += ' Completez ' + invalidLineCount + ' ligne(s) pour preparer la validation.';
                        }
                        $statusSummary
                            .addClass(invalidLineCount > 0 ? 'text-info' : 'text-success')
                            .text(activeMessage);
                    }
                    return;
                }

                if (selectedStatus === 'validee' || selectedStatus === 'valide') {
                    if (!hasAtLeastOneLine) {
                        $statusSummary
                            .addClass('text-warning')
                            .text('Pour passer en Validee, ajoutez au moins une ligne.');
                        return;
                    }
                    if (!hasCompleteLines) {
                        $statusSummary
                            .addClass('text-warning')
                            .text('Pour passer en Validee, completez les ' + invalidLineCount + ' ligne(s) incomplete(s) (article, quantite, prix).');
                        return;
                    }
                    if (!hasClient || !hasDevise || !hasReglement) {
                        var missingFields = [];
                        if (!hasClient) {
                            missingFields.push('client');
                        }
                        if (!hasDevise) {
                            missingFields.push('devise');
                        }
                        if (!hasReglement) {
                            missingFields.push('reglement');
                        }
                        $statusSummary
                            .addClass('text-info')
                            .text('Validee disponible. Conseil qualite: completer ' + missingFields.join(', ') + '.');
                        return;
                    }
                    $statusSummary
                        .addClass('text-success')
                        .text('Tout est pret: la piece est pleinement eligible au statut Validee.');
                    return;
                }

                if (!hasAtLeastOneLine) {
                    $statusSummary
                        .addClass('text-muted')
                        .text('Brouillon: ajoutez au moins une ligne pour debloquer le statut Active.');
                    return;
                }

                if (!hasCompleteLines) {
                    $statusSummary
                        .addClass('text-info')
                        .text('Brouillon: Active est disponible. Completez les lignes pour atteindre Validee.');
                    return;
                }

                $statusSummary
                    .addClass('text-success')
                    .text('Brouillon solide: vous pouvez evoluer vers Active puis Validee.');
            }

            function refreshStatusEligibilityUI() {
                updateStatusOptionsAvailability();
                renderStatusEligibility();
            }

            if ($status.length) {
                refreshStatusEligibilityUI();
                $status.off('change.statusEligibility').on('change.statusEligibility', refreshStatusEligibilityUI);
            }

            if ($client.length && $reglement.length) {
                function applyClientReglementIfEmpty() {
                    var selectedOption = $client.find('option:selected');
                    var clientReglementId = String(selectedOption.data('reglement-id') || '').trim();
                    var currentReglementId = String($reglement.val() || '').trim();
                    if (clientReglementId !== '' && currentReglementId === '') {
                        $reglement.val(clientReglementId).trigger('change');
                    }
                }

                applyClientReglementIfEmpty();
                $client.off('change.pieceReglement').on('change.pieceReglement', function() {
                    applyClientReglementIfEmpty();
                    refreshStatusEligibilityUI();
                });
            }

            if ($devise.length) {
                $devise.off('change.statusEligibility').on('change.statusEligibility', refreshStatusEligibilityUI);
            }
            if ($reglement.length) {
                $reglement.off('change.statusEligibility').on('change.statusEligibility', refreshStatusEligibilityUI);
            }

            if (window.__pieceLinesObserver) {
                window.__pieceLinesObserver.disconnect();
                window.__pieceLinesObserver = null;
            }

            var linesBody = document.querySelector('#piece-lines tbody');
            if (linesBody && typeof MutationObserver !== 'undefined') {
                window.__pieceLinesObserver = new MutationObserver(function() {
                    refreshStatusEligibilityUI();
                });
                window.__pieceLinesObserver.observe(linesBody, {
                    childList: true,
                    subtree: true,
                    attributes: true,
                    attributeFilter: ['data-piece-line', 'data-has-article', 'data-qty', 'data-pub']
                });
            }
        }

        if (!window.__pieceFormAutoScrollHooksBound) {
            window.__pieceFormAutoScrollHooksBound = true;
            document.addEventListener('turbo:load', initPieceForm);
            document.addEventListener('turbo:render', initPieceForm);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPieceForm);
        } else {
            initPieceForm();
        }
    })();
</script>
{% endblock %}

