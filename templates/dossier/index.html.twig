{% extends 'template_oukatech.html.twig' %}

{% block PageTitle %}
    Gestion des Dossiers
{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Dossiers</h1>
    </div>
</div>

<div class="action-bar">
    <div class="action-buttons">
        <a class="btn-add" href="{{ path('dossier.edit') }}">
            <i class="fas fa-plus"></i> Nouveau Dossier
        </a>
        <a class="btn btn-sm btn-outline-success ml-2 no-loading" href="{{ path('export.dossiers') }}" title="Exporter CSV">
            <i class="fas fa-file-csv mr-1"></i> Exporter
        </a>
    </div>
    <div class="search-box">
        {% include "components/search_data.html.twig" with {search: search} only %}
    </div>
</div>

<div class="table-container">
    {% if dossiers|length > 0 %}
    <table class="table">
        <thead>
            <tr>
                <th data-sort-key="id" data-sort-type="number">ID</th>
                <th data-sort-key="nom">Nom</th>
                <th data-sort-key="adresse">Adresse</th>
                <th>CP / Ville / Pays</th>
                <th data-sort-key="rc">RC</th>
                <th>Logo</th>
                <th class="dossier-theme-col">Theme</th>
                <th data-sort-key="devise">Devise</th>
                <th>Numerotations</th>
                <th class="text-center" style="width: 120px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for dossier in dossiers %}
            {% set dossierTheme = dossier.theme %}
            {% set themeColor = dossierTheme ? dossierTheme.primaryColor : '#475569' %}
            {% set themeLabel = dossierTheme ? dossierTheme.name : 'Thème non défini' %}
            <tr>
                <td><strong>#{{ dossier.id }}</strong></td>
                <td>{{ dossier.nom }}</td>
                <td>{{ dossier.adresse }}</td>
                <td>
                    {{ dossier.codepostal ?: '-' }}
                    {{ dossier.ville ?: '' }}
                    {% if dossier.pays %}<br><small class="text-muted">{{ dossier.pays }}</small>{% endif %}
                </td>
                <td>{{ dossier.rc }}</td>
                <td>
                    {% if dossier.logo %}
                        <img src="{{ dossier.logo }}" alt="Logo" style="height:32px; width:32px; object-fit:cover; border-radius:6px;">
                    {% else %}
                        <span class="text-muted">-</span>
                    {% endif %}
                </td>
                <td class="dossier-theme-col">
                    <span class="dossier-theme-badge" title="{{ themeLabel }}">
                        <span class="dossier-theme-badge__swatch" style="background:{{ themeColor }};"></span>
                        <small class="text-muted dossier-theme-badge__label">{{ themeLabel }}</small>
                    </span>
                </td>
                <td>{{ dossier.devise }}</td>
                <td>
                    <small class="text-muted d-block">DV: {{ dossier.devisno ?? 0 }} | CMD: {{ dossier.cmdno ?? 0 }}</small>
                    <small class="text-muted d-block">BL: {{ dossier.blno ?? 0 }} | FAC: {{ dossier.factureno ?? 0 }}</small>
                </td>
                <td class="text-center">
                    <a href="{{ path('dossier.edit', {id: dossier.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn"
                            data-delete-url="{{ path('dossier.delete', {id: dossier.id}) }}"
                            data-item-name="{{ dossier.nom }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% include "components/_pagination.html.twig" with {currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, route: 'dossier.list', routeParams: {}} %}
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-folder-open"></i>
        </div>
        <h5>Aucun dossier trouve</h5>
        <p>Creez votre premier dossier pour organiser vos donnees.</p>
        <a href="{{ path('dossier.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouveau dossier
        </a>
    </div>
    {% endif %}
</div>

<style>
    th.dossier-theme-col,
    td.dossier-theme-col {
        width: 170px;
        min-width: 170px;
        max-width: 170px;
    }

    td.dossier-theme-col {
        overflow: hidden;
    }

    .dossier-theme-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        vertical-align: middle;
    }

    .dossier-theme-badge__swatch {
        display: inline-block;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        border: 1px solid #e2e8f0;
        flex: 0 0 18px;
    }

    .dossier-theme-badge__label {
        display: block;
        min-width: 0;
        max-width: calc(100% - 24px);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>
{% endblock %}
