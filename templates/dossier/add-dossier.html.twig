        function appendThemeOption(theme) {
            if (!themeGrid || !theme || !theme.id) {
                return;
            }

            if (updateThemeOption(theme)) {
                var existingRadio = themeGrid.querySelector('.theme-option[data-theme-id="' + String(theme.id) + '"] .theme-radio-input');
                if (existingRadio) {
                    existingRadio.checked = true;
                    existingRadio.dispatchEvent(new Event('change', { bubbles: true }));
