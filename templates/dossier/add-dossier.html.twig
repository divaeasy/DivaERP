            option.remove();

            if (wasSelected) {
                var nextSelectedRadio = null;
                if (fallbackThemeId) {
                    nextSelectedRadio = themeGrid.querySelector('.theme-option[data-theme-id="' + String(fallbackThemeId) + '"] .theme-radio-input');
