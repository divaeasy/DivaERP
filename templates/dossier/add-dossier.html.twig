            themeGrid.prepend(option);
            bindThemeOption(option);

            var radio = option.querySelector('.theme-radio-input');
            if (radio) {
                radio.checked = true;
                radio.dispatchEvent(new Event('change', { bubbles: true }));
            }

            syncThemeSelection();
