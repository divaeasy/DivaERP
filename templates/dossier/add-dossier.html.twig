{% extends "template_oukatech.html.twig" %}
{% block PageTitle %}Dossier{% endblock %}

{% block body %}
{% set dossierEntity = dossier is defined ? dossier.vars.data : null %}
<div class="page-header dossier-editor__header">
    <div class="d-flex align-items-center">
        <a href="{{ path('dossier.list') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div>
            <h1 class="h3 mb-1 text-gray-800">{{ id > 0 ? 'Modifier le dossier' : 'Nouveau dossier' }}</h1>
        </div>
    </div>
</div>

<div class="dossier-editor">
    {{ form_start(dossier, {'attr': {'class': 'needs-validation dossier-editor__form', 'novalidate': 'novalidate'}}) }}

    <div class="row">
        <div class="col-xl-7 mb-4">
            <section class="form-card dossier-panel mb-4">
                <div class="dossier-panel__head">
                    <h5><i class="fas fa-folder-open mr-2"></i>Identite du dossier</h5>
                    <p>Nom, adresse, reference et devise utilises dans toute l'application.</p>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            {{ form_label(dossier.nom, 'Nom', {'label_attr': {'class': 'required'}}) }}
                            {{ form_widget(dossier.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom du dossier'}}) }}
                            {{ form_errors(dossier.nom) }}
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    {{ form_label(dossier.adresse, 'Adresse') }}
                    {{ form_widget(dossier.adresse, {'attr': {'class': 'form-control', 'placeholder': 'Adresse du dossier'}}) }}
                    {{ form_errors(dossier.adresse) }}
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            {{ form_label(dossier.codepostal, 'Code postal') }}
                            {{ form_widget(dossier.codepostal, {'attr': {'class': 'form-control', 'placeholder': 'Code postal'}}) }}
                            {{ form_errors(dossier.codepostal) }}
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            {{ form_label(dossier.ville, 'Ville') }}
                            {{ form_widget(dossier.ville, {'attr': {'class': 'form-control', 'placeholder': 'Ville'}}) }}
                            {{ form_errors(dossier.ville) }}
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            {{ form_label(dossier.pays, 'Pays') }}
                            {{ form_widget(dossier.pays, {'attr': {'class': 'form-control', 'placeholder': 'Pays'}}) }}
                            {{ form_errors(dossier.pays) }}
                        </div>
                    </div>
                </div>

                <div class="form-group mb-0">
                    {{ form_label(dossier.devise, 'Devise') }}
                    {{ form_widget(dossier.devise, {'attr': {'class': 'form-control js-example-basic-single'}}) }}
                    {{ form_errors(dossier.devise) }}
                </div>
            </section>

            <section class="form-card dossier-panel mb-4 dossier-panel--compact">
                <div class="dossier-panel__head">
                    <h5><i class="fas fa-id-card mr-2"></i>Infos legales et contact</h5>
                    <p>Ces informations sont reutilisees dans le PDF facture (pied de page).</p>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(dossier.siret, 'SIRET / ICE') }}
                            {{ form_widget(dossier.siret, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 12345678901234'}}) }}
                            {{ form_errors(dossier.siret) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(dossier.naf, 'Code NAF') }}
                            {{ form_widget(dossier.naf, {'attr': {'class': 'form-control', 'placeholder': 'Code NAF'}}) }}
                            {{ form_errors(dossier.naf) }}
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(dossier.tvaintra, 'TVA Intra') }}
                            {{ form_widget(dossier.tvaintra, {'attr': {'class': 'form-control', 'placeholder': 'Numero TVA'}}) }}
                            {{ form_errors(dossier.tvaintra) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(dossier.tel, 'Telephone') }}
                            {{ form_widget(dossier.tel, {'attr': {'class': 'form-control', 'placeholder': 'Telephone'}}) }}
                            {{ form_errors(dossier.tel) }}
                        </div>
                    </div>
                </div>

                <div class="row mb-0">
                    <div class="col-md-6">
                        <div class="form-group mb-0">
                            {{ form_label(dossier.email, 'Email') }}
                            {{ form_widget(dossier.email, {'attr': {'class': 'form-control', 'placeholder': 'contact@entreprise.com'}}) }}
                            {{ form_errors(dossier.email) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-0">
                            {{ form_label(dossier.rc, 'RC') }}
                            {{ form_widget(dossier.rc, {'attr': {'class': 'form-control', 'placeholder': 'Registre du commerce'}}) }}
                            {{ form_errors(dossier.rc) }}
                        </div>
                    </div>
                </div>

                <div class="form-group mt-3 mb-0">
                    {{ form_label(dossier.penalitesretard, 'Texte legal retard (modele 1)') }}
                    {{ form_widget(dossier.penalitesretard, {'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Pénalités de retard... (facultatif)'}}) }}
                    {{ form_errors(dossier.penalitesretard) }}
                </div>
            </section>

            <section class="form-card dossier-panel mb-4 dossier-panel--compact">
                <div class="dossier-panel__head">
                    <h5><i class="fas fa-university mr-2"></i>Coordonnees bancaires</h5>
                </div>
                <div class="row mb-0">
                    <div class="col-md-6">
                        <div class="form-group mb-0">
                            {{ form_label(dossier.iban, 'IBAN') }}
                            {{ form_widget(dossier.iban, {'attr': {'class': 'form-control', 'placeholder': 'IBAN'}}) }}
                            {{ form_errors(dossier.iban) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-0">
                            {{ form_label(dossier.bic, 'BIC') }}
                            {{ form_widget(dossier.bic, {'attr': {'class': 'form-control', 'placeholder': 'BIC / SWIFT'}}) }}
                            {{ form_errors(dossier.bic) }}
                        </div>
                    </div>
                </div>
            </section>

            <section class="form-card dossier-panel mb-4 dossier-panel--compact">
                <div class="dossier-panel__head">
                    <h5><i class="fas fa-hashtag mr-2"></i>Numerotations</h5>
                    <p>Numéros initiaux pour chaque type de pièce. Le système incrémente automatiquement à chaque création avec des séquences indépendantes.</p>
                </div>
                <div class="row mb-0">
                    <div class="col-md-3">
                        <div class="form-group mb-0">
                            {{ form_label(dossier.devisno, 'Devis') }}
                            {{ form_widget(dossier.devisno, {'attr': {'class': 'form-control', 'min': 0, 'placeholder': 'N° devis'}}) }}
                            {{ form_errors(dossier.devisno) }}
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb-0">
                            {{ form_label(dossier.cmdno, 'Commande') }}
                            {{ form_widget(dossier.cmdno, {'attr': {'class': 'form-control', 'min': 0, 'placeholder': 'N° commande'}}) }}
                            {{ form_errors(dossier.cmdno) }}
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb-0">
                            {{ form_label(dossier.blno, 'BL') }}
                            {{ form_widget(dossier.blno, {'attr': {'class': 'form-control', 'min': 0, 'placeholder': 'N° BL'}}) }}
                            {{ form_errors(dossier.blno) }}
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb-0">
                            {{ form_label(dossier.factureno, 'Facture') }}
                            {{ form_widget(dossier.factureno, {'attr': {'class': 'form-control', 'min': 0, 'placeholder': 'N° facture'}}) }}
                            {{ form_errors(dossier.factureno) }}
                        </div>
                    </div>
                </div>
            </section>

            <section class="form-card dossier-panel dossier-panel--compact">
                <div class="dossier-panel__head">
                    <h5><i class="fas fa-image mr-2"></i>Logo</h5>
                    <p>Ajoutez un logo propre pour le switcher de dossier, les fiches utilisateurs et les vues de gestion.</p>
                </div>

                <div class="logo-uploader">
                    <div class="logo-uploader__preview logo-uploader__preview--large" id="logoPreview">
                        {% if dossierEntity is defined and dossierEntity and dossierEntity.logo %}
                            <img src="{{ dossierEntity.logo }}" alt="Logo actuel" id="logoPreviewImage">
                        {% else %}
                            <div class="logo-uploader__placeholder" id="logoPreviewPlaceholder">
                                <i class="fas fa-image"></i>
                                <span>Aperçu du logo</span>
                            </div>
                        {% endif %}
                    </div>

                    <div class="logo-uploader__controls">
                        <div class="logo-upload-trigger-wrap">
                            <button type="button" class="logo-upload-trigger" id="logoUploadButton">
                                <i class="fas fa-upload mr-2"></i>Choisir un logo
                            </button>
                            {{ form_widget(dossier.logoFile, {'attr': {'class': 'logo-upload-input', 'id': 'logoUpload', 'accept': 'image/*', 'onchange': 'window.handleDossierLogoChange && window.handleDossierLogoChange(this)'}}) }}
                        </div>
                        <span class="logo-upload-filename" id="logoFileName">{% if dossierEntity is defined and dossierEntity and dossierEntity.logo %}Logo actuel chargé{% else %}Aucun fichier sélectionné{% endif %}</span>
                        <small class="text-muted">Formats conseillés : PNG ou JPG. Le logo sera affiché avec le nom du dossier.</small>
                        {{ form_errors(dossier.logoFile) }}
                    </div>
                </div>
            </section>
        </div>

        <div class="col-xl-5 mb-4">
            <section class="form-card dossier-panel dossier-panel--compact dossier-panel--sticky">
                <div class="dossier-panel__head dossier-panel__head--with-action">
                    <div>
                        <h5><i class="fas fa-palette mr-2"></i>Palette du dossier</h5>
                        <p>Le theme choisi pilote les couleurs principales du menu, des boutons et des contenus.</p>
                    </div>
                    {% if is_granted('ROLE_ADMIN') %}
                        <button type="button" class="theme-settings-trigger js-open-theme-modal" title="Creer un nouveau theme">
                            <i class="fas fa-plus"></i>
                        </button>
                    {% endif %}
                </div>
                <div class="theme-option-grid" id="themeOptionGrid">
                    {% for child in dossier.theme %}
                        {% set themeName = child.vars.attr['data-theme-name']|default(child.vars.label|default('Theme')) %}
                        {% set themeDescription = child.vars.attr['data-theme-description']|default('Palette personnalisee') %}
                        {% set themePrimary = child.vars.attr['data-theme-primary']|default('#475569') %}
                        {% set themeSecondary = child.vars.attr['data-theme-secondary']|default('#334155') %}
                        {% set themeAccent = child.vars.attr['data-theme-accent']|default('#94a3b8') %}
                        {% set themeId = child.vars.attr['data-theme-id']|default('') %}
                        {% set themeSystemRaw = child.vars.attr['data-theme-system']|default('0') %}
                        {% set themeIsSystem = themeSystemRaw in ['1', 1, true, 'true'] %}
                        <div
                            class="theme-option"
                            data-theme-id="{{ themeId }}"
                            data-theme-name="{{ themeName }}"
                            data-theme-description="{{ themeDescription }}"
                            data-theme-primary="{{ themePrimary }}"
                            data-theme-secondary="{{ themeSecondary }}"
                            data-theme-accent="{{ themeAccent }}"
                            data-theme-is-system="{{ themeIsSystem ? '1' : '0' }}"
                        >
                            <input
                                type="radio"
                                class="theme-radio-input"
                                id="{{ child.vars.id }}"
                                name="{{ child.vars.full_name }}"
                                value="{{ child.vars.value }}"
                                {% if child.vars.checked %}checked{% endif %}
                                {% if child.vars.required %}required{% endif %}
                                data-theme-id="{{ themeId }}"
                            >
                            <label for="{{ child.vars.id }}" class="theme-option__card" data-theme-card="true">
                                <span class="theme-option__preview">
                                    <span class="theme-option__dot" style="background: {{ themePrimary }};"></span>
                                    <span class="theme-option__dot" style="background: {{ themeSecondary }};"></span>
                                    <span class="theme-option__dot" style="background: {{ themeAccent }};"></span>
                                </span>
                                <span class="theme-option__content">
                                    <span class="theme-option__title">{{ themeName }}</span>
                                    <span class="theme-option__text" title="{{ themeDescription }}">{{ themeDescription }}</span>
                                </span>
                                <span class="theme-option__check">
                                    <i class="fas fa-check"></i>
                                </span>
                            </label>
                            {% if is_granted('ROLE_ADMIN') %}
                                <div class="theme-option__menu">
                                    <button
                                        type="button"
                                        class="theme-option__menu-toggle no-loading"
                                        data-no-loading="true"
                                        data-theme-menu-toggle="true"
                                        aria-haspopup="true"
                                        aria-expanded="false"
                                        aria-label="Actions du theme"
                                    >
                                        <i class="fas fa-ellipsis-h"></i>
                                    </button>
                                    <div class="theme-option__menu-dropdown" data-theme-menu-dropdown hidden>
                                        <button type="button" class="theme-option__menu-item" data-theme-action="edit">
                                            <i class="fas fa-pen mr-2"></i>Modifier
                                        </button>
                                        <button
                                            type="button"
                                            class="theme-option__menu-item theme-option__menu-item--danger"
                                            data-theme-action="delete"
                                            {% if themeIsSystem %}disabled title="Theme systeme non supprimable"{% endif %}
                                        >
                                            <i class="fas fa-trash mr-2"></i>Supprimer
                                        </button>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="theme-empty-state">
                            <i class="fas fa-palette"></i>
                            <span>Aucun theme disponible.</span>
                        </div>
                    {% endfor %}
                </div>
                <div class="theme-pagination" id="themePagination">
                    <button type="button" class="theme-pagination__arrow" id="themePagePrev" aria-label="Themes precedents">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <div class="theme-pagination__dots" id="themePagerDots" role="tablist" aria-label="Pagination des themes"></div>
                    <button type="button" class="theme-pagination__arrow" id="themePageNext" aria-label="Themes suivants">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
                {{ form_errors(dossier.theme) }}
            </section>
        </div>
    </div>

    <div class="form-actions dossier-editor__actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save mr-2"></i>{{ id > 0 ? 'Mettre a jour' : 'Enregistrer' }}
        </button>
        <a href="{{ path('dossier.list') }}" class="btn btn-secondary">
            <i class="fas fa-times mr-2"></i>Annuler
        </a>
    </div>

    {{ form_widget(dossier._token) }}
    {{ form_end(dossier, {'render_rest': false}) }}
</div>

{% if is_granted('ROLE_ADMIN') %}
{% set themeUpdateUrlTemplate = path('dossier.theme.update', {id: 999999})|replace({'999999': '__ID__'}) %}
{% set themeDeleteUrlTemplate = path('dossier.theme.delete', {id: 999999})|replace({'999999': '__ID__'}) %}
<div
    class="theme-modal"
    id="themeCreateModal"
    aria-hidden="true"
    data-create-url="{{ path('dossier.theme.create') }}"
    data-update-url-template="{{ themeUpdateUrlTemplate }}"
    data-delete-url-template="{{ themeDeleteUrlTemplate }}"
    data-csrf-token="{{ csrf_token('create_dossier_theme') }}"
    data-manage-csrf-token="{{ csrf_token('manage_dossier_theme') }}"
>
    <div class="theme-modal__backdrop" data-theme-modal-close="true"></div>
    <div class="theme-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="themeCreateModalTitle">
        <button type="button" class="theme-modal__close" data-theme-modal-close="true" aria-label="Fermer">&times;</button>

        <div class="theme-modal__icon">
            <i class="fas fa-palette"></i>
        </div>

        <h4 id="themeCreateModalTitle">Nouveau theme</h4>
        <p class="theme-modal__subtitle" id="themeCreateModalSubtitle">Ajoutez une palette personnalisee qui sera disponible immediatement dans ce dossier.</p>

        <div class="theme-modal__message-slot">
            <div class="theme-modal__alert" id="themeCreateMessage" hidden></div>
        </div>

        <form id="themeCreateForm" class="theme-modal__form no-loading" data-no-loading="true" novalidate>
            <input type="hidden" id="themeEditId" name="themeId" value="">
            <div class="form-group mb-3">
                <label for="themeName" class="required">Nom du theme</label>
                <input type="text" id="themeName" name="name" class="form-control" placeholder="Ex: Bleu ocean premium" required>
            </div>

            <div class="form-group mb-3">
                <label for="themeDescription">Description</label>
                <input type="text" id="themeDescription" name="description" class="form-control" placeholder="Ex: Palette elegante pour pilotage commercial">
            </div>

            <div class="theme-color-grid">
                <div class="theme-color-row" data-color-role="primary">
                    <label for="themePrimaryColor" class="required">Couleur primaire</label>
                    <div class="theme-color-inputs">
                        <input type="color" id="themePrimaryColor" name="primaryColor" value="#4F46E5" data-color-input data-color-role="primary">
                        <input type="text" class="form-control" value="#4F46E5" data-hex-input data-color-role="primary" maxlength="7" required>
                    </div>
                </div>
                  
                <div class="theme-color-row theme-color-row--readonly" data-color-role="accent">
                    <label for="themeAccentColor">Couleur accent<span class="theme-color-row__hint">Auto</span></label>
                    <div class="theme-color-inputs">
                        <input type="color" id="themeAccentColor" value="#818CF8" data-color-input data-color-role="accent" disabled tabindex="-1" aria-readonly="true">
                        <input type="text" class="form-control" value="#818CF8" data-hex-input data-color-role="accent" maxlength="7" readonly aria-readonly="true">
                    </div>
                </div>
            </div>

            <div class="theme-modal__actions">
                <button type="button" class="btn btn-secondary" data-theme-modal-close="true">Annuler</button>
                <button type="submit" class="btn btn-primary" id="themeCreateSubmitBtn">
                    <span class="theme-submit-label"><i class="fas fa-plus mr-2"></i><span id="themeSubmitLabelText">Creer le theme</span></span>
                    <span class="theme-submit-loading" hidden><i class="fas fa-circle-notch fa-spin mr-2"></i><span id="themeSubmitLoadingText">Creation...</span></span>
                </button>
            </div>
        </form>
    </div>
</div>
{% endif %}
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var HEX_COLOR_REGEX = /^#[0-9A-Fa-f]{6}$/;

    window.handleDossierLogoChange = function (inputElement) {
        var preview = document.getElementById('logoPreview');
        var fileName = document.getElementById('logoFileName');
        var file = inputElement && inputElement.files && inputElement.files[0] ? inputElement.files[0] : null;

        if (!preview || !fileName) {
            return;
        }

        if (!file) {
            fileName.textContent = '{% if dossierEntity is defined and dossierEntity and dossierEntity.logo %}Logo actuel charge{% else %}Aucun fichier selectionne{% endif %}';
            return;
        }

        fileName.textContent = file.name;

        if (!file.type.match(/^image\//)) {
            return;
        }

        var reader = new FileReader();
        reader.onload = function (loadEvent) {
            preview.innerHTML = '<img src="' + loadEvent.target.result + '" alt="Apercu du logo" id="logoPreviewImage">';
        };
        reader.readAsDataURL(file);
    };

    function initDossierForm() {
        if (window.jQuery && $.fn.select2) {
            $('.js-example-basic-single').each(function () {
                if (!$(this).hasClass('select2-hidden-accessible')) {
                    $(this).select2({
                        theme: 'bootstrap-5',
                        allowClear: true,
                        width: '100%'
                    });
                }
            });
        }

        var input = document.getElementById('logoUpload');
        var preview = document.getElementById('logoPreview');
        var themeGrid = document.getElementById('themeOptionGrid');
        var themePagination = document.getElementById('themePagination');
        var themePagePrevButton = document.getElementById('themePagePrev');
        var themePageNextButton = document.getElementById('themePageNext');
        var themePagerDots = document.getElementById('themePagerDots');
        var THEME_PAGE_SIZE = 8;
        var currentThemePage = 0;
        var isAdmin = {{ is_granted('ROLE_ADMIN') ? 'true' : 'false' }};

        function getThemeOptions() {
            return themeGrid ? Array.from(themeGrid.querySelectorAll('.theme-option')) : [];
        }

        function syncThemePaginationDots(pageCount) {
            if (!themePagerDots) {
                return;
            }

            themePagerDots.innerHTML = '';

            for (var page = 0; page < pageCount; page += 1) {
                var dot = document.createElement('button');
                dot.type = 'button';
                dot.className = 'theme-pagination__dot' + (page === currentThemePage ? ' is-active' : '');
                dot.setAttribute('aria-label', 'Aller a la page ' + (page + 1));
                dot.setAttribute('aria-current', page === currentThemePage ? 'true' : 'false');
                dot.setAttribute('data-theme-page', String(page));
                themePagerDots.appendChild(dot);
            }
        }

        function applyThemePage() {
            var options = getThemeOptions();
            var pageCount = Math.max(1, Math.ceil(options.length / THEME_PAGE_SIZE));
            if (currentThemePage >= pageCount) {
                currentThemePage = pageCount - 1;
            }
            if (currentThemePage < 0) {
                currentThemePage = 0;
            }

            options.forEach(function (option, index) {
                var optionPage = Math.floor(index / THEME_PAGE_SIZE);
                option.hidden = optionPage !== currentThemePage;
            });

            if (themePagination) {
                themePagination.classList.toggle('is-hidden', options.length <= THEME_PAGE_SIZE);
            }
            if (themePagePrevButton) {
                themePagePrevButton.disabled = currentThemePage <= 0;
            }
            if (themePageNextButton) {
                themePageNextButton.disabled = currentThemePage >= (pageCount - 1);
            }

            syncThemePaginationDots(pageCount);
        }

        function showGlobalToast(message, type) {
            if (!message) {
                return;
            }

            if (typeof window.showAppToast === 'function') {
                window.showAppToast({
                    message: message,
                    type: type || 'info'
                });
                return;
            }

            if (type === 'error') {
                console.error(message);
            } else {
                console.log(message);
            }
        }

        function syncThemeSelection() {
            var selectedIndex = -1;
            var options = getThemeOptions();

            options.forEach(function (option, index) {
                var radio = option.querySelector('.theme-radio-input');
                var isSelected = !!(radio && radio.checked);
                option.classList.toggle('theme-option--selected', isSelected);
                if (isSelected) {
                    selectedIndex = index;
                }
            });

            if (selectedIndex >= 0) {
                currentThemePage = Math.floor(selectedIndex / THEME_PAGE_SIZE);
            }

            applyThemePage();
        }

        function getThemeDataFromOption(option) {
            if (!option) {
                return null;
            }

            return {
                id: parseInt(option.getAttribute('data-theme-id') || '', 10),
                name: option.getAttribute('data-theme-name') || 'Theme',
                description: option.getAttribute('data-theme-description') || 'Palette personnalisee',
                primaryColor: option.getAttribute('data-theme-primary') || '#475569',
                secondaryColor: option.getAttribute('data-theme-secondary') || '#334155',
                accentColor: option.getAttribute('data-theme-accent') || '#94a3b8',
                isSystem: String(option.getAttribute('data-theme-is-system') || '0') === '1'
            };
        }

