{% extends "template_oukatech.html.twig" %}
{% block PageTitle%}
    Dossier
{% endblock %}
{% block title %}Dossier{% endblock %}
{% block body %}
{{ form_start(dossier)}}
    <div class="row">
        <div class="col">{{form_row(dossier.nom)}}</div>
        <div class="col">{{form_row(dossier.adresse)}}</div>
    </div>
    <div class="row">
        
        <div class="col">{{form_row(dossier.logo)}}</div>
        <div class="col">{{form_row(dossier.rc)}}</div>
        <div class="col">{{ form_row(dossier.devise,{'attr': {'class': 'form-control js-example-basic-single'}}) }}</div>
    </div>
    
    <button type="submit" class="btn btn-lg btn-primary mt-2">Enregistrer</button>
{{form_rest(dossier)}}
{% endblock %}
{% block javascripts %}
    <script>
        $(document).ready(function() {
            $('.js-example-basic-single').select2();
        });
    </script>
{% endblock %}