            var menuDropdown = option.querySelector('[data-theme-menu-dropdown]');
            if (!menuContainer || !menuToggle || !menuDropdown) {
                return;
            }

            option.dataset.actionsBound = '1';

            menuToggle.addEventListener('click', function (event) {
                event.preventDefault();
                event.stopPropagation();

                var shouldOpen = menuDropdown.hidden;
                closeAllThemeMenus(shouldOpen ? option : null);
                menuDropdown.hidden = !shouldOpen;
                menuToggle.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
                menuContainer.classList.toggle('theme-option__menu--open', shouldOpen);
            });

            menuDropdown.addEventListener('click', function (event) {
                var actionButton = event.target && event.target.closest ? event.target.closest('[data-theme-action]') : null;
                if (!actionButton || actionButton.disabled) {
                    return;
                }

                event.preventDefault();
                event.stopPropagation();

                var action = actionButton.getAttribute('data-theme-action');
                var themeData = getThemeDataFromOption(option);
                menuDropdown.hidden = true;
                menuToggle.setAttribute('aria-expanded', 'false');
                menuContainer.classList.remove('theme-option__menu--open');

                if (action === 'edit') {
                    openModal('edit', themeData);
