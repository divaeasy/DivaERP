{% extends "template_oukatech.html.twig" %}
{% block PageTitle %}Dossier{% endblock %}

{% block body %}
{% set dossierEntity = dossier is defined ? dossier.vars.data : null %}
<div class="page-header dossier-editor__header">
    <div class="d-flex align-items-center">
        <a href="{{ path('dossier.list') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div>
            <h1 class="h3 mb-1 text-gray-800">{{ id > 0 ? 'Modifier le dossier' : 'Nouveau dossier' }}</h1>
        </div>
    </div>
</div>

<div class="dossier-editor">
    {{ form_start(dossier, {'attr': {'class': 'needs-validation dossier-editor__form', 'novalidate': 'novalidate'}}) }}

    <div class="row align-items-start">
        <div class="col-xl-7 mb-4">
            <section class="form-card dossier-panel mb-4">
                <div class="dossier-panel__head">
                    <h5><i class="fas fa-folder-open mr-2"></i>Identite du dossier</h5>
                    <p>Nom, adresse, reference et devise utilises dans toute l'application.</p>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(dossier.nom, 'Nom', {'label_attr': {'class': 'required'}}) }}
                            {{ form_widget(dossier.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom du dossier'}}) }}
                            {{ form_errors(dossier.nom) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(dossier.rc, 'RC') }}
                            {{ form_widget(dossier.rc, {'attr': {'class': 'form-control', 'placeholder': 'Registre du commerce'}}) }}
                            {{ form_errors(dossier.rc) }}
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    {{ form_label(dossier.adresse, 'Adresse') }}
                    {{ form_widget(dossier.adresse, {'attr': {'class': 'form-control', 'placeholder': 'Adresse du dossier'}}) }}
                    {{ form_errors(dossier.adresse) }}
                </div>

                <div class="form-group mb-0">
                    {{ form_label(dossier.devise, 'Devise') }}
                    {{ form_widget(dossier.devise, {'attr': {'class': 'form-control js-example-basic-single'}}) }}
                    {{ form_errors(dossier.devise) }}
                </div>
            </section>

            <section class="form-card dossier-panel dossier-panel--compact">
                <div class="dossier-panel__head">
                    <h5><i class="fas fa-image mr-2"></i>Logo</h5>
                    <p>Ajoutez un logo propre pour le switcher de dossier, les fiches utilisateurs et les vues de gestion.</p>
                </div>

                <div class="logo-uploader">
                    <div class="logo-uploader__preview logo-uploader__preview--large" id="logoPreview">
                        {% if dossierEntity is defined and dossierEntity and dossierEntity.logo %}
                            <img src="{{ dossierEntity.logo }}" alt="Logo actuel" id="logoPreviewImage">
                        {% else %}
                            <div class="logo-uploader__placeholder" id="logoPreviewPlaceholder">
                                <i class="fas fa-image"></i>
                                <span>Aperçu du logo</span>
                            </div>
                        {% endif %}
                    </div>

                    <div class="logo-uploader__controls">
                        <div class="logo-upload-trigger-wrap">
                            <button type="button" class="logo-upload-trigger" id="logoUploadButton">
                                <i class="fas fa-upload mr-2"></i>Choisir un logo
                            </button>
                            {{ form_widget(dossier.logoFile, {'attr': {'class': 'logo-upload-input', 'id': 'logoUpload', 'accept': 'image/*', 'onchange': 'window.handleDossierLogoChange && window.handleDossierLogoChange(this)'}}) }}
                        </div>
                        <span class="logo-upload-filename" id="logoFileName">{% if dossierEntity is defined and dossierEntity and dossierEntity.logo %}Logo actuel chargé{% else %}Aucun fichier sélectionné{% endif %}</span>
                        <small class="text-muted">Formats conseillés : PNG ou JPG. Le logo sera affiché avec le nom du dossier.</small>
                        {{ form_errors(dossier.logoFile) }}
                    </div>
                </div>
            </section>
        </div>

        <div class="col-xl-5 mb-4">
            <section class="form-card dossier-panel dossier-panel--compact dossier-panel--sticky">
                <div class="dossier-panel__head dossier-panel__head--with-action">
                    <div>
                        <h5><i class="fas fa-palette mr-2"></i>Palette du dossier</h5>
                        <p>Le theme choisi pilote les couleurs principales du menu, des boutons et des contenus.</p>
                    </div>
                    {% if is_granted('ROLE_ADMIN') %}
                        <button type="button" class="theme-settings-trigger js-open-theme-modal" title="Creer un nouveau theme">
                            <i class="fas fa-cog"></i>
                        </button>
                    {% endif %}
                </div>

                <div class="theme-option-grid" id="themeOptionGrid">
                    {% for child in dossier.theme %}
                        {% set themeName = child.vars.attr['data-theme-name']|default(child.vars.label|default('Theme')) %}
                        {% set themeDescription = child.vars.attr['data-theme-description']|default('Palette personnalisee') %}
                        {% set themePrimary = child.vars.attr['data-theme-primary']|default('#475569') %}
                        {% set themeSecondary = child.vars.attr['data-theme-secondary']|default('#334155') %}
                        {% set themeAccent = child.vars.attr['data-theme-accent']|default('#94a3b8') %}
                        {% set themeId = child.vars.attr['data-theme-id']|default('') %}
                        <div class="theme-option" data-theme-id="{{ themeId }}">
                            {{ form_widget(child, {'attr': {'class': 'theme-radio-input'}}) }}
                            <label for="{{ child.vars.id }}" class="theme-option__card" data-theme-card="true">
                                <span class="theme-option__preview">
                                    <span class="theme-option__dot" style="background: {{ themePrimary }};"></span>
                                    <span class="theme-option__dot" style="background: {{ themeSecondary }};"></span>
                                    <span class="theme-option__dot" style="background: {{ themeAccent }};"></span>
                                </span>
                                <span class="theme-option__content">
                                    <span class="theme-option__title">{{ themeName }}</span>
                                    <span class="theme-option__text">{{ themeDescription }}</span>
                                </span>
                                <span class="theme-option__check">
                                    <i class="fas fa-check"></i>
                                </span>
                            </label>
                        </div>
                    {% else %}
                        <div class="theme-empty-state">
                            <i class="fas fa-palette"></i>
                            <span>Aucun theme disponible.</span>
                        </div>
                    {% endfor %}
                </div>
                {{ form_errors(dossier.theme) }}
            </section>
        </div>
    </div>

    <div class="form-actions dossier-editor__actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save mr-2"></i>{{ id > 0 ? 'Mettre a jour' : 'Enregistrer' }}
        </button>
        <a href="{{ path('dossier.list') }}" class="btn btn-secondary">
            <i class="fas fa-times mr-2"></i>Annuler
        </a>
    </div>

    {{ form_widget(dossier._token) }}
    {{ form_end(dossier, {'render_rest': false}) }}
</div>

{% if is_granted('ROLE_ADMIN') %}
<div class="theme-modal" id="themeCreateModal" aria-hidden="true" data-create-url="{{ path('dossier.theme.create') }}" data-csrf-token="{{ csrf_token('create_dossier_theme') }}">
    <div class="theme-modal__backdrop" data-theme-modal-close="true"></div>
    <div class="theme-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="themeCreateModalTitle">
        <button type="button" class="theme-modal__close" data-theme-modal-close="true" aria-label="Fermer">&times;</button>

        <div class="theme-modal__icon">
            <i class="fas fa-palette"></i>
        </div>

        <h4 id="themeCreateModalTitle">Nouveau theme</h4>
        <p class="theme-modal__subtitle">Ajoutez une palette personnalisee qui sera disponible immediatement dans ce dossier.</p>

        <div class="theme-modal__message-slot">
            <div class="theme-modal__alert" id="themeCreateMessage" hidden></div>
        </div>

        <form id="themeCreateForm" class="theme-modal__form" novalidate>
            <div class="form-group mb-3">
                <label for="themeName" class="required">Nom du theme</label>
                <input type="text" id="themeName" name="name" class="form-control" placeholder="Ex: Bleu ocean premium" required>
            </div>

            <div class="form-group mb-3">
                <label for="themeDescription">Description</label>                                                                                                           v                                                                      
                <input type="text" id="themeDescription" name="description" class="form-control" placeholder="Ex: Palette elegante pour pilotage commercial">
            </div>

            <div class="theme-color-grid">
                <div class="theme-color-row" data-color-role="primary">
                    <label for="themePrimaryColor" class="required">Couleur primaire</label>
                    <div class="theme-color-inputs">
                        <input type="color" id="themePrimaryColor" name="primaryColor" value="#4F46E5" data-color-input data-color-role="primary">
                        <input type="text" class="form-control" value="#4F46E5" data-hex-input data-color-role="primary" maxlength="7" required>
                    </div>
                </div>
                  
                <div class="theme-color-row theme-color-row--readonly" data-color-role="accent">
                    <label for="themeAccentColor">Couleur accent<span class="theme-color-row__hint">Auto</span></label>
                    <div class="theme-color-inputs">
                        <input type="color" id="themeAccentColor" value="#818CF8" data-color-input data-color-role="accent" disabled tabindex="-1" aria-readonly="true">
                        <input type="text" class="form-control" value="#818CF8" data-hex-input data-color-role="accent" maxlength="7" readonly aria-readonly="true">
                    </div>
                </div>
            </div>

            <div class="theme-modal__actions">
                <button type="button" class="btn btn-secondary" data-theme-modal-close="true">Annuler</button>
                <button type="submit" class="btn btn-primary" id="themeCreateSubmitBtn">
                    <span class="theme-submit-label"><i class="fas fa-plus mr-2"></i>Creer le theme</span>
                    <span class="theme-submit-loading" hidden><i class="fas fa-circle-notch fa-spin mr-2"></i>Creation...</span>
                </button>
            </div>
        </form>
    </div>
</div>
{% endif %}
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var HEX_COLOR_REGEX = /^#[0-9A-Fa-f]{6}$/;

    window.handleDossierLogoChange = function (inputElement) {
        var preview = document.getElementById('logoPreview');
        var fileName = document.getElementById('logoFileName');
        var file = inputElement && inputElement.files && inputElement.files[0] ? inputElement.files[0] : null;

        if (!preview || !fileName) {
            return;
        }

        if (!file) {
            fileName.textContent = '{% if dossierEntity is defined and dossierEntity and dossierEntity.logo %}Logo actuel charge{% else %}Aucun fichier selectionne{% endif %}';
            return;
        }

        fileName.textContent = file.name;

        if (!file.type.match(/^image\//)) {
            return;
        }

        var reader = new FileReader();
        reader.onload = function (loadEvent) {
            preview.innerHTML = '<img src="' + loadEvent.target.result + '" alt="Apercu du logo" id="logoPreviewImage">';
        };
        reader.readAsDataURL(file);
    };

    function initDossierForm() {
        if (window.jQuery && $.fn.select2) {
            $('.js-example-basic-single').each(function () {
                if (!$(this).hasClass('select2-hidden-accessible')) {
                    $(this).select2({
                        theme: 'bootstrap-5',
                        allowClear: true,
                        width: '100%'
                    });
                }
            });
        }

        var input = document.getElementById('logoUpload');
        var preview = document.getElementById('logoPreview');
        var themeGrid = document.getElementById('themeOptionGrid');

        function getThemeOptions() {
            return themeGrid ? Array.from(themeGrid.querySelectorAll('.theme-option')) : [];
        }

        function syncThemeSelection() {
            getThemeOptions().forEach(function (option) {
                var radio = option.querySelector('.theme-radio-input');
                option.classList.toggle('theme-option--selected', !!(radio && radio.checked));
            });
        }

        function bindThemeOption(option) {
            if (!option || option.dataset.bound === '1') {
                return;
            }

            option.dataset.bound = '1';
            var radio = option.querySelector('.theme-radio-input');
            var card = option.querySelector('[data-theme-card="true"]');

            if (card && radio) {
                card.addEventListener('click', function (event) {
                    event.preventDefault();
                    radio.checked = true;
                    radio.dispatchEvent(new Event('change', { bubbles: true }));
                    syncThemeSelection();
                });
            }

            if (radio) {
                radio.addEventListener('change', syncThemeSelection);
            }
        }

        function escapeHtml(value) {
            return String(value || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function appendThemeOption(theme) {
            if (!themeGrid || !theme || !theme.id) {
                return;
            }

            var firstRadio = themeGrid.querySelector('.theme-radio-input');
            var inputName = firstRadio ? firstRadio.getAttribute('name') : 'dossier_form[theme]';
            var firstId = firstRadio ? firstRadio.id : 'dossier_form_theme_0';
            var idBase = firstId ? firstId.replace(/_\d+$/, '') : 'dossier_form_theme';
            var optionId = idBase + '_' + String(theme.id);

            var option = document.createElement('div');
            option.className = 'theme-option';
            option.setAttribute('data-theme-id', String(theme.id));
            option.innerHTML = '' +
                '<input type="radio" class="theme-radio-input" id="' + optionId + '" name="' + escapeHtml(inputName) + '" value="' + String(theme.id) + '">' +
                '<label for="' + optionId + '" class="theme-option__card" data-theme-card="true">' +
                    '<span class="theme-option__preview">' +
                        '<span class="theme-option__dot" style="background:' + escapeHtml(theme.primaryColor || '#475569') + ';"></span>' +
                        '<span class="theme-option__dot" style="background:' + escapeHtml(theme.secondaryColor || '#334155') + ';"></span>' +
                        '<span class="theme-option__dot" style="background:' + escapeHtml(theme.accentColor || '#94a3b8') + ';"></span>' +
                    '</span>' +
                    '<span class="theme-option__content">' +
                        '<span class="theme-option__title">' + escapeHtml(theme.name || 'Theme') + '</span>' +
                        '<span class="theme-option__text">' + escapeHtml(theme.description || 'Palette personnalisee') + '</span>' +
                    '</span>' +
                    '<span class="theme-option__check"><i class="fas fa-check"></i></span>' +
                '</label>';

            var emptyState = themeGrid.querySelector('.theme-empty-state');
            if (emptyState) {
                emptyState.remove();
            }

            themeGrid.prepend(option);
            bindThemeOption(option);

            var radio = option.querySelector('.theme-radio-input');
            if (radio) {
                radio.checked = true;
                radio.dispatchEvent(new Event('change', { bubbles: true }));
            }

            syncThemeSelection();
        }

        getThemeOptions().forEach(bindThemeOption);
        syncThemeSelection();

        if (input && preview && input.dataset.enhanced !== '1') {
            input.dataset.enhanced = '1';
            input.classList.add('logo-upload-input--ready');
            input.addEventListener('change', function () {
                window.handleDossierLogoChange(input);
            });
        }

        var modal = document.getElementById('themeCreateModal');
        if (!modal || modal.dataset.bound === '1') {
            return;
        }

        modal.dataset.bound = '1';
        var modalOpenBtn = document.querySelector('.js-open-theme-modal');
        var modalCloseButtons = Array.from(modal.querySelectorAll('[data-theme-modal-close="true"]'));
        var modalForm = document.getElementById('themeCreateForm');
        var modalMessage = document.getElementById('themeCreateMessage');
        var submitButton = document.getElementById('themeCreateSubmitBtn');
        var primaryColorInput = modal.querySelector('[data-color-input][data-color-role="primary"]');
        var primaryHexInput = modal.querySelector('[data-hex-input][data-color-role="primary"]');
        var secondaryColorInput = modal.querySelector('[data-color-input][data-color-role="secondary"]');
        var secondaryHexInput = modal.querySelector('[data-hex-input][data-color-role="secondary"]');
        var accentColorInput = modal.querySelector('[data-color-input][data-color-role="accent"]');
        var accentHexInput = modal.querySelector('[data-hex-input][data-color-role="accent"]');

        function showModalMessage(message, type) {
            if (!modalMessage) {
                return;
            }

            modalMessage.hidden = false;
            modalMessage.classList.remove('theme-modal__alert--error', 'theme-modal__alert--success');
            modalMessage.classList.add(type === 'success' ? 'theme-modal__alert--success' : 'theme-modal__alert--error');
            modalMessage.textContent = message;
        }

        function hideModalMessage() {
            if (!modalMessage) {
                return;
            }

            modalMessage.hidden = true;
            modalMessage.textContent = '';
            modalMessage.classList.remove('theme-modal__alert--error', 'theme-modal__alert--success');
        }

        function setSubmitting(isSubmitting) {
            if (!submitButton) {
                return;
            }

            submitButton.disabled = !!isSubmitting;
            var label = submitButton.querySelector('.theme-submit-label');
            var loading = submitButton.querySelector('.theme-submit-loading');
            if (label) {
                label.hidden = !!isSubmitting;
            }
            if (loading) {
                loading.hidden = !isSubmitting;
            }
        }

        function normalizeHexColor(rawValue, fallback) {
            var normalized = (rawValue || '').toString().trim().toUpperCase();
            return HEX_COLOR_REGEX.test(normalized) ? normalized : fallback;
        }

        function shadeHexColor(hexColor, percent) {
            var hex = normalizeHexColor(hexColor, '#475569').slice(1);
            var red = parseInt(hex.slice(0, 2), 16);
            var green = parseInt(hex.slice(2, 4), 16);
            var blue = parseInt(hex.slice(4, 6), 16);

            if (Number.isNaN(red) || Number.isNaN(green) || Number.isNaN(blue)) {
                return '#475569';
            }

            if (percent < 0) {
                var factor = 1 + percent;
                red = red * factor;
                green = green * factor;
                blue = blue * factor;
            } else {
                red = red + ((255 - red) * percent);
                green = green + ((255 - green) * percent);
                blue = blue + ((255 - blue) * percent);
            }

            red = Math.max(0, Math.min(255, Math.round(red)));
            green = Math.max(0, Math.min(255, Math.round(green)));
            blue = Math.max(0, Math.min(255, Math.round(blue)));

            return '#' + [red, green, blue].map(function (value) {
                return value.toString(16).padStart(2, '0');
            }).join('').toUpperCase();
        }

        function applyColorPair(colorInput, hexInput, value) {
            if (colorInput) {
                colorInput.value = value;
            }
            if (hexInput) {
                hexInput.value = value;
            }
        }

        function syncGeneratedPalette() {
            var baseColor = normalizeHexColor(
                primaryHexInput ? primaryHexInput.value : (primaryColorInput ? primaryColorInput.value : ''),
                '#4F46E5'
            );

            applyColorPair(primaryColorInput, primaryHexInput, baseColor);
            applyColorPair(secondaryColorInput, secondaryHexInput, shadeHexColor(baseColor, -0.22));
            applyColorPair(accentColorInput, accentHexInput, shadeHexColor(baseColor, 0.24));
        }

        function bindPaletteInputs() {
            if (!primaryColorInput || primaryColorInput.dataset.bound === '1') {
                return;
            }

            primaryColorInput.dataset.bound = '1';
            primaryColorInput.addEventListener('input', function () {
                if (primaryHexInput) {
                    primaryHexInput.value = (primaryColorInput.value || '').toUpperCase();
                }
                syncGeneratedPalette();
            });

            if (!primaryHexInput || primaryHexInput.dataset.bound === '1') {
                return;
            }

            primaryHexInput.dataset.bound = '1';
            primaryHexInput.addEventListener('input', function () {
                var normalized = (primaryHexInput.value || '').trim().toUpperCase();
                if (HEX_COLOR_REGEX.test(normalized) && primaryColorInput) {
                    primaryColorInput.value = normalized;
                    syncGeneratedPalette();
                }
            });

            primaryHexInput.addEventListener('blur', function () {
                primaryHexInput.value = normalizeHexColor(primaryHexInput.value, primaryColorInput ? primaryColorInput.value : '#4F46E5');
                syncGeneratedPalette();
            });
        }

        function openModal() {
            hideModalMessage();
            syncGeneratedPalette();
            modal.classList.add('is-open');
            modal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('theme-modal-open');
        }

        function closeModal() {
            modal.classList.remove('is-open');
            modal.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('theme-modal-open');
            setSubmitting(false);
        }

        bindPaletteInputs();
        syncGeneratedPalette();

        if (modalOpenBtn) {
            modalOpenBtn.addEventListener('click', function (event) {
                event.preventDefault();
                openModal();
            });
        }

        modalCloseButtons.forEach(function (button) {
            button.addEventListener('click', function (event) {
                event.preventDefault();
                closeModal();
            });
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && modal.classList.contains('is-open')) {
                closeModal();
            }
        });

        if (modalForm) {
            modalForm.addEventListener('submit', function (event) {
                event.preventDefault();
                hideModalMessage();

                var formData = new FormData(modalForm);
                var payload = {
                    _token: modal.getAttribute('data-csrf-token') || '',
                    name: (formData.get('name') || '').toString().trim(),
                    description: (formData.get('description') || '').toString().trim(),
                    primaryColor: normalizeHexColor(formData.get('primaryColor'), '#4F46E5')
                };

                if (!payload.name) {
                    showModalMessage('Le nom du theme est obligatoire.', 'error');
                    return;
                }

                if (!HEX_COLOR_REGEX.test(payload.primaryColor)) {
                    showModalMessage('La couleur primaire doit etre au format #RRGGBB.', 'error');
                    return;
                }

                setSubmitting(true);

                fetch(modal.getAttribute('data-create-url'), {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(payload)
                })
                .then(function (response) {
                    return response.json().then(function (json) {
                        return { ok: response.ok, json: json };
                    });
                })
                .then(function (result) {
                    if (!result.ok || !result.json || !result.json.success) {
                        throw new Error(result.json && result.json.message ? result.json.message : 'Impossible de creer le theme.');
                    }

                    appendThemeOption(result.json.theme);
                    showModalMessage(result.json.message || 'Theme cree avec succes.', 'success');

                    setTimeout(function () {
                        modalForm.reset();
                        syncGeneratedPalette();
                        closeModal();
                    }, 420);
                })
                .catch(function (error) {
                    showModalMessage(error.message || 'Une erreur est survenue lors de la creation du theme.', 'error');
                })
                .finally(function () {
                    setSubmitting(false);
                });
            });
        }
    }

    if (document.readyState !== 'loading') {
        initDossierForm();
    }

    document.addEventListener('DOMContentLoaded', initDossierForm);
    document.addEventListener('turbo:load', initDossierForm);
    document.addEventListener('turbo:render', initDossierForm);
})();
</script>

<style>
    .dossier-editor__header {
        margin-bottom: 1.5rem;
    }

    .dossier-editor__form {
        margin-bottom: 0;
    }

    .dossier-panel {
        border: 1px solid rgba(148, 163, 184, 0.16);
        border-radius: 18px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
        padding: 1.6rem;
    }

    .dossier-panel .row {
        margin-left: -3.1rem;
        margin-right: -3.1rem;
    }

    .dossier-panel .row > [class*='col'] {
        padding-left: 1.6rem;
        padding-right: 1.6rem;
    }

    .dossier-panel--compact {
        padding: 1.4rem;
    }

    .dossier-panel__head {
        margin-bottom: 1.25rem;
    }

    .dossier-panel__head--with-action {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.8rem;
    }

    .dossier-panel__eyebrow {
        display: inline-block;
        margin-bottom: 0.45rem;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--theme-primary);
    }

    .dossier-panel__head h5 {
        margin-bottom: 0.35rem;
        color: #0f172a;
        font-weight: 700;
    }

    .dossier-panel__head p {
        margin: 0;
        color: #64748b;
        font-size: 0.92rem;
        line-height: 1.55;
    }

    .theme-settings-trigger {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        border: 1px solid rgba(15, 23, 42, 0.1);
        background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 100%);
        color: #334155;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .theme-settings-trigger:hover {
        color: var(--theme-primary);
        border-color: rgba(37, 99, 235, 0.28);
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12);
        transform: translateY(-1px);
    }

    .theme-option-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.85rem;
        max-height: 500px;
        overflow-y: auto;
        padding-right: 8px;
    }

    .theme-option-grid::-webkit-scrollbar {
        width: 6px;
    }

    .theme-option-grid::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 10px;
    }

    .theme-option-grid::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
    }

    .theme-option-grid::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    .theme-option {
        position: relative;
    }

    .theme-empty-state {
        grid-column: 1 / -1;
        border: 1px dashed #cbd5e1;
        border-radius: 14px;
        min-height: 92px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 0.45rem;
        color: #64748b;
        font-weight: 600;
    }

    .theme-radio-input {
        position: absolute;
        opacity: 0;
        inset: 0;
        z-index: -1;
    }

    .theme-option__card {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-height: 80px;
        padding: 0.85rem 0.9rem;
        border: 1px solid #dbe3f0;
        border-radius: 16px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        cursor: pointer;
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
        margin-bottom: 0;
    }

    .theme-option__card:hover {
        transform: translateY(-1px);
        box-shadow: 0 16px 32px rgba(15, 23, 42, 0.08);
        border-color: rgba(37, 99, 235, 0.25);
    }

    .theme-option__preview {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        flex-shrink: 0;
    }

    .theme-option__dot {
        width: 11px;
        height: 36px;
        border-radius: 999px;
        box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.35);
    }

    .theme-option__content {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .theme-option__title {
        color: #0f172a;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .theme-option__text {
        color: #64748b;
        font-size: 0.7rem;
        line-height: 1.2;
        margin-top: 0.15rem;
        max-height: calc(1.2em * 2);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .theme-option__check {
        width: 24px;
        height: 24px;
        border-radius: 999px;
        background: #e2e8f0;
        color: transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-left: auto;
        flex-shrink: 0;
        transition: all 0.18s ease;
        font-size: 0.75rem;
    }

    .theme-radio-input:checked + .theme-option__card {
        border-color: var(--theme-primary);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.11), 0 20px 35px rgba(15, 23, 42, 0.08);
        background: linear-gradient(180deg, rgba(255, 255, 255, 1) 0%, rgba(239, 246, 255, 0.9) 100%);
    }

    .theme-radio-input:checked + .theme-option__card .theme-option__check {
        background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-secondary) 100%);
        color: #ffffff;
    }

    .theme-option--selected .theme-option__card {
        border-color: var(--theme-primary);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.11), 0 20px 35px rgba(15, 23, 42, 0.08);
        background: linear-gradient(180deg, rgba(255, 255, 255, 1) 0%, rgba(239, 246, 255, 0.9) 100%);
    }

    .theme-option--selected .theme-option__check {
        background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-secondary) 100%);
        color: #ffffff;
    }

    .logo-uploader {
        display: grid;
        grid-template-columns: 196px minmax(0, 1fr);
        gap: 1rem;
        align-items: stretch;
    }

    .logo-uploader__preview {
        min-height: 156px;
        border: 1px dashed #cbd5e1;
        border-radius: 18px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        overflow: hidden;
    }

    .logo-uploader__preview--large {
        min-height: 188px;
    }

    .logo-uploader__preview img {
        max-width: 100%;
        max-height: 148px;
        object-fit: contain;
        display: block;
    }

    .logo-uploader__placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
        color: #94a3b8;
        text-align: center;
        font-size: 0.9rem;
    }

    .logo-uploader__placeholder i {
        font-size: 1.45rem;
        color: var(--theme-primary);
    }

    .logo-uploader__controls {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.65rem;
        min-width: 0;
    }

    .logo-upload-input {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    .logo-upload-trigger-wrap {
        position: relative;
        display: inline-flex;
        width: 100%;
    }

    .logo-upload-trigger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0.85rem 1rem;
        border-radius: 14px;
        background: linear-gradient(180deg, var(--theme-primary) 0%, var(--theme-secondary) 100%);
        color: #ffffff;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        margin-bottom: 0;
        border: 0;
        box-shadow: 0 14px 28px rgba(15, 23, 42, 0.12);
        width: 100%;
    }

    .logo-upload-trigger:hover {
        color: #ffffff;
        text-decoration: none;
    }

    .logo-upload-trigger:focus {
        outline: none;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.14), 0 14px 28px rgba(15, 23, 42, 0.12);
    }

    .logo-upload-filename {
        font-size: 0.88rem;
        color: #475569;
        font-weight: 600;
        word-break: break-word;
    }

    .dossier-editor__actions {
        margin-top: 0;
        padding-top: 1rem;
    }

    .dossier-panel--sticky {
        position: sticky;
        top: 1.5rem;
    }

    .theme-modal {
        position: fixed;
        inset: 0;
        z-index: 2080;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 1.2rem;
    }

    .theme-modal.is-open {
        display: flex;
    }

    .theme-modal__backdrop {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, 0.38);
        backdrop-filter: blur(2px);
    }

    .theme-modal__dialog {
        position: relative;
        width: min(720px, calc(100vw - 2rem));
        max-height: calc(100vh - 2.4rem);
        overflow-y: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
        border-radius: 22px;
        background: #ffffff;
        border: 1px solid rgba(148, 163, 184, 0.24);
        box-shadow: 0 35px 70px rgba(15, 23, 42, 0.32);
        padding: 1.55rem;
    }

    .theme-modal__dialog::-webkit-scrollbar {
        width: 0;
        height: 0;
    }

    .theme-modal__close {
        position: absolute;
        top: 16px;
        right: 16px;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        border: 0;
        background: transparent;
        color: #94a3b8;
        font-size: 28px;
        line-height: 1;
        transition: all 0.2s ease;
    }

    .theme-modal__close:hover {
        color: #334155;
        background: rgba(15, 23, 42, 0.06);
    }

    .theme-modal__icon {
        width: 76px;
        height: 76px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-secondary) 100%);
        color: #fff;
        font-size: 1.5rem;
        box-shadow: 0 16px 34px rgba(15, 23, 42, 0.24);
    }

    .theme-modal h4 {
        text-align: center;
        margin-bottom: 0.25rem;
        font-weight: 800;
        color: #0f172a;
    }

    .theme-modal__subtitle {
        text-align: center;
        color: #64748b;
        margin-bottom: 1rem;
    }

    .theme-modal__message-slot {
        min-height: 64px;
        margin-bottom: 0.5rem;
    }

    .theme-modal__alert {
        border-radius: 10px;
        padding: 0.65rem 0.85rem;
        font-weight: 600;
        margin-bottom: 0;
        font-size: 0.9rem;
    }

    .theme-modal__alert--error {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .theme-modal__alert--success {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }

    .theme-color-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem;
    }

    .theme-color-row label {
        font-size: 0.82rem;
        font-weight: 700;
        color: #334155;
        margin-bottom: 0.38rem;
        display: block;
    }

    .theme-color-row__hint {
        font-size: 0.72rem;
        font-weight: 700;
        color: #64748b;
        margin-left: 0.3rem;
    }

    .theme-color-inputs {
        display: grid;
        grid-template-columns: 58px minmax(0, 1fr);
        gap: 0.55rem;
        align-items: center;
    }

    .theme-color-inputs input[type='color'] {
        width: 58px;
        height: 42px;
        border-radius: 10px;
        border: 1px solid #cbd5e1;
        padding: 0.2rem;
        background: #fff;
    }

    .theme-color-row--readonly .theme-color-inputs input[type='color'] {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .theme-color-row--readonly .theme-color-inputs .form-control {
        background: #f8fafc;
        color: #64748b;
        cursor: not-allowed;
    }

    .theme-modal__actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.7rem;
        margin-top: 1rem;
    }

    body.theme-modal-open {
        overflow: hidden;
    }

    @media (max-width: 991.98px) {
        .logo-uploader {
            grid-template-columns: 1fr;
        }

        .logo-uploader__preview {
            min-height: 180px;
        }

        .theme-color-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 575.98px) {
        .theme-option-grid {
            grid-template-columns: 1fr;
            max-height: 400px;
        }

        .theme-option__card {
            min-height: 84px;
        }

        .theme-modal__actions {
            flex-direction: column-reverse;
        }

        .theme-modal__actions .btn {
            width: 100%;
        }
    }
</style>
{% endblock %}

