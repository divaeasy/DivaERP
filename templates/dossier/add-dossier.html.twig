            }

            var firstRadio = themeGrid.querySelector('.theme-radio-input');
            var inputName = firstRadio ? firstRadio.getAttribute('name') : 'dossier_form[theme]';
            var firstId = firstRadio ? firstRadio.id : 'dossier_form_theme_0';
            var inputRequired = firstRadio ? firstRadio.required : true;
            var idBase = firstId ? firstId.replace(/_\d+$/, '') : 'dossier_form_theme';
            var optionId = idBase + '_' + String(theme.id);
