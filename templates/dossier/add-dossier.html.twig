                        '<span class="theme-option__dot" style="background:' + escapeHtml(theme.secondaryColor || '#334155') + ';"></span>' +
                        '<span class="theme-option__dot" style="background:' + escapeHtml(theme.accentColor || '#94a3b8') + ';"></span>' +
                    '</span>' +
                    '<span class="theme-option__content">' +
