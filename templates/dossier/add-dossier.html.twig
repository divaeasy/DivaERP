            document.body.classList.remove('theme-modal-open');
            setSubmitting(false);
            setModalMode('create');
        }

        function resetThemeDeleteState() {
            if (!deleteConfirmButton) {
                return;
            }

            deleteConfirmButton.removeAttribute('data-theme-delete-id');
        }

        function performThemeDelete(themeId) {
            if (!themeId) {
                return;
            }

            var deleteUrl = buildThemeApiUrl(modal.getAttribute('data-delete-url-template') || '', themeId);
            var payload = {
                _token: modal.getAttribute('data-manage-csrf-token') || ''
            };

            if (!deleteUrl) {
                showGlobalToast('Action de suppression indisponible pour le moment.', 'error');
                return;
            }

            deleteConfirmButton.classList.add('disabled');
            deleteConfirmButton.setAttribute('aria-disabled', 'true');

            fetch(deleteUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(payload)
            })
            .then(function (response) {
                var contentType = response.headers.get('content-type');
                if (!contentType || !contentType.includes('application/json')) {
                    throw new Error('Reponse invalide: format non-JSON recu');
                }

                return response.json().then(function (json) {
                    if (!response.ok) {
                        throw new Error((json && json.message) ? json.message : ('Erreur serveur: ' + response.status + ' ' + response.statusText));
                    }

                    return json;
                });
            })
            .then(function (json) {
                if (!json || json.success !== true) {
                    throw new Error((json && json.message) ? json.message : 'Suppression impossible.');
                }

                removeThemeOption(json.deletedThemeId || themeId, json.fallbackThemeId || null);
                showGlobalToast(json.message || 'Theme supprime avec succes.', 'success');

                if (window.jQuery && deleteConfirmModal && typeof window.jQuery.fn.modal === 'function') {
                    window.jQuery(deleteConfirmModal).modal('hide');
                }
            })
            .catch(function (error) {
                showGlobalToast(error && error.message ? error.message : 'Une erreur est survenue lors de la suppression du theme.', 'error');
            })
            .finally(function () {
                deleteConfirmButton.classList.remove('disabled');
                deleteConfirmButton.setAttribute('aria-disabled', 'false');
                resetThemeDeleteState();
            });
        }

        bindPaletteInputs();
        syncGeneratedPalette();

        if (modalOpenBtn) {
            modalOpenBtn.addEventListener('click', function (event) {
                event.preventDefault();
                openModal('create');
            });
        }

        modalCloseButtons.forEach(function (button) {
            button.addEventListener('click', function (event) {
                event.preventDefault();
                closeModal();
            });
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && modal.classList.contains('is-open')) {
                closeModal();
