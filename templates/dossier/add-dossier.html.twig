        var modalForm = document.getElementById('themeCreateForm');
        var modalMessage = document.getElementById('themeCreateMessage');
        var submitButton = document.getElementById('themeCreateSubmitBtn');
        var modalTitle = document.getElementById('themeCreateModalTitle');
