        if (modalForm) {
            modalForm.addEventListener('submit', function (event) {
                event.preventDefault();
                hideGlobalLoadingOverlay();
                hideModalMessage();

                var modalMode = modal.getAttribute('data-mode') || 'create';
                var editingThemeId = parseInt((modalEditIdInput ? modalEditIdInput.value : '') || '', 10);
                var formData = new FormData(modalForm);
                var payload = {
                    _token: modalMode === 'edit'
                        ? (modal.getAttribute('data-manage-csrf-token') || '')
                        : (modal.getAttribute('data-csrf-token') || ''),
                    name: (formData.get('name') || '').toString().trim(),
                    description: (formData.get('description') || '').toString().trim(),
                    primaryColor: normalizeHexColor(formData.get('primaryColor'), '#4F46E5')
                };

                var requestUrl = modal.getAttribute('data-create-url') || '';
                if (modalMode === 'edit') {
                    if (Number.isNaN(editingThemeId)) {
                        showModalMessage('Theme invalide pour la mise a jour.', 'error');
                        return;
                    }

                    requestUrl = buildThemeApiUrl(modal.getAttribute('data-update-url-template') || '', editingThemeId);
                }

                if (!requestUrl) {
                    showModalMessage('Action indisponible. Veuillez recharger la page.', 'error');
                    return;
                }

                if (!payload.name) {
                    showModalMessage('Le nom du theme est obligatoire.', 'error');
                    return;
                }

                if (!HEX_COLOR_REGEX.test(payload.primaryColor)) {
                    showModalMessage('La couleur primaire doit etre au format #RRGGBB.', 'error');
                    return;
                }

                setSubmitting(true);

                var requestTimeout = setTimeout(function () {
                    showModalMessage('La création du thème a pris trop de temps. Veuillez réessayer.', 'error');
                    setSubmitting(false);
                    hideGlobalLoadingOverlay();
                }, 15000);

                fetch(requestUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(payload)
                })
                .then(function (response) {
                    var contentType = response.headers.get('content-type');
                    if (!contentType || !contentType.includes('application/json')) {
                        throw new Error('Réponse invalide: format non-JSON reçu');
                    }

                    return response.json().then(function (json) {
                        if (!response.ok) {
                            throw new Error((json && json.message) ? json.message : ('Erreur serveur: ' + response.status + ' ' + response.statusText));
                        }

                        return json;
                    });
                })
                .then(function (json) {
                    clearTimeout(requestTimeout);
                    hideGlobalLoadingOverlay();

                    if (!json || !json.theme || !json.theme.id) {
                        var errorMsg = (json && json.message) ? json.message : 'Donnees de theme invalides recues du serveur.';
                        console.error('Theme API response invalid:', json);
                        throw new Error(errorMsg);
                    }

                    setSubmitting(false);

                    appendThemeOption(json.theme);
                    showGlobalToast(
                        json.message || (modalMode === 'edit' ? 'Theme mis a jour avec succes.' : 'Theme cree avec succes.'),
                        'success'
                    );

                    closeModal();
                })
                .catch(function (error) {
                    clearTimeout(requestTimeout);
                    setSubmitting(false);
                    hideGlobalLoadingOverlay();
                    showModalMessage(error && error.message ? error.message : 'Une erreur est survenue lors de la creation du theme.', 'error');
                });
            });
        }
    }

    if (document.readyState !== 'loading') {
        initDossierForm();
    }

    document.addEventListener('DOMContentLoaded', initDossierForm);
    document.addEventListener('turbo:load', initDossierForm);
    document.addEventListener('turbo:render', initDossierForm);
})();
</script>

