            modalMessage.hidden = false;
            modalMessage.classList.remove('theme-modal__alert--error', 'theme-modal__alert--success');
            modalMessage.classList.add(type === 'success' ? 'theme-modal__alert--success' : 'theme-modal__alert--error');
