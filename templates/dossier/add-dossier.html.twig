            var deleteButton = option.querySelector('[data-theme-action="delete"]');
            if (deleteButton) {
                deleteButton.disabled = !!theme.isSystem;
                if (theme.isSystem) {
                    deleteButton.setAttribute('title', 'Theme systeme non supprimable');
