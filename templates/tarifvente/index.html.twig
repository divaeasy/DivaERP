{% extends 'template_oukatech.html.twig' %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Tarifs de Vente</h1>
    </div>
</div>

<div class="action-bar">
    <a class="btn-add" href="{{ path('tarifvente.edit') }}">
        <i class="fas fa-plus"></i> Nouveau Tarif de Vente
    </a>
    <div class="search-box">
        {% include "components/search_data.html.twig" with {search: search} only %}
    </div>
</div>

<div class="table-container">
    {% if tarifventes|length > 0 %}
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tarif</th>
                <th>Client</th>
                <th>Article</th>
                <th>Devise</th>
                <th>Date effet</th>
                <th class="text-right">Prix</th>
                <th class="text-center" style="width: 120px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for tarifvente in tarifventes %}
            <tr>
                <td><strong>#{{ tarifvente.id }}</strong></td>
                <td>{{ tarifvente.tarif }}</td>
                <td>{{ tarifvente.client }}</td>
                <td>{{ tarifvente.article }}</td>
                <td><span class="badge badge-info">{{ tarifvente.devise }}</span></td>
                <td>{{ tarifvente.dateeffet|date('d/m/Y') }}</td>
                <td class="text-right"><strong>{{ tarifvente.prix|number_format(2, ',', ' ') }}</strong></td>
                <td class="text-center">
                    <a href="{{ path('tarifvente.edit', {id: tarifvente.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn"
                            data-delete-url="{{ path('tarifvente.delete', {id: tarifvente.id}) }}"
                            data-item-name="Tarif #{{ tarifvente.id }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-tag"></i>
        </div>
        <h5>Aucun tarif de vente trouvé</h5>
        <p>Configurez vos tarifs de vente pour personnaliser vos offres.</p>
        <a href="{{ path('tarifvente.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouveau tarif de vente
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
