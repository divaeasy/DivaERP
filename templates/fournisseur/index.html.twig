{% extends 'template_oukatech.html.twig' %}

{% block PageTitle%}
    Gestion des Fournisseurs
{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Fournisseurs</h1>
    </div>
</div>

<div class="action-bar">
    <div class="action-buttons">
        <a class="btn-add" href="{{ path('fournisseur.edit') }}">
            <i class="fas fa-plus"></i> Nouveau Fournisseur
        </a>
        <a class="btn btn-sm btn-outline-success ml-2 no-loading" href="{{ path('export.fournisseurs') }}" title="Exporter CSV">
            <i class="fas fa-file-csv mr-1"></i> Exporter
        </a>
    </div>
    <div class="search-box">
        {% include "components/search_data.html.twig" with {search: search} only %}
    </div>
</div>

<div class="table-container">
    {% if fournisseurs|length > 0 %}
    <table class="table js-crud-list-table"
           data-crud-resource="fournisseur"
           data-bulk-delete-token="{{ csrf_token('crud_bulk_delete_fournisseur') }}"
           data-placeholder="____">
        <thead>
            <tr data-row-id="{{ fournisseur.id }}">
                <th data-sort-key="id" data-sort-type="number">ID</th>
                <th data-sort-key="nom">Nom</th>
                <th data-sort-key="adresse">Adresse</th>
                <th data-sort-key="ville">Ville</th>
                <th data-sort-key="pays">Pays</th>
                <th data-sort-key="tel">Téléphone</th>
                <th data-sort-key="email">Email</th>
                <th data-sort-key="tarif">Tarif</th>
                <th class="text-center" style="width: 150px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for fournisseur in fournisseurs %}
            <tr>
                <td><strong>#{{ fournisseur.id }}</strong></td>
                <td>{{ fournisseur.nom|default('____') }}</td>
                <td>{{ fournisseur.adr1|default('____') }}</td>
                <td>{{ fournisseur.ville|default('____') }}</td>
                <td>{{ fournisseur.pays|default('____') }}</td>
                <td>{{ fournisseur.tel|default('____') }}</td>
                <td>{{ fournisseur.email|default('____') }}</td>
                <td>{{ fournisseur.tarif|default('____') }}</td>
                <td class="text-center" data-role="actions">
                    <a href="{{ path('fournisseur.detail', {id: fournisseur.id}) }}" class="btn btn-action btn-view" title="Voir">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a href="{{ path('fournisseur.edit', {id: fournisseur.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn"
                            data-delete-url="{{ path('fournisseur.delete', {id: fournisseur.id}) }}"
                            data-item-name="{{ fournisseur.nom }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% include "components/_pagination.html.twig" with {currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, route: 'fournisseur.list', routeParams: {}} %}
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-truck"></i>
        </div>
        <h5>Aucun fournisseur trouvé</h5>
        <p>Ajoutez votre premier fournisseur pour commencer à gérer vos achats.</p>
        <a href="{{ path('fournisseur.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouveau fournisseur
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
