{% extends 'template_oukatech.html.twig' %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Clients</h1>
    </div>
</div>

<div class="action-bar">
    <a class="btn-add" href="{{ path('client.edit') }}">
        <i class="fas fa-plus"></i> Nouveau Client
    </a>
    <div class="search-box">
        {% include "components/search_data.html.twig" with {search: search} only %}
    </div>
</div>

<div class="table-container">
    {% if clients|length > 0 %}
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Adresse</th>
                <th>Ville</th>
                <th>Pays</th>
                <th>Téléphone</th>
                <th>Email</th>
                <th>Tarif</th>
                <th class="text-center" style="width: 150px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for client in clients %}
            <tr>
                <td><strong>#{{ client.id }}</strong></td>
                <td>{{ client.nom }}</td>
                <td>{{ client.adr1 }}</td>
                <td>{{ client.ville }}</td>
                <td>{{ client.pays }}</td>
                <td>{{ client.tel }}</td>
                <td>{{ client.email }}</td>
                <td>{{ client.tarif }}</td>
                <td class="text-center">
                    <a href="{{ path('client.detail', {id: client.id}) }}" class="btn btn-action btn-view" title="Voir">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a href="{{ path('client.edit', {id: client.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn" 
                            data-delete-url="{{ path('client.delete', {id: client.id}) }}"
                            data-item-name="{{ client.nom }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div class="empty-state">
        <i class="fas fa-users"></i>
        <p>Aucun client trouvé</p>
        <a href="{{ path('client.edit') }}" class="btn btn-primary mt-3">
            <i class="fas fa-plus mr-2"></i>Créer le premier client
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
