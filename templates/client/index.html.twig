{% extends 'template_oukatech.html.twig' %}

{% block title %}Clients{% endblock %}

{% block body %}
{% include "components/search_data.html.twig" with {search: search} only %}
<br/>
<div class="input-group"  >

<a class="btn btn-primary" href="{{path('client.edit')}}" role="button">Ajouter</a>
<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p>

  

</div>

<br/>
<div class="row">

  <table class="table table-striped">
    <thead class="thead-light">
      <tr>
        <th scope="col">Id</th>
        <th scope="col">Nom</th>
        <th scope="col">Adresse</th>
        <th scope="col">Rue</th>
        <th scope="col">Code postal</th>
        <th scope="col">Ville</th>
        <th scope="col">Pays</th>
        <th scope="col">Tarif</th>
   
        <th scope="col"></th>
  
      </tr>
    </thead>
    <tbody>
      {% for client in clients %}
      <tr>
        <th scope="row"><a href="{{ path('client.edit',{id: client.id}) }}" >{{client.id}}</a></th>
        <th scope="row">{{client.nom}}</th>
        <td>{{client.adr1}}</td>
        <td>{{client.rue}}</td>
        <td>{{client.codepostal}}</td>
        <td>{{client.ville}}</td>
        <td>{{client.pays}}</td>
        <td>{{ client.tarif }}</td>
        
        {%if is_granted('ROLE_ADMIN')%}
        <td><a href="{{ path('client.edit',{id: client.id}) }}" ><i class="fa-solid fa-user-pen"></i></a></td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>

</div>
{% endblock %}
