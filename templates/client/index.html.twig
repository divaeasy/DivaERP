{% extends 'template_oukatech.html.twig' %}

{% block PageTitle%}
    Gestion des Clients
{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Clients</h1>
    </div>
</div>

<div class="action-bar">
    <div class="action-buttons">
        <button type="button" class="btn-add no-loading" data-toggle="modal" data-target="#crudQuickCreateModal">
            <i class="fas fa-plus"></i> Nouveau Client
        </button>
        <a class="btn btn-sm btn-outline-success ml-2 no-loading" href="{{ path('export.clients') }}" title="Exporter CSV">
            <i class="fas fa-file-csv mr-1"></i> Exporter
        </a>
        <button type="button" class="btn btn-sm btn-outline-primary ml-2 no-loading" data-toggle="modal" data-target="#crudImportModal">
            <i class="fas fa-file-import fa-md"></i> Importer
        </button>
    </div>
    <div class="table-bulk-actions" id="clientsBulkActions" data-bulk-bar-for="clients">
        <div class="table-bulk-actions__content">
            <div class="table-bulk-actions__left">
                <span class="table-bulk-actions__badge">
                    <i class="fas fa-check-circle"></i>
                    <strong data-selection-count>0</strong>
                </span>
                <span class="table-bulk-actions__label" data-selection-label>Aucun client selectionne</span>
            </div>
            <div class="table-bulk-actions__buttons">
                <button type="button" class="btn btn-sm table-bulk-actions__delete-btn no-loading" data-bulk-action="delete">
                    <i class="fas fa-trash-alt mr-1"></i> Supprimer
                </button>
                <button type="button" class="btn btn-sm table-bulk-actions__clear-btn no-loading" data-bulk-clear>
                    Annuler
                </button>
            </div>
        </div>
    </div>
    <div class="action-tools">
        <div class="search-box">
            {% include "components/search_data.html.twig" with {search: search} only %}
        </div>
    </div>
</div>

<div class="table-container">
    <div class="crud-column-settings-floating">
        <button type="button" class="no-loading crud-column-settings__trigger" aria-expanded="false">
            <i class="fas fa-cog"></i>
        </button>
        <div class="crud-column-settings__menu"></div>
    </div>

    {% if clients|length > 0 %}
    <table class="table js-crud-list-table commercial-table"
           id="clientsTable"
           data-table-id="clients"
           data-crud-resource="client"
           data-bulk-delete-token="{{ csrf_token('crud_bulk_delete_client') }}"
           data-update-token="{{ csrf_token('crud_update_client') }}"
           data-create-token="{{ csrf_token('crud_create_client') }}"
           data-import-token="{{ csrf_token('crud_import_client') }}"
           data-enable-quick-create="1"
           data-enable-import="1"
           data-placeholder="____">
        <thead>
            <tr>
                <th class="row-selector-head" data-column-key="selector">
                    <div class="form-check d-flex justify-content-center mb-0">
                        <input class="form-check-input position-static" type="checkbox" data-select-all-checkbox aria-label="Selectionner toutes les lignes">
                    </div>
                </th>
                <th data-sort-key="id" data-sort-type="number" data-column-key="id">ID</th>
                <th data-sort-key="nom" data-column-key="nom" data-field="nom" data-required="1">Nom</th>
                <th data-sort-key="adresse" data-column-key="adresse" data-field="adr1" data-required="1">Adresse</th>
                <th data-sort-key="ville" data-column-key="ville" data-field="ville" data-type="entity">Ville</th>
                <th data-sort-key="pays" data-column-key="pays" data-field="pays" data-type="entity">Pays</th>
                <th data-sort-key="tel" data-column-key="tel" data-field="tel" data-type="digits">Telephone</th>
                <th data-sort-key="email" data-column-key="email" data-field="email">Email</th>
                <th data-sort-key="tarif" data-column-key="tarif" data-field="tarif" data-type="entity">Tarif</th>
                <th class="text-center" style="width: 170px;" data-column-key="actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for client in clients %}
            <tr data-row-id="{{ client.id }}" data-item-id="{{ client.id }}">
                <td class="row-selector-cell" data-column-key="selector">
                    <div class="form-check d-flex justify-content-center mb-0">
                        <input class="form-check-input position-static" type="checkbox" value="{{ client.id }}" data-row-checkbox aria-label="Selectionner client {{ client.nom|default(client.id) }}">
                    </div>
                </td>
                <td data-column-key="id"><strong>#{{ client.id }}</strong></td>
                <td data-column-key="nom" data-field="nom">{{ client.nom|default('____') }}</td>
                <td data-column-key="adresse" data-field="adr1">{{ client.adr1|default('____') }}</td>
                <td data-column-key="ville" data-field="ville">{{ client.ville|default('____') }}</td>
                <td data-column-key="pays" data-field="pays">{{ client.pays|default('____') }}</td>
                <td data-column-key="tel" data-field="tel">{{ client.tel|default('____') }}</td>
                <td data-column-key="email" data-field="email">{{ client.email|default('____') }}</td>
                <td data-column-key="tarif" data-field="tarif">{{ client.tarif|default('____') }}</td>
                <td class="text-center" data-role="actions" data-column-key="actions">
                    <a href="{{ path('client.detail', {id: client.id}) }}" class="btn btn-action btn-view" title="Voir">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a href="{{ path('client.edit', {id: client.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn"
                            data-delete-url="{{ path('client.delete', {id: client.id}) }}"
                            data-item-name="{{ client.nom }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% include "components/_pagination.html.twig" with {currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, route: 'client.list', routeParams: {}} %}
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-users"></i>
        </div>
        <h5>Aucun client trouve</h5>
        <p>Ajoutez votre premier client pour commencer a gerer vos relations.</p>
        <a href="{{ path('client.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouveau client
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
{% endblock %}
