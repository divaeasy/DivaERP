{% extends 'template_oukatech.html.twig' %}

{% block PageTitle%}
    Gestion des Tarifs
{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Tarifs</h1>
    </div>
</div>

<div class="action-bar">
    <div class="action-buttons">
        <a class="btn-add" href="{{ path('tarif.edit') }}">
            <i class="fas fa-plus"></i> Nouveau Tarif
        </a>
        <a class="btn btn-sm btn-outline-success ml-2 no-loading" href="{{ path('export.tarifs') }}" title="Exporter CSV">
            <i class="fas fa-file-csv mr-1"></i> Exporter
        </a>
    </div>
    <div class="table-bulk-actions" id="tarifsBulkActions" data-bulk-bar-for="tarifs">
        <div class="table-bulk-actions__content">
            <div class="table-bulk-actions__left">
                <span class="table-bulk-actions__badge">
                    <i class="fas fa-check-circle"></i>
                    <strong data-selection-count>0</strong>
                </span>
                <span class="table-bulk-actions__label" data-selection-label>Aucun tarif selectionne</span>
            </div>
            <div class="table-bulk-actions__buttons">
                <button type="button" class="btn btn-sm table-bulk-actions__delete-btn no-loading" data-bulk-action="delete">
                    <i class="fas fa-trash-alt mr-1"></i> Supprimer
                </button>
                <button type="button" class="btn btn-sm table-bulk-actions__clear-btn no-loading" data-bulk-clear>
                    Annuler
                </button>
            </div>
        </div>
    </div>
    <div class="action-tools">
        <div class="search-box">
            {% include "components/search_data.html.twig" with {search: search} only %}
        </div>
    </div>
</div>

<div class="table-container">
    <div class="crud-column-settings-floating">
        <button type="button" class="no-loading crud-column-settings__trigger" aria-expanded="false">
            <i class="fas fa-cog"></i>
        </button>
        <div class="crud-column-settings__menu"></div>
    </div>
    {% if tarifs|length > 0 %}
    <table class="table js-crud-list-table commercial-table"
           id="tarifsTable"
           data-table-id="tarifs"
           data-crud-resource="tarif"
           data-bulk-delete-token="{{ csrf_token('crud_bulk_delete_tarif') }}"
           data-update-token="{{ csrf_token('crud_update_tarif') }}"
           data-create-token="{{ csrf_token('crud_create_tarif') }}"
           data-import-token="{{ csrf_token('crud_import_tarif') }}"
           data-enable-quick-create="1"
           data-enable-import="1"
           data-placeholder="____">
        <thead>
            <tr>
                <th class="row-selector-head" data-column-key="selector">
                    <div class="form-check d-flex justify-content-center mb-0">
                        <input class="form-check-input position-static" type="checkbox" data-select-all-checkbox aria-label="Selectionner toutes les lignes">
                    </div>
                </th>
                <th data-sort-key="id" data-sort-type="number" data-column-key="id">ID</th>
                <th data-sort-key="libelle" data-field="libelle" data-required="1" data-column-key="libelle">Libelle</th>
                <th class="text-center" style="width: 140px;" data-column-key="actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for tarif in tarifs %}
            <tr data-row-id="{{ tarif.id }}" data-item-id="{{ tarif.id }}">
                <td class="row-selector-cell" data-column-key="selector">
                    <div class="form-check d-flex justify-content-center mb-0">
                        <input class="form-check-input position-static" type="checkbox" value="{{ tarif.id }}" data-row-checkbox aria-label="Selectionner tarif {{ tarif.libelle|default(tarif.id) }}">
                    </div>
                </td>
                <td data-column-key="id"><strong>#{{ tarif.id }}</strong></td>
                <td data-field="libelle" data-field-value="{{ tarif.libelle|default('') }}" data-column-key="libelle">{{ tarif.libelle|default('____') }}</td>
                <td class="text-center" data-role="actions" data-column-key="actions">
                    <a href="{{ path('tarif.edit', {id: tarif.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn"
                            data-delete-url="{{ path('tarif.delete', {id: tarif.id}) }}"
                            data-item-name="{{ tarif.libelle }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% include "components/_pagination.html.twig" with {currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, route: 'tarif.list', routeParams: {}} %}
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-tags"></i>
        </div>
        <h5>Aucun tarif trouve</h5>
        <p>Definissez vos grilles tarifaires pour vos produits et services.</p>
        <a href="{{ path('tarif.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouveau tarif
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
