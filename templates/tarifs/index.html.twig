{% extends 'template_oukatech.html.twig' %}

{% block title %}Tarifs{% endblock %}

{% block body %}

<br/>
<div class="input-group"  >

<a class="btn btn-primary" href="{{path('tarif.edit')}}" role="button">Ajouter</a>


</div>

<br/>
<div class="row">

  <table class="table table-striped">
    <thead class="thead-light">
      <tr>
        <th scope="col">Id</th>
        <th scope="col">Libellé</th>
        
   
        <th scope="col"></th>
  
      </tr>
    </thead>
    <tbody>
      {% for tarif in tarifs %}
      <tr>
        <th scope="row"><a href="{{ path('tarif.edit',{id: tarif.id}) }}" >{{tarif.id}}</a></th>
        <th scope="row">{{tarif.libelle}}</th>
       

        
        {%if is_granted('ROLE_ADMIN')%}
        <td><a href="{{ path('tarif.edit',{id: tarif.id}) }}" ><i class="fa-solid fa-user-pen"></i></a></td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>

</div>
{% endblock %}
