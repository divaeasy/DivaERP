{% extends 'template_oukatech.html.twig' %}

{% block PageTitle%}
    Gestion des Tarifs -
{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Tarifs</h1>
    </div>
</div>

<div class="action-bar">
    <a class="btn-add" href="{{ path('tarif.edit') }}">
        <i class="fas fa-plus"></i> Nouveau Tarif
    </a>
    <a class="btn btn-sm btn-outline-success ml-2 no-loading" href="{{ path('export.tarifs') }}" title="Exporter CSV">
        <i class="fas fa-file-csv mr-1"></i> Exporter
    </a>
    <div class="search-box">
        {% include "components/search_data.html.twig" with {search: search} only %}
    </div>
</div>

<div class="table-container">
    {% if tarifs|length > 0 %}
    <table class="table">
        <thead>
            <tr>
                <th data-sort-key="id" data-sort-type="number">ID</th>
                <th data-sort-key="libelle">Libellé</th>
                <th class="text-center" style="width: 120px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for tarif in tarifs %}
            <tr>
                <td><strong>#{{ tarif.id }}</strong></td>
                <td>{{ tarif.libelle }}</td>
                <td class="text-center">
                    <a href="{{ path('tarif.edit', {id: tarif.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn"
                            data-delete-url="{{ path('tarif.delete', {id: tarif.id}) }}"
                            data-item-name="{{ tarif.libelle }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% include "components/_pagination.html.twig" with {currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, route: 'tarif.list', routeParams: {}} %}
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-tags"></i>
        </div>
        <h5>Aucun tarif trouvé</h5>
        <p>Définissez vos grilles tarifaires pour vos produits et services.</p>
        <a href="{{ path('tarif.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouveau tarif
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
