{% extends 'template_oukatech.html.twig' %}

{% block PageTitle%}
    Gestion des Prospects -
{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('app_dash_bord') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">Gestion des Prospects</h1>
    </div>
</div>

<div class="action-bar">
    <a class="btn-add" href="{{ path('prospect.edit') }}">
        <i class="fas fa-plus"></i> Nouveau Prospect
    </a>
    <div class="search-box">
        {% include "components/search_data.html.twig" with {search: search} only %}
    </div>
</div>

<div class="table-container">
    {% if prospects|length > 0 %}
    <table class="table">
        <thead>
            <tr>
                <th data-sort-key="id" data-sort-type="number">ID</th>
                <th data-sort-key="nom">Nom</th>
                <th data-sort-key="adresse">Adresse</th>
                <th data-sort-key="ville">Ville</th>
                <th data-sort-key="pays">Pays</th>
                <th data-sort-key="tel">Téléphone</th>
                <th data-sort-key="email">Email</th>
                <th class="text-center" style="width: 120px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for prospect in prospects %}
            <tr>
                <td><strong>#{{ prospect.id }}</strong></td>
                <td>{{ prospect.nom }}</td>
                <td>{{ prospect.adr1 }}</td>
                <td>{{ prospect.ville }}</td>
                <td>{{ prospect.pays }}</td>
                <td>{{ prospect.tel }}</td>
                <td>{{ prospect.email }}</td>
                <td class="text-center">
                    <a href="{{ path('prospect.edit', {id: prospect.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                        <i class="fas fa-edit"></i>
                    </a>
                    <button type="button" class="btn btn-action btn-delete delete-btn"
                            data-delete-url="{{ path('prospect.delete', {id: prospect.id}) }}"
                            data-item-name="{{ prospect.nom }}"
                            title="Supprimer">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="fas fa-user-plus"></i>
        </div>
        <h5>Aucun prospect trouvé</h5>
        <p>Ajoutez vos premiers prospects pour développer votre portefeuille.</p>
        <a href="{{ path('prospect.edit') }}" class="btn btn-primary">
            <i class="fas fa-plus mr-2"></i>Nouveau prospect
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}
