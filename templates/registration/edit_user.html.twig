{% extends 'template_oukatech.html.twig' %}

{% block PageTitle %}{{ isNew ? 'Nouvel utilisateur' : 'Modifier l\'utilisateur' }}{% endblock %}

{% block body %}
<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="{{ path('users.list') }}" class="btn-back mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 text-gray-800">{{ isNew ? 'Nouvel utilisateur' : 'Modifier l\'utilisateur' }}</h1>
    </div>
</div>

{{ form_start(userForm, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

<div class="row">
    <!-- Left column: Personal info -->
    <div class="col-lg-8">
        <div class="form-card">
            <div class="card-header-custom">
                <h5><i class="fas fa-user mr-2"></i>Informations personnelles</h5>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="required">Nom</label>
                        {{ form_widget(userForm.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom de l\'utilisateur', 'required': 'required'}}) }}
                        {{ form_errors(userForm.nom) }}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="required">Prénom</label>
                        {{ form_widget(userForm.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Prénom de l\'utilisateur', 'required': 'required'}}) }}
                        {{ form_errors(userForm.prenom) }}
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="required">Adresse email</label>
                {{ form_widget(userForm.email, {'attr': {'class': 'form-control', 'placeholder': 'email@exemple.com', 'required': 'required'}}) }}
                {{ form_errors(userForm.email) }}
            </div>
            <div class="form-group">
                <label>{{ isNew ? 'Mot de passe' : 'Nouveau mot de passe' }}</label>
                {{ form_widget(userForm.plainPassword, {'attr': {'class': 'form-control', 'placeholder': isNew ? 'Choisir un mot de passe' : 'Laisser vide pour ne pas changer'}}) }}
                <small class="form-text text-muted">
                    {% if not isNew %}
                        Laissez vide pour conserver le mot de passe actuel.
                    {% else %}
                        Minimum 6 caractères.
                    {% endif %}
                </small>
                {{ form_errors(userForm.plainPassword) }}
            </div>
        </div>
    </div>

    <!-- Right column: Role & Settings -->
    <div class="col-lg-4">
        <div class="form-card">
            <div class="card-header-custom">
                <h5><i class="fas fa-shield-alt mr-2"></i>Rôle & Accès</h5>
            </div>
            <div class="form-group">
                <label class="d-block mb-3">Rôles</label>
                <div class="role-checkboxes-container">
                    {% for key, value in userForm.roles %}
                    {% set isUserRole = value.vars.label == 'ROLE_UTILISATEUR' or value.vars.label == 'ROLE_USER' %}
                    <div class="role-checkbox-item">
                        {% if isUserRole %}
                            <input type="checkbox" id="role_{{ key }}" name="{{ userForm.roles.vars.name }}[]" value="{{ value.vars.value }}" class="role-checkbox-input" {% if value.vars.checked %}checked{% endif %} disabled />
                        {% else %}
                            <input type="checkbox" id="role_{{ key }}" name="{{ userForm.roles.vars.name }}[]" value="{{ value.vars.value }}" class="role-checkbox-input" {% if value.vars.checked %}checked{% endif %} />
                        {% endif %}
                        <label for="role_{{ key }}" class="role-badge-label {% if isUserRole %}role-badge-disabled{% endif %}" title="{% if isUserRole %}(Obligatoire){% endif %}">
                            {% if value.vars.label == 'ROLE_ADMIN' %}
                                <i class="fas fa-crown"></i>
                            {% elseif value.vars.label == 'ROLE_COMPTABLE' %}
                                <i class="fas fa-calculator"></i>
                            {% elseif value.vars.label == 'ROLE_RESPONSABLE_VENTE' %}
                                <i class="fas fa-chart-line"></i>
                            {% elseif value.vars.label == 'ROLE_MAGASIN' %}
                                <i class="fas fa-warehouse"></i>
                            {% elseif value.vars.label == 'ROLE_UTILISATEUR' or value.vars.label == 'ROLE_USER' %}
                                <i class="fas fa-user-check"></i>
                            {% else %}
                                <i class="fas fa-user"></i>
                            {% endif %}
                        </label>
                    </div>
                    {% endfor %}
                </div>
                <small class="form-text text-muted d-block mt-3" style="font-size: 12px;">Un utilisateur peut avoir plusieurs rôles. Le rôle "Utilisateur" est obligatoire et ne peut pas être retiré.</small>
                {{ form_errors(userForm.roles) }}
                <style>
                    .role-checkboxes-container { display: flex; flex-direction: row; gap: 12px; flex-wrap: wrap; }
                    .role-checkbox-item { display: flex; align-items: center; width: calc(50% - 6px); }
                    .role-checkbox-input { display: none !important; }
                    .role-badge-label { display: inline-flex; align-items: center; justify-content: center; gap: 0; padding: 10px 14px; border-radius: 6px; font-size: 16px; cursor: pointer; transition: all 0.2s ease; border: 2px solid #cbd5e1; background-color: transparent; color: #64748b; margin: 0; user-select: none; flex-grow: 1; }
                    .role-badge-label i { font-size: 18px; }
                    .role-checkbox-input:checked + .role-badge-label { background-color: #4e73df; color: white; border-color: #4e73df; box-shadow: 0 2px 8px rgba(78, 115, 223, 0.2); }
                    .role-checkbox-input:focus + .role-badge-label { outline: 2px solid #4e73df; outline-offset: 2px; }
                    .role-badge-label:hover { border-color: #4e73df; background-color: rgba(78, 115, 223, 0.08); }
                    .role-badge-label.role-badge-disabled { opacity: 0.5; cursor: not-allowed; background-color: transparent; border-color: #cbd5e1; }
                    .role-badge-label.role-badge-disabled:hover { border-color: #cbd5e1; background-color: transparent; }
                    .role-checkbox-input:disabled + .role-badge-label { opacity: 0.5; cursor: not-allowed; }
                </style>
            </div>
            <div class="form-group">
                <label class="required">Dossier</label>
                {{ form_widget(userForm.dossier, {'attr': {'class': 'form-control js-example-basic-single', 'required': 'required'}}) }}
                {{ form_errors(userForm.dossier) }}
            </div>
            <div class="form-group">
                <div class="custom-control custom-switch">
                    {{ form_widget(userForm.isVerified, {'attr': {'class': 'custom-control-input', 'id': 'isVerifiedSwitch'}}) }}
                    <label class="custom-control-label" for="isVerifiedSwitch" style="font-size: 14px; font-weight: 500; color: #5a5c69;">
                        Email vérifié
                    </label>
                </div>
                <small class="form-text text-muted mt-1">Cochez si l'email de l'utilisateur est confirmé.</small>
                {{ form_errors(userForm.isVerified) }}
            </div>
        </div>

        {% if not isNew %}
        <div class="form-card" style="background: #f8f9fc; border: 1px solid #e3e6f0;">
            <div class="card-header-custom" style="border-bottom-color: #d1d3e2;">
                <h5><i class="fas fa-info-circle mr-2" style="color: #858796;"></i>Informations</h5>
            </div>
            <div class="mb-2">
                <small class="text-muted d-block">ID utilisateur</small>
                <strong class="text-gray-800">#{{ user.id }}</strong>
            </div>
            <div class="mb-2">
                <small class="text-muted d-block">Statut email</small>
                {% if user.isVerified %}
                    <span class="badge badge-success"><i class="fas fa-check mr-1"></i>Vérifié</span>
                {% else %}
                    <span class="badge badge-danger"><i class="fas fa-times mr-1"></i>Non vérifié</span>
                {% endif %}
            </div>
        </div>
        {% endif %}
    </div>
</div>

<div class="form-actions">
    <button type="submit" class="btn btn-primary">
        <i class="fas fa-save mr-2"></i>{{ isNew ? 'Créer l\'utilisateur' : 'Enregistrer les modifications' }}
    </button>
    <a href="{{ path('users.list') }}" class="btn btn-secondary">
        <i class="fas fa-times mr-2"></i>Annuler
    </a>
</div>

{{ form_end(userForm) }}
{% endblock %}
