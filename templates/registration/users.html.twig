{% extends 'template_oukatech.html.twig' %}

{% block PageTitle %}Utilisateurs{% endblock %}
{% block body %}
    <div class="page-header">
        <div class="d-flex align-items-center">
            <a href="{{ path('app_profile') }}" class="btn-back mr-3">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h1 class="h3 mb-0 text-gray-800">Gestion des utilisateurs</h1>
        </div>
    </div>
    <div class="table-container">

    <table class="table">
    <thead>
        <tr>
        <th data-sort-key="nom">Nom</th>
        <th data-sort-key="prenom">Prénom</th>
        <th data-sort-key="email">Email</th>
        <th data-sort-key="dossier">Dossier</th>
        <th>Rôles</th>
        <th>Vérifié</th>
        {%if is_granted('ROLE_ADMIN')%}
        <th class="text-center" style="width: 120px;">Actions</th>
        {% endif %}
        </tr>
    </thead>
    <tbody>
        {% for utilisateur in utilisateurs %}
        <tr>
        <td>{{ utilisateur.nom }}</td>
        <td>{{ utilisateur.prenom }}</td>
        <td>{{ utilisateur.email }}</td>
        <td>{{ utilisateur.dossier }}</td>
        <td>
            {% for role in utilisateur.roles %}
                {% if role == 'ROLE_ADMIN' %}
                    <span class="badge badge-danger">Admin</span>
                {% elseif role == 'ROLE_COMPTABLE' %}
                    <span class="badge badge-warning">Comptable</span>
                {% elseif role == 'ROLE_COMMERCIAL' %}
                    <span class="badge badge-info">Commercial</span>
                {% elseif role == 'ROLE_USER' %}
                    <span class="badge badge-secondary">Utilisateur</span>
                {% endif %}
            {% endfor %}
        </td>
        <td>
            {% if utilisateur.isVerified %}
                <span class="badge badge-success"><i class="fas fa-check"></i> Oui</span>
            {% else %}
                <span class="badge badge-danger"><i class="fas fa-times"></i> Non</span>
            {% endif %}
        </td>
        {%if is_granted('ROLE_ADMIN')%}
        <td class="text-center">
            <a href="{{ path('users.edit',{id: utilisateur.id}) }}" class="btn btn-action btn-edit" title="Modifier">
                <i class="fas fa-edit"></i>
            </a>
            <button type="button" class="btn btn-action btn-delete delete-btn"
                    data-delete-url="{{ path('users.delete',{id: utilisateur.id}) }}"
                    data-item-name="{{ utilisateur.nom }} {{ utilisateur.prenom }}"
                    title="Supprimer">
                <i class="fas fa-trash"></i>
            </button>
        </td>
        {% endif %}
        </tr>
        {% endfor %}
    </tbody>
    </table>

    </div>
{% endblock %}
