    <script>
        $(document).ready(function() {
            function finalizePageLoadedState() {
                $('body').removeClass('js-loading').addClass('js-loaded');
                if (typeof window.hideLoading === 'function') {
                    window.hideLoading();
                }
            }

            function isHistoryRestoreNavigation(nativeEvent) {
                if (nativeEvent && nativeEvent.persisted) {
                    return true;
                }

                if (window.performance && typeof window.performance.getEntriesByType === 'function') {
                    var navEntries = window.performance.getEntriesByType('navigation');
                    if (navEntries && navEntries.length > 0) {
                        return navEntries[0].type === 'back_forward';
                    }
                }

                return false;
            }

            // ===== FOUC Prevention - mark loaded only after full page load =====
            if (!window.__pageLoadClassHookBound) {
                window.__pageLoadClassHookBound = true;
                $(window).one('load', function() {
                    finalizePageLoadedState();
                });
            }
            if (document.readyState === 'complete') {
                finalizePageLoadedState();
