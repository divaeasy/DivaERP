        .table-container { position: relative; overflow: visible !important; }

        /* ===== UNIFIED ACTION BAR (Search + Create Button) ===== */
        .action-bar {
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 15px;
            background: white;
            padding: 15px 20px;
            border-radius: 8px;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1);
            min-height: 56px;
        }
        .action-bar .btn-add {
            background: linear-gradient(180deg, var(--theme-primary) 10%, var(--theme-secondary) 100%);
            color: white;
            padding: 12px 24px;
            border-radius: 6px;
            font-weight: 600;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
            text-decoration: none;
            white-space: nowrap;
        }
        .action-bar .btn-add i,
        .action-bar .action-buttons .btn i,
        .action-bar .btn-search i {
            font-size: 0.8rem;
            width: 0.95rem;
            height: 0.95rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }
        .action-bar .btn-add:hover {
            background: linear-gradient(180deg, var(--theme-secondary) 10%, var(--theme-primary) 100%);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
            text-decoration: none;
        }
        .action-bar .search-box {
            flex: 1;
            max-width: 500px;
            min-width: 250px;
        }
        .action-bar .action-buttons {
            display: flex;
            align-items: center;
            gap: 0;
        }
        .action-bar .action-buttons .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.42rem;
        }
        .action-bar .action-tools {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            margin-left: auto;
        }
        .action-bar .table-bulk-actions {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, calc(-50% + 14px));
            opacity: 0;
            pointer-events: none;
            transition: transform 0.22s ease, opacity 0.22s ease;
            z-index: 8;
            width: min(52vw, 560px);
            min-width: 320px;
            max-width: 560px;
            margin: 0;
            padding: 8px 10px;
            border-radius: 12px;
            border: 1px solid rgba(148, 163, 184, 0.36);
            background: #fff;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12);
            color: #0f172a;
            overflow: hidden;
        }
        .action-bar .table-bulk-actions.is-visible {
            transform: translate(-50%, -50%);
            opacity: 1;
            pointer-events: auto;
        }
        .table-bulk-actions__content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }
        .table-bulk-actions__left {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }
        .table-bulk-actions__badge {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: rgba(37, 99, 235, 0.12);
            color: #1e40af;
            border-radius: 999px;
            padding: 0.34rem 0.62rem;
            font-size: 0.88rem;
            white-space: nowrap;
        }
        .table-bulk-actions__label {
            font-size: 0.88rem;
            color: #475569;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .table-bulk-actions__buttons {
            display: flex;
            align-items: center;
            gap: 0.55rem;
        }
        .table-bulk-actions__delete-btn,
        .table-bulk-actions__clear-btn {
            border-radius: 8px;
            font-weight: 700;
            line-height: 1.2;
        }
        .table-bulk-actions__delete-btn {
            color: #fff;
            background: linear-gradient(135deg, #ef4444, #dc2626);
            border: 0;
            box-shadow: 0 8px 18px rgba(220, 38, 38, 0.22);
        }
        .table-bulk-actions__clear-btn {
            border: 1px solid #cbd5e1;
            color: #475569;
            background: #fff;
        }
        .table-container .commercial-table {
            width: 100%;
            table-layout: fixed;
            border-collapse: separate;
            border-spacing: 0;
        }
        .table-container .commercial-table thead th,
        .table-container .commercial-table tbody td {
            padding: 0.72rem 0.5rem;
            font-size: 0.86rem;
            vertical-align: middle;
        }
        .table-container .commercial-table .row-selector-head,
        .table-container .commercial-table .row-selector-cell {
            width: 42px;
            text-align: center;
        }
        .table-container .commercial-table [data-column-key="actions"] {
            position: sticky;
            right: 0;
            z-index: 3;
            background: #fff;
        }
        .table-container .commercial-table thead [data-column-key="actions"] {
            z-index: 5;
            background: var(--theme-primary);
        }
        .table-container .commercial-table tbody tr.is-selected {
            background: rgba(37, 99, 235, 0.08);
        }
        .table-container .commercial-table tbody td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .table-container .commercial-table tbody tr.js-inline-editing td {
            overflow: visible !important;
        }
        .table-container .commercial-table thead th:first-child {
            border-top-left-radius: 8px;
        }
        .table-container .commercial-table thead th:last-child {
            border-top-right-radius: 8px;
        }
        .table-container .commercial-table tbody tr:last-child td:first-child {
            border-bottom-left-radius: 8px;
        }
        .table-container .commercial-table tbody tr:last-child td:last-child {
            border-bottom-right-radius: 8px;
        }
        @media (max-width: 992px) {
            .action-bar .table-bulk-actions {
                position: static;
                transform: none;
                opacity: 0;
                pointer-events: auto;
                width: 100%;
                min-width: 0;
                max-width: none;
                margin-top: 0.55rem;
                display: none;
            }
            .action-bar .table-bulk-actions.is-visible {
                display: block;
                transform: none;
                opacity: 1;
                margin-top: 0.55rem;
            }
            .table-bulk-actions__content {
                flex-direction: column;
                align-items: stretch;
            }
            .table-bulk-actions__buttons {
                justify-content: flex-end;
            }
            .action-bar .action-tools {
                width: 100%;
                justify-content: flex-start;
            }
        }

        /* ===== NAVIGATION SEARCH DROPDOWN ===== */
        #navSearchResults {
            max-height: 400px;
            overflow-y: auto;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            z-index: 1050;
            border-radius: 8px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.15);
            border: 1px solid #e3e6f0;
            margin-top: 5px;
        }
        #navSearchResults .dropdown-item {
            padding: 12px 20px;
            border-bottom: 1px solid #f8f9fc;
            transition: all 0.2s;
        }
        #navSearchResults .dropdown-item:last-child {
            border-bottom: none;
        }
        #navSearchResults .dropdown-item:hover {
            background: #f8f9fc;
            color: var(--theme-primary);
        }
        #navSearchResults .dropdown-item i {
            width: 20px;
        }

        /* ===== EMPTY STATE ===== */
        .empty-state {
            text-align: center;
            padding: 80px 40px;
            color: #6c757d;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .empty-state .empty-state-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #eef2ff 0%, #e8eafd 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
        }
        .empty-state .empty-state-icon i,
        .empty-state > i {
            font-size: 32px;
            color: var(--theme-primary);
            opacity: 1;
            margin-bottom: 0;
        }
        .empty-state > i {
            width: 80px;
            height: 80px;
            line-height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #eef2ff 0%, #e8eafd 100%);
            margin-bottom: 20px;
            font-size: 32px;
            color: var(--theme-primary);
            opacity: 1;
        }
        .empty-state h5 {
            font-size: 18px;
            font-weight: 600;
            color: #344767;
            margin-bottom: 8px;
        }
        .empty-state p {
            margin: 0 0 24px 0;
            font-size: 15px;
            color: #8898aa;
            max-width: 320px;
        }
        .empty-state .btn {
            padding: 10px 24px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(78, 115, 223, 0.25);
            transition: all 0.2s ease;
        }
        .empty-state .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 12px rgba(78, 115, 223, 0.35);
        }

        /* ===== TOAST NOTIFICATIONS ===== */
        .toast-container {
            position: fixed;
            top: 80px;
            right: 24px;
            z-index: 1085;
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-width: 420px;
            width: 100%;
        }
        .toast-notification {
            display: flex;
            align-items: flex-start;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
            padding: 16px 18px;
            position: relative;
            overflow: hidden;
            border-left: 4px solid transparent;
            animation: toastSlideIn 0.35s cubic-bezier(0.21, 1.02, 0.73, 1) forwards;
        }
        .toast-notification.toast-hiding {
            animation: toastSlideOut 0.3s ease-in forwards;
        }
        .toast-icon {
            flex-shrink: 0;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 14px;
            font-size: 16px;
        }
        .toast-content {
            flex: 1;
            min-width: 0;
        }
        .toast-title {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 2px;
        }
        .toast-message {
            font-size: 13px;
            color: #5a5c69;
            line-height: 1.4;
            word-wrap: break-word;
        }
        .toast-close {
            background: none;
            border: none;
            font-size: 20px;
            line-height: 1;
            color: #b0b3c5;
            cursor: pointer;
            padding: 0 0 0 10px;
            transition: color 0.2s;
            flex-shrink: 0;
        }
        .toast-close:hover {
            color: #5a5c69;
        }
        .toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: rgba(0, 0, 0, 0.05);
        }
        .toast-progress-bar {
            height: 100%;
            width: 100%;
            transform-origin: left;
            animation: toastCountdown 5s linear forwards;
        }
        /* Success */
        .toast-success {
            border-left-color: #1cc88a;
        }
        .toast-success .toast-icon {
            background: #e8f8f0;
            color: #1cc88a;
        }
        .toast-success .toast-title {
            color: #1cc88a;
        }
        .toast-success .toast-progress-bar {
            background: #1cc88a;
        }
        /* Error */
        .toast-error {
            border-left-color: #e74a3b;
        }
        .toast-error .toast-icon {
            background: #fdf0ef;
            color: #e74a3b;
        }
        .toast-error .toast-title {
            color: #e74a3b;
        }
        .toast-error .toast-progress-bar {
            background: #e74a3b;
        }
        /* Info */
        .toast-info {
            border-left-color: var(--theme-primary);
        }
        .toast-info .toast-icon {
            background: #eef2ff;
            color: var(--theme-primary);
        }
        .toast-info .toast-title {
            color: var(--theme-primary);
        }
        .toast-info .toast-progress-bar {
            background: var(--theme-primary);
        }
        @keyframes toastSlideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        @keyframes toastSlideOut {
            from { transform: translateX(0); opacity: 1; }
            to { transform: translateX(100%); opacity: 0; }
        }
        @keyframes toastCountdown {
            from { transform: scaleX(1); }
            to { transform: scaleX(0); }
        }
        @media (max-width: 480px) {
            .toast-container {
                top: 74px;
                right: 12px;
                left: 12px;
                max-width: none;
            }
        }

        /* ===== DELETE MODAL STYLING ===== */
        .modal-delete .modal-header {
            background: #e74a3b;
            color: white;
            border-radius: 0;
        }
        .modal-delete .modal-header .close {
            color: white;
            opacity: 1;
        }
        .modal-delete .modal-body {
            padding: 30px;
            text-align: center;
        }
        .modal-delete .modal-body i {
            font-size: 48px;
            color: #e74a3b;
            margin-bottom: 15px;
        }
        .modal-delete .btn-danger {
            background: #e74a3b;
            border-color: #e74a3b;
        }

        /* ===== FORM BUTTON GROUP ===== */
        .form-actions {
            display: flex;
            gap: 10px;
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px solid #e3e6f0;
        } 
        .form-actions .btn {
            padding: 12px 30px;
            font-weight: 600;
            border-radius: 6px;
        }
        .form-actions .btn-primary {
            background: linear-gradient(180deg, var(--theme-primary) 10%, var(--theme-secondary) 100%);
            border: none;
        }
        .form-actions .btn-secondary {
            background: #858796;
            border: none;
        }

        /* Badges for status */
        .badge-status {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
        }
        .badge-active { background: #1cc88a; color: white; }
        .badge-draft { background: #f6c23e; color: white; }
        .badge-expired { background: #858796; color: white; }

        /* ===== DISABLED NAV LINKS ===== */
        .nav-link.nav-disabled,
        .collapse-item.nav-disabled {
            pointer-events: none !important;
            cursor: not-allowed !important;
            opacity: 0.42 !important;
        }
        th[data-sort-key] {
            cursor: pointer;
            position: relative;
            user-select: none;
            transition: background 0.15s ease;
            padding-right: 34px !important;
        }
        th[data-sort-key]:hover {
            background: var(--theme-secondary) !important;
        }
        th[data-sort-key]::after {
            content: '\f0dc';
            font-family: 'Font Awesome 6 Free';
            font-weight: 300;
            font-weight: 900;
            position: absolute;
            right: calc(var(--table-resize-handle-width, 7px) + 10px);
            top: 50%;
            transform: translateY(-50%);
            font-size: 11px;
            opacity: 0.35;
            transition: opacity 0.15s ease;
        }
        th[data-sort-key]:hover::after {
            opacity: 0.6;
        }
        th[data-sort-key].sort-asc::after {
            content: '\f0de';
            opacity: 1;
        }
        th[data-sort-key].sort-desc::after {
            content: '\f0dd';
            opacity: 1;
        }
        th[data-sort-key].sort-asc,
        th[data-sort-key].sort-desc {
            background: var(--theme-primary) !important;
        }

        /* Unify header resize separators across all tables */
        .table thead th .column-resize-handle,
        .table thead th .article-column-resize-handle,
        .table thead th .piece-column-resize-handle {
            position: absolute;
            top: 0;
            right: 0 !important;
            left: auto !important;
            width: var(--table-resize-handle-width, 7px) !important;
            height: 100% !important;
            cursor: col-resize;
            background: transparent;
            z-index: 10;
        }
        .table thead th .column-resize-handle::after,
        .table thead th .article-column-resize-handle::after,
        .table thead th .piece-column-resize-handle::after {
            content: '';
            position: absolute;
            top: var(--table-resize-separator-top, 12%);
            right: var(--table-resize-separator-right, 2px);
            width: var(--table-resize-separator-width, 2px);
            height: var(--table-resize-separator-height, 76%);
            border-radius: 1px;
            background: rgba(255, 255, 255, 0.46);
            transition: background-color 0.15s ease;
        }
        .table thead th:hover .column-resize-handle::after,
        .table thead th:hover .article-column-resize-handle::after,
        .table thead th:hover .piece-column-resize-handle::after {
            background: rgba(255, 255, 255, 0.68);
        }
        .is-resizing-column .column-resize-handle::after,
        .article-column-resize-handle.is-dragging::after,
        .piece-column-resize-handle.is-dragging::after {
            background: rgba(37, 99, 235, 0.82) !important;
        }
    </style>
    
    {% block stylesheets %}
        {{ importmap('app') }}
    {% endblock %}

</head>

