                    pageIcon = pageFallbackMeta.icon;
                }

                if (pageSection === '') {
                    if (existingForCurrentUrl) {
                        pageSection = String(existingForCurrentUrl.section || '').trim();
                    }
                    if (pageSection === '') {
                        pageSection = getSectionLabelFromLink($primaryLink) || getPanelLabel(normalizedPanelId);
                    }
                }

                if (pageLinkClass === '') {
                    if (existingForCurrentUrl) {
                        pageLinkClass = normalizeRecentLinkClass(existingForCurrentUrl.linkClass || '');
                    }
                    if (pageLinkClass === '' && $primaryLink.length) {
                        pageLinkClass = normalizeRecentLinkClass($primaryLink.attr('class') || '');
                    }
                    if (pageLinkClass === '') {
                        pageLinkClass = pageFallbackMeta.linkClass;
                    }
                }

                upsertRecentItem({
                    name: pageName,
                    url: currentUrl,
                    panel: normalizedPanelId,
                    icon: pageIcon,
                    section: pageSection,
                    linkClass: pageLinkClass
                });
            };

            var readSectionState = function() {
                try {
                    return JSON.parse(window.localStorage.getItem(sidebarSectionStateStorageKey) || '{}') || {};
                } catch (storageReadError) {
                    return {};
                }
            };

            var writeSectionState = function(state) {
                try {
                    window.localStorage.setItem(sidebarSectionStateStorageKey, JSON.stringify(state));
                } catch (storageWriteError) {
                    // Ignore storage write failures.
                }
            };

            var setSidebarSectionOpen = function($section, isOpen, persistState) {
                if (!$section || !$section.length) {
                    return;
                }

                $section.toggleClass('is-open', isOpen);
                $section.find('.sidebar-panel-section-toggle').first().attr('aria-expanded', isOpen ? 'true' : 'false');

                if (persistState === false) {
                    return;
                }

                var panelId = String($section.closest('.sidebar-panel-content').data('sidebarPanel') || '').trim();
                var sectionKey = String($section.data('sectionKey') || '').trim();
                if (panelId === '' || sectionKey === '') {
                    return;
                }

                var savedState = readSectionState();
                savedState[panelId + ':' + sectionKey] = isOpen ? 1 : 0;
                writeSectionState(savedState);
            };

            var setSidebarPanel = function(panelId, persistState) {
                if (!panelId) {
                    return;
                }

                var $targetToggle = $sidebarPanelToggles.filter('[data-sidebar-panel="' + panelId + '"]').first();
                var $targetPanel = $sidebarPanelContents.filter('[data-sidebar-panel="' + panelId + '"]').first();

                if (!$targetToggle.length || !$targetPanel.length || $targetToggle.hasClass('nav-disabled')) {
                    return;
                }

                setSidebarSubnavCollapsed(false, persistState);
                clearPrimarySidebarActiveState();
                $sidebarPanelContents.removeClass('is-active');

                $targetToggle.addClass('active').attr('aria-pressed', 'true');
                $targetPanel.addClass('is-active');
                updateSidebarBreadcrumb(panelId);
                renderRecentItems(panelId);

                if (persistState !== false) {
