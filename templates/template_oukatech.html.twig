    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        {% set currentRoute = app.request.attributes.get('_route') %}
        {% set commercialRoutes = ['client.list', 'client.edit', 'prospect.list', 'prospect.edit', 'article.list', 'article.edit', 'tarif.list', 'tarif.edit', 'tarifvente.list', 'tarifvente.edit'] %}
        {% set accountingRoutes = ['entetepiece.list', 'entetepiece.edit', 'reglement.list', 'reglement.edit', 'devise.list', 'devise.edit', 'unite.list', 'unite.edit'] %}
        {% set administrationRoutes = ['dossier.list', 'dossier.edit', 'pays.list', 'pays.edit', 'ville.list', 'ville.edit'] %}
        {% set initialSidebarPanel = '' %}
        {% set currentDossier = app.user and app.user.currentDossier ? app.user.currentDossier : null %}
        {% set currentDossierLocation = '' %}
        {% if currentRoute in commercialRoutes %}
            {% set initialSidebarPanel = 'commercial' %}
        {% elseif currentRoute in accountingRoutes %}
            {% set initialSidebarPanel = 'accounting' %}
        {% elseif currentRoute in administrationRoutes %}
            {% set initialSidebarPanel = 'administration' %}
        {% endif %}
        {% if currentDossier %}
            {% if currentDossier.ville %}
                {% set currentDossierLocation = currentDossier.ville %}
            {% endif %}
            {% if currentDossier.pays %}
                {% set currentDossierLocation = currentDossierLocation ? currentDossierLocation ~ ', ' ~ currentDossier.pays : currentDossier.pays %}
            {% endif %}
        {% endif %}
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark double-sidebar" id="accordionSidebar" data-initial-panel="{{ initialSidebarPanel }}">
            <div class="sidebar-layout">
                <div class="sidebar-rail">
                    <a class="sidebar-brand d-flex align-items-center justify-content-center nav-loading"
                       href="{{ path('app_dash_bord') }}"
                       aria-label="Dashboard">
                        <div class="sidebar-brand-icon">
                            {% if currentDossier and currentDossier.logo %}
                                <img class="sidebar-brand-logo"
                                     src="{{ currentDossier.logo }}"
                                     alt="Logo {{ currentDossier.nom }}">
                            {% else %}
                                <i data-lucide="layers"></i>
                            {% endif %}
                        </div>
                        <span class="sidebar-brand-meta">
                            <span class="sidebar-brand-name">{{ currentDossier ? currentDossier.nom : 'Dossier actif' }}</span>
                            <span class="sidebar-brand-subtitle">ERP Workspace</span>
                        </span>
                    </a>

                    <button id="sidebarCollapseToggle" class="sidebar-collapse-control" type="button" aria-label="Ouvrir la barre latérale" aria-expanded="true" title="Barre latérale">
                        <i class="sidebar-collapse-icon" data-lucide="chevron-right"></i>
                    </button>

                    <div class="sidebar-scroll-container">
                        <li class="nav-item">
                            <a class="nav-link nav-loading sidebar-icon-link {% if currentRoute == 'app_dash_bord' %}active{% endif %}"
                               href="{{ path('app_dash_bord') }}"
                               data-nav-label="Dashboard"
                               aria-label="Dashboard">
                                <i data-lucide="chart-line"></i>
                                <span class="sidebar-link-text">Dashboard</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <button class="nav-link sidebar-panel-toggle {% if not is_granted('ROLE_COMMERCIAL') %}nav-disabled{% endif %} {% if initialSidebarPanel == 'commercial' %}active{% endif %}"
                                    type="button"
                                    data-sidebar-panel="commercial"
                                    data-nav-label="Commercial"
                                    aria-label="Commercial"
                                    aria-pressed="{% if initialSidebarPanel == 'commercial' %}true{% else %}false{% endif %}">
                                <i data-lucide="handshake"></i>
                                <span class="sidebar-link-text">Commercial</span>
                            </button>
                        </li>

                        <li class="nav-item">
                            <button class="nav-link sidebar-panel-toggle {% if not is_granted('ROLE_COMPTABLE') %}nav-disabled{% endif %} {% if initialSidebarPanel == 'accounting' %}active{% endif %}"
                                    type="button"
                                    data-sidebar-panel="accounting"
                                    data-nav-label="Comptabilité"
                                    aria-label="Comptabilité"
                                    aria-pressed="{% if initialSidebarPanel == 'accounting' %}true{% else %}false{% endif %}">
                                <i data-lucide="calculator"></i>
                                <span class="sidebar-link-text">Comptabilité</span>
                            </button>
                        </li>

                        <li class="nav-item">
                            <button class="nav-link sidebar-panel-toggle {% if not is_granted('ROLE_ADMIN') %}nav-disabled{% endif %} {% if initialSidebarPanel == 'administration' %}active{% endif %}"
                                    type="button"
                                    data-sidebar-panel="administration"
                                    data-nav-label="Administration"
                                    aria-label="Administration"
                                    aria-pressed="{% if initialSidebarPanel == 'administration' %}true{% else %}false{% endif %}">
                                <i data-lucide="network"></i>
                                <span class="sidebar-link-text">Administration</span>
                            </button>
                        </li>
                    </div>

                    {% if app.user %}
                    <div class="sidebar-footer">
                        <div class="dropup no-arrow sidebar-profile-dropdown">
                            <a class="nav-link dropdown-toggle sidebar-profile-toggle"
                               href="#"
                               id="sidebarUserDropdown"
                               role="button"
                               data-toggle="dropdown"
                               aria-haspopup="true"
                               aria-expanded="false">
                                <span class="sidebar-profile-avatar" title="{{ app.user.prenom }} {{ app.user.nom }}">{{ app.user.prenom|slice(0, 1)|upper }}</span>
                                <span class="sidebar-profile-meta">
                                    <span class="sidebar-profile-name">{{ app.user.prenom }} {{ app.user.nom }}</span>
                                    <span class="sidebar-profile-label">Mon profil</span>
                                </span>
                                <i class="sidebar-profile-caret" data-lucide="chevron-up"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                 aria-labelledby="sidebarUserDropdown">
                                <a class="dropdown-item" href="{{ path('app_profile') }}">
                                    <i class="sidebar-profile-menu-icon mr-2 text-gray-400" data-lucide="user"></i>
                                    Mon Profil
                                </a>
                                <a class="dropdown-item" href="{{ path('app_profile_edit') }}">
                                    <i class="sidebar-profile-menu-icon mr-2 text-gray-400" data-lucide="settings"></i>
                                    Paramètres
                                </a>
                                {% if is_granted('ROLE_ADMIN') %}
                                <a class="dropdown-item" href="{{ path('users.list') }}">
                                    <i class="sidebar-profile-menu-icon mr-2 text-gray-400" data-lucide="users"></i>
                                    Utilisateurs
                                </a>
                                {% endif %}
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item js-open-logout-modal" href="#">
                                    <i class="sidebar-profile-menu-icon mr-2 text-gray-400" data-lucide="log-out"></i>
                                    Déconnexion
                                </a>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                </div>

                <div class="sidebar-panel">
                    <div class="sidebar-panel-header">
                        <div class="sidebar-panel-header__eyebrow">Dossier</div>
                        <div class="sidebar-panel-header__title-row">
                            {% if app.user %}
                                <div class="dropdown no-arrow sidebar-dossier-switcher">
                                    <button class="nav-link dropdown-toggle sidebar-dossier-switcher__toggle"
                                       type="button"
                                       id="sidebarDossierDropdown"
                                       data-toggle="dropdown"
                                       data-display="static"
                                       aria-haspopup="true"
                                       aria-expanded="false"
                                       title="Changer de dossier">
                                        <span class="sidebar-dossier-switcher__title">{{ currentDossier ? currentDossier.nom : 'Navigation' }}</span>
                                        <span class="sidebar-dossier-switcher__icon" aria-hidden="true">
                                            <i data-lucide="chevron-down"></i>
                                        </span>
                                    </button>
                                    <div class="dropdown-menu shadow"
                                         aria-labelledby="sidebarDossierDropdown">
                                        {% for dossier in app.user.dossiers %}
                                            {% set dossierThemeColor = dossier.theme and dossier.theme.primaryColor ? dossier.theme.primaryColor : '#475569' %}
                                            <a class="dropdown-item {% if currentDossier and dossier.id == currentDossier.id %}active{% endif %}"
                                               href="{{ path('dossier.switch', {'id': dossier.id}) }}">
                                                <span class="dossier-switcher__item">
                                                    {% if dossier.logo %}
                                                        <img src="{{ dossier.logo }}" alt="logo">
                                                    {% else %}
                                                        <i class="text-theme" data-lucide="folder"></i>
                                                    {% endif %}
                                                    <span>{{ dossier.nom }}</span>
                                                    <span class="dossier-theme-indicator" style="background-color: {{ dossierThemeColor }};"></span>
                                                </span>
                                            </a>
                                        {% else %}
                                            <span class="dropdown-item-text text-muted small">Aucun dossier</span>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% else %}
                                <div class="sidebar-panel-header__title">{{ currentDossier ? currentDossier.nom : 'Navigation' }}</div>
                            {% endif %}
                        </div>
                        {% if currentDossier %}
                            <div class="sidebar-panel-header__meta">
                                {% if currentDossier.devise %}
                                    <span class="sidebar-panel-header__badge">
                                        <i data-lucide="wallet"></i>
                                        <span>{{ currentDossier.devise.code }}</span>
                                    </span>
                                {% endif %}
                                <span class="sidebar-panel-header__badge">
                                    <i data-lucide="hash"></i>
                                    <span>{{ currentDossier.id }}</span>
                                </span>
                                {% if currentDossierLocation %}
                                    <span class="sidebar-panel-header__badge">
                                        <i data-lucide="map-pin"></i>
                                        <span>{{ currentDossierLocation }}</span>
                                    </span>
                                {% endif %}
                            </div>
                        {% endif %}
                        <div class="sidebar-panel-header__subtitle">Accès rapide par module</div>
                    </div>

                    <div class="sidebar-panel-scroll">
                        <div class="sidebar-panel-content {% if initialSidebarPanel == 'commercial' %}is-active{% endif %}" data-sidebar-panel="commercial">
                            <div class="sidebar-panel-title sidebar-panel-title--commercial">
                                <i data-lucide="handshake"></i>
                                <span>Commercial</span>
                            </div>
                            <div class="sidebar-panel-section">
                                <div class="sidebar-panel-links">
                                    <a class="nav-link nav-loading sidebar-panel-link sidebar-panel-link--clients {% if not is_granted('ROLE_COMMERCIAL') %}nav-disabled{% endif %} {% if currentRoute in ['client.list', 'client.edit'] %}active{% endif %}"
                                       href="{% if is_granted('ROLE_COMMERCIAL') %}{{ path('client.list') }}{% else %}javascript:void(0){% endif %}">
                                        <i data-lucide="users"></i>
                                        <span>Clients</span>
                                    </a>
                                    <a class="nav-link nav-loading sidebar-panel-link sidebar-panel-link--prospects {% if not is_granted('ROLE_COMMERCIAL') %}nav-disabled{% endif %} {% if currentRoute in ['prospect.list', 'prospect.edit'] %}active{% endif %}"
