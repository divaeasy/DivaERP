                            <i class="fas fa-times mr-2"></i>Annuler
                        </button>
                        <a href="{{ path('app_logout') }}" class="btn" style="background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-secondary) 100%); color: white; border: none; font-weight: 600; padding: 12px 28px; border-radius: 8px; font-size: 14px; transition: all 0.3s ease; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; justify-content: center; flex: 1; max-width: 160px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12); cursor: pointer;" onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 8px 24px rgba(0, 0, 0, 0.18)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 16px rgba(0, 0, 0, 0.12)';">
