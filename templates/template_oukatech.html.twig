            var $navSearchInput = $('#navSearchInput');
            var $navSearchResults = $('#navSearchResults');
            var isTypingTarget = function(target) {
                if (!target) {
                    return false;
                }

                if (target.isContentEditable) {
                    return true;
                }

                var tagName = String(target.tagName || '').toLowerCase();
                return tagName === 'input' || tagName === 'textarea' || tagName === 'select';
            };

            $navSearchInput.on('input', function() {
                var query = $(this).val().toLowerCase().trim();
                $navSearchResults.empty();

                if (query.length < 1) {
                    $navSearchResults.hide();
                    return;
                }

                var matches = navItems.filter(function(item) {
                    return item.name.toLowerCase().includes(query);
                }).slice(0, 8); // Limit to 8 results

                if (matches.length > 0) {
                    matches.forEach(function(item) {
                        $navSearchResults.append(
                            '<a class="dropdown-item" href="' + item.url + '">' +
                            '<i class="' + item.icon + ' fa-fw mr-2 text-gray-400"></i>' + 
                            item.name + '</a>'
                        );
                    });
                    $navSearchResults.show();
                } else {
                    $navSearchResults.append(
                        '<span class="dropdown-item text-muted">Aucun résultat trouvé</span>'
                    );
                    $navSearchResults.show();
                }
            });

            $navSearchInput.on('focus', function() {
                if ($(this).val().trim().length > 0) {
                    $navSearchInput.trigger('input');
                }
            });

            $(document).on('keydown.navSearchShortcut', function(event) {
                var pressedKey = String(event.key || '').toLowerCase();
                var hasModifier = event.ctrlKey || event.metaKey;

                if (!hasModifier) {
                    return;
                }

                // Ctrl+K: Focus search
                if (pressedKey === 'k') {
                    if (!$navSearchInput.length) {
                        return;
                    }

                    if (isTypingTarget(event.target) && event.target.id === 'navSearchInput') {
                        return;
                    }

                    event.preventDefault();
                    $navSearchInput.trigger('focus');
                    $navSearchInput.select();
                    if ($navSearchInput.val().trim().length > 0) {
                        $navSearchInput.trigger('input');
                    }
                    return;
                }

                // Ctrl+1-4: Navigate sidebar panels
                var shortcutKey = pressedKey;
                if (!/^[1-4]$/.test(shortcutKey)) {
                    return; // Only handle 1-4
                }

                // Don't interfere with text input
                if (isTypingTarget(event.target)) {
                    return;
                }

                event.preventDefault();

                // Find and click the nav link with matching shortcut key
                var $targetLink = $('[data-nav-shortcut-key="' + shortcutKey + '"]').first();
                if (!$targetLink.length) {
                    return;
                }

                // Check if link is disabled
                if ($targetLink.hasClass('nav-disabled')) {
                    return;
                }

                // Trigger click or navigation
                if ($targetLink.is('a')) {
                    // For links, navigate to href
                    var href = $targetLink.attr('href');
                    if (href && href !== '#' && !href.startsWith('javascript')) {
                        window.location.href = href;
                    }
                } else if ($targetLink.is('button')) {
                    // For buttons, trigger click (sidebar panel toggle)
                    $targetLink.click();
                }
            });

            $(document).on('click', function(e) {
                if (!$(e.target).closest('.navbar-search').length) {
                    $navSearchResults.hide();
                }
            });

            // ===== SIDEBAR HOVER CARDS (rendered above content, no sidebar overflow) =====
            if (!window.__sidebarHoverCardBound) {
                window.__sidebarHoverCardBound = true;

                var hoverCard = document.getElementById('sidebarHoverCard');
                var activeSidebarLink = null;

                var isCompactViewport = function() {
                    return window.matchMedia('(max-width: 768px)').matches;
                };
                var isSidebarExpanded = function() {
                    return document.body.classList.contains('sidebar-expanded');
                };

                var ensureHoverCard = function() {
                    if (hoverCard && hoverCard.isConnected) {
                        return hoverCard;
                    }

                    hoverCard = document.getElementById('sidebarHoverCard');
                    if (!hoverCard) {
                        hoverCard = document.createElement('div');
                        hoverCard.id = 'sidebarHoverCard';
                        hoverCard.className = 'sidebar-hover-card';
                        document.body.appendChild(hoverCard);
                    }

                    return hoverCard;
                };

                var placeHoverCard = function(link) {
                    var sidebar = document.getElementById('accordionSidebar');
                    var card = ensureHoverCard();
                    if (!sidebar || !link || !card) {
                        return;
                    }

                    var linkRect = link.getBoundingClientRect();
                    var sidebarRect = sidebar.getBoundingClientRect();
                    var label = link.getAttribute('data-nav-label') || link.getAttribute('aria-label') || '';
                    var shortcut = link.getAttribute('data-nav-shortcut') || '';

                    card.innerHTML = '';
                    var labelNode = document.createElement('span');
                    labelNode.className = 'sidebar-hover-card__label';
                    labelNode.textContent = label;
                    card.appendChild(labelNode);

                    if (shortcut) {
                        var shortcutNode = document.createElement('span');
                        shortcutNode.className = 'sidebar-hover-card__shortcut';
                        shortcutNode.textContent = shortcut;
                        card.appendChild(shortcutNode);
                    }

                    card.style.left = Math.round(linkRect.right + 6) + 'px';
                    card.style.top = Math.round(linkRect.top + (linkRect.height / 2)) + 'px';
                };

                var showHoverCard = function(link) {
                    if (!link || link.classList.contains('nav-disabled') || isCompactViewport() || isSidebarExpanded()) {
                        hideHoverCard();
                        return;
                    }
                    if (link.classList.contains('sidebar-utility-toggle') && link.getAttribute('aria-expanded') === 'true') {
                        hideHoverCard();
                        return;
                    }

                    var card = ensureHoverCard();
                    if (!card) {
                        return;
                    }

                    activeSidebarLink = link;
                    placeHoverCard(link);
                    card.classList.add('show');
                };

                var hideHoverCard = function() {
                    activeSidebarLink = null;
                    var card = ensureHoverCard();
                    if (card) {
                        card.classList.remove('show');
                    }
                };

                document.addEventListener('mouseover', function(event) {
                    var link = event.target.closest ? event.target.closest('.sidebar-icon-link, .sidebar-panel-toggle, .sidebar-utility-toggle') : null;
                    if (!link) {
                        return;
                    }

                    var fromElement = event.relatedTarget;
                    if (fromElement && link.contains(fromElement)) {
                        return;
                    }

                    showHoverCard(link);
                }, true);

                document.addEventListener('mouseout', function(event) {
                    var link = event.target.closest ? event.target.closest('.sidebar-icon-link, .sidebar-panel-toggle, .sidebar-utility-toggle') : null;
                    if (!link) {
                        return;
                    }

                    var toElement = event.relatedTarget;
                    if (toElement && link.contains(toElement)) {
                        return;
                    }

                    hideHoverCard();
                }, true);

                document.addEventListener('focusin', function(event) {
                    var link = event.target.closest ? event.target.closest('.sidebar-icon-link, .sidebar-panel-toggle, .sidebar-utility-toggle') : null;
                    if (link) {
                        showHoverCard(link);
                    }
                });

                document.addEventListener('focusout', function(event) {
                    var link = event.target.closest ? event.target.closest('.sidebar-icon-link, .sidebar-panel-toggle, .sidebar-utility-toggle') : null;
                    if (link) {
                        hideHoverCard();
                    }
                });

                var sidebarScrollContainer = document.querySelector('.sidebar-scroll-container');
                if (sidebarScrollContainer) {
                    sidebarScrollContainer.addEventListener('scroll', function() {
                        if (activeSidebarLink) {
                            placeHoverCard(activeSidebarLink);
                        }
                    }, { passive: true });
                }

                window.addEventListener('resize', function() {
                    if (isSidebarExpanded()) {
                        hideHoverCard();
                    } else if (activeSidebarLink) {
                        placeHoverCard(activeSidebarLink);
                    } else {
                        hideHoverCard();
                    }
                });

                document.addEventListener('turbo:before-visit', hideHoverCard);
                document.addEventListener('turbo:before-cache', hideHoverCard);
            }

        });
    </script>

    <!-- Instant client-side table sorting -->
    <script>
    $(document).ready(function() {
        $('th[data-sort-key]').on('click', function() {
            var $th = $(this);
            var colIndex = $th.index();
            var $table = $th.closest('table');
            var $tbody = $table.find('tbody');
            var rows = $tbody.find('tr').get();
            var sortType = $th.data('sort-type') || 'string';

            // Determine direction
            var asc = true;
            if ($th.hasClass('sort-asc')) {
                asc = false;
            }

            // Clear all sort classes in this table
            $table.find('th[data-sort-key]').removeClass('sort-asc sort-desc');
            $th.addClass(asc ? 'sort-asc' : 'sort-desc');

            // Sort rows
            rows.sort(function(a, b) {
                var cellA = $(a).children('td').eq(colIndex).text().trim();
                var cellB = $(b).children('td').eq(colIndex).text().trim();

                if (sortType === 'number') {
                    var numA = parseFloat(cellA.replace(/[^0-9,.\-]/g, '').replace(',', '.')) || 0;
                    var numB = parseFloat(cellB.replace(/[^0-9,.\-]/g, '').replace(',', '.')) || 0;
                    return asc ? numA - numB : numB - numA;
                }
                if (sortType === 'date') {
                    // Parse dd/mm/yyyy
                    var partsA = cellA.split('/');
                    var partsB = cellB.split('/');
                    var dateA = partsA.length === 3 ? new Date(partsA[2], partsA[1]-1, partsA[0]) : new Date(0);
                    var dateB = partsB.length === 3 ? new Date(partsB[2], partsB[1]-1, partsB[0]) : new Date(0);
                    return asc ? dateA - dateB : dateB - dateA;
                }
                // Default: string (locale-aware)
                return asc ? cellA.localeCompare(cellB, 'fr') : cellB.localeCompare(cellA, 'fr');
            });

            // Re-append sorted rows (no page reload, instant)
            $.each(rows, function(i, row) {
                $tbody.append(row);
            });
        });
    });
    </script>
    
