    <!-- FontAwesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">

    <!-- SB Admin 2 CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/startbootstrap-sb-admin-2/4.1.4/css/sb-admin-2.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5.min.css">
    <link rel="stylesheet" href="{{ asset('styles/crud-list-columns.css') }}">
    
    <!-- Custom ERP Styles -->
    <style>
        /* ===== FOUC (Flash of Unstyled Content) Prevention ===== */
        .js-loading * {
            animation-duration: 0s !important;
            transition-duration: 0s !important;
        }
        .js-loading .select2-container,
        .js-loading .collapse {
            opacity: 0;
        }
        .js-loaded .select2-container,
        .js-loaded .collapse {
            opacity: 1;
            transition: opacity 0.15s ease-in-out;
        }
        .js-loading #loadingOverlay {
            display: flex;
        }
        .js-loading #loadingOverlay,
        .js-loading #loadingOverlay * {
            animation-duration: initial !important;
            transition-duration: initial !important;
        }
        .js-loading #loadingOverlay .spinner-circle {
            animation: spin 0.8s linear infinite !important;
        }

        /* ===== FIXED LAYOUT STRUCTURE ===== */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }
        #wrapper {
            display: flex;
            height: 100vh;
            width: 100%;
            overflow: hidden;
        }
        
        /* Sidebar Fixed */
        #accordionSidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            width: var(--sidebar-width, 92px) !important;
            min-width: var(--sidebar-width, 92px) !important;
            max-width: var(--sidebar-width, 92px) !important;
            flex: 0 0 var(--sidebar-width, 92px) !important;
            z-index: 1030;
            display: flex;
            flex-direction: column;
            overflow-x: visible;
            overflow-y: hidden;
            scrollbar-width: none;
        }
        #accordionSidebar::-webkit-scrollbar { display: none; }
        #accordionSidebar .sidebar-brand {
            flex-shrink: 0;
            position: sticky;
            top: 0;
            z-index: 10;
            background: inherit;
        }
        #accordionSidebar > hr:first-of-type {
            flex-shrink: 0;
        }
        #accordionSidebar .nav-item,
        #accordionSidebar > hr {
            flex-shrink: 0;
        }
       
        /* Sidebar content container (no scroll) */
        .sidebar-scroll-container {
            flex: 1;
            overflow: hidden;
            padding: 12px 0 16px;
        }
       
        /* Content wrapper adjustment */
        #content-wrapper {
            margin-left: var(--sidebar-width, 92px) !important;
            width: calc(100% - var(--sidebar-width, 92px)) !important;
            height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: margin-left 0.32s cubic-bezier(0.2, 0.8, 0.2, 1), width 0.32s cubic-bezier(0.2, 0.8, 0.2, 1);
        }
        #wrapper #accordionSidebar + #content-wrapper {
            margin-left: var(--sidebar-width, 92px) !important;
            width: calc(100% - var(--sidebar-width, 92px)) !important;
        }
       
        /* Fixed topbar */
        .topbar {
            position: sticky !important;
            top: 0;
            z-index: 1020;
            flex-shrink: 0;
            margin-bottom: 0 !important;
            background: white !important;
        }
       
        /* Content area - MUST be scrollable */
        #content {
            flex: 1 1 auto !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            min-height: 0 !important; /* Critical for flexbox scroll */
            max-height: none !important;
            height: auto !important;
            padding-bottom: 0;
            scroll-behavior: smooth;
            display: flex;
            flex-direction: column;
        }
       
        /* Ensure body block content doesn't break scroll */
        #content > .container-fluid {
            flex: 1 0 auto;
            overflow: visible !important;
            padding: 1.5rem !important;
            margin: 0 !important;
        }
       
        /* Add padding to dashboard rows for chart spacing */
        #content .row {
            padding: 0 1.5rem;
        }
       
        /* Content area scrollbar styling */
        #content::-webkit-scrollbar {
            width: 10px;
        }
        #content::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.08);
            border-radius: 999px;
        }
        #content::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, var(--theme-accent, #94a3b8), var(--theme-primary, #475569));
            border-radius: 999px;
            border: 2px solid rgba(255,255,255,0.72);
        }
        #content::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, var(--theme-primary, #475569), var(--theme-secondary, #334155));
        }
       
        /* Footer - always at bottom, scrolls with content */
        .site-footer {
            flex-shrink: 0;
            padding: 0.75rem 0;
            background: #f8f9fc;
            border-top: 1px solid #e3e6f0;
        }
        .site-footer span {
            font-size: 12px;
            color: #b7b9cc;
            letter-spacing: 0.3px;
        }
       
        /* When sidebar is toggled */
        .sidebar.toggled {
            width: var(--sidebar-width, 92px) !important;
            min-width: var(--sidebar-width, 92px) !important;
            max-width: var(--sidebar-width, 92px) !important;
        }
        .sidebar.toggled + #content-wrapper {
            margin-left: var(--sidebar-width, 92px) !important;
            width: calc(100% - var(--sidebar-width, 92px)) !important;
        }
       
        /* Mobile responsive */
        @media (max-width: 768px) {
            #accordionSidebar {
                width: var(--sidebar-width-collapsed);
                transform: translateX(-100%);
                transition: transform 0.3s ease;
            }
            #accordionSidebar.show {
                transform: translateX(0);
            }
            #content-wrapper {
                margin-left: 0;
                width: 100%;
            }
            .sidebar-icon-link::before,
            .sidebar-icon-link::after {
                display: none !important;
            }
            #accordionSidebar .sidebar-collapse-control {
                display: none !important;
            }
        }
 
        /* ===== LOADING SPINNER OVERLAY - Content Area Only ===== */
        .loading-overlay {
            display: none;
            position: fixed;
            top: 70px; /* Below topbar */
            left: var(--sidebar-width, 92px); /* After sidebar */
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.92);
            z-index: 100;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(2px);
        }
        .loading-overlay.active {
            display: flex;
        }
       
        /* Topbar dropdown z-index fix */
        .topbar .dropdown-menu {
            z-index: 1050 !important;
        }
       
        /* Responsive loading overlay */
        @media (max-width: 768px) {
            .loading-overlay {
                left: 0;
                top: 56px;
            }
        }
        .sidebar.toggled ~ #content-wrapper .loading-overlay {
            left: var(--sidebar-width, 92px);
        }
        .loading-spinner {
            background: white;
            padding: 40px 60px;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.15);
            text-align: center;
        }
        .spinner-circle {
            width: 60px;
            height: 60px;
            border: 5px solid #e9ecef;
            border-top: 5px solid var(--theme-primary);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 0 auto 20px;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .loading-text {
            color: #5a5c69;
            font-weight: 600;
            font-size: 15px;
        }
 
        /* ===== USER AVATAR STYLING ===== */
        .user-avatar {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-secondary) 100%);
            color: white;
            font-weight: bold;
            font-size: 18px;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.18), inset 0 1px 0 rgba(255,255,255,0.25);
            border: 2px solid rgba(255, 255, 255, 0.82);
        }

        /* ===== REQUIRED FIELD INDICATOR ===== */
        .form-group label.required::after,
        label.required::after {
            content: " *";
            color: #e74a3b;
            font-weight: bold;
        }
        
        /* ===== FORM CARD STYLING ===== */
        .form-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
            padding: 25px;
            margin-bottom: 20px;
        }
        .form-card .card-header-custom {
            border-bottom: 1px solid var(--theme-border);
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        .form-card .card-header-custom h5 {
            margin: 0;
            color: var(--theme-primary);
            font-weight: 600;
        }

        /* ===== FORM INPUT IMPROVEMENTS ===== */
        .form-card .form-control,
        .form-card .form-control:not(.select2-hidden-accessible) {
            border: 1.5px solid #d1d3e2;
            border-radius: 8px;
            height: 42px;
            padding: 9px 12px;
            font-size: 14px;
            color: #3a3b45;
            background-color: #fff;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .form-card .form-control:hover {
            border-color: #b0bfe6;
        }
        .form-card .form-control:focus {
            border-color: var(--theme-primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
            background-color: #fff;
        }
        .form-card .form-control::placeholder {
            color: #a0a4b8;
        }
        .form-card textarea.form-control {
            height: auto;
            min-height: 80px;
        }
        .form-card .form-group label {
            font-size: 13px;
            font-weight: 600;
            color: #5a5c69;
            margin-bottom: 6px;
        }

        /* ===== DROPDOWN/SELECT2 IMPROVEMENTS ===== */
        .select2-container--bootstrap-5 .select2-selection {
            border: 1.5px solid #d1d3e2 !important;
            border-radius: 8px !important;
            padding: 0 12px !important;
            height: 42px !important;
            min-height: 42px !important;
            background: #fff !important;
            transition: all 0.2s ease !important;
            display: flex !important;
            align-items: center !important;
        }
        .select2-container--bootstrap-5 .select2-selection:hover {
            border-color: #b0bfe6 !important;
        }
        .select2-container--bootstrap-5.select2-container--focus .select2-selection,
        .select2-container--bootstrap-5.select2-container--open .select2-selection {
            border-color: var(--theme-primary) !important;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12) !important;
        }
        .select2-container--bootstrap-5 .select2-selection__rendered {
            color: #3a3b45 !important;
            font-size: 14px !important;
            line-height: 40px !important;
            padding: 0 !important;
            padding-right: 28px !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            white-space: nowrap !important;
            display: block !important;
            width: 100% !important;
        }
        .select2-container--bootstrap-5 .select2-selection--single {
            height: 42px !important;
            padding: 0 12px !important;
        }
        .select2-container--bootstrap-5 .select2-selection__placeholder {
            color: #a0a4b8 !important;
            font-size: 14px !important;
        }
        .select2-container--bootstrap-5 .select2-selection__arrow {
            height: 100% !important;
            right: 12px !important;
            top: 0 !important;
            display: flex !important;
            align-items: center !important;
            width: 20px !important;
        }
        .select2-container--bootstrap-5 .select2-selection__arrow b {
            border: none !important;
            width: 10px !important;
            height: 10px !important;
            margin: 0 !important;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%236e7891' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e") !important;
            background-repeat: no-repeat !important;
            background-size: contain !important;
            background-position: center !important;
            transition: transform 0.2s ease !important;
        }
        .select2-container--bootstrap-5.select2-container--open .select2-selection__arrow b {
            transform: rotate(180deg) !important;
        }
        .select2-container--bootstrap-5 .select2-dropdown {
            border: 1.5px solid #d1d3e2 !important;
            border-radius: 8px !important;
            box-shadow: 0 8px 24px rgba(0,0,0,0.1) !important;
            margin-top: 4px !important;
            overflow: hidden !important;
        }
        .select2-container--bootstrap-5 .select2-search--dropdown .select2-search__field {
            border: 1.5px solid #d1d3e2 !important;
            border-radius: 6px !important;
            padding: 8px 12px !important;
            font-size: 14px !important;
        }
        .select2-container--bootstrap-5 .select2-search--dropdown .select2-search__field:focus {
            border-color: var(--theme-primary) !important;
            outline: none !important;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12) !important;
        }
        .select2-container--bootstrap-5 .select2-results__option {
            padding: 9px 14px !important;
            font-size: 14px !important;
            color: #3a3b45 !important;
            transition: background-color 0.15s ease !important;
        }
        .select2-container--bootstrap-5 .select2-results__option--highlighted {
            background-color: #eef2ff !important;
            color: var(--theme-primary) !important;
        }
        .select2-container--bootstrap-5 .select2-results__option--selected {
            background-color: var(--theme-primary) !important;
            color: #fff !important;
        }
        .select2-container--bootstrap-5 .select2-selection__clear {
            margin-right: 5px !important;
            color: #a0a4b8 !important;
            font-size: 18px !important;
        }
        .select2-container--bootstrap-5 .select2-selection__clear:hover {
            color: #e74a3b !important;
        }
        .select2-container {
            width: 100% !important;
        }
        /* Native select styling */
        select.form-control:not(.select2-hidden-accessible) {
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
            background-color: #fff;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%236e7891' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 12px center;
            background-size: 14px 10px;
            border: 1.5px solid #d1d3e2;
            border-radius: 8px;
            padding: 9px 36px 9px 12px;
            font-size: 14px;
            color: #3a3b45;
            cursor: pointer;
            transition: all 0.2s ease;
            height: 42px;
        }
        select.form-control:not(.select2-hidden-accessible):hover {
            border-color: #b0bfe6;
        }
        select.form-control:not(.select2-hidden-accessible):focus {
            border-color: var(--theme-primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
            outline: none;
        }

        /* ===== VALIDATION STYLES ===== */
        .form-control.is-invalid {
            border-color: #e74a3b;
            background-image: none;
        }
        .form-control.is-valid {
            border-color: #1cc88a;
            background-image: none;
        }
        .invalid-feedback {
            display: none;
            color: #e74a3b;
            font-size: 12px;
            margin-top: 4px;
        }
        .form-control.is-invalid ~ .invalid-feedback,
        .was-validated .form-control:invalid ~ .invalid-feedback {
            display: block;
        }

        /* ===== TABLE IMPROVEMENTS ===== */
        .table-container {
            background: white;
            border-radius: 8px;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
            overflow: hidden;
        }
        .table-container .table {
            margin-bottom: 0;
        }
        .table thead th {
            background: var(--theme-primary);
            color: white;
            border: none;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 15px 12px;
            white-space: nowrap;
        }
        .table tbody td, .table tbody th {
            padding: 12px;
            vertical-align: middle;
            border-color: #e3e6f0;
        }
        .table tbody tr:hover {
            background-color: rgba(0, 0, 0, 0.02);
        }
        .table thead th:first-child {
            border-top-left-radius: 8px;
        }
        .table thead th:last-child {
            border-top-right-radius: 8px;
        }
        .table tbody tr:last-child td:first-child {
            border-bottom-left-radius: 8px;
        }
        .table tbody tr:last-child td:last-child {
            border-bottom-right-radius: 8px;
        }

        /* ===== ACTION BUTTONS (NO WRAP) ===== */
        .table td.text-center {
            white-space: nowrap;
        }
        .btn-action {
            padding: 8px 12px;
            font-size: 16px;
            border-radius: 4px;
            margin: 0 2px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            border: none;
            background: transparent;
            font-weight: 500;
        }
        .btn-action i {
            font-size: 18px;
        }
        .btn-action.disabled,
        .btn-action[aria-disabled="true"] {
            pointer-events: none;
            opacity: 0.45;
            transform: none !important;
        }
        .btn-edit, .btn-view {
            color: var(--theme-primary);
            background: transparent;
        }
        .btn-edit:hover, .btn-view:hover {
            background: rgba(var(--theme-primary-rgb, 37, 99, 235), 0.12);
            color: var(--theme-secondary);
            transform: translateY(-1px);
        }
        .btn-delete {
            color: #e74a3b;
            background: transparent;
        }
        .btn-delete:hover {
            background: rgba(231, 74, 59, 0.12);
            color: #c82333;
            transform: translateY(-1px);
        }
        .table .btn-delete .fa-trash:before,
        .table .btn-action.btn-delete .fa-trash:before {
            content: "\f2ed";
        }
        .btn-einvoicing {
            color: #0891b2;
            background: transparent;
        }
        .btn-einvoicing:hover {
            background: rgba(8, 145, 178, 0.12);
            color: #0e7490;
            transform: translateY(-1px);
        }
        .btn-einvoicing--no-facture {
            color: rgba(107, 114, 128, 0.5);
        }
        .btn-einvoicing--no-facture:hover {
            color: rgba(107, 114, 128, 0.7);
            background: transparent;
            transform: none;
        }
        .btn-convert {
            color: #1cc88a;
            background: transparent;
        }
        .btn-convert:hover {
            background: rgba(28, 200, 138, 0.12);
            color: #0f8659;
            transform: translateY(-1px);
        }

        .table tr.js-inline-editing td {
            background: rgba(37, 99, 235, 0.06);
            overflow: visible !important;
            position: relative;
            z-index: 2;
        }
        .table .js-inline-editor:not(.inline-dropdown-shell) {
            display: block;
            width: 100%;
            min-height: 1.3rem;
            line-height: 1.35;
            padding: 0;
            margin: 0;
            border: 0;
            background: transparent;
            color: inherit;
            outline: none;
            cursor: text;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .table .js-inline-editor:not(.inline-dropdown-shell):focus {
            outline: none;
            box-shadow: none;
        }
        .table .js-inline-editor:not(.inline-dropdown-shell):empty::before {
            content: attr(data-placeholder);
            color: #94a3b8;
        }
        .table .inline-dropdown-shell.js-inline-editor {
            display: flex;
            width: 100%;
            min-height: 1.5rem;
            line-height: 1.35;
            margin: 0;
            padding: 0;
            border: 0;
            background: transparent;
            outline: none;
        }
        .table .js-inline-editor.is-invalid {
            color: #dc2626;
        }
        .inline-dropdown-shell {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 0.3rem;
            min-height: 1.5rem;
            z-index: 1;
            overflow: visible;
        }
        .inline-dropdown-shell.is-open {
            z-index: 2400;
            overflow: visible;
        }
        .inline-dropdown-label {
            display: block;
            flex: 1 1 auto;
            min-width: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            cursor: pointer;
            font-size: 0.88rem;
            color: #334155;
            font-weight: 500;
            padding: 0.25rem 0.4rem;
            border-radius: 4px;
            transition: background-color 0.15s ease;
        }
        .inline-dropdown-shell.is-open .inline-dropdown-label {
            background: rgba(37, 99, 235, 0.06);
        }
        .inline-dropdown-trigger {
            width: 20px;
            height: 20px;
            border: none;
            background: transparent;
            color: #6b7280;
            border-radius: 4px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: background-color 0.15s ease, color 0.15s ease;
            flex-shrink: 0;
            font-size: 0.75rem;
            padding: 0;
        }
        .inline-dropdown-trigger:hover,
        .inline-dropdown-shell.is-open .inline-dropdown-trigger {
            background: rgba(37, 99, 235, 0.1);
            color: var(--theme-primary);
        }
        .inline-dropdown-menu {
            position: absolute;
            top: calc(100% + 6px);
            left: 0;
            right: auto;
            min-width: 200px;
            max-width: calc(100vw - 1rem);
            max-height: 280px;
            overflow-y: auto;
            padding: 0;
            border-radius: 8px;
            background: #fff;
            border: 1px solid #e2e8f0;
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.12);
