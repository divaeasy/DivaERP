                    </button>

                    <!-- Confirm -->
                    <a id="confirmDeleteBtn" href="#"
                        class="btn"
                        style="
                            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
                            color: white;
                            border: none;
                            font-weight: 600;
                            padding: 12px 28px;
