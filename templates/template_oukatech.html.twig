        'secondary':'#334155',
        'accent':'#94a3b8',
        'text':'#020617',
        'bg':'#f8fafc'
    },

    'bleu-corporate': {
        'primary':'#1e40af',
        'secondary':'#1e3a8a',
        'accent':'#60a5fa',
        'text':'#0f172a',
        'bg':'#f8fafc'
    },

    'emeraude': {
        'primary':'#059669',
        'secondary':'#047857',
        'accent':'#34d399',
        'text':'#022c22',
        'bg':'#f0fdf4'
    },

