            var isApplePlatform = /(Mac|iPhone|iPad|iPod)/i.test((navigator.platform || '') + ' ' + (navigator.userAgent || ''));
            var shortcutModifierLabel = isApplePlatform ? '⌘' : 'Ctrl';
            var formatShortcut = function(keyLabel) {
                return shortcutModifierLabel + '+' + keyLabel;
            };

            $('[data-search-shortcut-hint]').text(formatShortcut('K'));
            $('[data-nav-shortcut-key]').each(function() {
                var keyLabel = String($(this).data('navShortcutKey') || '').trim();
