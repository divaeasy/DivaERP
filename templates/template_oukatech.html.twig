<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

   <title>Diva Easy - {% block PageTitle %}{% endblock %}</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">

    <!-- FontAwesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">

    <!-- SB Admin 2 CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/startbootstrap-sb-admin-2/4.1.4/css/sb-admin-2.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5.min.css">
    
    <!-- Custom ERP Styles -->
    <style>
        /* ===== FOUC (Flash of Unstyled Content) Prevention ===== */
        .js-loading * {
            animation-duration: 0s !important;
            transition-duration: 0s !important;
        }
        .js-loading .select2-container,
        .js-loading .collapse {
            opacity: 0;
        }
        .js-loaded .select2-container,
        .js-loaded .collapse {
            opacity: 1;
            transition: opacity 0.15s ease-in-out;
        }

        /* ===== FIXED LAYOUT STRUCTURE ===== */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }
        #wrapper {
            display: flex;
            height: 100vh;
            width: 100%;
            overflow: hidden;
        }
        
        /* Sidebar Fixed */
        #accordionSidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            width: var(--sidebar-width, 92px) !important;
            min-width: var(--sidebar-width, 92px) !important;
            max-width: var(--sidebar-width, 92px) !important;
            flex: 0 0 var(--sidebar-width, 92px) !important;
            z-index: 1030;
            display: flex;
            flex-direction: column;
            overflow-x: visible;
            overflow-y: hidden;
            scrollbar-width: none;
        }
        #accordionSidebar::-webkit-scrollbar { display: none; }
        #accordionSidebar .sidebar-brand {
            flex-shrink: 0;
            position: sticky;
            top: 0;
            z-index: 10;
            background: inherit;
        }
        #accordionSidebar > hr:first-of-type {
            flex-shrink: 0;
        }
        #accordionSidebar .nav-item,
        #accordionSidebar > hr {
            flex-shrink: 0;
        }
       
        /* Sidebar content container (no scroll) */
        .sidebar-scroll-container {
            flex: 1;
            overflow: hidden;
            padding: 12px 0 16px;
        }
       
        /* Content wrapper adjustment */
        #content-wrapper {
            margin-left: var(--sidebar-width, 92px) !important;
            width: calc(100% - var(--sidebar-width, 92px)) !important;
            height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        #wrapper #accordionSidebar + #content-wrapper {
            margin-left: var(--sidebar-width, 92px) !important;
            width: calc(100% - var(--sidebar-width, 92px)) !important;
        }
       
        /* Fixed topbar */
        .topbar {
            position: sticky !important;
            top: 0;
            z-index: 1020;
            flex-shrink: 0;
            margin-bottom: 0 !important;
            background: white !important;
        }
       
        /* Content area - MUST be scrollable */
        #content {
            flex: 1 1 auto !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            min-height: 0 !important; /* Critical for flexbox scroll */
            max-height: none !important;
            height: auto !important;
            padding-bottom: 0;
            scroll-behavior: smooth;
            display: flex;
            flex-direction: column;
        }
       
        /* Ensure body block content doesn't break scroll */
        #content > .container-fluid {
            flex: 1 0 auto;
            overflow: visible !important;
            padding: 1.5rem !important;
            margin: 0 !important;
        }
       
        /* Add padding to dashboard rows for chart spacing */
        #content .row {
            padding: 0 1.5rem;
        }
       
        /* Content area scrollbar styling */
        #content::-webkit-scrollbar {
            width: 10px;
        }
        #content::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.08);
            border-radius: 999px;
        }
        #content::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, var(--theme-accent, #94a3b8), var(--theme-primary, #475569));
            border-radius: 999px;
            border: 2px solid rgba(255,255,255,0.72);
        }
        #content::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, var(--theme-primary, #475569), var(--theme-secondary, #334155));
        }
       
        /* Footer - always at bottom, scrolls with content */
        .site-footer {
            flex-shrink: 0;
            padding: 0.75rem 0;
            background: #f8f9fc;
            border-top: 1px solid #e3e6f0;
        }
        .site-footer span {
            font-size: 12px;
            color: #b7b9cc;
            letter-spacing: 0.3px;
        }
       
        /* When sidebar is toggled */
        .sidebar.toggled {
            width: var(--sidebar-width, 92px) !important;
            min-width: var(--sidebar-width, 92px) !important;
            max-width: var(--sidebar-width, 92px) !important;
        }
        .sidebar.toggled + #content-wrapper {
            margin-left: var(--sidebar-width, 92px) !important;
            width: calc(100% - var(--sidebar-width, 92px)) !important;
        }
       
        /* Mobile responsive */
        @media (max-width: 768px) {
            #accordionSidebar {
                width: var(--sidebar-width-collapsed);
                transform: translateX(-100%);
                transition: transform 0.3s ease;
            }
            #accordionSidebar.show {
                transform: translateX(0);
            }
            #content-wrapper {
                margin-left: 0;
                width: 100%;
            }
            .sidebar-icon-link::before,
            .sidebar-icon-link::after {
                display: none !important;
            }
            #accordionSidebar .sidebar-collapse-control {
                display: none !important;
            }
        }
 
        /* ===== LOADING SPINNER OVERLAY - Content Area Only ===== */
        .loading-overlay {
            display: none;
            position: fixed;
            top: 70px; /* Below topbar */
            left: var(--sidebar-width, 92px); /* After sidebar */
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.92);
            z-index: 100;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(2px);
        }
        .loading-overlay.active {
            display: flex;
        }
       
        /* Topbar dropdown z-index fix */
        .topbar .dropdown-menu {
            z-index: 1050 !important;
        }
       
        /* Responsive loading overlay */
        @media (max-width: 768px) {
            .loading-overlay {
                left: 0;
                top: 56px;
            }
        }
        .sidebar.toggled ~ #content-wrapper .loading-overlay {
            left: var(--sidebar-width, 92px);
        }
        .loading-spinner {
            background: white;
            padding: 40px 60px;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.15);
            text-align: center;
        }
        .spinner-circle {
            width: 60px;
            height: 60px;
            border: 5px solid #e9ecef;
            border-top: 5px solid var(--theme-primary);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 0 auto 20px;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .loading-text {
            color: #5a5c69;
            font-weight: 600;
            font-size: 15px;
        }
 
        /* ===== USER AVATAR STYLING ===== */
        .user-avatar {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-secondary) 100%);
            color: white;
            font-weight: bold;
            font-size: 18px;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.18), inset 0 1px 0 rgba(255,255,255,0.25);
            border: 2px solid rgba(255, 255, 255, 0.82);
        }

        /* ===== REQUIRED FIELD INDICATOR ===== */
        .form-group label.required::after,
        label.required::after {
            content: " *";
            color: #e74a3b;
            font-weight: bold;
        }
        
        /* ===== FORM CARD STYLING ===== */
        .form-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
            padding: 25px;
            margin-bottom: 20px;
        }
        .form-card .card-header-custom {
            border-bottom: 1px solid var(--theme-border);
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        .form-card .card-header-custom h5 {
            margin: 0;
            color: var(--theme-primary);
            font-weight: 600;
        }

        /* ===== FORM INPUT IMPROVEMENTS ===== */
        .form-card .form-control,
        .form-card .form-control:not(.select2-hidden-accessible) {
            border: 1.5px solid #d1d3e2;
            border-radius: 8px;
            height: 42px;
            padding: 9px 12px;
            font-size: 14px;
            color: #3a3b45;
            background-color: #fff;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .form-card .form-control:hover {
            border-color: #b0bfe6;
        }
        .form-card .form-control:focus {
            border-color: var(--theme-primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
            background-color: #fff;
        }
        .form-card .form-control::placeholder {
            color: #a0a4b8;
        }
        .form-card textarea.form-control {
            height: auto;
            min-height: 80px;
        }
        .form-card .form-group label {
            font-size: 13px;
            font-weight: 600;
            color: #5a5c69;
            margin-bottom: 6px;
        }

        /* ===== DROPDOWN/SELECT2 IMPROVEMENTS ===== */
        .select2-container--bootstrap-5 .select2-selection {
            border: 1.5px solid #d1d3e2 !important;
            border-radius: 8px !important;
            padding: 0 12px !important;
            height: 42px !important;
            min-height: 42px !important;
            background: #fff !important;
            transition: all 0.2s ease !important;
            display: flex !important;
            align-items: center !important;
        }
        .select2-container--bootstrap-5 .select2-selection:hover {
            border-color: #b0bfe6 !important;
        }
        .select2-container--bootstrap-5.select2-container--focus .select2-selection,
        .select2-container--bootstrap-5.select2-container--open .select2-selection {
            border-color: var(--theme-primary) !important;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12) !important;
        }
        .select2-container--bootstrap-5 .select2-selection__rendered {
            color: #3a3b45 !important;
            font-size: 14px !important;
            line-height: 40px !important;
            padding: 0 !important;
            padding-right: 28px !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            white-space: nowrap !important;
            display: block !important;
            width: 100% !important;
        }
        .select2-container--bootstrap-5 .select2-selection--single {
            height: 42px !important;
            padding: 0 12px !important;
        }
        .select2-container--bootstrap-5 .select2-selection__placeholder {
            color: #a0a4b8 !important;
            font-size: 14px !important;
        }
        .select2-container--bootstrap-5 .select2-selection__arrow {
            height: 100% !important;
            right: 12px !important;
            top: 0 !important;
            display: flex !important;
            align-items: center !important;
            width: 20px !important;
        }
        .select2-container--bootstrap-5 .select2-selection__arrow b {
            border: none !important;
            width: 10px !important;
            height: 10px !important;
            margin: 0 !important;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%236e7891' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e") !important;
            background-repeat: no-repeat !important;
            background-size: contain !important;
            background-position: center !important;
            transition: transform 0.2s ease !important;
        }
        .select2-container--bootstrap-5.select2-container--open .select2-selection__arrow b {
            transform: rotate(180deg) !important;
        }
        .select2-container--bootstrap-5 .select2-dropdown {
            border: 1.5px solid #d1d3e2 !important;
            border-radius: 8px !important;
            box-shadow: 0 8px 24px rgba(0,0,0,0.1) !important;
            margin-top: 4px !important;
            overflow: hidden !important;
        }
        .select2-container--bootstrap-5 .select2-search--dropdown .select2-search__field {
            border: 1.5px solid #d1d3e2 !important;
            border-radius: 6px !important;
            padding: 8px 12px !important;
            font-size: 14px !important;
        }
        .select2-container--bootstrap-5 .select2-search--dropdown .select2-search__field:focus {
            border-color: var(--theme-primary) !important;
            outline: none !important;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12) !important;
        }
        .select2-container--bootstrap-5 .select2-results__option {
            padding: 9px 14px !important;
            font-size: 14px !important;
            color: #3a3b45 !important;
            transition: background-color 0.15s ease !important;
        }
        .select2-container--bootstrap-5 .select2-results__option--highlighted {
            background-color: #eef2ff !important;
            color: var(--theme-primary) !important;
        }
        .select2-container--bootstrap-5 .select2-results__option--selected {
            background-color: var(--theme-primary) !important;
            color: #fff !important;
        }
        .select2-container--bootstrap-5 .select2-selection__clear {
            margin-right: 5px !important;
            color: #a0a4b8 !important;
            font-size: 18px !important;
        }
        .select2-container--bootstrap-5 .select2-selection__clear:hover {
            color: #e74a3b !important;
        }
        .select2-container {
            width: 100% !important;
        }
        /* Native select styling */
        select.form-control:not(.select2-hidden-accessible) {
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
            background-color: #fff;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%236e7891' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 12px center;
            background-size: 14px 10px;
            border: 1.5px solid #d1d3e2;
            border-radius: 8px;
            padding: 9px 36px 9px 12px;
            font-size: 14px;
            color: #3a3b45;
            cursor: pointer;
            transition: all 0.2s ease;
            height: 42px;
        }
        select.form-control:not(.select2-hidden-accessible):hover {
            border-color: #b0bfe6;
        }
        select.form-control:not(.select2-hidden-accessible):focus {
            border-color: var(--theme-primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
            outline: none;
        }

        /* ===== VALIDATION STYLES ===== */
        .form-control.is-invalid {
            border-color: #e74a3b;
            background-image: none;
        }
        .form-control.is-valid {
            border-color: #1cc88a;
            background-image: none;
        }
        .invalid-feedback {
            display: none;
            color: #e74a3b;
            font-size: 12px;
            margin-top: 4px;
        }
        .form-control.is-invalid ~ .invalid-feedback,
        .was-validated .form-control:invalid ~ .invalid-feedback {
            display: block;
        }

        /* ===== TABLE IMPROVEMENTS ===== */
        .table-container {
            background: white;
            border-radius: 8px;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
            overflow: hidden;
        }
        .table-container .table {
            margin-bottom: 0;
        }
        .table thead th {
            background: var(--theme-primary);
            color: white;
            border: none;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 15px 12px;
            white-space: nowrap;
        }
        .table tbody td, .table tbody th {
            padding: 12px;
            vertical-align: middle;
            border-color: #e3e6f0;
        }
        .table tbody tr:hover {
            background-color: rgba(0, 0, 0, 0.02);
        }

        /* ===== ACTION BUTTONS (NO WRAP) ===== */
        .table td.text-center {
            white-space: nowrap;
        }
        .btn-action {
            padding: 8px 12px;
            font-size: 16px;
            border-radius: 4px;
            margin: 0 2px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            border: none;
            background: transparent;
            font-weight: 500;
        }
        .btn-action i {
            font-size: 18px;
        }
        .btn-action.disabled,
        .btn-action[aria-disabled="true"] {
            pointer-events: none;
            opacity: 0.45;
            transform: none !important;
        }
        .btn-edit, .btn-view {
            color: var(--theme-primary);
            background: transparent;
        }
        .btn-edit:hover, .btn-view:hover {
            background: rgba(var(--theme-primary-rgb, 37, 99, 235), 0.12);
            color: var(--theme-secondary);
            transform: translateY(-1px);
        }
        .btn-delete {
            color: #e74a3b;
            background: transparent;
        }
        .btn-delete:hover {
            background: rgba(231, 74, 59, 0.12);
            color: #c82333;
            transform: translateY(-1px);
        }
        .btn-einvoicing {
            color: #0891b2;
            background: transparent;
        }
        .btn-einvoicing:hover {
            background: rgba(8, 145, 178, 0.12);
            color: #0e7490;
            transform: translateY(-1px);
        }
        .btn-einvoicing--no-facture {
            color: rgba(107, 114, 128, 0.5);
        }
        .btn-einvoicing--no-facture:hover {
            color: rgba(107, 114, 128, 0.7);
            background: transparent;
            transform: none;
        }
        .btn-convert {
            color: #1cc88a;
            background: transparent;
        }
        .btn-convert:hover {
            background: rgba(28, 200, 138, 0.12);
            color: #0f8659;
            transform: translateY(-1px);
        }

        .page-header {
            margin-bottom: 1rem;
        }
        .page-header h1 {
            margin: 0;
            font-size: 1.5rem;
        }
        .page-header .btn-back {
            background: var(--theme-secondary);
            color: white;
            padding: 8px 16px;
            border-radius: 4px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            transition: all 0.2s ease;
        }
        .page-header .btn-back:hover {
            background: var(--theme-primary);
            color: white;
            text-decoration: none;
        }

        /* ===== UNIFIED ACTION BAR (Search + Create Button) ===== */
        .action-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 15px;
            background: white;
            padding: 15px 20px;
            border-radius: 8px;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1);
        }
        .action-bar .btn-add {
            background: linear-gradient(180deg, var(--theme-primary) 10%, var(--theme-secondary) 100%);
            color: white;
            padding: 12px 24px;
            border-radius: 6px;
            font-weight: 600;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
            text-decoration: none;
            white-space: nowrap;
        }
        .action-bar .btn-add:hover {
            background: linear-gradient(180deg, var(--theme-secondary) 10%, var(--theme-primary) 100%);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
            text-decoration: none;
        }
        .action-bar .search-box {
            flex: 1;
            max-width: 500px;
            min-width: 250px;
        }

        /* ===== NAVIGATION SEARCH DROPDOWN ===== */
        #navSearchResults {
            max-height: 400px;
            overflow-y: auto;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            z-index: 1050;
            border-radius: 8px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.15);
            border: 1px solid #e3e6f0;
            margin-top: 5px;
        }
        #navSearchResults .dropdown-item {
            padding: 12px 20px;
            border-bottom: 1px solid #f8f9fc;
            transition: all 0.2s;
        }
        #navSearchResults .dropdown-item:last-child {
            border-bottom: none;
        }
        #navSearchResults .dropdown-item:hover {
            background: #f8f9fc;
            color: var(--theme-primary);
        }
        #navSearchResults .dropdown-item i {
            width: 20px;
        }

        /* ===== EMPTY STATE ===== */
        .empty-state {
            text-align: center;
            padding: 80px 40px;
            color: #6c757d;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .empty-state .empty-state-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #eef2ff 0%, #e8eafd 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
        }
        .empty-state .empty-state-icon i,
        .empty-state > i {
            font-size: 32px;
            color: var(--theme-primary);
            opacity: 1;
            margin-bottom: 0;
        }
        .empty-state > i {
            width: 80px;
            height: 80px;
            line-height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #eef2ff 0%, #e8eafd 100%);
            margin-bottom: 20px;
            font-size: 32px;
            color: var(--theme-primary);
            opacity: 1;
        }
        .empty-state h5 {
            font-size: 18px;
            font-weight: 600;
            color: #344767;
            margin-bottom: 8px;
        }
        .empty-state p {
            margin: 0 0 24px 0;
            font-size: 15px;
            color: #8898aa;
            max-width: 320px;
        }
        .empty-state .btn {
            padding: 10px 24px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(78, 115, 223, 0.25);
            transition: all 0.2s ease;
        }
        .empty-state .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 12px rgba(78, 115, 223, 0.35);
        }

        /* ===== TOAST NOTIFICATIONS ===== */
        .toast-container {
            position: fixed;
            top: 80px;
            right: 24px;
            z-index: 1019;
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-width: 420px;
            width: 100%;
        }
        .toast-notification {
            display: flex;
            align-items: flex-start;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
            padding: 16px 18px;
            position: relative;
            overflow: hidden;
            border-left: 4px solid transparent;
            animation: toastSlideIn 0.35s cubic-bezier(0.21, 1.02, 0.73, 1) forwards;
        }
        .toast-notification.toast-hiding {
            animation: toastSlideOut 0.3s ease-in forwards;
        }
        .toast-icon {
            flex-shrink: 0;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 14px;
            font-size: 16px;
        }
        .toast-content {
            flex: 1;
            min-width: 0;
        }
        .toast-title {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 2px;
        }
        .toast-message {
            font-size: 13px;
            color: #5a5c69;
            line-height: 1.4;
            word-wrap: break-word;
        }
        .toast-close {
            background: none;
            border: none;
            font-size: 20px;
            line-height: 1;
            color: #b0b3c5;
            cursor: pointer;
            padding: 0 0 0 10px;
            transition: color 0.2s;
            flex-shrink: 0;
        }
        .toast-close:hover {
            color: #5a5c69;
        }
        .toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: rgba(0, 0, 0, 0.05);
        }
        .toast-progress-bar {
            height: 100%;
            width: 100%;
            transform-origin: left;
            animation: toastCountdown 5s linear forwards;
        }
        /* Success */
        .toast-success {
            border-left-color: #1cc88a;
        }
        .toast-success .toast-icon {
            background: #e8f8f0;
            color: #1cc88a;
        }
        .toast-success .toast-title {
            color: #1cc88a;
        }
        .toast-success .toast-progress-bar {
            background: #1cc88a;
        }
        /* Error */
        .toast-error {
            border-left-color: #e74a3b;
        }
        .toast-error .toast-icon {
            background: #fdf0ef;
            color: #e74a3b;
        }
        .toast-error .toast-title {
            color: #e74a3b;
        }
        .toast-error .toast-progress-bar {
            background: #e74a3b;
        }
        /* Info */
        .toast-info {
            border-left-color: var(--theme-primary);
        }
        .toast-info .toast-icon {
            background: #eef2ff;
            color: var(--theme-primary);
        }
        .toast-info .toast-title {
            color: var(--theme-primary);
        }
        .toast-info .toast-progress-bar {
            background: var(--theme-primary);
        }
        @keyframes toastSlideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        @keyframes toastSlideOut {
            from { transform: translateX(0); opacity: 1; }
            to { transform: translateX(100%); opacity: 0; }
        }
        @keyframes toastCountdown {
            from { transform: scaleX(1); }
            to { transform: scaleX(0); }
        }
        @media (max-width: 480px) {
            .toast-container {
                top: 74px;
                right: 12px;
                left: 12px;
                max-width: none;
            }
        }

        /* ===== DELETE MODAL STYLING ===== */
        .modal-delete .modal-header {
            background: #e74a3b;
            color: white;
            border-radius: 0;
        }
        .modal-delete .modal-header .close {
            color: white;
            opacity: 1;
        }
        .modal-delete .modal-body {
            padding: 30px;
            text-align: center;
        }
        .modal-delete .modal-body i {
            font-size: 48px;
            color: #e74a3b;
            margin-bottom: 15px;
        }
        .modal-delete .btn-danger {
            background: #e74a3b;
            border-color: #e74a3b;
        }

        /* ===== FORM BUTTON GROUP ===== */
        .form-actions {
            display: flex;
            gap: 10px;
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px solid #e3e6f0;
        } 
        .form-actions .btn {
            padding: 12px 30px;
            font-weight: 600;
            border-radius: 6px;
        }
        .form-actions .btn-primary {
            background: linear-gradient(180deg, var(--theme-primary) 10%, var(--theme-secondary) 100%);
            border: none;
        }
        .form-actions .btn-secondary {
            background: #858796;
            border: none;
        }

        /* Badges for status */
        .badge-status {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
        }
        .badge-active { background: #1cc88a; color: white; }
        .badge-draft { background: #f6c23e; color: white; }
        .badge-expired { background: #858796; color: white; }

        /* ===== DISABLED NAV LINKS ===== */
        .nav-link.nav-disabled,
        .collapse-item.nav-disabled {
            pointer-events: none !important;
            cursor: not-allowed !important;
            opacity: 0.42 !important;
        }
        th[data-sort-key] {
            cursor: pointer;
            position: relative;
            user-select: none;
            transition: background 0.15s ease;
            padding-right: 28px !important;
        }
        th[data-sort-key]:hover {
            background: var(--theme-secondary) !important;
        }
        th[data-sort-key]::after {
            content: '\f0dc';
            font-family: 'Font Awesome 6 Free';
            font-weight: 300;
            font-weight: 900;
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 11px;
            opacity: 0.35;
            transition: opacity 0.15s ease;
        }
        th[data-sort-key]:hover::after {
            opacity: 0.6;
        }
        th[data-sort-key].sort-asc::after {
            content: '\f0de';
            opacity: 1;
        }
        th[data-sort-key].sort-desc::after {
            content: '\f0dd';
            opacity: 1;
        }
        th[data-sort-key].sort-asc,
        th[data-sort-key].sort-desc {
            background: var(--theme-primary) !important;
        }
    </style>
    
    {% block stylesheets %}
        {{ importmap('app') }}
    {% endblock %}

</head>

<body id="page-top" class="js-loading">
    {% set fallbackPalette = {
        'primary':'#475569',
        'secondary':'#334155',
        'accent':'#94a3b8',
        'text':'#0f172a',
        'bg':'#f8fafc'
    } %}
    {% set currentDossierTheme = app.user and app.user.currentDossier ? app.user.currentDossier.theme : null %}
    {% set palette = {
        'primary': currentDossierTheme and currentDossierTheme.primaryColor ? currentDossierTheme.primaryColor : fallbackPalette.primary,
        'secondary': currentDossierTheme and currentDossierTheme.secondaryColor ? currentDossierTheme.secondaryColor : fallbackPalette.secondary,
        'accent': currentDossierTheme and currentDossierTheme.accentColor ? currentDossierTheme.accentColor : fallbackPalette.accent,
        'text': currentDossierTheme and currentDossierTheme.textColor ? currentDossierTheme.textColor : fallbackPalette.text,
        'bg': currentDossierTheme and currentDossierTheme.backgroundColor ? currentDossierTheme.backgroundColor : fallbackPalette.bg
    } %}
    <style>
