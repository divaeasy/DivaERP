            var faUtilityClasses = new Set([
                'fa-sm', 'fa-lg', 'fa-xl', 'fa-xs', 'fa-1x', 'fa-2x', 'fa-3x', 'fa-4x', 'fa-5x',
                'fa-fw', 'fa-spin', 'fa-pulse', 'fa-rotate-90', 'fa-rotate-180', 'fa-rotate-270',
                'fa-flip-horizontal', 'fa-flip-vertical', 'fa-flip-both'
            ]);

            var convertFaIconNodesToLucide = function(scope) {
                var root = scope && scope.querySelectorAll ? scope : document;
                var iconNodes = root.querySelectorAll('i[class*="fa"], i[class~="fa"], i[class~="fas"], i[class~="far"], i[class~="fab"], i[class~="fal"]');

                iconNodes.forEach(function(iconNode) {
                    if (!iconNode || iconNode.hasAttribute('data-lucide')) {
                        return;
                    }

                    var classList = Array.prototype.slice.call(iconNode.classList || []);
                    if (!classList.length) {
                        return;
                    }

                    var faIconClass = '';
                    for (var i = 0; i < classList.length; i += 1) {
                        var cls = classList[i];
                        if (cls.indexOf('fa-') === 0 && !faUtilityClasses.has(cls)) {
                            faIconClass = cls;
                            break;
                        }
                    }

                    if (!faIconClass) {
                        return;
                    }

                    var lucideIconName = faToLucideMap[faIconClass] || 'circle';
                    var cleanedClassList = classList.filter(function(cls) {
                        var isFaFamilyClass = cls === 'fa' || cls === 'fas' || cls === 'far' || cls === 'fal' || cls === 'fab' || cls === 'fad';
                        return !isFaFamilyClass && cls !== faIconClass;
                    });

                    iconNode.setAttribute('class', cleanedClassList.join(' ').trim());
                    iconNode.setAttribute('data-lucide', lucideIconName);
                });
            };

            window.renderProjectOutlineIcons = function(scope) {
                convertFaIconNodesToLucide(scope || document);

                if (!window.lucide || typeof window.lucide.createIcons !== 'function') {
                    return;
                }

                window.lucide.createIcons({
                    attrs: {
                        'stroke-width': '1.8'
                    }
                });
            };

            window.renderProjectOutlineIcons(document);

            if (!window.__outlineIconsObserverBound && window.MutationObserver) {
                window.__outlineIconsObserverBound = true;

                var iconRenderPending = false;
                var scheduleIconRender = function() {
                    if (iconRenderPending) {
                        return;
                    }

                    iconRenderPending = true;
                    window.requestAnimationFrame(function() {
                        iconRenderPending = false;
                        window.renderProjectOutlineIcons(document);
                    });
                };

                var iconObserver = new MutationObserver(function(mutations) {
                    for (var m = 0; m < mutations.length; m += 1) {
                        var mutation = mutations[m];
                        if (!mutation.addedNodes || !mutation.addedNodes.length) {
                            continue;
                        }

                        for (var n = 0; n < mutation.addedNodes.length; n += 1) {
                            var addedNode = mutation.addedNodes[n];
                            if (!addedNode || addedNode.nodeType !== 1) {
                                continue;
                            }

                            var isIconNode = addedNode.matches && (
                                addedNode.matches('i[class*="fa"]') ||
                                addedNode.matches('i[data-lucide]')
                            );
                            var hasIconChildren = addedNode.querySelector && (
                                addedNode.querySelector('i[class*="fa"]') ||
                                addedNode.querySelector('i[data-lucide]')
                            );

                            if (isIconNode || hasIconChildren) {
                                scheduleIconRender();
                                return;
                            }
                        }
                    }
                });

                if (document.body) {
                    iconObserver.observe(document.body, { childList: true, subtree: true });
                }
            }
            
            var $sidebarProfileToggle = $('#sidebarUserDropdown');
            var $sidebarProfileMenu = $sidebarProfileToggle.siblings('.dropdown-menu');

            var positionSidebarProfileMenu = function() {
                if (!$sidebarProfileToggle.length || !$sidebarProfileMenu.length || !$sidebarProfileMenu.hasClass('show')) {
                    return;
                }

                if ($('body').hasClass('sidebar-expanded') && !$('#accordionSidebar').hasClass('double-sidebar')) {
                    $sidebarProfileMenu.css({ left: '', top: '', right: '', bottom: '' });
                    return;
                }

                var toggleRect = $sidebarProfileToggle[0].getBoundingClientRect();
                var menuElement = $sidebarProfileMenu[0];
                var previousVisibility = menuElement.style.visibility;

                menuElement.style.visibility = 'hidden';
                var menuWidth = menuElement.offsetWidth || 214;
                var menuHeight = menuElement.offsetHeight || 180;

                var gap = 12;
                var viewportPadding = 8;
                var left = toggleRect.right + gap;
                var top = toggleRect.bottom - menuHeight;

                if ((left + menuWidth) > (window.innerWidth - viewportPadding)) {
                    left = Math.max(viewportPadding, toggleRect.left - menuWidth - gap);
                }
                if (top < viewportPadding) {
                    top = viewportPadding;
                }
                if ((top + menuHeight) > (window.innerHeight - viewportPadding)) {
                    top = Math.max(viewportPadding, window.innerHeight - menuHeight - viewportPadding);
                }

                $sidebarProfileMenu.css({
                    left: Math.round(left) + 'px',
                    top: Math.round(top) + 'px',
                    right: 'auto',
                    bottom: 'auto'
                });

                menuElement.style.visibility = previousVisibility;
            };

            // Handle sidebar profile dropdown explicitly
            $sidebarProfileToggle.off('click.dropdown').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                var $dropdownMenu = $(this).siblings('.dropdown-menu');
                var isOpen = $dropdownMenu.hasClass('show');
                
                // Close all other open dropdowns
                $('.dropdown-menu.show').removeClass('show');
                $('.dropdown-toggle').attr('aria-expanded', 'false');
                
                // Toggle this dropdown
                if (!isOpen) {
                    $dropdownMenu.addClass('show');
                    $(this).attr('aria-expanded', 'true');
                    positionSidebarProfileMenu();
                }
            });

            $(window).on('resize.sidebarProfileDropdown', function() {
                positionSidebarProfileMenu();
            });

            // ===== SIDEBAR COLLAPSE/EXPAND =====
            var $body = $('body');
            var $sidebar = $('#accordionSidebar');
            var $sidebarCollapseToggle = $('#sidebarCollapseToggle');
            var sidebarStateStorageKey = 'diva_erp.sidebar.expanded';

            var setSidebarExpanded = function(expanded, persistState) {
                $body.toggleClass('sidebar-expanded', expanded);
                $sidebar.attr('data-sidebar-state', expanded ? 'expanded' : 'collapsed');
                $sidebarCollapseToggle.attr('aria-expanded', expanded ? 'true' : 'false');
                $sidebarCollapseToggle.attr('aria-label', expanded ? 'Fermer la barre latérale' : 'Ouvrir la barre latérale');
                $sidebarCollapseToggle.attr('title', expanded ? 'Fermer la barre latérale' : 'Ouvrir la barre latérale');

                var hoverCardElement = document.getElementById('sidebarHoverCard');
                if (hoverCardElement) {
                    hoverCardElement.classList.remove('show');
                }
                if ($sidebarProfileToggle.length) {
                    $sidebarProfileToggle.attr('aria-expanded', 'false');
                    $sidebarProfileMenu.removeClass('show').css({ left: '', top: '', right: '', bottom: '' });
                }

                if (persistState !== false) {
                    try {
                        window.localStorage.setItem(sidebarStateStorageKey, expanded ? '1' : '0');
                    } catch (storageError) {
                        // Ignore storage failures (private mode / restricted browser settings).
                    }
                }
            };

            if ($sidebar.length && $sidebarCollapseToggle.length) {
                var syncSidebarState = function() {
                    var isMobileViewport = window.matchMedia('(max-width: 768px)').matches;
                    setSidebarExpanded(!isMobileViewport, false);
                };

                syncSidebarState();
                $(window).on('resize.sidebarState', syncSidebarState);
            }

            var $sidebarPanelToggles = $('.sidebar-panel-toggle');
            var $sidebarPanelContents = $('.sidebar-panel-content');
            var sidebarPanelStorageKey = 'diva_erp.sidebar.panel';

            var setSidebarPanel = function(panelId, persistState) {
                if (!panelId) {
                    return;
                }

                var $targetToggle = $sidebarPanelToggles.filter('[data-sidebar-panel="' + panelId + '"]').first();
                var $targetPanel = $sidebarPanelContents.filter('[data-sidebar-panel="' + panelId + '"]').first();

                if (!$targetToggle.length || !$targetPanel.length || $targetToggle.hasClass('nav-disabled')) {
                    return;
                }

                $sidebarPanelToggles.removeClass('active').attr('aria-pressed', 'false');
                $sidebarPanelContents.removeClass('is-active');

                $targetToggle.addClass('active').attr('aria-pressed', 'true');
                $targetPanel.addClass('is-active');

                if (persistState !== false) {
                    try {
                        window.localStorage.setItem(sidebarPanelStorageKey, panelId);
                    } catch (storageError) {
                        // Ignore storage failures.
                    }
                }
            };

            if ($sidebarPanelToggles.length && $sidebarPanelContents.length) {
                var routePanel = String($sidebar.data('initial-panel') || '').trim();
                var storedPanel = '';

                try {
                    storedPanel = String(window.localStorage.getItem(sidebarPanelStorageKey) || '').trim();
                } catch (storageReadError) {
                    storedPanel = '';
                }

                var preferredPanel = routePanel || storedPanel;
                var hasPreferredPanel = preferredPanel !== '' && $sidebarPanelToggles.filter('[data-sidebar-panel="' + preferredPanel + '"]:not(.nav-disabled)').length > 0;

                if (!hasPreferredPanel) {
                    preferredPanel = String($sidebarPanelToggles.not('.nav-disabled').first().data('sidebarPanel') || '').trim();
                }

                setSidebarPanel(preferredPanel, false);

                $sidebarPanelToggles.on('click', function(e) {
                    e.preventDefault();

                    var $toggle = $(this);
                    if ($toggle.hasClass('nav-disabled')) {
                        return;
                    }

                    setSidebarPanel(String($toggle.data('sidebarPanel') || '').trim(), true);
                });
            }
            
            // Close dropdown when clicking outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('.dropdown').length) {
                    $('.dropdown-menu.show').removeClass('show');
                    $('.dropdown-toggle').attr('aria-expanded', 'false');
                    $sidebarProfileMenu.css({ left: '', top: '', right: '', bottom: '' });
                }
            });

            // Keep modal backdrop deterministic across Turbo navigation.
            if (!window.__modalBackdropHooksBound) {
                window.__modalBackdropHooksBound = true;

                window.syncSingleModalBackdrop = function(forceClean) {
                    var $openModals = $('.modal.show');
                    var $backdrops = $('body > .modal-backdrop');

                    // If no modal is open, any backdrop is stale and must be removed.
                    if ($openModals.length === 0) {
                        if (!forceClean) {
                            return;
                        }
                        $backdrops.remove();
                        $('body').removeClass('modal-open').css('padding-right', '');
                        return;
                    }

                    if ($backdrops.length > 1) {
                        $backdrops.slice(0, -1).remove();
                    }
                };

                window.clearModalBackdropState = function() {
                    $('.modal-backdrop').remove();
                    $('body').removeClass('modal-open').css('padding-right', '');
                };

                // Clean stale backdrops before opening a modal.
                $(document).on('show.bs.modal.modalBackdropFix', '.modal', function() {
                    if ($('.modal.show').not(this).length === 0) {
                        clearModalBackdropState();
                    }
                });

                // Cleanup when all modals are closed.
                $(document).on('hidden.bs.modal.modalBackdropFix', '.modal', function() {
                    if ($('.modal.show').length === 0) {
                        clearModalBackdropState();
                    } else {
                        syncSingleModalBackdrop(false);
                    }
                });

                // After modal open transition, keep exactly one backdrop.
                $(document).on('shown.bs.modal.modalBackdropFix', '.modal', function() {
                    syncSingleModalBackdrop(false);
                });

                // Open logout modal with controlled backdrop lifecycle (prevents stacked backdrops).
                $(document).on('click.logoutModalTrigger', '.js-open-logout-modal', function(event) {
                    event.preventDefault();
                    event.stopPropagation();

                    // Close profile dropdown before opening modal.
                    $('.dropdown-menu.show').removeClass('show');
                    $('.dropdown-toggle').attr('aria-expanded', 'false');

