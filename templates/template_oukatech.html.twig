                toast.on('mouseenter', function() {
                    clearTimeout(timer);
                    toast.find('.toast-progress-bar').css('animation-play-state', 'paused');
                });
                toast.on('mouseleave', function() {
                    var remaining = toast.find('.toast-progress-bar')[0];
                    var computedStyle = window.getComputedStyle(remaining);
                    var transform = computedStyle.getPropertyValue('transform');
                    // Restart timer with remaining visual time
                    toast.find('.toast-progress-bar').css('animation-play-state', 'running');
                    timer = setTimeout(function() {
                        dismissToast(toast);
                    }, 2000);
