                    storedPanel = '';
                }

                var preferredPanel = routePanel || storedPanel;
                var hasPreferredPanel = preferredPanel !== '' && $sidebarPanelToggles.filter('[data-sidebar-panel="' + preferredPanel + '"]:not(.nav-disabled)').length > 0;

                if (!hasPreferredPanel) {
                    preferredPanel = String($sidebarPanelToggles.not('.nav-disabled').first().data('sidebarPanel') || '').trim();
                }

                var storedSubnavState = getStoredSubnavState();
                var shouldStartCollapsed = false;

                if (routePanel !== '') {
                    shouldStartCollapsed = false;
                } else if (routeSubnavState === 'collapsed') {
                    shouldStartCollapsed = true;
                } else if (storedSubnavState !== null) {
                    shouldStartCollapsed = storedSubnavState;
                }

                if (shouldStartCollapsed || preferredPanel === '') {
                    setSidebarSubnavCollapsed(true, false);
