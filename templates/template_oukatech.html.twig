                        var shouldSync = false;
                        for (var i = 0; i < mutations.length; i++) {
                            var mutation = mutations[i];
                            if (mutation.type !== 'childList') {
                                continue;
                            }
                            var added = mutation.addedNodes;
                            var removed = mutation.removedNodes;
                            for (var a = 0; a < added.length; a++) {
                                if (added[a].nodeType === 1 && added[a].classList && added[a].classList.contains('modal-backdrop')) {
                                    shouldSync = true;
                                    break;
                                }
                            }
                            if (!shouldSync) {
                                for (var r = 0; r < removed.length; r++) {
                                    if (removed[r].nodeType === 1 && removed[r].classList && removed[r].classList.contains('modal-backdrop')) {
                                        shouldSync = true;
                                        break;
                                    }
                                }
                            }
                            if (shouldSync) {
                                break;
                            }
                        }

                        if (shouldSync) {
                            queueBackdropSync();
                        }
                    });

                    backdropObserver.observe(document.body, { childList: true });
                }

                // Initial pass on first load.
                syncSingleModalBackdrop(true);
            }

            // Loading Spinner Functions
            var loadingShownAt = 0;
            var loadingMinVisibleMs = 800;
            var loadingHideTimer = null;

            window.showLoading = function() {
                if (loadingHideTimer) {
                    window.clearTimeout(loadingHideTimer);
                    loadingHideTimer = null;
                }
                loadingShownAt = Date.now();
                $('#loadingOverlay').addClass('active');
            };
            window.hideLoading = function(force) {
                var hideNow = function() {
                    $('#loadingOverlay').removeClass('active');
                    loadingHideTimer = null;
                };

                if (force === true) {
                    hideNow();
                    return;
                }

                if (!loadingShownAt) {
                    hideNow();
                    return;
                }

                var elapsed = Date.now() - loadingShownAt;
                var remaining = Math.max(loadingMinVisibleMs - elapsed, 0);
                if (remaining <= 0) {
                    hideNow();
                    return;
                }

                if (loadingHideTimer) {
                    window.clearTimeout(loadingHideTimer);
                }
                loadingHideTimer = window.setTimeout(hideNow, remaining);
            };

            // ===== SHOW LOADING ON ALL NAVIGATION =====
            // Intercept all link clicks (except those with data-toggle, hash links, external links, and export links)
            $(document).on('click', 'a', function(e) {
                var $link = $(this);
                var href = $link.attr('href');
                
                // Skip if: no href, hash link, external link, data-toggle (dropdowns/modals), or delete button
                if (!href || 
                    href === '#' || 
                    href.startsWith('#') || 
                    href.startsWith('javascript:') ||
                    href.startsWith('mailto:') ||
                    href.startsWith('tel:') ||
                    $link.attr('data-toggle') ||
                    $link.attr('target') === '_blank' ||
                    $link.hasClass('delete-btn') ||
                    $link.attr('download') !== undefined ||
                    $link.hasClass('einv-download-card') ||
                    $link.hasClass('no-loading') ||
                    $link.hasClass('convert-prospect-btn') ||
                    href.match(/download[-_]?(pdf|xml|file)/i) ||
                    href.match(/\/export[\.\/]/i) ||
                    $link.closest('.modal').length) {
                    return; // Let the default behavior happen
                }
                
                // Close all open modals and remove backdrops before navigation.
                $('.modal.show').each(function() {
                    $(this).modal('hide');
                });
                if (typeof clearModalBackdropState === 'function') {
                    clearModalBackdropState();
                } else {
                    $('.modal-backdrop').remove();
                    $('body').removeClass('modal-open').css('padding-right', '');
                }
                
                // Show loading spinner
                showLoading();
            });

            // Show loading on form submit
            $('form').on('submit', function() {
                var form = $(this);

                // Allow AJAX/local handlers to opt-out from global navigation loader.
                if (form.hasClass('no-loading') || form.is('[data-no-loading]')) {
                    return;
                }

                if (form[0].checkValidity() !== false) {
                    showLoading();
                }
            });

            // Show loading on delete confirmation
            $('.btn-confirm-delete').on('click', function() {
                showLoading();
            });

            // Show loading on explicit browser refresh shortcuts (F5, Ctrl/Cmd+R)
            $(document).on('keydown', function(event) {
                var key = String(event.key || '').toLowerCase();
                var isRefreshShortcut = key === 'f5' || ((event.ctrlKey || event.metaKey) && key === 'r');
                if (isRefreshShortcut) {
                    showLoading();
                }
            });

            // Show loading when the page is unloading (refresh/navigation/back)
            $(window).on('beforeunload', function() {
                showLoading();
            });

            // Show loading when navigating with browser back/forward controls
            if (!window.__loadingOverlayHistoryHookBound) {
                window.__loadingOverlayHistoryHookBound = true;
                window.addEventListener('popstate', function() {
                    showLoading();
                });
            }

            // Hide loading when page fully loads (for browser back button)
            $(window).on('pageshow', function(event) {
                var nativeEvent = event.originalEvent || event;
                if (isHistoryRestoreNavigation(nativeEvent)) {
                    showLoading();
                }

                finalizePageLoadedState();
            });

            // Turbo can render without triggering pageshow, so make sure overlay is always reset.
            if (!window.__loadingOverlayTurboHooksBound) {
                window.__loadingOverlayTurboHooksBound = true;

                document.addEventListener('turbo:before-visit', function() {
                    showLoading();
                });

                document.addEventListener('turbo:visit', function() {
                    showLoading();
                });

                document.addEventListener('turbo:before-render', function() {
                    showLoading();
                });

                document.addEventListener('turbo:load', function() {
                    hideLoading();
                });

                document.addEventListener('turbo:render', function() {
                    if (document.documentElement.hasAttribute('data-turbo-preview')) {
                        showLoading();
                        return;
                    }
                    hideLoading();
                });

                document.addEventListener('turbo:before-cache', function() {
                    hideLoading();
                });

                document.addEventListener('turbo:fetch-request-error', function() {
                    hideLoading();
                });

                document.addEventListener('turbo:submit-end', function(event) {
                    if (!event.detail || event.detail.success === false) {
                        hideLoading();
                    }
                });
            }

            // ===== FORM VALIDATION =====
            $('form').each(function() {
                var form = $(this);
                
                // Mark required fields labels
                form.find('input[required], select[required], textarea[required]').each(function() {
                    var label = $(this).closest('.form-group').find('label').first();
                    if (label.length && !label.hasClass('required')) {
                        label.addClass('required');
                    }
                    // Also check for parent row with label
                    var parentLabel = $(this).parents('.form-group, .col').find('label').first();
                    if (parentLabel.length && !parentLabel.hasClass('required')) {
                        parentLabel.addClass('required');
                    }
                });

                // Real-time validation
                form.find('input, select, textarea').on('blur change', function() {
                    validateField($(this));
                });

                // Form submit validation
                form.on('submit', function(e) {
                    var isValid = true;
                    form.find('input[required], select[required], textarea[required]').each(function() {
                        if (!validateField($(this))) {
                            isValid = false;
                        }
                    });
                    
                    if (!isValid) {
                        e.preventDefault();
                        hideLoading();
                        // Scroll to first error
                        var firstError = form.find('.is-invalid').first();
                        if (firstError.length) {
                            $('html, body').animate({
                                scrollTop: firstError.offset().top - 100
                            }, 300);
                        }
                    }
                });
            });

            function validateField(field) {
                var isValid = true;
                var value = field.val();
                var feedbackDiv = field.siblings('.invalid-feedback');
                
                // Create feedback div if doesn't exist
                if (!feedbackDiv.length) {
                    feedbackDiv = $('<div class="invalid-feedback"></div>');
                    field.after(feedbackDiv);
                }

                // Check if required
                if (field.prop('required') && (!value || value.trim() === '')) {
                    field.addClass('is-invalid').removeClass('is-valid');
                    feedbackDiv.text('Ce champ est obligatoire');
                    isValid = false;
                }
                // Check email format
                else if (field.attr('type') === 'email' && value) {
                    var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                    if (!emailRegex.test(value)) {
                        field.addClass('is-invalid').removeClass('is-valid');
                        feedbackDiv.text('Veuillez entrer une adresse email valide');
                        isValid = false;
                    } else {
                        field.addClass('is-valid').removeClass('is-invalid');
                    }
                }
                // Check number
                else if (field.attr('type') === 'number' && value) {
                    if (isNaN(value)) {
                        field.addClass('is-invalid').removeClass('is-valid');
                        feedbackDiv.text('Veuillez entrer un nombre valide');
                        isValid = false;
                    } else {
                        field.addClass('is-valid').removeClass('is-invalid');
                    }
                }
                else if (value && value.trim() !== '') {
                    field.addClass('is-valid').removeClass('is-invalid');
                }
                else {
                    field.removeClass('is-invalid is-valid');
                }

                return isValid;
            }

            // Delete confirmation modal handler
            $('.delete-btn').on('click', function(e) {
                e.preventDefault();
                var deleteUrl = $(this).data('delete-url');
                var itemName = $(this).data('item-name') || 'cet élèment';
                
                $('#deleteModalItemName').text(itemName);
                $('#confirmDeleteBtn').attr('href', deleteUrl);
                $('#deleteConfirmModal').modal('show');
            });

            // Keep backdrop visible until delete modal fully closes, then navigate.
            $(document).on('click', '#confirmDeleteBtn', function(e) {
                e.preventDefault();

                var deleteUrl = $(this).attr('href');
                if (!deleteUrl || deleteUrl === '#') {
                    return;
                }

                var navigateToDelete = function() {
                    showLoading();
                    window.location.href = deleteUrl;
                };

                var $deleteModal = $('#deleteConfirmModal');
                if ($deleteModal.length && $deleteModal.hasClass('show')) {
                    $deleteModal.one('hidden.bs.modal.deleteNavigate', function() {
                        navigateToDelete();
                    });
                    $deleteModal.modal('hide');
                    return;
                }

                navigateToDelete();
            });

            // ===== TOAST NOTIFICATIONS =====
            function getOrCreateToastContainer() {
                var container = $('.toast-container').first();
                if (container.length) {
                    return container;
                }

                var host = $('.container-fluid.py-3').first();
                if (!host.length) {
                    host = $('body');
                }

                container = $('<div class="toast-container"></div>');
                host.prepend(container);
                return container;
            }

            function dismissToast(toast) {
                if (!toast || !toast.length || toast.data('toastDismissing') === 1) {
                    return;
                }
                toast.data('toastDismissing', 1);
                toast.addClass('toast-hiding');
                setTimeout(function() {
                    toast.remove();
                    if ($('.toast-container').children().length === 0) {
                        $('.toast-container').remove();
                    }
                }, 300);
            }

            function bindToastLifecycle(toast) {
                if (!toast || !toast.length) {
                    return;
                }

                if (toast.data('toastBound') === 1) {
                    return;
                }

                toast.data('toastBound', 1);

                var timer = setTimeout(function() {
                    dismissToast(toast);
                }, 5000);
                // Failsafe: always dismiss eventually, even if hover paused the main timer.
                var hardTimer = setTimeout(function() {
                    dismissToast(toast);
                }, 9000);

                toast.on('mouseenter', function() {
                    clearTimeout(timer);
                    toast.find('.toast-progress-bar').css('animation-play-state', 'paused');
                });

                toast.on('mouseleave', function() {
                    toast.find('.toast-progress-bar').css('animation-play-state', 'running');
                    timer = setTimeout(function() {
                        dismissToast(toast);
                    }, 2000);
                });

                toast.find('.toast-close').on('click', function() {
                    clearTimeout(timer);
                    clearTimeout(hardTimer);
                    dismissToast(toast);
                });
            }

            window.showAppToast = function(configOrMessage, typeArg) {
                var config = (typeof configOrMessage === 'object' && configOrMessage !== null)
                    ? configOrMessage
                    : { message: configOrMessage, type: typeArg };

                var message = String((config && config.message) ? config.message : '').trim();
                if (!message) {
                    return;
                }

                var normalizedType = String((config && config.type) ? config.type : 'info').toLowerCase();
                if (['success', 'error', 'info'].indexOf(normalizedType) === -1) {
                    normalizedType = 'info';
                }

                var variant = {
                    success: { css: 'toast-success', icon: 'fas fa-check-circle', title: 'Succes' },
                    error: { css: 'toast-error', icon: 'fas fa-exclamation-circle', title: 'Erreur' },
                    info: { css: 'toast-info', icon: 'fas fa-info-circle', title: 'Information' }
                }[normalizedType];

                var title = String((config && config.title) ? config.title : variant.title);

                var toast = $('<div/>', { 'class': 'toast-notification ' + variant.css, role: 'alert' });
                toast.append(
                    $('<div/>', { 'class': 'toast-icon' }).append($('<i/>', { 'class': variant.icon }))
                );
                toast.append(
                    $('<div/>', { 'class': 'toast-content' })
                        .append($('<div/>', { 'class': 'toast-title', text: title }))
                        .append($('<div/>', { 'class': 'toast-message', text: message }))
                );
                toast.append($('<button/>', { type: 'button', 'class': 'toast-close', 'aria-label': 'Fermer', text: '×' }));
                toast.append(
                    $('<div/>', { 'class': 'toast-progress' }).append($('<div/>', { 'class': 'toast-progress-bar' }))
                );

                var container = getOrCreateToastContainer();
                container.append(toast);
                bindToastLifecycle(toast);
            };

            $('.toast-notification').each(function() {
                bindToastLifecycle($(this));
            });

            // Auto-close toasts on page navigation
            $(window).on('beforeunload', function() {
                $('.toast-container').hide();
            });

            // ===== INITIALIZE SELECT2 WITH IMPROVED STYLING =====
            if ($.fn.select2) {
                $('.js-example-basic-single').each(function() {
                    var $select = $(this);
                    var currentValue = $select.val();
                    var hasSelection = false;

                    if ($select.prop('multiple')) {
                        hasSelection = Array.isArray(currentValue) ? currentValue.length > 0 : String(currentValue || '').trim() !== '';
                    } else {
                        hasSelection = currentValue !== null && String(currentValue).trim() !== '';
                    }

                    var placeholderText = String(
                        $select.attr('placeholder') ||
                        $select.data('placeholder') ||
                        'Selectionner une option'
                    ).trim();

                    if (placeholderText === '') {
                        placeholderText = 'Selectionner une option';
                    }

                    if (!hasSelection) {
                        $select.attr('data-placeholder', placeholderText);
                    }

                    if (!hasSelection && $select.is('select') && !$select.prop('multiple')) {
                        if ($select.find('option[value=\"\"]').length === 0) {
                            $select.prepend($('<option></option>').attr('value', ''));
                        }
                        $select.val('');
                    }

                    if (!$select.hasClass('select2-hidden-accessible')) {
                        var select2Options = {
                            theme: 'bootstrap-5',
                            allowClear: true,
                            width: '100%'
                        };

                        if (!hasSelection) {
                            select2Options.placeholder = placeholderText;
                        }

                        $select.select2(select2Options);
                    }
                });
            }

            // ===== NAVIGATION SEARCH FUNCTIONALITY =====
            var navItems = [
                { name: 'Dashboard', url: '{{ path('app_dash_bord') }}', icon: 'fas fa-tachometer-alt' },
                { name: 'Clients - Liste', url: '{{ path('client.list') }}', icon: 'fas fa-users' },
                { name: 'Clients - Nouveau', url: '{{ path('client.edit') }}', icon: 'fas fa-user-plus' },
                { name: 'Prospects - Liste', url: '{{ path('prospect.list') }}', icon: 'fas fa-user-plus' },
                { name: 'Prospects - Nouveau', url: '{{ path('prospect.edit') }}', icon: 'fas fa-user-plus' },
                { name: 'Articles - Liste', url: '{{ path('article.list') }}', icon: 'fas fa-boxes' },
                { name: 'Articles - Nouveau', url: '{{ path('article.edit') }}', icon: 'fas fa-box' },
                { name: 'Pièces - Liste', url: '{{ path('entetepiece.list') }}', icon: 'fas fa-file-invoice' },
                { name: 'Pièces - Nouvelle', url: '{{ path('entetepiece.edit') }}', icon: 'fas fa-file-invoice' },
                { name: 'Règlements - Liste', url: '{{ path('reglement.list') }}', icon: 'fas fa-money-bill-wave' },
                { name: 'Règlements - Nouveau', url: '{{ path('reglement.edit') }}', icon: 'fas fa-money-bill-wave' },
                { name: 'Dossiers - Liste', url: '{{ path('dossier.list') }}', icon: 'fas fa-folder-open' },
                { name: 'Dossiers - Nouveau', url: '{{ path('dossier.edit') }}', icon: 'fas fa-folder-plus' },
                { name: 'Devises - Liste', url: '{{ path('devise.list') }}', icon: 'fas fa-euro-sign' },
                { name: 'Devises - Nouvelle', url: '{{ path('devise.edit') }}', icon: 'fas fa-euro-sign' },
                { name: 'Tarifs - Liste', url: '{{ path('tarif.list') }}', icon: 'fas fa-tags' },
                { name: 'Tarifs - Nouveau', url: '{{ path('tarif.edit') }}', icon: 'fas fa-tag' },
                { name: 'Tarifs Vente - Liste', url: '{{ path('tarifvente.list') }}', icon: 'fas fa-tags' },
                { name: 'Tarifs Vente - Nouveau', url: '{{ path('tarifvente.edit') }}', icon: 'fas fa-tag' },
                { name: 'Unités - Liste', url: '{{ path('unite.list') }}', icon: 'fas fa-balance-scale' },
                { name: 'Unités - Nouvelle', url: '{{ path('unite.edit') }}', icon: 'fas fa-balance-scale' },
                { name: 'Pays - Liste', url: '{{ path('pays.list') }}', icon: 'fas fa-globe' },
                { name: 'Pays - Nouveau', url: '{{ path('pays.edit') }}', icon: 'fas fa-globe' },
                { name: 'Villes - Liste', url: '{{ path('ville.list') }}', icon: 'fas fa-city' },
                { name: 'Villes - Nouvelle', url: '{{ path('ville.edit') }}', icon: 'fas fa-city' },
                { name: 'Mon Profil', url: '{{ path('app_profile') }}', icon: 'fas fa-user' },
                { name: 'Paramètres Profil', url: '{{ path('app_profile_edit') }}', icon: 'fas fa-cog' }
            ];

            var $navSearchInput = $('#navSearchInput');
            var $navSearchResults = $('#navSearchResults');

            $navSearchInput.on('input', function() {
                var query = $(this).val().toLowerCase().trim();
                $navSearchResults.empty();

                if (query.length < 1) {
                    $navSearchResults.hide();
                    return;
                }

                var matches = navItems.filter(function(item) {
                    return item.name.toLowerCase().includes(query);
                }).slice(0, 8); // Limit to 8 results

                if (matches.length > 0) {
                    matches.forEach(function(item) {
                        $navSearchResults.append(
                            '<a class="dropdown-item" href="' + item.url + '">' +
                            '<i class="' + item.icon + ' fa-fw mr-2 text-gray-400"></i>' + 
                            item.name + '</a>'
                        );
                    });
                    $navSearchResults.show();
                } else {
                    $navSearchResults.append(
                        '<span class="dropdown-item text-muted">Aucun résultat trouvé</span>'
                    );
                    $navSearchResults.show();
                }
            });

            $navSearchInput.on('focus', function() {
                if ($(this).val().trim().length > 0) {
                    $navSearchInput.trigger('input');
                }
            });

            $(document).on('click', function(e) {
                if (!$(e.target).closest('.navbar-search').length) {
                    $navSearchResults.hide();
                }
            });

            // ===== SIDEBAR HOVER CARDS (rendered above content, no sidebar overflow) =====
            if (!window.__sidebarHoverCardBound) {
                window.__sidebarHoverCardBound = true;

                var hoverCard = document.getElementById('sidebarHoverCard');
                var activeSidebarLink = null;

                var isCompactViewport = function() {
                    return window.matchMedia('(max-width: 768px)').matches;
                };
                var isSidebarExpanded = function() {
                    return document.body.classList.contains('sidebar-expanded');
                };

                var ensureHoverCard = function() {
                    if (hoverCard && hoverCard.isConnected) {
                        return hoverCard;
                    }

                    hoverCard = document.getElementById('sidebarHoverCard');
                    if (!hoverCard) {
                        hoverCard = document.createElement('div');
                        hoverCard.id = 'sidebarHoverCard';
                        hoverCard.className = 'sidebar-hover-card';
                        document.body.appendChild(hoverCard);
                    }

                    return hoverCard;
                };

                var placeHoverCard = function(link) {
                    var sidebar = document.getElementById('accordionSidebar');
                    var card = ensureHoverCard();
                    if (!sidebar || !link || !card) {
                        return;
                    }

                    var linkRect = link.getBoundingClientRect();
                    var sidebarRect = sidebar.getBoundingClientRect();
                    var label = link.getAttribute('data-nav-label') || link.getAttribute('aria-label') || '';
                    card.textContent = label;
                    card.style.left = Math.round(sidebarRect.right + 12) + 'px';
                    card.style.top = Math.round(linkRect.top + (linkRect.height / 2)) + 'px';
                };

                var showHoverCard = function(link) {
                    if (!link || link.classList.contains('nav-disabled') || isCompactViewport() || isSidebarExpanded()) {
                        hideHoverCard();
                        return;
                    }

                    var card = ensureHoverCard();
                    if (!card) {
                        return;
                    }

                    activeSidebarLink = link;
                    placeHoverCard(link);
                    card.classList.add('show');
                };

                var hideHoverCard = function() {
                    activeSidebarLink = null;
                    var card = ensureHoverCard();
                    if (card) {
                        card.classList.remove('show');
                    }
                };

                document.addEventListener('mouseover', function(event) {
                    var link = event.target.closest ? event.target.closest('.sidebar-icon-link, .sidebar-panel-toggle') : null;
                    if (!link) {
                        return;
                    }

                    var fromElement = event.relatedTarget;
                    if (fromElement && link.contains(fromElement)) {
                        return;
                    }

                    showHoverCard(link);
                }, true);

                document.addEventListener('mouseout', function(event) {
                    var link = event.target.closest ? event.target.closest('.sidebar-icon-link, .sidebar-panel-toggle') : null;
                    if (!link) {
                        return;
                    }

                    var toElement = event.relatedTarget;
                    if (toElement && link.contains(toElement)) {
                        return;
                    }

                    hideHoverCard();
                }, true);

                document.addEventListener('focusin', function(event) {
                    var link = event.target.closest ? event.target.closest('.sidebar-icon-link, .sidebar-panel-toggle') : null;
                    if (link) {
                        showHoverCard(link);
                    }
                });

                document.addEventListener('focusout', function(event) {
                    var link = event.target.closest ? event.target.closest('.sidebar-icon-link, .sidebar-panel-toggle') : null;
                    if (link) {
                        hideHoverCard();
                    }
                });

                var sidebarScrollContainer = document.querySelector('.sidebar-scroll-container');
                if (sidebarScrollContainer) {
                    sidebarScrollContainer.addEventListener('scroll', function() {
                        if (activeSidebarLink) {
                            placeHoverCard(activeSidebarLink);
                        }
                    }, { passive: true });
                }

                window.addEventListener('resize', function() {
                    if (isSidebarExpanded()) {
                        hideHoverCard();
                    } else if (activeSidebarLink) {
                        placeHoverCard(activeSidebarLink);
                    } else {
                        hideHoverCard();
                    }
                });

                document.addEventListener('turbo:before-visit', hideHoverCard);
                document.addEventListener('turbo:before-cache', hideHoverCard);
            }

        });
    </script>

    <!-- Instant client-side table sorting -->
    <script>
    $(document).ready(function() {
        $('th[data-sort-key]').on('click', function() {
            var $th = $(this);
            var colIndex = $th.index();
            var $table = $th.closest('table');
            var $tbody = $table.find('tbody');
            var rows = $tbody.find('tr').get();
            var sortType = $th.data('sort-type') || 'string';

            // Determine direction
            var asc = true;
            if ($th.hasClass('sort-asc')) {
                asc = false;
            }

            // Clear all sort classes in this table
            $table.find('th[data-sort-key]').removeClass('sort-asc sort-desc');
            $th.addClass(asc ? 'sort-asc' : 'sort-desc');

            // Sort rows
            rows.sort(function(a, b) {
                var cellA = $(a).children('td').eq(colIndex).text().trim();
                var cellB = $(b).children('td').eq(colIndex).text().trim();

                if (sortType === 'number') {
                    var numA = parseFloat(cellA.replace(/[^0-9,.\-]/g, '').replace(',', '.')) || 0;
                    var numB = parseFloat(cellB.replace(/[^0-9,.\-]/g, '').replace(',', '.')) || 0;
                    return asc ? numA - numB : numB - numA;
                }
                if (sortType === 'date') {
                    // Parse dd/mm/yyyy
                    var partsA = cellA.split('/');
                    var partsB = cellB.split('/');
                    var dateA = partsA.length === 3 ? new Date(partsA[2], partsA[1]-1, partsA[0]) : new Date(0);
                    var dateB = partsB.length === 3 ? new Date(partsB[2], partsB[1]-1, partsB[0]) : new Date(0);
                    return asc ? dateA - dateB : dateB - dateA;
                }
                // Default: string (locale-aware)
                return asc ? cellA.localeCompare(cellB, 'fr') : cellB.localeCompare(cellA, 'fr');
            });

            // Re-append sorted rows (no page reload, instant)
            $.each(rows, function(i, row) {
                $tbody.append(row);
            });
        });
    });
    </script>
    
