                window.clearModalBackdropState = function() {
                    $('.modal-backdrop').remove();
                    $('body').removeClass('modal-open').css('padding-right', '');
                };

                // Clean stale backdrops before opening a modal.
                $(document).on('show.bs.modal.modalBackdropFix', '.modal', function() {
                    if ($('.modal.show').not(this).length === 0) {
                        clearModalBackdropState();
                    }
                });

                // Cleanup when all modals are closed.
                $(document).on('hidden.bs.modal.modalBackdropFix', '.modal', function() {
                    if ($('.modal.show').length === 0) {
                        clearModalBackdropState();
                    } else {
                        syncSingleModalBackdrop(false);
