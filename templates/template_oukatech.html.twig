                    clearModalBackdropState();
                });
                document.addEventListener('turbo:load', function() {
                    syncSingleModalBackdrop(true);
                });
                document.addEventListener('turbo:render', function() {
                    syncSingleModalBackdrop(true);
                });

                // Reconcile backdrop mutations immediately (same effect as manual refresh, no refresh needed).
                if (!window.__modalBackdropObserverBound) {
                    window.__modalBackdropObserverBound = true;
                    window.__modalBackdropSyncQueued = false;

                    window.queueBackdropSync = function() {
                        if (window.__modalBackdropSyncQueued) {
                            return;
                        }
                        window.__modalBackdropSyncQueued = true;
                        window.requestAnimationFrame(function() {
                            window.__modalBackdropSyncQueued = false;
                            syncSingleModalBackdrop(false);
                        });
