                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="position: absolute; right: 20px; top: 20px; background: none; border: none; font-size: 28px; color: #b0bfe6; opacity: 0.7; z-index: 10; transition: all 0.2s ease; padding: 0; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;" onmouseover="this.style.opacity='1'; this.style.color='#5a5c69';" onmouseout="this.style.opacity='0.7'; this.style.color='#b0bfe6';">
                    <span aria-hidden="true" style="font-weight: 300; line-height: 1;">&times;</span>
                </button>
                
                <!-- Content Area -->
                <div style="padding: 48px 32px 32px; text-align: center;" class="logout-modal-content">
                    <!-- Icon Circle Badge -->
                    <div style="width: 80px; height: 80px; background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-secondary) 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 28px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);">
                        <i class="fas fa-sign-out-alt" style="font-size: 36px; color: white;"></i>
                    </div>
                    
                    <!-- Heading -->
                    <h3 id="logoutModalLabel" style="margin: 0 0 12px; font-size: 24px; font-weight: 700; color: #0f172a;">
                        Déconnexion
                    </h3>
                    
                    <!-- Subtitle -->
                    <p style="margin: 0 0 24px; font-size: 15px; color: #64748b; line-height: 1.6;">
                        Êtes-vous sûr de vouloir quitter votre compte?
                    </p>
                    
                    <!-- Additional Info -->
                    <div style="background: rgba(0, 0, 0, 0.02); border-left: 3px solid var(--theme-primary); border-radius: 6px; padding: 14px 16px; margin-bottom: 28px; text-align: left;">
                        <p style="margin: 0; font-size: 13px; color: #64748b; line-height: 1.5;">
                            <i class="fas fa-info-circle mr-2" style="color: var(--theme-primary);"></i>
                            Vous serez déconnecté de votre séance et devrez vous réauthentifier pour accéder à vos données.
                        </p>
                    </div>
                    
