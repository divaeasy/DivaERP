            // ===== FORM VALIDATION =====
            $('form').each(function() {
                var form = $(this);
                
                // Mark required fields labels
                form.find('input[required], select[required], textarea[required]').each(function() {
                    var label = $(this).closest('.form-group').find('label').first();
                    if (label.length && !label.hasClass('required')) {
                        label.addClass('required');
                    }
                    // Also check for parent row with label
                    var parentLabel = $(this).parents('.form-group, .col').find('label').first();
                    if (parentLabel.length && !parentLabel.hasClass('required')) {
                        parentLabel.addClass('required');
                    }
                });

                // Real-time validation
                form.find('input, select, textarea').on('blur change', function() {
                    validateField($(this));
                });

                // Form submit validation
                form.on('submit', function(e) {
                    var isValid = true;
                    form.find('input[required], select[required], textarea[required]').each(function() {
                        if (!validateField($(this))) {
                            isValid = false;
                        }
                    });
                    
                    if (!isValid) {
                        e.preventDefault();
                        hideLoading();
                        // Scroll to first error
                        var firstError = form.find('.is-invalid').first();
                        if (firstError.length) {
                            $('html, body').animate({
                                scrollTop: firstError.offset().top - 100
                            }, 300);
                        }
                    }
                });
            });

            function validateField(field) {
                var isValid = true;
                var value = field.val();
                var feedbackDiv = field.siblings('.invalid-feedback');
                
                // Create feedback div if doesn't exist
                if (!feedbackDiv.length) {
                    feedbackDiv = $('<div class="invalid-feedback"></div>');
                    field.after(feedbackDiv);
                }

                // Check if required
                if (field.prop('required') && (!value || value.trim() === '')) {
                    field.addClass('is-invalid').removeClass('is-valid');
                    feedbackDiv.text('Ce champ est obligatoire');
                    isValid = false;
                }
                // Check email format
                else if (field.attr('type') === 'email' && value) {
                    var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                    if (!emailRegex.test(value)) {
                        field.addClass('is-invalid').removeClass('is-valid');
                        feedbackDiv.text('Veuillez entrer une adresse email valide');
                        isValid = false;
                    } else {
                        field.addClass('is-valid').removeClass('is-invalid');
                    }
                }
                // Check number
                else if (field.attr('type') === 'number' && value) {
                    if (isNaN(value)) {
                        field.addClass('is-invalid').removeClass('is-valid');
                        feedbackDiv.text('Veuillez entrer un nombre valide');
                        isValid = false;
                    } else {
                        field.addClass('is-valid').removeClass('is-invalid');
                    }
                }
                else if (value && value.trim() !== '') {
                    field.addClass('is-valid').removeClass('is-invalid');
                }
                else {
                    field.removeClass('is-invalid is-valid');
                }

                return isValid;
            }

