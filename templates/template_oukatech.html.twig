        'secondary': currentDossierTheme and currentDossierTheme.secondaryColor ? currentDossierTheme.secondaryColor : fallbackPalette.secondary,
        'accent': currentDossierTheme and currentDossierTheme.accentColor ? currentDossierTheme.accentColor : fallbackPalette.accent,
        'text': currentDossierTheme and currentDossierTheme.textColor ? currentDossierTheme.textColor : fallbackPalette.text,
