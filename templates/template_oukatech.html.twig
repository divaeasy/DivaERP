                'fa-user-tag': 'user-plus',
                'fa-user-tie': 'user',
                'fa-wallet': 'wallet'
            };

            var faUtilityClasses = new Set([
                'fa-sm', 'fa-lg', 'fa-xl', 'fa-xs', 'fa-1x', 'fa-2x', 'fa-3x', 'fa-4x', 'fa-5x',
                'fa-fw', 'fa-spin', 'fa-pulse', 'fa-rotate-90', 'fa-rotate-180', 'fa-rotate-270',
                'fa-flip-horizontal', 'fa-flip-vertical', 'fa-flip-both'
            ]);

            var convertFaIconNodesToLucide = function(scope) {
                var root = scope && scope.querySelectorAll ? scope : document;
                var iconNodes = root.querySelectorAll('i[class*="fa"], i[class~="fa"], i[class~="fas"], i[class~="far"], i[class~="fab"], i[class~="fal"]');

                iconNodes.forEach(function(iconNode) {
                    if (!iconNode || iconNode.hasAttribute('data-lucide')) {
                        return;
                    }

                    var classList = Array.prototype.slice.call(iconNode.classList || []);
                    if (!classList.length) {
                        return;
                    }

                    var faIconClass = '';
                    for (var i = 0; i < classList.length; i += 1) {
                        var cls = classList[i];
                        if (cls.indexOf('fa-') === 0 && !faUtilityClasses.has(cls)) {
                            faIconClass = cls;
                            break;
                        }
                    }

                    if (!faIconClass) {
                        return;
                    }

                    var lucideIconName = faToLucideMap[faIconClass] || 'circle';
                    var cleanedClassList = classList.filter(function(cls) {
                        var isFaFamilyClass = cls === 'fa' || cls === 'fas' || cls === 'far' || cls === 'fal' || cls === 'fab' || cls === 'fad';
                        return !isFaFamilyClass && cls !== faIconClass;
                    });

                    iconNode.setAttribute('class', cleanedClassList.join(' ').trim());
                    iconNode.setAttribute('data-lucide', lucideIconName);
                });
            };

            window.renderProjectOutlineIcons = function(scope) {
                convertFaIconNodesToLucide(scope || document);

                if (!window.lucide || typeof window.lucide.createIcons !== 'function') {
                    return;
                }

                window.lucide.createIcons({
                    attrs: {
                        'stroke-width': '1.8'
                    }
                });
            };

            window.renderProjectOutlineIcons(document);

            if (!window.__outlineIconsObserverBound && window.MutationObserver) {
                window.__outlineIconsObserverBound = true;

                var iconRenderPending = false;
                var scheduleIconRender = function() {
                    if (iconRenderPending) {
                        return;
                    }

                    iconRenderPending = true;
                    window.requestAnimationFrame(function() {
                        iconRenderPending = false;
                        window.renderProjectOutlineIcons(document);
                    });
                };

                var iconObserver = new MutationObserver(function(mutations) {
                    for (var m = 0; m < mutations.length; m += 1) {
                        var mutation = mutations[m];
                        if (!mutation.addedNodes || !mutation.addedNodes.length) {
                            continue;
                        }

                        for (var n = 0; n < mutation.addedNodes.length; n += 1) {
                            var addedNode = mutation.addedNodes[n];
                            if (!addedNode || addedNode.nodeType !== 1) {
                                continue;
                            }

                            var isIconNode = addedNode.matches && (
                                addedNode.matches('i[class*="fa"]') ||
                                addedNode.matches('i[data-lucide]')
                            );
                            var hasIconChildren = addedNode.querySelector && (
                                addedNode.querySelector('i[class*="fa"]') ||
                                addedNode.querySelector('i[data-lucide]')
                            );

                            if (isIconNode || hasIconChildren) {
                                scheduleIconRender();
                                return;
                            }
                        }
                    }
                });

                if (document.body) {
                    iconObserver.observe(document.body, { childList: true, subtree: true });
                }
            }
            
            var $sidebarProfileToggle = $('#sidebarUserDropdown');
            var $sidebarProfileMenu = $sidebarProfileToggle.siblings('.dropdown-menu');

            var positionSidebarProfileMenu = function() {
                if (!$sidebarProfileToggle.length || !$sidebarProfileMenu.length || !$sidebarProfileMenu.hasClass('show')) {
                    return;
                }

                if ($('body').hasClass('sidebar-expanded') && !$('#accordionSidebar').hasClass('double-sidebar')) {
                    $sidebarProfileMenu.css({ left: '', top: '', right: '', bottom: '' });
                    return;
                }

                var toggleRect = $sidebarProfileToggle[0].getBoundingClientRect();
                var menuElement = $sidebarProfileMenu[0];
                var previousVisibility = menuElement.style.visibility;

                menuElement.style.visibility = 'hidden';
                var menuWidth = menuElement.offsetWidth || 214;
                var menuHeight = menuElement.offsetHeight || 180;

                var gap = 12;
                var viewportPadding = 8;
                var left = toggleRect.right + gap;
                var top = toggleRect.bottom - menuHeight;

                if ((left + menuWidth) > (window.innerWidth - viewportPadding)) {
                    left = Math.max(viewportPadding, toggleRect.left - menuWidth - gap);
                }
                if (top < viewportPadding) {
                    top = viewportPadding;
                }
                if ((top + menuHeight) > (window.innerHeight - viewportPadding)) {
                    top = Math.max(viewportPadding, window.innerHeight - menuHeight - viewportPadding);
                }

                $sidebarProfileMenu.css({
                    left: Math.round(left) + 'px',
                    top: Math.round(top) + 'px',
                    right: 'auto',
                    bottom: 'auto'
                });

                menuElement.style.visibility = previousVisibility;
            };

            // Handle sidebar profile dropdown explicitly
            $sidebarProfileToggle.off('click.dropdown').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                var $dropdownMenu = $(this).siblings('.dropdown-menu');
                var isOpen = $dropdownMenu.hasClass('show');
                
                // Close all other open dropdowns
                $('.dropdown-menu.show').removeClass('show');
                $('.dropdown-toggle').attr('aria-expanded', 'false');
                
                // Toggle this dropdown
                if (!isOpen) {
                    $dropdownMenu.addClass('show');
                    $(this).attr('aria-expanded', 'true');
                    positionSidebarProfileMenu();
                }
            });

            $(window).on('resize.sidebarProfileDropdown', function() {
                positionSidebarProfileMenu();
            });

            var sidebarUtilityToggleSelector = '.sidebar-utility-actions .sidebar-utility-toggle';

            var closeSidebarUtilityMenus = function() {
                $('.sidebar-utility-actions .dropdown').removeClass('show');
                $('.sidebar-utility-actions .dropdown-menu').removeClass('show is-position-left').css({
                    left: '-9999px',
                    top: '-9999px',
                    right: 'auto',
                    bottom: 'auto',
                    '--utility-arrow-offset': '18px'
                });
                $(sidebarUtilityToggleSelector).attr('aria-expanded', 'false');
            };

            var positionSidebarUtilityMenu = function($toggle, $menu) {
                if (!$toggle || !$toggle.length || !$menu || !$menu.length) {
                    return;
                }

                var toggleRect = $toggle[0].getBoundingClientRect();
                var menuElement = $menu[0];
