.ligne-edit-modal-content {
    border: 0;
    border-radius: 8px;
    box-shadow: 0 22px 56px rgba(15, 23, 42, 0.22);
    overflow: hidden;
}

.ligne-edit-modal-header {
    align-items: center;
    background: #111827;
    border: 0;
