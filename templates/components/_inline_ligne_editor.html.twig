    border-radius: 8px;
    border: 1px solid #e2e8f0;
}

.ligne-editor-section-head {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
}

.ligne-editor-section-head h6 {
    color: #111827;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0;
    margin: 0;
