    border: 1px solid #e2e8f0;
    border-radius: 8px;
    overflow: hidden;
}

.ligne-editor-table thead {
    background: #f1f5f9;
}

.ligne-editor-table th {
    color: #475569;
    font-weight: 700;
    font-size: 0.8rem;
