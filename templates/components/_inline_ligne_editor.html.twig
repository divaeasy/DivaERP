}

.ligne-edit-modal-footer {
    background: #fff;
    border-top: 1px solid #e2e8f0;
    padding: 14px 20px;
}

.ligne-edit-modal-footer .btn {
    border-radius: 6px;
    font-weight: 700;
}

.ligne-edit-modal-footer .btn-primary {
    background: #2563eb;
    border-color: #2563eb;
}

/* Modal backdrop customization */
#inlineLigneEditorModal .modal-backdrop {
    background: rgba(0, 0, 0, 0.5);
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .ligne-editor-modal-body {
        padding: 16px;
    }
    
    .ligne-editor-quickadd,
    .ligne-editor-table {
        padding: 16px;
    }
    
    .ligne-editor-table .table {
        font-size: 0.85rem;
    }
    
    .ligne-editor-quickadd-form .form-row {
        flex-direction: column;
    }
    
    .ligne-editor-quickadd-form .col-md-3 {
        width: 100%;
    }
}
</style>
