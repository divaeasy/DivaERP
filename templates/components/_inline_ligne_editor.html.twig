.ligne-editor-modal-footer {
    border-top: 1px solid #e2e8f0;
    padding: 14px 24px;
    background: white;
}

.ligne-editor-modal-footer .btn {
    font-weight: 600;
    border-radius: 6px;
    padding: 8px 20px;
    transition: all 0.2s;
}

.ligne-editor-modal-footer .btn-secondary {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    color: #475569;
}

.ligne-editor-modal-footer .btn-secondary:hover {
    background: #e2e8f0;
    border-color: #94a3b8;
