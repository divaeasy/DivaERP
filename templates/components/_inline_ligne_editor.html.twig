{# Floating Ligne Editor Modal #}
<div class="modal fade" id="inlineLigneEditorModal" tabindex="-1" role="dialog" aria-labelledby="inlineLigneEditorModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content ligne-editor-modal-content">
            <div class="modal-header ligne-editor-modal-header">
                <div>
                    <h5 class="modal-title" id="inlineLigneEditorModalLabel">
                        <i class="fas fa-list-ul mr-2"></i>Gestion des lignes
                    </h5>
                    <small id="inlineLigneEditorMeta">Piece selectionnee</small>
                </div>
                <button type="button" class="close text-white" id="closeLigneEditor" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body ligne-editor-modal-body">
                {# Quick Add Form #}
                <div class="ligne-editor-quickadd">
                    <h6><i class="fas fa-plus mr-2"></i>Ajouter une ligne</h6>
                    <form id="inlineLigneQuickForm" class="ligne-editor-quickadd-form">
                        <div class="form-group">
                            <label for="inlineEditorArticleSelect">Article</label>
                            <select id="inlineEditorArticleSelect" class="form-control form-control-sm inline-article-select js-article-search-select" required>
                                <option value="">Selectionner...</option>
                            </select>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <label for="inlineEditorQteInput">Qte</label>
                                <input type="number" id="inlineEditorQteInput" class="form-control form-control-sm inline-qty-input" min="0.01" step="0.01" value="1" required>
                            </div>
                            <div class="form-group col-md-2">
                                <label for="inlineEditorPubInput">P.U.</label>
                                <input type="number" id="inlineEditorPubInput" class="form-control form-control-sm inline-pub-input ligne-auto-price" min="0" step="0.01" value="0.00" readonly required>
                            </div>
                            <div class="form-group col-md-2">
                                <label for="inlineEditorRemiseInput">Remise %</label>
                                <input type="number" id="inlineEditorRemiseInput" class="form-control form-control-sm inline-remise-input" min="0" max="100" value="0">
                            </div>
                            <div class="form-group col-md-2">
                                <label for="inlineEditorMontantDisplay">Montant</label>
                                <input type="text" id="inlineEditorMontantDisplay" class="form-control form-control-sm" readonly value="0.00">
                            </div>
                            <div class="form-group col-md-3">
                                <label>&nbsp;</label>
                                <button type="button" class="btn btn-primary btn-sm btn-block inline-add-ligne-btn">
                                    <i class="fas fa-plus mr-1"></i>Ajouter
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                {# Lignes Table #}
                <div class="ligne-editor-table">
                    <div class="ligne-editor-section-head">
                        <h6><i class="fas fa-list-ul mr-2"></i>Lignes existantes</h6>
                    </div>
                    <div class="table-responsive ligne-editor-table-wrap">
                        <table class="table table-sm table-hover mb-0" id="inlineLignesTable">
                            <thead>
                                <tr>
                                    <th style="width: 30%;">Article</th>
                                    <th class="text-right" style="width: 12%;">Qte</th>
                                    <th class="text-right" style="width: 12%;">P.U.</th>
                                    <th class="text-right" style="width: 12%;">Remise</th>
                                    <th class="text-right" style="width: 15%;">Montant</th>
                                    <th class="text-right" style="width: 10%;">QteSt</th>
                                    <th class="text-center" style="width: 9%;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="inlineLignesTableBody">
                                <tr><td colspan="7" class="text-center text-muted py-4"><i class="fas fa-inbox mb-2" style="font-size: 1.5rem;"></i><br>Aucune ligne</td></tr>
                            </tbody>
                            <tfoot>
                                <tr class="font-weight-bold bg-light">
                                    <td colspan="4" class="text-right">Total</td>
                                    <td class="text-right" id="inlineLigneTotal">0.00</td>
                                    <td colspan="2"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <div class="modal-footer ligne-editor-modal-footer">
                <button type="button" class="btn btn-secondary" id="closeLigneEditorBtn">
                    <i class="fas fa-times mr-1"></i>Fermer
                </button>
            </div>
        </div>
    </div>
</div>

{# Edit Ligne Modal #}
<div class="modal fade" id="editLigneModal" tabindex="-1" role="dialog" aria-labelledby="editLigneModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content ligne-edit-modal-content">
            <div class="modal-header ligne-edit-modal-header">
                <h5 class="modal-title" id="editLigneModalLabel">
                    <i class="fas fa-edit mr-2"></i>Modifier la ligne
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body ligne-edit-modal-body">
                <form id="editLigneForm">
                    <input type="hidden" id="editLigneId">
                    <input type="hidden" id="editLigneIndex">

                    <div class="form-group">
                        <label for="editArticleSelect">Article <span class="text-danger">*</span></label>
                        <select id="editArticleSelect" class="form-control form-control-sm" required>
                            <option value="">Selectionner un article...</option>
                        </select>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label for="editQteInput">Quantite <span class="text-danger">*</span></label>
                            <input type="number" id="editQteInput" class="form-control form-control-sm" min="0.01" step="0.01" required>
                        </div>
                        <div class="form-group col-md-6">
                            <label for="editPubInput">P.U. <span class="text-danger">*</span></label>
                            <input type="number" id="editPubInput" class="form-control form-control-sm" min="0" step="0.01" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label for="editRemiseInput">Remise %</label>
                            <input type="number" id="editRemiseInput" class="form-control form-control-sm" min="0" max="100" step="0.01" value="0">
                        </div>
                        <div class="form-group col-md-6">
                            <label for="editMontantDisplay">Montant</label>
                            <input type="text" id="editMontantDisplay" class="form-control form-control-sm" readonly>
                        </div>
                    </div>

                    <hr class="my-3">

                    <div class="form-group">
                        <label for="editQteStDisplay">QteSt (Stock) <span class="text-muted small">(Lecture seule)</span></label>
                        <input type="text" id="editQteStDisplay" class="form-control form-control-sm" readonly>
                    </div>

                    <div class="form-group">
                        <label for="editMouvementDisplay">Mouvement de Stock <span class="text-muted small">(Lecture seule)</span></label>
                        <input type="text" id="editMouvementDisplay" class="form-control form-control-sm" readonly>
                    </div>
                </form>
            </div>

            <div class="modal-footer ligne-edit-modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i>Annuler
                </button>
                <button type="button" class="btn btn-primary" id="editLigneSaveBtn">
                    <i class="fas fa-save mr-1"></i>Enregistrer
                </button>
            </div>
        </div>
    </div>
</div>

<style>
