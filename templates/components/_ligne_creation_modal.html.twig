{# Modal for quick ligne creation after piece creation #}
<div class="modal fade" id="ligneCreationModal" tabindex="-1" role="dialog" aria-labelledby="ligneCreationModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content ligne-create-modal-content">
            <div class="modal-header ligne-create-modal-header">
                <div>
                    <h5 class="modal-title" id="ligneCreationModalLabel">
                        <i class="fas fa-list-ul mr-2"></i>Lignes de la piece
                    </h5>
                    <div class="ligne-create-modal-subtitle">Ajoutez les articles avant de finaliser la piece.</div>
                </div>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close" id="ligneModalClose">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body ligne-create-modal-body">
                <div class="ligne-create-toolbar" id="ligneQuickAddForm">
                    <form id="quickLineForm" class="ligne-create-grid">
                        <div class="form-group">
                            <label for="quickArticleSelect">Article</label>
                            <select id="quickArticleSelect" class="form-control form-control-sm" required>
                                <option value="">Selectionner un article...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="quickQtyInput">Qte</label>
                            <input type="number" id="quickQtyInput" class="form-control form-control-sm" min="0.01" step="0.01" value="1" required>
                        </div>
                        <div class="form-group">
                            <label for="quickPubInput">P.U.</label>
                            <input type="number" id="quickPubInput" class="form-control form-control-sm ligne-auto-price" min="0" step="0.01" value="0.00" readonly>
                        </div>
                        <div class="form-group">
                            <label for="quickRemiseInput">Remise %</label>
                            <input type="number" id="quickRemiseInput" class="form-control form-control-sm" min="0" max="100" value="0">
                        </div>
                        <div class="form-group">
                            <label for="quickMontantDisplay">Montant</label>
                            <input type="text" id="quickMontantDisplay" class="form-control form-control-sm" readonly value="0.00">
                        </div>
                        <button type="button" class="btn btn-primary btn-sm" id="addLineQuickBtn">
                            <i class="fas fa-plus mr-1"></i> Ajouter
                        </button>
                    </form>
                </div>

                <div id="lignesTableContainer">
                    <div class="ligne-create-section-head">
                        <h6><i class="fas fa-list"></i> Lignes ajoutees</h6>
                        <span><span id="ligneCount">0</span> ligne(s)</span>
                    </div>

                    <div class="table-responsive ligne-create-table-wrap">
                        <table class="table table-sm table-hover mb-0" id="lignesTable">
                            <thead>
                                <tr>
                                    <th>Article</th>
                                    <th class="text-right">Qte</th>
                                    <th class="text-right">P.U.</th>
                                    <th class="text-right">Remise</th>
                                    <th class="text-right">Montant</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody id="lignesTableBody">
                                <tr id="emptyLigneRow">
                                    <td colspan="6" class="text-center text-muted py-4">
                                        <i class="fas fa-inbox mb-1"></i><br>Aucune ligne ajoutee pour le moment
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="text-right font-weight-bold">Total</td>
                                    <td class="text-right font-weight-bold"><span id="totalMontant">0.00</span></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <div class="modal-footer ligne-create-modal-footer">
                <button type="button" class="btn btn-secondary" id="ligneModalContinue">
                    <i class="fas fa-clock mr-2"></i>Ajouter plus tard
                </button>
                <button type="button" class="btn btn-primary" id="ligneModalFinish" disabled>
                    <i class="fas fa-check mr-2"></i>Terminer et editer
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.ligne-create-modal-content {
    border: 0;
    border-radius: 8px;
    box-shadow: 0 24px 64px rgba(15, 23, 42, 0.24);
    overflow: hidden;
}
.ligne-create-modal-header {
    align-items: flex-start;
    background: #111827;
    border: 0;
    color: #fff;
    padding: 18px 24px;
}
.ligne-create-modal-header .modal-title {
    font-size: 1.08rem;
    font-weight: 800;
    letter-spacing: 0;
}
.ligne-create-modal-subtitle {
    color: #cbd5e1;
    font-size: 0.84rem;
    margin-top: 3px;
}
.ligne-create-modal-body {
    background: #f6f8fb;
    max-height: 70vh;
    overflow-y: auto;
    padding: 20px 24px;
}
.ligne-create-toolbar {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    margin-bottom: 18px;
    overflow-x: auto;
    padding: 14px;
}
.ligne-create-grid {
    align-items: end;
    display: grid;
    gap: 10px;
    grid-template-columns: minmax(240px, 1.7fr) minmax(82px, 0.5fr) minmax(105px, 0.65fr) minmax(98px, 0.6fr) minmax(110px, 0.65fr) auto;
}
.ligne-create-grid .form-group {
    margin: 0;
}
.ligne-create-grid label {
    color: #475569;
    font-size: 0.78rem;
    font-weight: 700;
    margin-bottom: 4px;
}
.ligne-create-grid .form-control {
    border-radius: 7px;
    min-height: 34px;
}
.ligne-create-grid input[readonly] {
    background: #f8fafc;
    color: #111827;
    font-weight: 800;
}
.ligne-create-grid .ligne-auto-price {
    border-style: dashed;
}
.ligne-create-section-head {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
}
.ligne-create-section-head h6 {
    color: #1f2937;
    font-weight: 700;
    margin: 0;
}
.ligne-create-section-head h6 i {
    color: #2563eb;
    margin-right: 6px;
}
.ligne-create-section-head span {
    color: #64748b;
    font-size: 0.85rem;
    font-weight: 700;
}
.ligne-create-table-wrap {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    overflow: hidden;
}
#lignesTable thead,
#lignesTable tfoot {
    background: #f1f5f9;
}
#lignesTable th,
#lignesTable td {
    padding: 10px 9px;
    vertical-align: middle;
}
#lignesTable th {
    color: #475569;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
}
#lignesTable tbody tr {
    transition: background-color 0.16s ease;
}
#lignesTable tbody tr:hover {
    background-color: #f8fbff;
}
#lignesTable tfoot td {
    color: #1f2937;
}
.ligne-create-modal-footer {
    background: #fff;
    border-top: 1px solid #e2e8f0;
    padding: 14px 22px;
}
#ligneCreationModal .form-control:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.14);
}
#ligneCreationModal #addLineQuickBtn {
    flex-shrink: 0;
    justify-self: end;
    min-width: 108px;
}
#ligneCreationModal .btn-primary:not(:disabled) {
    background: #2563eb;
    border-color: #2563eb;
    cursor: pointer;
    opacity: 1;
    transition: all 0.2s ease;
}
#ligneCreationModal #addLineQuickBtn.disabled,
#ligneCreationModal #addLineQuickBtn:disabled {
    cursor: not-allowed;
    opacity: 0.55;
    pointer-events: none;
}
#ligneCreationModal #addLineQuickBtn:not(:disabled) {
    pointer-events: auto;
}
#ligneCreationModal .btn-primary:not(:disabled):hover {
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.28);
    transform: translateY(-1px);
}
.ligne-delete-btn {
    align-items: center;
    background: #fff1f2;
    border: 1px solid #fecdd3;
    border-radius: 6px;
    color: #dc2626;
    cursor: pointer;
    display: inline-flex;
    height: 30px;
    justify-content: center;
    padding: 0;
    width: 30px;
}
.ligne-delete-btn:hover {
    background: #ffe4e6;
    color: #991b1b;
}
@media (max-width: 992px) {
    .ligne-create-grid {
        grid-template-columns: 1fr 1fr;
    }
    .ligne-create-grid #addLineQuickBtn {
        grid-column: 1 / -1;
    }
}
</style>
