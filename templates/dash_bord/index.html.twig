{% extends "template_oukatech.html.twig" %}

{% block PageTitle %}
    Tableau de bord
{% endblock %}

{% block body %}
<div class="dashboard-shell">
    <div class="dashboard-head mb-4">
        <h2 class="dashboard-title mb-0">Tableau de bord</h2>
        <a href="{{ path('export.dashboard.excel') }}" class="btn btn-sm btn-primary no-loading dashboard-export-btn" title="Exporter en Excel">
            <i class="fas fa-file-excel mr-2"></i>Exporter Excel
        </a>
    </div>

    <div class="kpi-grid mb-4">
        <article class="kpi-card kpi-card--revenue">
            <span class="kpi-card__icon"><i class="fas fa-wallet"></i></span>
            <div>
                <p class="kpi-card__label">Chiffre d'affaires</p>
                <p class="kpi-card__value">{{ totalRevenueCurrent|number_format(2, ',', ' ') }} EUR</p>
                <p class="kpi-card__meta">Annee {{ currentYear }}</p>
            </div>
        </article>

        <article class="kpi-card {% if growthPercentage >= 0 %}kpi-card--growth{% else %}kpi-card--decline{% endif %}">
            <span class="kpi-card__icon"><i class="fas fa-chart-line"></i></span>
            <div>
                <p class="kpi-card__label">Croissance</p>
                <p class="kpi-card__value">{% if growthPercentage >= 0 %}+{% endif %}{{ growthPercentage }}%</p>
                <p class="kpi-card__meta">vs {{ previousYear }}</p>
            </div>
        </article>

        <article class="kpi-card kpi-card--invoices">
            <span class="kpi-card__icon"><i class="fas fa-file-invoice"></i></span>
            <div>
                <p class="kpi-card__label">Factures emises</p>
                <p class="kpi-card__value">{{ invoiceCount }}</p>
                <p class="kpi-card__meta">Annee {{ currentYear }}</p>
            </div>
        </article>

        <article class="kpi-card kpi-card--clients">
            <span class="kpi-card__icon"><i class="fas fa-user-plus"></i></span>
            <div>
                <p class="kpi-card__label">Clients du dossier</p>
                <p class="kpi-card__value">{{ totalClients }}</p>
                <p class="kpi-card__meta">+{{ newCustomersThisMonth }} ce mois</p>
            </div>
        </article>

        <article class="kpi-card kpi-card--products">
            <span class="kpi-card__icon"><i class="fas fa-boxes"></i></span>
            <div>
                <p class="kpi-card__label">Produits vendus</p>
                <p class="kpi-card__value">{{ totalProductsSold }}</p>
                <p class="kpi-card__meta">Annee {{ currentYear }}</p>
            </div>
        </article>
    </div>

    <div class="row mb-4">
        <div class="col-xl-8 col-lg-7 mb-4 mb-lg-0">
            <section class="dashboard-panel h-100">
                <header class="dashboard-panel__header">
                    <h6 class="dashboard-panel__title">Comparaison des ventes {{ currentYear }} / {{ previousYear }}</h6>
                </header>
                <div class="dashboard-panel__body chart-height-lg">
                    <canvas id="salesComparisonChart"></canvas>
                </div>
            </section>
        </div>
        <div class="col-xl-4 col-lg-5">
            <section class="dashboard-panel h-100">
                <header class="dashboard-panel__header">
                    <h6 class="dashboard-panel__title">Ventes mensuelles</h6>
                </header>
                <div class="dashboard-panel__body chart-height-lg">
                    <canvas id="monthlySalesChart"></canvas>
                </div>
            </section>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-xl-6 col-lg-6 mb-4 mb-lg-0">
            <section class="dashboard-panel h-100">
                <header class="dashboard-panel__header">
                    <h6 class="dashboard-panel__title">Top 5 produits</h6>
                </header>
                <div class="dashboard-panel__body chart-height-md">
                    <canvas id="topProductsChart"></canvas>
                </div>
            </section>
        </div>
        <div class="col-xl-6 col-lg-6">
            <section class="dashboard-panel h-100">
                <header class="dashboard-panel__header">
                    <h6 class="dashboard-panel__title">Repartition par type de piece</h6>
                </header>
                <div class="dashboard-panel__body chart-height-md">
                    <canvas id="categoryChart"></canvas>
                </div>
            </section>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-xl-6 col-lg-6 mb-4 mb-lg-0">
            <section class="dashboard-panel h-100">
                <header class="dashboard-panel__header">
                    <h6 class="dashboard-panel__title">Croissance clients</h6>
                </header>
                <div class="dashboard-panel__body chart-height-md">
                    <canvas id="customerGrowthChart"></canvas>
                </div>
            </section>
        </div>
        <div class="col-xl-6 col-lg-6">
            <section class="dashboard-panel h-100">
                <header class="dashboard-panel__header">
                    <h6 class="dashboard-panel__title">Etat des paiements</h6>
                </header>
                <div class="dashboard-panel__body chart-height-md">
                    <canvas id="paymentStatusChart"></canvas>
                </div>
            </section>
        </div>
    </div>
</div>

<style>
.dashboard-shell {
    padding-bottom: 1.2rem;
}

.dashboard-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    background: linear-gradient(120deg, rgba(9, 84, 92, 0.08), rgba(7, 45, 52, 0.02));
    border: 1px solid rgba(12, 73, 82, 0.11);
    border-radius: 16px;
    padding: 1.1rem 1.3rem;
}

.dashboard-title {
    margin: 0;
    color: #123146;
    font-weight: 800;
    font-size: 1.6rem;
}

.dashboard-export-btn {
    border-radius: 10px;
    padding: 0.48rem 0.95rem;
    font-weight: 700;
}

.kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 0.85rem;
}

.kpi-card {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.95rem 1rem;
    border-radius: 14px;
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.09);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
}

.kpi-card__icon {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    font-size: 0.95rem;
    background: rgba(14, 120, 129, 0.12);
    color: #0d5f68;
}

.kpi-card__label,
.kpi-card__value,
.kpi-card__meta {
    margin: 0;
}

.kpi-card__label {
    color: #5f7480;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.kpi-card__value {
    color: #0f2f42;
    font-size: 1.28rem;
    line-height: 1.2;
    font-weight: 800;
}

.kpi-card__meta {
    color: #7a909b;
    font-size: 0.8rem;
}

.kpi-card--growth .kpi-card__icon {
    background: rgba(22, 163, 74, 0.15);
    color: #168242;
}

.kpi-card--decline .kpi-card__icon {
    background: rgba(220, 38, 38, 0.14);
    color: #bf2635;
}

.kpi-card--invoices .kpi-card__icon {
    background: rgba(37, 99, 235, 0.13);
    color: #1d4ed8;
}

.kpi-card--clients .kpi-card__icon {
    background: rgba(245, 158, 11, 0.16);
    color: #b66b0f;
}

.kpi-card--products .kpi-card__icon {
    background: rgba(15, 118, 110, 0.14);
    color: #0f766e;
}

.dashboard-panel {
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.09);
    border-radius: 16px;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
    overflow: hidden;
}

.dashboard-panel__header {
    padding: 0.95rem 1.15rem 0.65rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    background: linear-gradient(120deg, rgba(8, 74, 83, 0.07), rgba(8, 74, 83, 0.01));
}

.dashboard-panel__title {
    margin: 0;
    font-weight: 800;
    color: #14354a;
    font-size: 0.95rem;
}

.dashboard-panel__body {
    padding: 0.9rem 1rem 1rem;
}

.chart-height-lg {
    height: 320px;
}

.chart-height-md {
    height: 290px;
}

@media (max-width: 991.98px) {
    .dashboard-head {
        flex-direction: column;
        align-items: flex-start;
    }

    .dashboard-export-btn {
        width: 100%;
        justify-content: center;
    }

    .chart-height-lg,
    .chart-height-md {
        height: 280px;
    }
}
</style>
{% endblock %}

{% block javascripts %}
<script>
$(document).ready(function() {
    if (typeof Chart === 'undefined') {
        return;
    }

    var primaryHex = (getComputedStyle(document.documentElement).getPropertyValue('--theme-primary') || '#0f5d63').trim();
    var secondaryHex = '#2c6f9e';
    var accentHex = '#14b8a6';

    var months = {{ chartMonths|raw }};
    var currentYearSeries = {{ currentYearValues|raw }};
    var previousYearSeries = {{ previousYearValues|raw }};
    var productLabels = {{ productNames|raw }};
    var productSeries = {{ productQty|raw }};
    var categoryLabels = {{ categoryNames|raw }};
    var categorySeries = {{ categoryAmounts|raw }};
    var customerSeries = {{ customerCounts|raw }};
    var paymentLabels = {{ paymentStatusLabels|raw }};
    var paymentSeries = {{ paymentStatusAmounts|raw }};

    function getCtx(id) {
        var el = document.getElementById(id);
        return el ? el.getContext('2d') : null;
    }

    function hexToRgba(hex, alpha) {
        var value = hex.replace('#', '');
        var normalized = value.length === 3 ? value.split('').map(function(char) { return char + char; }).join('') : value;
        var num = parseInt(normalized, 16);
        return 'rgba(' + ((num >> 16) & 255) + ', ' + ((num >> 8) & 255) + ', ' + (num & 255) + ', ' + alpha + ')';
    }

    function formatCurrency(value) {
        return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 2 }).format(value || 0);
    }

    function kEuro(value) {
        var numeric = Number(value) || 0;
        if (Math.abs(numeric) >= 1000) {
            return new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 }).format(numeric / 1000) + ' k€';
        }
        return new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 }).format(numeric) + ' €';
    }

    Chart.defaults.global.defaultFontFamily = 'Nunito, sans-serif';
    Chart.defaults.global.defaultFontColor = '#5f7280';

    var axisColor = 'rgba(101, 120, 133, 0.25)';

    var salesCtx = getCtx('salesComparisonChart');
    if (salesCtx) {
        new Chart(salesCtx, {
            type: 'line',
            data: {
                labels: months,
                datasets: [
                    {
                        label: 'Annee {{ currentYear }}',
                        data: currentYearSeries,
                        borderColor: hexToRgba(primaryHex, 1),
                        backgroundColor: hexToRgba(primaryHex, 0.14),
                        borderWidth: 2,
                        lineTension: 0.35,
                        fill: true,
                        pointRadius: 3
                    },
                    {
                        label: 'Annee {{ previousYear }}',
                        data: previousYearSeries,
                        borderColor: hexToRgba(secondaryHex, 1),
                        backgroundColor: hexToRgba(secondaryHex, 0.12),
                        borderWidth: 2,
                        lineTension: 0.35,
                        fill: true,
                        pointRadius: 3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                legend: { display: true, position: 'top' },
                tooltips: {
                    callbacks: {
                        label: function(tooltipItem, data) {
                            return data.datasets[tooltipItem.datasetIndex].label + ' : ' + formatCurrency(tooltipItem.yLabel);
                        }
                    }
                },
                scales: {
                    xAxes: [{ gridLines: { display: false } }],
                    yAxes: [{
                        ticks: { beginAtZero: true, callback: kEuro },
                        gridLines: { color: axisColor }
                    }]
                }
            }
        });
    }

    var monthlyCtx = getCtx('monthlySalesChart');
    if (monthlyCtx) {
        new Chart(monthlyCtx, {
            type: 'bar',
            data: {
                labels: months,
                datasets: [{
                    label: 'Ventes',
                    data: currentYearSeries,
                    backgroundColor: hexToRgba(primaryHex, 0.86),
                    borderColor: hexToRgba(primaryHex, 1),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                legend: { display: false },
                tooltips: {
                    callbacks: {
                        label: function(tooltipItem) {
                            return formatCurrency(tooltipItem.yLabel);
                        }
                    }
                },
                scales: {
                    xAxes: [{ gridLines: { display: false } }],
                    yAxes: [{
                        ticks: { beginAtZero: true, callback: kEuro },
                        gridLines: { color: axisColor }
                    }]
                }
            }
        });
    }

    var topCtx = getCtx('topProductsChart');
    if (topCtx) {
        new Chart(topCtx, {
            type: 'horizontalBar',
            data: {
                labels: productLabels,
                datasets: [{
                    label: 'Quantite',
                    data: productSeries,
                    backgroundColor: [
                        hexToRgba(primaryHex, 0.86),
                        hexToRgba(secondaryHex, 0.86),
                        hexToRgba(accentHex, 0.86),
                        'rgba(52, 90, 122, 0.84)',
                        'rgba(84, 120, 153, 0.76)'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                legend: { display: false },
                tooltips: {
                    callbacks: {
                        label: function(tooltipItem) {
                            return 'Qte : ' + tooltipItem.xLabel;
                        }
                    }
                },
                scales: {
                    xAxes: [{ ticks: { beginAtZero: true }, gridLines: { color: axisColor } }],
                    yAxes: [{ gridLines: { display: false } }]
                }
            }
        });
    }

    var categoryCtx = getCtx('categoryChart');
    if (categoryCtx) {
        new Chart(categoryCtx, {
            type: 'doughnut',
            data: {
                labels: categoryLabels,
                datasets: [{
                    data: categorySeries,
                    backgroundColor: [
                        hexToRgba(primaryHex, 0.9),
                        hexToRgba(secondaryHex, 0.9),
                        hexToRgba(accentHex, 0.9),
                        'rgba(59, 130, 246, 0.8)',
                        'rgba(15, 118, 110, 0.75)',
                        'rgba(100, 116, 139, 0.8)'
                    ],
                    borderColor: '#ffffff',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutoutPercentage: 64,
                legend: {
                    position: 'bottom',
                    labels: { boxWidth: 12, padding: 14 }
                },
                tooltips: {
                    callbacks: {
                        label: function(tooltipItem, data) {
                            var dataset = data.datasets[tooltipItem.datasetIndex].data;
                            var total = dataset.reduce(function(sum, value) { return sum + value; }, 0);
                            var value = dataset[tooltipItem.index] || 0;
                            var pct = total > 0 ? ((value / total) * 100).toFixed(1) : '0.0';
                            return formatCurrency(value) + ' (' + pct + '%)';
                        }
                    }
                }
            }
        });
    }

    var customerCtx = getCtx('customerGrowthChart');
    if (customerCtx) {
        new Chart(customerCtx, {
            type: 'line',
            data: {
                labels: months,
                datasets: [{
                    label: 'Nouveaux clients',
                    data: customerSeries,
                    borderColor: hexToRgba(accentHex, 0.95),
                    backgroundColor: hexToRgba(accentHex, 0.16),
                    borderWidth: 2,
                    lineTension: 0.35,
                    fill: true,
                    pointRadius: 3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                legend: { display: false },
                tooltips: {
                    callbacks: {
                        label: function(tooltipItem) {
                            return 'Nouveaux clients : ' + Math.round(tooltipItem.yLabel || 0);
                        }
                    }
                },
                scales: {
                    xAxes: [{ gridLines: { display: false } }],
                    yAxes: [{ ticks: { beginAtZero: true }, gridLines: { color: axisColor } }]
                }
            }
        });
    }

    var paymentCtx = getCtx('paymentStatusChart');
    if (paymentCtx) {
        new Chart(paymentCtx, {
            type: 'doughnut',
            data: {
                labels: paymentLabels,
                datasets: [{
                    data: paymentSeries,
                    backgroundColor: [
                        hexToRgba(accentHex, 0.9),
                        hexToRgba(primaryHex, 0.9),
                        hexToRgba(secondaryHex, 0.9),
                        'rgba(220, 38, 38, 0.84)'
                    ],
                    borderColor: '#ffffff',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutoutPercentage: 64,
                legend: {
                    position: 'bottom',
                    labels: { boxWidth: 12, padding: 14 }
                },
                tooltips: {
                    callbacks: {
                        label: function(tooltipItem, data) {
                            var dataset = data.datasets[tooltipItem.datasetIndex].data;
                            var total = dataset.reduce(function(sum, value) { return sum + value; }, 0);
                            var value = dataset[tooltipItem.index] || 0;
                            var pct = total > 0 ? ((value / total) * 100).toFixed(1) : '0.0';
                            return formatCurrency(value) + ' (' + pct + '%)';
                        }
                    }
                }
            }
        });
    }
});
</script>
{% endblock %}
