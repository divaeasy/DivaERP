{% extends "template_oukatech.html.twig" %}
{% block PageTitle%}
    Tableau de bord
{% endblock %}
{% block body %}

<!-- Dashboard Export Buttons -->
<div class="row mb-3">
    <div class="col-12">
        <div style="display: flex; gap: 10px; align-items: center;">
            <h4 class="mb-0" style="flex: 1;">📊 Tableau de Bord</h4>
            <a href="{{ path('export.dashboard.excel') }}" class="btn btn-sm btn-success no-loading" title="Exporter en Excel">
                <i class="fas fa-file-excel mr-1"></i> Excel
            </a>
            <a href="{{ path('export.dashboard.pdf') }}" class="btn btn-sm btn-danger no-loading" title="Exporter en PDF">
                <i class="fas fa-file-pdf mr-1"></i> PDF
            </a>
        </div>
    </div>
</div>

<!-- Cartes KPI -->
<div class="row mb-4">
    <!-- Chiffre d'affaires total -->
    <div class="col mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                            💰 Chiffre d'affaires</div>
                        <div class="h6 mb-0 font-weight-bold text-gray-800">{{ totalRevenueCurrent|number_format(2, ',', ' ') }}</div>
                        <small class="text-muted">Jan — {{ "now"|date("M") }} {{ currentYear }}</small>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-wallet fa-2x text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Évolution % -->
    <div class="col mb-4">
        <div class="card {% if growthPercentage >= 0 %}border-left-success{% else %}border-left-danger{% endif %} shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold {% if growthPercentage >= 0 %}text-success{% else %}text-danger{% endif %} text-uppercase mb-1">
                            {% if growthPercentage >= 0 %}📈 Croissance{% else %}📉 Baisse{% endif %}</div>
                        <div class="h6 mb-0 font-weight-bold text-gray-800">
                            {% if growthPercentage >= 0 %}+{% endif %}{{ growthPercentage }}%
                        </div>
                        <small class="text-muted">vs même période {{ previousYear }}</small>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-chart-line fa-2x {% if growthPercentage >= 0 %}text-success{% else %}text-danger{% endif %}"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Nombre de factures -->
    <div class="col mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                            🧾 Factures</div>
                        <div class="h6 mb-0 font-weight-bold text-gray-800">{{ invoiceCount }}</div>
                        <small class="text-muted">Année {{ currentYear }}</small>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-file-invoice fa-2x text-info"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Nouveaux clients -->
    <div class="col mb-4">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                            👥 Nouveaux clients</div>
                        <div class="h6 mb-0 font-weight-bold text-gray-800">{{ newCustomersThisMonth }}</div>
                        <small class="text-muted">Ce mois</small>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-user-plus fa-2x text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Produits vendus -->
    <div class="col mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                            📦 Produits vendus</div>
                        <div class="h6 mb-0 font-weight-bold text-gray-800">{{ totalProductsSold }}</div>
                        <small class="text-muted">Année {{ currentYear }}</small>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-boxes fa-2x text-success"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Factures en retard -->
    {# <div class="col mb-4">
        <div class="card border-left-danger shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                            ⚠️ Factures en retard</div>
                        <div class="h6 mb-0 font-weight-bold text-gray-800">{{ overdueInvoices.count }}</div>
                        <small class="text-muted">{{ overdueInvoices.amount|number_format(2, ',', ' ') }} €</small>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-exclamation-triangle fa-2x text-danger"></i>
                    </div>
                </div>
            </div>
        </div>
    </div> #}
</div>

<!-- Graphiques Ligne 1 : Comparaison des ventes -->
<div class="row mb-4">
    <!-- 1. Comparaison des ventes : Année courante vs Année précédente -->
    <div class="col-xl-8 col-lg-7">
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">📊 Comparaison des ventes — {{ currentYear }} vs {{ previousYear }}</h6>
            </div>
            <div class="card-body">
                <div class="chart-area" style="height: 300px;">
                    <canvas id="salesComparisonChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Ventes mensuelles -->
    <div class="col-xl-4 col-lg-5">
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">📈 Ventes mensuelles ({{ currentYear }})</h6>
            </div>
            <div class="card-body">
                <div class="chart-bar" style="height: 300px;">
                    <canvas id="monthlySalesChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Graphiques Ligne 2 : Produits & Catégories -->
<div class="row mb-4">
    <!-- 3. Top 5 Produits -->
    <div class="col-xl-6 col-lg-6">
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">🏆 Top 5 Produits par quantité</h6>
            </div>
            <div class="card-body">
                <div class="chart-bar" style="height: 300px;">
                    <canvas id="topProductsChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Répartition des ventes par catégorie -->
    <div class="col-xl-6 col-lg-6">
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">🎯 Répartition des ventes par catégorie</h6>
            </div>
            <div class="card-body">
                <div class="chart-pie" style="height: 300px;">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Graphiques Ligne 3 : Croissance clients & Paiements -->
<div class="row mb-4">
    <!-- 5. Croissance des clients -->
    <div class="col-xl-6 col-lg-6">
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">📊 Croissance des clients ({{ currentYear }})</h6>
            </div>
            <div class="card-body">
                <div class="chart-area" style="height: 300px;">
                    <canvas id="customerGrowthChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- 6. État des paiements -->
    <div class="col-xl-6 col-lg-6">
        <div class="card shadow">
            <div class="card-header py-3 d-flex align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">💳 État des paiements</h6>
            </div>
            <div class="card-body">
                <div class="chart-pie" style="height: 300px;">
                    <canvas id="paymentStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    <script>
    $(document).ready(function() {
        const primaryHex = '#4e73df';
        const secondaryHex = '#e07410';
        const accentHex = '#1cc88a';

        function hexToRgba(hex, alpha) {
            const raw = hex.replace('#', '');
            const normalized = raw.length === 3
                ? raw.split('').map(function (char) { return char + char; }).join('')
                : raw;
            const color = parseInt(normalized, 16);

            return 'rgba('
                + ((color >> 16) & 255) + ', '
                + ((color >> 8) & 255) + ', '
                + (color & 255) + ', '
                + alpha + ')';
        }

        function buildGradient(context, startColor, endColor) {
            const gradient = context.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, startColor);
            gradient.addColorStop(1, endColor);

            return gradient;
        }

        const primaryColor = hexToRgba(primaryHex, 1);
        const secondaryColor = hexToRgba(secondaryHex, 1);
        const accentColor = hexToRgba(accentHex, 1);
        const successColor = accentColor;
        const dangerColor = 'rgba(231, 74, 59, 1)';
        const infoColor = hexToRgba(primaryHex, 0.72);
        const warningColor = hexToRgba(accentHex, 0.6);
        const themeSeries = [
            hexToRgba(primaryHex, 0.88),
            hexToRgba(secondaryHex, 0.88),
            hexToRgba(accentHex, 0.88),
            'rgba(15, 23, 42, 0.78)',
            'rgba(148, 163, 184, 0.84)',
            'rgba(231, 74, 59, 0.82)',
        ];

        // Utility function for formatting currency
        function formatCurrency(value) {
            return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(value);
        }

        // 1. Sales Comparison Chart (Line Chart - Year vs Year)
        const salesComparisonCtx = document.getElementById('salesComparisonChart').getContext('2d');
        new Chart(salesComparisonCtx, {
            type: 'line',
            data: {
                labels: {{ chartMonths|raw }},
                datasets: [
                    {
                        label: 'Année {{ currentYear }}',
                        data: {{ currentYearValues|raw }},
                        borderColor: primaryColor,
                        backgroundColor: hexToRgba(primaryHex, 0.12),
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true,
                        pointRadius: 4,
                        pointBackgroundColor: primaryColor,
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                    },
                    {
                        label: 'Année {{ previousYear }}',
                        data: {{ previousYearValues|raw }},
                        borderColor: secondaryColor,
                        backgroundColor: hexToRgba(secondaryHex, 0.12),
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true,
                        pointRadius: 4,
                        pointBackgroundColor: secondaryColor,
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0,0,0,0.8)',
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ' : ' + formatCurrency(context.parsed.y);
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return (value / 1000).toFixed(0) + 'K €';
                            }
                        }
                    }
                }
            }
        });

        // 2. Monthly Sales Distribution (Bar Chart)
        const monthlySalesCtx = document.getElementById('monthlySalesChart').getContext('2d');
        new Chart(monthlySalesCtx, {
            type: 'bar',
            data: {
                labels: {{ chartMonths|raw }},
                datasets: [{
                    label: 'Ventes mensuelles',
                    data: {{ currentYearValues|raw }},
                    backgroundColor: primaryColor,
                    borderColor: primaryColor,
                    borderWidth: 1,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false,
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0,0,0,0.8)',
                        callbacks: {
                            label: function(context) {
                                return formatCurrency(context.parsed.y);
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return (value / 1000).toFixed(0) + 'K €';
                            }
                        }
                    }
                }
            }
        });

        // 3. Top 5 Products (Horizontal Bar Chart)
        const topProductsCtx = document.getElementById('topProductsChart').getContext('2d');
        new Chart(topProductsCtx, {
            type: 'bar',
            data: {
                labels: {{ productNames|raw }},
                datasets: [{
                    label: 'Quantité vendue',
                    data: {{ productQty|raw }},
                    backgroundColor: themeSeries.slice(0, {{ productNames|raw }}.length),
                    borderColor: [
                        primaryColor,
                        secondaryColor,
                        accentColor,
                        infoColor,
                        warningColor,
                    ],
                    borderWidth: 1,
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false,
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return 'Qté : ' + context.parsed.x;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                    }
                }
            }
        });

        // 4. Sales by Category (Donut Chart — modern)
        const categoryCtx = document.getElementById('categoryChart').getContext('2d');
        const categoryGradients = [
            buildGradient(categoryCtx, hexToRgba(primaryHex, 0.95), hexToRgba(primaryHex, 0.55)),
            buildGradient(categoryCtx, hexToRgba(secondaryHex, 0.95), hexToRgba(secondaryHex, 0.55)),
            buildGradient(categoryCtx, hexToRgba(accentHex, 0.95), hexToRgba(accentHex, 0.55)),
            buildGradient(categoryCtx, 'rgba(15, 23, 42, 0.85)', 'rgba(15, 23, 42, 0.45)'),
            buildGradient(categoryCtx, 'rgba(148, 163, 184, 0.9)', 'rgba(148, 163, 184, 0.48)'),
            buildGradient(categoryCtx, 'rgba(231, 74, 59, 0.9)', 'rgba(231, 74, 59, 0.5)'),
        ];
        new Chart(categoryCtx, {
            type: 'doughnut',
            data: {
                labels: {{ categoryNames|raw }},
                datasets: [{
                    data: {{ categoryAmounts|raw }},
                    backgroundColor: categoryGradients.slice(0, {{ categoryNames|raw }}.length),
                    borderColor: '#fff',
                    borderWidth: 3,
                    hoverBorderWidth: 4,
                    hoverOffset: 8,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 16,
                            usePointStyle: true,
                            pointStyle: 'circle',
                            font: { size: 12, weight: '600' },
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0,0,0,0.8)',
                        padding: 12,
                        cornerRadius: 8,
                        titleFont: { size: 13, weight: '700' },
                        bodyFont: { size: 12 },
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = total > 0 ? ((context.parsed / total) * 100).toFixed(1) : 0;
                                return ' ' + formatCurrency(context.parsed) + ' (' + percentage + '%)';
                            }
                        }
                    }
                }
            }
        });

        // 5. Customer Growth (Line Chart)
        const customerGrowthCtx = document.getElementById('customerGrowthChart').getContext('2d');
        new Chart(customerGrowthCtx, {
            type: 'line',
            data: {
                labels: {{ chartMonths|raw }},
                datasets: [{
                    label: 'Clients actifs',
                    data: {{ customerCounts|raw }},
                    borderColor: successColor,
                    backgroundColor: hexToRgba(accentHex, 0.12),
                    borderWidth: 2,
                    tension: 0.4,
                    fill: true,
                    pointRadius: 4,
                    pointBackgroundColor: successColor,
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false,
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0,0,0,0.8)',
                        callbacks: {
                            label: function(context) {
                                return 'Clients : ' + Math.round(context.parsed.y);
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                    }
                }
            }
        });

        // 6. État des paiements (Doughnut Chart — modern)
        const paymentStatusCtx = document.getElementById('paymentStatusChart').getContext('2d');
        const paymentGradients = [
            buildGradient(paymentStatusCtx, hexToRgba(accentHex, 0.95), hexToRgba(accentHex, 0.55)),
            buildGradient(paymentStatusCtx, hexToRgba(primaryHex, 0.95), hexToRgba(primaryHex, 0.55)),
            buildGradient(paymentStatusCtx, hexToRgba(secondaryHex, 0.95), hexToRgba(secondaryHex, 0.55)),
            buildGradient(paymentStatusCtx, 'rgba(231, 74, 59, 0.9)', 'rgba(231, 74, 59, 0.5)'),
        ];
        new Chart(paymentStatusCtx, {
            type: 'doughnut',
            data: {
                labels: {{ paymentStatusLabels|raw }},
                datasets: [{
                    data: {{ paymentStatusAmounts|raw }},
                    backgroundColor: paymentGradients,
                    borderColor: '#fff',
                    borderWidth: 3,
                    hoverBorderWidth: 4,
                    hoverOffset: 8,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 16,
                            usePointStyle: true,
                            pointStyle: 'circle',
                            font: { size: 12, weight: '600' },
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0,0,0,0.8)',
                        padding: 12,
                        cornerRadius: 8,
                        titleFont: { size: 13, weight: '700' },
                        bodyFont: { size: 12 },
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const pct = total > 0 ? ((context.parsed / total) * 100).toFixed(1) : 0;
                                return ' ' + formatCurrency(context.parsed) + ' (' + pct + '%)';
                            }
                        }
                    }
                }
            }
        });
    });
    </script>
{% endblock %}
