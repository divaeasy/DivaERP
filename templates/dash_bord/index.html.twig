{% extends "template_oukatech.html.twig" %}
{% block PageTitle%}
    Dashboard
{% endblock %}
{% block body %}

<!-- KPI Cards Row -->
<div class="row mb-4">
    <!-- Total Revenue Card -->
    <div class="col mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                            💰 Total Revenue</div>
                        <div class="h6 mb-0 font-weight-bold text-gray-800">{{ totalRevenueCurrent|number_format(2, '.', ',') }}</div>
                        <small class="text-muted">{{ currentYear }}</small>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-wallet fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Growth % Card -->
    <div class="col mb-4">
        <div class="card {% if growthPercentage >= 0 %}border-left-success{% else %}border-left-danger{% endif %} shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold {% if growthPercentage >= 0 %}text-success{% else %}text-danger{% endif %} text-uppercase mb-1">
                            {% if growthPercentage >= 0 %}📈 Growth{% else %}📉 Decline{% endif %}</div>
                        <div class="h6 mb-0 font-weight-bold text-gray-800">
                            {% if growthPercentage >= 0 %}+{% endif %}{{ growthPercentage }}%
                        </div>
                        <small class="text-muted">vs {{ previousYear }}</small>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-chart-line fa-2x {% if growthPercentage >= 0 %}text-success{% else %}text-danger{% endif %}"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Invoice Count Card -->
    <div class="col mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                            🧾 Invoices</div>
                        <div class="h6 mb-0 font-weight-bold text-gray-800">{{ invoiceCount }}</div>
                        <small class="text-muted">Year {{ currentYear }}</small>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-file-invoice fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- New Customers Card -->
    <div class="col mb-4">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                            👥 New Customers</div>
                        <div class="h6 mb-0 font-weight-bold text-gray-800">{{ newCustomersThisMonth }}</div>
                        <small class="text-muted">This Month</small>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-user-plus fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Sold Card -->
    <div class="col mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                            📦 Products Sold</div>
                        <div class="h6 mb-0 font-weight-bold text-gray-800">{{ totalProductsSold }}</div>
                        <small class="text-muted">Year {{ currentYear }}</small>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-boxes fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 1: Sales Comparison -->
<div class="row mb-4">
    <!-- 1. Sales Comparison: Current Year vs Previous Year (Line Chart) -->
    <div class="col-xl-8 col-lg-7">
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">📊 Sales Comparison - {{ currentYear }} vs {{ previousYear }}</h6>
            </div>
            <div class="card-body">
                <div class="chart-area" style="height: 300px;">
                    <canvas id="salesComparisonChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Monthly Sales Distribution (Bar Chart) -->
    <div class="col-xl-4 col-lg-5">
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">📈 Monthly Sales ({{ currentYear }})</h6>
            </div>
            <div class="card-body">
                <div class="chart-bar" style="height: 300px;">
                    <canvas id="monthlySalesChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 2: Products & Categories -->
<div class="row mb-4">
    <!-- 3. Top 5 Products (Horizontal Bar Chart) -->
    <div class="col-xl-6 col-lg-6">
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">🏆 Top 5 Products by Quantity</h6>
            </div>
            <div class="card-body">
                <div class="chart-bar" style="height: 300px;">
                    <canvas id="topProductsChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Sales by Category (Donut Chart) -->
    <div class="col-xl-6 col-lg-6">
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">🎯 Sales Distribution by Category</h6>
            </div>
            <div class="card-body">
                <div class="chart-pie" style="height: 300px;">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 3: Customer Growth & Payments -->
<div class="row mb-4">
    <!-- 5. Customer Growth (Line Chart) -->
    <div class="col-xl-6 col-lg-6">
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">📊 Customer Growth ({{ currentYear }})</h6>
            </div>
            <div class="card-body">
                <div class="chart-area" style="height: 300px;">
                    <canvas id="customerGrowthChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- 6. Payment Status (Stacked Bar Chart) -->
    <div class="col-xl-6 col-lg-6">
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">💳 Payment Status Overview</h6>
            </div>
            <div class="card-body">
                <div class="chart-bar" style="height: 300px;">
                    <canvas id="paymentStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script>
        // Color palette
        const primaryColor = 'rgba(78, 115, 223, 1)';
        const secondaryColor = 'rgba(224, 116, 16, 1)';
        const successColor = 'rgba(28, 200, 138, 1)';
        const dangerColor = 'rgba(231, 74, 59, 1)';
        const infoColor = 'rgba(54, 185, 204, 1)';
        const warningColor = 'rgba(246, 194, 62, 1)';

        // Utility function for formatting currency
        function formatCurrency(value) {
            return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value);
        }

        // 1. Sales Comparison Chart (Line Chart - Year vs Year)
        const salesComparisonCtx = document.getElementById('salesComparisonChart').getContext('2d');
        new Chart(salesComparisonCtx, {
            type: 'line',
            data: {
                labels: {{ chartMonths|raw }},
                datasets: [
                    {
                        label: '{{ currentYear }}',
                        data: {{ currentYearValues|raw }},
                        borderColor: primaryColor,
                        backgroundColor: 'rgba(78, 115, 223, 0.1)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true,
                        pointRadius: 4,
                        pointBackgroundColor: primaryColor,
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                    },
                    {
                        label: '{{ previousYear }}',
                        data: {{ previousYearValues|raw }},
                        borderColor: secondaryColor,
                        backgroundColor: 'rgba(224, 116, 16, 0.1)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true,
                        pointRadius: 4,
                        pointBackgroundColor: secondaryColor,
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0,0,0,0.8)',
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': ' + formatCurrency(context.parsed.y);
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return '$' + (value / 1000).toFixed(0) + 'K';
                            }
                        }
                    }
                }
            }
        });

        // 2. Monthly Sales Distribution (Bar Chart)
        const monthlySalesCtx = document.getElementById('monthlySalesChart').getContext('2d');
        new Chart(monthlySalesCtx, {
            type: 'bar',
            data: {
                labels: {{ chartMonths|raw }},
                datasets: [{
                    label: 'Monthly Sales',
                    data: {{ currentYearValues|raw }},
                    backgroundColor: primaryColor,
                    borderColor: primaryColor,
                    borderWidth: 1,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false,
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0,0,0,0.8)',
                        callbacks: {
                            label: function(context) {
                                return formatCurrency(context.parsed.y);
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return '$' + (value / 1000).toFixed(0) + 'K';
                            }
                        }
                    }
                }
            }
        });

        // 3. Top 5 Products (Horizontal Bar Chart)
        const topProductsCtx = document.getElementById('topProductsChart').getContext('2d');
        new Chart(topProductsCtx, {
            type: 'bar',
            data: {
                labels: {{ productNames|raw }},
                datasets: [{
                    label: 'Quantity Sold',
                    data: {{ productQty|raw }},
                    backgroundColor: [
                        'rgba(78, 115, 223, 0.8)',
                        'rgba(224, 116, 16, 0.8)',
                        'rgba(28, 200, 138, 0.8)',
                        'rgba(54, 185, 204, 0.8)',
                        'rgba(246, 194, 62, 0.8)',
                    ],
                    borderColor: [
                        primaryColor,
                        secondaryColor,
                        successColor,
                        infoColor,
                        warningColor,
                    ],
                    borderWidth: 1,
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false,
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return 'Qty: ' + context.parsed.x;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                    }
                }
            }
        });

        // 4. Sales by Category (Donut Chart)
        const categoryCtx = document.getElementById('categoryChart').getContext('2d');
        const categoryColors = [
            'rgba(78, 115, 223, 0.8)',
            'rgba(224, 116, 16, 0.8)',
            'rgba(28, 200, 138, 0.8)',
            'rgba(54, 185, 204, 0.8)',
            'rgba(246, 194, 62, 0.8)',
            'rgba(231, 74, 59, 0.8)',
        ];
        new Chart(categoryCtx, {
            type: 'doughnut',
            data: {
                labels: {{ categoryNames|raw }},
                datasets: [{
                    data: {{ categoryAmounts|raw }},
                    backgroundColor: categoryColors.slice(0, {{ categoryNames|raw|length }}),
                    borderColor: '#fff',
                    borderWidth: 2,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = ((context.parsed / total) * 100).toFixed(1);
                                return context.label + ': ' + formatCurrency(context.parsed) + ' (' + percentage + '%)';
                            }
                        }
                    }
                }
            }
        });

        // 5. Customer Growth (Line Chart)
        const customerGrowthCtx = document.getElementById('customerGrowthChart').getContext('2d');
        new Chart(customerGrowthCtx, {
            type: 'line',
            data: {
                labels: {{ chartMonths|raw }},
                datasets: [{
                    label: 'Active Customers',
                    data: {{ customerCounts|raw }},
                    borderColor: successColor,
                    backgroundColor: 'rgba(28, 200, 138, 0.1)',
                    borderWidth: 2,
                    tension: 0.4,
                    fill: true,
                    pointRadius: 4,
                    pointBackgroundColor: successColor,
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false,
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0,0,0,0.8)',
                        callbacks: {
                            label: function(context) {
                                return 'Customers: ' + Math.round(context.parsed.y);
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                    }
                }
            }
        });

        // 6. Payment Status (Bar Chart)
        const paymentStatusCtx = document.getElementById('paymentStatusChart').getContext('2d');
        new Chart(paymentStatusCtx, {
            type: 'bar',
            data: {
                labels: {{ paymentStatusLabels|raw }},
                datasets: [{
                    label: 'Amount',
                    data: {{ paymentStatusAmounts|raw }},
                    backgroundColor: [
                        successColor,
                        infoColor,
                        warningColor,
                        dangerColor,
                    ],
                    borderColor: [
                        successColor,
                        infoColor,
                        warningColor,
                        dangerColor,
                    ],
                    borderWidth: 1,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false,
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return formatCurrency(context.parsed.y);
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return '$' + (value / 1000).toFixed(0) + 'K';
                            }
                        }
                    }
                }
            }
        });
    </script>
{% endblock %}