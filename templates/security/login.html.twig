{% extends 'template_oukatech.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<style>
    .auth-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 200px);
        padding: 40px 15px;
    }
    .auth-card {
        width: 100%;
        max-width: 460px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(78, 115, 223, 0.08), 0 2px 10px rgba(0,0,0,0.04);
        overflow: hidden;
        border: 1px solid rgba(0, 0, 0, 0.06);
    }
    .auth-header {
        background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-secondary) 100%);
        padding: 40px 40px 35px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .auth-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -30%;
        width: 80%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
    }
    .auth-header-icon {
        width: 70px;
        height: 70px;
        background: rgba(255,255,255,0.15);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        backdrop-filter: blur(5px);
    }
    .auth-header-icon i {
        font-size: 28px;
        color: white;
    }
    .auth-header h1 {
        color: white;
        font-size: 24px;
        font-weight: 700;
        margin: 0 0 6px;
        position: relative;
    }
    .auth-header p {
        color: rgba(255,255,255,0.8);
        font-size: 14px;
        margin: 0;
        position: relative;
    }
    .auth-body {
        padding: 35px 40px 40px;
    }
    .auth-form .form-group {
        margin-bottom: 22px;
    }
    .auth-form .form-group label {
        font-size: 13px;
        font-weight: 600;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }
    .auth-form .form-control {
        height: 48px;
        border: 2px solid #e3e6f0;
        border-radius: 10px;
        padding: 10px 16px 10px 44px;
        font-size: 14px;
        transition: all 0.2s ease;
        background-color: #f8f9fc;
    }
    .auth-form .form-control:focus {
        border-color: #4e73df;
        box-shadow: 0 0 0 3px rgba(78, 115, 223, 0.12);
        background-color: #fff;
    }
    .input-icon-wrapper {
        position: relative;
    }
    .input-icon-wrapper i,
    .input-icon-wrapper svg {
        position: absolute;
        left: 15px;
        top: 16px;
        color: #b7b9cc;
        font-size: 15px;
        width: 15px;
        height: 15px;
        z-index: 2;
        pointer-events: none;
        transition: color 0.2s;
    }
    .input-icon-wrapper:focus-within i,
    .input-icon-wrapper:focus-within svg {
        color: #4e73df;
    }
    .auth-form .btn-login {
        height: 48px;
        background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-secondary) 100%);
        border: none;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    .auth-form .btn-login:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }
    .auth-form .btn-login:active {
        transform: translateY(0);
    }
    .auth-divider {
        display: flex;
        align-items: center;
        margin: 25px 0;
        color: #b7b9cc;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .auth-divider::before,
    .auth-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #e3e6f0;
    }
    .auth-divider span {
        padding: 0 15px;
    }
    .auth-footer-link {
        text-align: center;
        font-size: 14px;
        color: #858796;
    }
    .auth-footer-link a {
        color: #4e73df;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.2s;
    }
    .auth-footer-link a:hover {
        color: #224abe;
        text-decoration: underline;
    }
    .custom-checkbox-styled {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        font-size: 13px;
        color: #6e707e;
    }
    .custom-checkbox-styled input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: #4e73df;
        cursor: pointer;
    }
</style>
{% endblock %}

{% block body %}
<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-header-icon">
                <i class="fas fa-lock"></i>
            </div>
            <h1>Connexion</h1>
            <p>Accédez à votre tableau de bord sécurisé</p>
        </div>
        <div class="auth-body">
            {% if error %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 10px; border: none; background: #fdf0ef; color: #e74a3b; font-size: 13px;">
                    <i class="fas fa-exclamation-circle mr-2"></i>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            {% endif %}

            {% for flash_message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 10px; border: none; background: #e8f8f0; color: #1cc88a; font-size: 13px;">
                    <i class="fas fa-check-circle mr-2"></i>
                    {{ flash_message }}
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            {% endfor %}

            {% if app.user %}
                <div class="alert alert-info" style="border-radius: 10px; border: none;">
                    Vous êtes connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>
                    <a href="{{ path('app_logout') }}" class="btn btn-sm btn-outline-danger float-right" style="border-radius: 6px;">Déconnexion</a>
                </div>
            {% else %}
                <form method="post" class="auth-form">
                    <div class="form-group">
                        <label for="inputEmail">Adresse email</label>
                        <div class="input-icon-wrapper">
                            <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus placeholder="votre@email.com">
                            <i class="fas fa-envelope"></i>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="inputPassword">Mot de passe</label>
                        <div class="input-icon-wrapper">
                            <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required placeholder="••••••••">
                            <i class="fas fa-key"></i>
                        </div>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="form-group d-flex align-items-center justify-content-between">
                        <label class="custom-checkbox-styled mb-0">
                            <input type="checkbox" name="_remember_me">
                            Se souvenir de moi
                        </label>
                    </div>

                    <button class="btn btn-primary btn-block btn-login" type="submit">
                        <i class="fas fa-sign-in-alt mr-2"></i>Se connecter
                    </button>
                </form>

                <div class="auth-divider"><span>ou</span></div>

                <p class="auth-footer-link mb-0">
                    Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a>
                </p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
